@model ShopProductFormViewModel

<form method="post" class="bg-white border rounded-3 p-4 text-dark">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Ürün adı</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Sku" class="form-label">SKU</label>
            <input asp-for="Sku" class="form-control" />
            <span asp-validation-for="Sku" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Category" class="form-label">Kategori</label>
            <input asp-for="Category" class="form-control" />
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="UnitPrice" class="form-label">Birim fiyat</label>
            <input asp-for="UnitPrice" class="form-control" />
            <span asp-validation-for="UnitPrice" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="StockQuantity" class="form-label">Bedensiz ürün stoğu</label>
            <input asp-for="StockQuantity" class="form-control" />
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
            <small class="form-text text-muted">Beden eklersen toplam stok bedenlerden hesaplanır.</small>
        </div>
        <div class="col-md-3">
            <label asp-for="MinimumStockQuantity" class="form-label">Kritik stok eşiği</label>
            <input asp-for="MinimumStockQuantity"
           class="form-control"
           min="0" />
            <span asp-validation-for="MinimumStockQuantity"
          class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="DisplayOrder" class="form-label">Sıralama</label>
            <input asp-for="DisplayOrder" class="form-control" />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <label class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                Aktif
            </label>
        </div>
        <div class="col-12">
            <label asp-for="ImageUrl" class="form-label">Görsel URL</label>
            <input asp-for="ImageUrl" class="form-control" />
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">Açıklama</label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Tags" class="form-label">Etiketler</label>
            <input asp-for="Tags" class="form-control" />
            <span asp-validation-for="Tags" class="text-danger"></span>
        </div>

        <div class="col-12" data-shop-variants>
            <div class="d-flex align-items-center justify-content-between gap-3 mb-2">
                <div>
                    <label class="form-label mb-0">Bedenler ve stokları</label>
                    <small class="d-block text-muted">Giyim ürünü değilse bu alanı boş bırakabilirsin.</small>
                </div>
                <button type="button"
                        class="btn btn-sm btn-outline-dark"
                        data-add-shop-variant>
                    + Beden ekle
                </button>
            </div>

            <div class="d-grid gap-2" data-shop-variant-list>
                @for (var index = 0; index < Model.Variants.Count; index++)
                {
                    <div class="row g-2 align-items-end border rounded-2 p-2"
                         data-shop-variant-row>
                        <input type="hidden" name="Variants.Index" value="@index" />
                        <input type="hidden" asp-for="Variants[index].Id" />
                        <div class="col-md-5">
                            <label asp-for="Variants[index].Size" class="form-label">Beden</label>
                            <input asp-for="Variants[index].Size" class="form-control" placeholder="S, M, L, XL..." />
                            <span asp-validation-for="Variants[index].Size" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Variants[index].StockQuantity" class="form-label">Stok</label>
                            <input asp-for="Variants[index].StockQuantity" class="form-control" min="0" />
                            <span asp-validation-for="Variants[index].StockQuantity" class="text-danger"></span>
                        </div>
                        <div class="col-md-2">
                            <label class="form-check mb-2">
                                <input asp-for="Variants[index].IsActive" class="form-check-input" />
                                Aktif
                            </label>
                        </div>
                        <div class="col-md-2 text-end">
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    data-remove-shop-variant>
                                Kaldır
                            </button>
                        </div>
                    </div>
                }
            </div>

            <span asp-validation-for="Variants" class="text-danger"></span>

            <template data-shop-variant-template>
                <div class="row g-2 align-items-end border rounded-2 p-2"
                     data-shop-variant-row>
                    <input type="hidden" name="Variants.Index" value="__index__" />
                    <input type="hidden" name="Variants[__index__].Id" value="0" />
                    <div class="col-md-5">
                        <label class="form-label">Beden</label>
                        <input name="Variants[__index__].Size" class="form-control" maxlength="50" placeholder="S, M, L, XL..." required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Stok</label>
                        <input name="Variants[__index__].StockQuantity" class="form-control" type="number" min="0" max="100000" value="0" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-check mb-2">
                            <input name="Variants[__index__].IsActive" class="form-check-input" type="checkbox" value="true" checked />
                            <input name="Variants[__index__].IsActive" type="hidden" value="false" />
                            Aktif
                        </label>
                    </div>
                    <div class="col-md-2 text-end">
                        <button type="button" class="btn btn-sm btn-outline-danger" data-remove-shop-variant>Kaldır</button>
                    </div>
                </div>
            </template>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        <button type="submit" class="btn btn-dark">Kaydet</button>
    </div>
</form>

<script>
    (() => {
        const root = document.querySelector("[data-shop-variants]");
        const list = root?.querySelector("[data-shop-variant-list]");
        const template = root?.querySelector("[data-shop-variant-template]");
        const addButton = root?.querySelector("[data-add-shop-variant]");

        if (!root || !list || !template || !addButton) {
            return;
        }

        let nextIndex = Date.now();

        root.addEventListener("click", event => {
            const removeButton = event.target.closest("[data-remove-shop-variant]");
            if (removeButton) {
                removeButton.closest("[data-shop-variant-row]")?.remove();
            }
        });

        addButton.addEventListener("click", () => {
            const html = template.innerHTML.replaceAll("__index__", nextIndex++);
            list.insertAdjacentHTML("beforeend", html);
            list.lastElementChild?.querySelector('input[name$=".Size"]')?.focus();
        });
    })();
</script>
