@model NO23.Web.ViewModels.GuestOrders.GuestOrderConfirmationViewModel
@{
    ViewData["Title"] = "Sipariş Alındı";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    <span class="badge text-bg-success mb-3">Siparişiniz alındı</span>
                    <h1 class="h2 mb-3">NO23 Shop siparişin oluşturuldu.</h1>
                    <p class="text-muted mb-4">
                        Sipariş numaranı teslimat takibi için saklayabilirsin.
                    </p>

                    <dl class="row g-3">
                        <dt class="col-sm-5">Sipariş Numarası</dt>
                        <dd class="col-sm-7"><strong>@Model.OrderNumber</strong></dd>
                        <dt class="col-sm-5">Ürün</dt>
                        <dd class="col-sm-7">@Model.ProductName</dd>
                        <dt class="col-sm-5">Adet</dt>
                        <dd class="col-sm-7">@Model.Quantity</dd>
                        <dt class="col-sm-5">Toplam</dt>
                        <dd class="col-sm-7">@Model.Total.ToString("C0")</dd>
                        <dt class="col-sm-5">Teslimat</dt>
                        <dd class="col-sm-7">@Model.DeliveryDate.ToString("dd.MM.yyyy") / @Model.DeliveryTimeSlot</dd>
                        <dt class="col-sm-5">Ödeme</dt>
                        <dd class="col-sm-7">@Model.PaymentStatusText</dd>
                    </dl>

                    <a class="btn btn-dark mt-4" asp-controller="Shop" asp-action="Index">
                        Shop'a Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
