@model KitchenMenuItemFormViewModel

<form method="post" class="bg-white border rounded-3 p-4 text-dark">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Category" class="form-label"></label>
            <select asp-for="Category" asp-items="Html.GetEnumSelectList<MenuItemCategory>()" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="DisplayOrder" class="form-label"></label>
            <input asp-for="DisplayOrder" class="form-control" />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Calories" class="form-label"></label>
            <input asp-for="Calories" class="form-control" />
            <span asp-validation-for="Calories" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="UnitPrice" class="form-label"></label>
            <input asp-for="UnitPrice" class="form-control" />
            <span asp-validation-for="UnitPrice" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="ProteinGrams" class="form-label"></label>
            <input asp-for="ProteinGrams" class="form-control" />
            <span asp-validation-for="ProteinGrams" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="CarbohydrateGrams" class="form-label"></label>
            <input asp-for="CarbohydrateGrams" class="form-control" />
            <span asp-validation-for="CarbohydrateGrams" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="FatGrams" class="form-label"></label>
            <input asp-for="FatGrams" class="form-control" />
            <span asp-validation-for="FatGrams" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Ingredients" class="form-label"></label>
            <textarea asp-for="Ingredients" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Ingredients" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Allergens" class="form-label"></label>
            <input asp-for="Allergens" class="form-control" />
            <span asp-validation-for="Allergens" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Tags" class="form-label"></label>
            <input asp-for="Tags" class="form-control" />
            <span asp-validation-for="Tags" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                @Html.DisplayNameFor(model => model.IsActive)
            </label>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        <button type="submit" class="btn btn-dark">Kaydet</button>
    </div>
</form>
