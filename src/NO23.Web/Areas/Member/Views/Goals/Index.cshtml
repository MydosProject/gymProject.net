@using System.Globalization
@model MemberGoalsIndexViewModel

@{
    ViewData["Title"] = "Hedeflerim";
    var classCreditText = Model.HasUnlimitedClasses
        ? "Sınırsız"
        : Model.RemainingClassCredits.ToString("00");

    string GetChallengeStatusName(string status)
    {
        return status switch
        {
            "Upcoming" => "Yakında",
            "Active" => "Devam Ediyor",
            "Completed" => "Tamamlandı",
            "Cancelled" => "İptal Edildi",
            _ => status
        };
    }
}

<section class="member-account-page member-goals-page">
    <div class="member-account-grid" aria-hidden="true"></div>
    <div class="member-account-orbit" aria-hidden="true"></div>

    <div class="container position-relative">
        <header class="member-account-hero">
            <div>
                <p class="member-account-kicker">NO23 / HEDEF PLANI</p>
                <h1>Hedefini belirle.<br /><span>Ritmini koru.</span></h1>
                <p>
                    Antrenman odağını güncel tut; üyelik paketin ve
                    kalan ders hakkınla planını aynı ekrandan takip et.
                </p>
            </div>

            <aside class="member-goals-score">
                <span>AKTİF PAKET</span>
                <strong>@Model.MembershipPackageName</strong>
                <div>
                    <small>KALAN DERS</small>
                    <b>@classCreditText</b>
                </div>
            </aside>
        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="member-dashboard-alert member-dashboard-alert-success" role="status">
                <span aria-hidden="true">✓</span>
                <div>
                    <strong>Hedefin güncellendi</strong>
                    <p>@successMessage</p>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="member-dashboard-alert" role="alert">
                <span aria-hidden="true">!</span>
                <div>
                    <strong>İşlem tamamlanamadı</strong>
                    <p>@errorMessage</p>
                </div>
            </div>
        }

        <div class="member-goals-layout">
            <form asp-area="Member"
                  asp-controller="Goals"
                  asp-action="Index"
                  asp-antiforgery="true"
                  method="post"
                  class="member-goals-form">
                <div class="member-account-card-head">
                    <span>01</span>
                    <div>
                        <p>ANTRENMAN ODAĞIN</p>
                        <h2>Neyi başarmak istiyorsun?</h2>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly"
                     class="member-account-validation"
                     role="alert"></div>

                <label class="member-goal-field">
                    <span>Fitness hedefi</span>
                    <textarea asp-for="FitnessGoal"
                              rows="6"
                              placeholder="Örneğin: Kuvvetimi artırmak, yağ oranımı düşürmek ve haftada üç gün düzenli antrenman yapmak istiyorum."></textarea>
                    <small asp-validation-for="FitnessGoal"></small>
                </label>

                <div class="member-goal-note">
                    <span aria-hidden="true">23</span>
                    <p>
                        Hedefini açık ve ölçülebilir yazman, ders ve
                        eğitmen seçimlerini daha kolay planlamanı sağlar.
                    </p>
                </div>

                <button class="member-account-submit" type="submit">
                    Hedefimi Güncelle
                    <span aria-hidden="true">→</span>
                </button>
            </form>

            <aside class="member-goals-membership">
                <div class="member-account-card-head">
                    <span>02</span>
                    <div>
                        <p>PAKETİN</p>
                        <h2>@Model.MembershipPackageName</h2>
                    </div>
                </div>

                <p class="member-goals-audience">@Model.MembershipPackageAudience</p>
                <p class="member-goals-description">@Model.MembershipPackageDescription</p>

                <div class="member-goals-credit">
                    <span>Kalan ders hakkın</span>
                    <strong>@classCreditText</strong>
                </div>

                @if (Model.IncludedBenefits.Count > 0)
                {
                    <div class="member-goals-benefits">
                        <span>PAKET AVANTAJLARI</span>
                        <ul>
                            @foreach (var benefit in Model.IncludedBenefits)
                            {
                                <li>@benefit</li>
                            }
                        </ul>
                    </div>
                }

                <a asp-area="Member"
                   asp-controller="Reservations"
                   asp-action="Index"
                   asp-fragment="group-classes"
                   class="member-account-settings-link">
                    Dersleri İncele
                    <span aria-hidden="true">↗</span>
                </a>
            </aside>
        </div>

        <section class="member-goals-challenges" id="challenge-progress">
            <div class="member-account-card-head">
                <span>03</span>
                <div>
                    <p>COMMUNITY CHALLENGE</p>
                    <h2>Kalori uyumunu takip et.</h2>
                </div>
            </div>

            @if (Model.ChallengeProgressCards.Count == 0)
            {
                <div class="member-goals-empty">
                    <strong>Henüz aktif challenge katılımın yok.</strong>
                    <p>Community sayfasındaki açık challenge'lara katıldığında ilerlemen burada görünecek.</p>
                    <a asp-area=""
                       asp-controller="Community"
                       asp-action="Index"
                       asp-fragment="challenges">
                        Challenge'ları incele
                    </a>
                </div>
            }
            else
            {
                <div class="member-challenge-grid">
                    @foreach (var challenge in Model.ChallengeProgressCards)
                    {
                        var progressWidth = Math.Min(100, challenge.ProgressPercent)
                            .ToString("0.#", CultureInfo.InvariantCulture);

                        <article class="member-challenge-card">
                            <div class="member-challenge-card-head">
                                <div>
                                    <span>@GetChallengeStatusName(challenge.Status)</span>
                                    <h3>@challenge.Title</h3>
                                </div>
                                <strong>@challenge.ProgressPercent%</strong>
                            </div>

                            <div class="member-challenge-progress">
                                <span style="width: @progressWidth%"></span>
                            </div>

                            <dl class="member-challenge-stats">
                                <div>
                                    <dt>Hedef aralığı</dt>
                                    <dd>@challenge.MinDailyCalories - @challenge.MaxDailyCalories kcal</dd>
                                </div>
                                <div>
                                    <dt>Başarılı gün</dt>
                                    <dd>@challenge.CompliantDays / @challenge.TotalDays</dd>
                                </div>
                                <div>
                                    <dt>Giriş</dt>
                                    <dd>@challenge.LoggedDays gün</dd>
                                </div>
                                <div>
                                    <dt>Tamamlanma</dt>
                                    <dd>@challenge.RequiredCompletionPercent%</dd>
                                </div>
                            </dl>

                            @if (challenge.TodayCaloriesConsumed.HasValue)
                            {
                                <p class="member-challenge-today">
                                    Bugün: @challenge.TodayCaloriesConsumed kcal ·
                                    @(challenge.TodayIsCompliant == true ? "Hedef aralığında" : "Hedef aralığı dışında")
                                </p>
                            }

                            @if (challenge.CanLogToday)
                            {
                                <form asp-area="Member"
                                      asp-controller="Goals"
                                      asp-action="LogChallengeCalories"
                                      asp-antiforgery="true"
                                      method="post"
                                      class="member-challenge-log-form">
                                    <input type="hidden" name="ParticipationId" value="@challenge.ParticipationId" />
                                    <input type="hidden" name="EntryDate" value="@challenge.LogDate.ToString("yyyy-MM-dd")" />
                                    <label>
                                        <span>Bugün alınan kalori</span>
                                        <input type="number"
                                               name="CaloriesConsumed"
                                               min="1"
                                               max="10000"
                                               value="@(challenge.TodayCaloriesConsumed?.ToString() ?? string.Empty)"
                                               placeholder="Örn. @challenge.TargetDailyCalories" />
                                    </label>
                                    <button type="submit">Kaloriyi Kaydet</button>
                                </form>
                            }
                            else
                            {
                                <p class="member-challenge-note">
                                    Kalori girişi challenge aktif tarih aralığında açılır.
                                </p>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
