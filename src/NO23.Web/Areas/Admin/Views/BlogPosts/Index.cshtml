@model IReadOnlyList<BlogPostListItemViewModel>
@{
    ViewData["Title"] = "NO23 Journal";
    var publishedCount = Model.Count(item => item.PublishedAtUtc.HasValue);
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">İÇERİK / NO23 JOURNAL</p>
                <h1>Blog yönetimi</h1>
                <p class="admin-page-description">Antrenman, beslenme ve yaşam tarzı içeriklerini yayına hazırla.</p>
            </div>
            <a class="btn btn-dark" asp-action="Create">+ Yeni yazı</a>
        </header>

        <div class="admin-metrics admin-metrics-two">
            <article><span>Toplam içerik</span><strong>@Model.Count</strong><small>Journal arşivi</small></article>
            <article><span>Yayın tarihli</span><strong>@publishedCount</strong><small>Planlanmış / yayında</small></article>
        </div>

        <div class="table-responsive admin-table-card">
            <table class="table align-middle mb-0">
                <thead><tr><th>Başlık</th><th>Kategori</th><th>Durum</th><th>Yayın tarihi</th><th class="text-end">İşlem</th></tr></thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="5"><div class="admin-empty-row">Henüz Journal yazısı eklenmedi.</div></td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Title</strong></td>
                                <td>@item.Category</td>
                                <td><span class="admin-status">@item.Status</span></td>
                                <td>@(item.PublishedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy") ?? "-")</td>
                                <td class="text-end"><a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
