@model NO23.Web.ViewModels.GuestOrders.GuestOrderPageViewModel
@{
    ViewData["Title"] = $"{Model.ItemName} Siparişi";
    var deliverySlots = new[] { "10:00-13:00", "13:00-16:00", "16:00-19:00" };
    var isOutOfStock = Model.StockQuantity is <= 0;
}

<section class="container py-5">
    <div class="row g-5">
        <div class="col-lg-5">
            <a class="text-decoration-none" asp-controller="Shop" asp-action="Index">
                Tüm shop ürünleri
            </a>

            <div class="mt-4">
                <span class="badge text-bg-light mb-3">@Model.Category</span>
                <h1 class="h2">@Model.ItemName</h1>
                <p class="text-muted">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "NO23 Shop koleksiyonundan seçili ürün."
                        : Model.Description)
                </p>
                <strong class="fs-4">@Model.UnitPrice.ToString("C0")</strong>
                <p class="small text-muted mt-3 mb-0">Stok: @(Model.StockQuantity ?? 0)</p>
            </div>
        </div>

        <div class="col-lg-7">
            <form class="card border-0 shadow-sm"
                  asp-controller="Shop"
                  asp-action="PlaceOrder"
                  method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ItemId" />

                <div class="card-body p-4">
                    <h2 class="h4 mb-4">Teslimat bilgileri</h2>

                    @if (isOutOfStock)
                    {
                        <div class="alert alert-warning">
                            Bu ürün şu anda stokta yok.
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="guestQuantity">Adet</label>
                            <input class="form-control" id="guestQuantity" name="input.Quantity" type="number" min="1" max="99" value="@Model.Input.Quantity" />
                            @Html.ValidationMessage("input.Quantity", null, new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-8">
                            <label class="form-label" for="guestFullName">Ad Soyad</label>
                            <input class="form-control" id="guestFullName" name="input.FullName" value="@Model.Input.FullName" autocomplete="name" />
                            @Html.ValidationMessage("input.FullName", null, new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="guestEmail">E-posta</label>
                            <input class="form-control" id="guestEmail" name="input.Email" type="email" value="@Model.Input.Email" autocomplete="email" />
                            @Html.ValidationMessage("input.Email", null, new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="guestPhone">Telefon</label>
                            <input class="form-control" id="guestPhone" name="input.PhoneNumber" value="@Model.Input.PhoneNumber" autocomplete="tel" />
                            @Html.ValidationMessage("input.PhoneNumber", null, new { @class = "text-danger small" })
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="guestAddress">Adres</label>
                            <textarea class="form-control" id="guestAddress" name="input.AddressLine" rows="3">@Model.Input.AddressLine</textarea>
                            @Html.ValidationMessage("input.AddressLine", null, new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" for="guestDistrict">İlçe</label>
                            <input class="form-control" id="guestDistrict" name="input.District" value="@Model.Input.District" />
                            @Html.ValidationMessage("input.District", null, new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" for="guestCity">Şehir</label>
                            <input class="form-control" id="guestCity" name="input.City" value="@Model.Input.City" />
                            @Html.ValidationMessage("input.City", null, new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-4">
                            <label class="form-label" for="guestPostalCode">Posta Kodu</label>
                            <input class="form-control" id="guestPostalCode" name="input.PostalCode" value="@Model.Input.PostalCode" />
                            @Html.ValidationMessage("input.PostalCode", null, new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="guestDeliveryDate">Teslimat Tarihi</label>
                            <input class="form-control" id="guestDeliveryDate" name="input.DeliveryDate" type="date" value="@Model.Input.DeliveryDate.ToString("yyyy-MM-dd")" />
                            @Html.ValidationMessage("input.DeliveryDate", null, new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label" for="guestDeliveryTimeSlot">Teslimat Saati</label>
                            <select class="form-select" id="guestDeliveryTimeSlot" name="input.DeliveryTimeSlot">
                                @foreach (var slot in deliverySlots)
                                {
                                    <option value="@slot" selected="@(slot == Model.Input.DeliveryTimeSlot ? "selected" : null)">@slot</option>
                                }
                            </select>
                            @Html.ValidationMessage("input.DeliveryTimeSlot", null, new { @class = "text-danger small" })
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="guestNotes">Sipariş Notu</label>
                            <textarea class="form-control" id="guestNotes" name="input.Notes" rows="3">@Model.Input.Notes</textarea>
                            @Html.ValidationMessage("input.Notes", null, new { @class = "text-danger small" })
                        </div>
                    </div>

                    <button class="btn btn-dark w-100 mt-4" type="submit" disabled="@isOutOfStock">
                        Siparişi Oluştur
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>
