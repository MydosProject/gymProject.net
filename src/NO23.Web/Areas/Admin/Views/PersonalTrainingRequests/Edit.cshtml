@model PersonalTrainingRequestFormViewModel

@{
    ViewData["Title"] = "Birebir Talep Yönetimi";

    var createdAtLocal =
        Model.CreatedAtUtc.ToLocalTime();
}

<section class="admin-personal-edit-page admin-personal-edit-redesign">

    <header class="admin-personal-edit-hero">

        <div>

            <p class="admin-personal-edit-hero-eyebrow">
                NO23 CLUB / DERS YÖNETİMİ
            </p>

            <h1>
                Birebir talebi yönet
            </h1>

            <p>
                Üyenin tercih ettiği gün ve saat aralığını incele,
                kesin randevuyu planla veya talebi uygun durumla kapat.
            </p>

        </div>

        <div class="admin-personal-edit-hero-reference">

            <span>
                Talep no
            </span>

            <strong>
                #@Model.Id.ToString("0000")
            </strong>

        </div>

    </header>


    <form method="post"
          class="admin-personal-edit-redesign-form">

        <div asp-validation-summary="ModelOnly"
             class="admin-personal-validation-summary text-danger">
        </div>

        <input type="hidden"
               asp-for="Id" />


        <section class="admin-personal-edit-block">

            <header class="admin-personal-edit-block-head">

                <span>
                    01
                </span>

                <div>

                    <p>
                        Talep özeti
                    </p>

                    <h2>
                        Üye ve çalışma bilgileri
                    </h2>

                </div>

            </header>


            <div class="admin-personal-edit-summary-grid">

                <article class="admin-personal-edit-summary-card">

                    <span>
                        Üye
                    </span>

                    <div class="admin-personal-edit-person">

                        <strong class="admin-personal-edit-avatar">
                            @(string.IsNullOrWhiteSpace(Model.MemberName)
                                ? "Ü"
                                : Model.MemberName
                                    .Trim()[0]
                                    .ToString()
                                    .ToUpper())
                        </strong>

                        <div>

                            <h3>
                                @Model.MemberName
                            </h3>

                            <p>
                                @Model.MemberEmail
                            </p>

                        </div>

                    </div>

                </article>


                <article class="admin-personal-edit-summary-card">

                    <span>
                        Eğitmen
                    </span>

                    <div class="admin-personal-edit-person">

                        <strong class="admin-personal-edit-avatar">
                            @(string.IsNullOrWhiteSpace(Model.TrainerName)
                                ? "E"
                                : Model.TrainerName
                                    .Trim()[0]
                                    .ToString()
                                    .ToUpper())
                        </strong>

                        <div>

                            <h3>
                                @Model.TrainerName
                            </h3>

                            <p class="admin-personal-edit-trainer-state
                                      @(Model.TrainerIsActive
                                          ? "is-active"
                                          : "is-inactive")">

                                @(Model.TrainerIsActive
                                    ? "Aktif eğitmen"
                                    : "Pasif eğitmen")

                            </p>

                        </div>

                    </div>

                </article>


                <article class="admin-personal-edit-summary-card">

                    <span>
                        Tercih edilen gün
                    </span>

                    <strong class="admin-personal-edit-summary-value">
                        @Model.PreferredDate.ToString("dd.MM.yyyy")
                    </strong>

                    <p>
                        Üyenin seçtiği tarih
                    </p>

                </article>


                <article class="admin-personal-edit-summary-card">

                    <span>
                        Saat aralığı
                    </span>

                    <strong class="admin-personal-edit-summary-value">
                        @Model.PreferredTimeWindow
                    </strong>

                    <p>
                        Üyenin tercih ettiği zaman
                    </p>

                </article>

            </div>


            <div class="admin-personal-edit-notes-grid">

                <article class="admin-personal-edit-note-card">

                    <div>

                        <span>
                            Üye notu
                        </span>

                        <strong>
                            Hedef ve beklenti
                        </strong>

                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.GoalNote)
                            ? "Üye bu talep için ek bir not paylaşmadı."
                            : Model.GoalNote)
                    </p>

                </article>


                <article class="admin-personal-edit-note-card is-trainer">

                    <div>

                        <span>
                            Eğitmen notu
                        </span>

                        <strong>
                            Eğitmenin üyeye ilettiği bilgi
                        </strong>

                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.TrainerNote)
                            ? "Eğitmen bu talep için henüz bir not eklemedi."
                            : Model.TrainerNote)
                    </p>

                </article>

            </div>

        </section>


        <section class="admin-personal-edit-block admin-personal-edit-planning">

            <header class="admin-personal-edit-block-head">

                <span>
                    02
                </span>

                <div>

                    <p>
                        Planlama
                    </p>

                    <h2>
                        Talep durumunu güncelle
                    </h2>

                </div>

            </header>


            <div class="admin-personal-edit-planning-grid">

                <div class="admin-personal-edit-field">

                    <label asp-for="Status">
                    </label>

                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<PersonalTrainingRequestStatus>()">
                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger">
                    </span>

                    <small>
                        Mevcut durum:
                        <strong>
                            @Model.CurrentStatusDisplayName
                        </strong>
                    </small>

                </div>


                <div class="admin-personal-edit-field">

                    <label asp-for="ScheduledAtLocal">
                    </label>

                    <input asp-for="ScheduledAtLocal"
                           type="datetime-local" />

                    <span asp-validation-for="ScheduledAtLocal"
                          class="text-danger">
                    </span>

                    <small>
                        Planlandı durumu için zorunludur.
                    </small>

                </div>


                <div class="admin-personal-edit-field is-wide">

                    <label asp-for="AdminNote">
                    </label>

                    <textarea asp-for="AdminNote"
                              rows="4"
                              placeholder="Üyeye gösterilecek planlama veya durum notunu yaz.">
                    </textarea>

                    <span asp-validation-for="AdminNote"
                          class="text-danger">
                    </span>

                </div>

            </div>


            @if (!Model.CanPlan)
            {
                <div class="admin-personal-edit-warning">

                    <span aria-hidden="true">
                        !
                    </span>

                    <div>

                        <strong>
                            Yeni planlama yapılamaz
                        </strong>

                        <p>
                            Bu talebin eğitmeni pasif olduğu için
                            yeni bir randevu planlanamaz.
                        </p>

                    </div>

                </div>
            }


            <footer class="admin-personal-edit-actions-footer">

                <div class="admin-personal-edit-created">

                    <span>
                        Oluşturulma
                    </span>

                    <strong>
                        @createdAtLocal.ToString(
                            "dd.MM.yyyy · HH:mm")
                    </strong>

                </div>


                <div class="admin-personal-edit-actions">

                    <a asp-action="Index"
                       class="admin-personal-edit-cancel">

                        Vazgeç

                    </a>

                    <button type="submit"
                            class="admin-personal-edit-save">

                        <span>
                            Değişiklikleri Kaydet
                        </span>

                        <strong aria-hidden="true">
                            →
                        </strong>

                    </button>

                </div>

            </footer>

        </section>

    </form>

</section>


@section Scripts {

}