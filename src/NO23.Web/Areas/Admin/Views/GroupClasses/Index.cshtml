@model IReadOnlyList<GroupClassListItemViewModel>
@{
    ViewData["Title"] = "Grup Dersleri";
}

<section class="py-5">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">Admin</p>
                <h1 class="h3 mb-0">Grup Dersleri</h1>
            </div>

            <a class="btn btn-dark" asp-action="Create">Yeni Ders</a>
        </div>

        <div class="table-responsive bg-white border rounded-3">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ders</th>
                        <th>Eğitmen</th>
                        <th>Süre</th>
                        <th>Zorluk</th>
                        <th>Kalori</th>
                        <th>Kapasite</th>
                        <th>Program</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var groupClass in Model)
                    {
                        <tr>
                            <td><strong>@groupClass.Name</strong></td>
                            <td>@groupClass.TrainerName</td>
                            <td>@groupClass.DurationMinutes dk</td>
                            <td>@groupClass.DifficultyLevel</td>
                            <td>@groupClass.AverageCaloriesBurned</td>
                            <td>@groupClass.Capacity</td>
                            <td>@groupClass.SessionCount</td>
                            <td>
                                <span class="badge @(groupClass.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(groupClass.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@groupClass.Id">Düzenle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
