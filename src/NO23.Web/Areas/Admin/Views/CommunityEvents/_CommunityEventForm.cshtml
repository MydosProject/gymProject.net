@model CommunityEventFormViewModel

<form method="post" class="bg-white border rounded-3 p-4 text-dark">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Title" class="form-label">Başlık</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Slug" class="form-label">URL kısa adı</label>
            <input asp-for="Slug" class="form-control" />
            <span asp-validation-for="Slug" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Summary" class="form-label">Kısa özet</label>
            <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Summary" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">Açıklama</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Type" class="form-label">Etkinlik türü</label>
            <select asp-for="Type" asp-items="Html.GetEnumSelectList<CommunityEventType>()" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label">Durum</label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<CommunityEventStatus>()" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="StartsAtUtc" class="form-label">Başlangıç</label>
            <input asp-for="StartsAtUtc" class="form-control" />
            <span asp-validation-for="StartsAtUtc" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="EndsAtUtc" class="form-label">Bitiş</label>
            <input asp-for="EndsAtUtc" class="form-control" />
            <span asp-validation-for="EndsAtUtc" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Location" class="form-label">Konum</label>
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Capacity" class="form-label">Kapasite</label>
            <input asp-for="Capacity" class="form-control" />
            <span asp-validation-for="Capacity" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="DisplayOrder" class="form-label">Sıralama</label>
            <input asp-for="DisplayOrder" class="form-control" />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="ImageUrl" class="form-label">Görsel URL</label>
            <input asp-for="ImageUrl" class="form-control" />
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label class="form-check">
                <input asp-for="IsMembersOnly" class="form-check-input" />
                Yalnızca üyelere özel
            </label>
        </div>
    </div>

    <div class="d-flex align-items-center flex-wrap gap-2 mt-4">
        @if (Model.Id > 0 &&
             Model.Status == CommunityEventStatus.Scheduled)
        {
            <button type="submit"
                    asp-action="Cancel"
                    asp-route-id="@Model.Id"
                    formnovalidate
                    class="btn btn-outline-danger admin-cancel-event-button"
                    onclick="return confirm('Bu etkinlik iptal edilecek ve kullanıcıların etkinlik listesinden kaldırılacak. Emin misin?');">
                Etkinliği İptal Et
            </button>
        }

        <div class="d-flex gap-2 ms-auto">
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Vazgeç
            </a>

            <button type="submit" class="btn btn-dark">
                Değişiklikleri Kaydet
            </button>
        </div>
    </div>
</form>
