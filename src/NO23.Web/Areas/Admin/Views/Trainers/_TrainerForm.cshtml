@model TrainerFormViewModel

<form method="post" class="bg-white border rounded-3 p-4 text-dark">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Specialty" class="form-label"></label>
            <input asp-for="Specialty" class="form-control" />
            <span asp-validation-for="Specialty" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Certifications" class="form-label"></label>
            <input asp-for="Certifications" class="form-control" />
            <span asp-validation-for="Certifications" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Bio" class="form-label"></label>
            <textarea asp-for="Bio" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Bio" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                @Html.DisplayNameFor(model => model.IsActive)
            </label>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        <button type="submit" class="btn btn-dark">Kaydet</button>
    </div>
</form>
