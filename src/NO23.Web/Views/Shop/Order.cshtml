@model NO23.Web.ViewModels.GuestOrders.GuestOrderPageViewModel
@{
    ViewData["Title"] = $"{Model.ItemName} Siparişi";
    var deliverySlots = new[] { "10:00-13:00", "13:00-16:00", "16:00-19:00" };
    var isOutOfStock = Model.StockQuantity is <= 0;
}

<div class="public-order-page public-shop-order">
    <div class="public-order-grid-bg" aria-hidden="true"></div>
    <div class="container position-relative">
        <header class="public-order-header">
            <a class="public-order-back"
               asp-area=""
               asp-controller="Shop"
               asp-action="Index">
                <span aria-hidden="true">←</span> Shop'a Dön
            </a>
            <div>
                <p class="public-order-kicker">NO23 / Guest Order</p>
                <h1>Seçimini yaptın.<br /><span>Teslimatını planla.</span></h1>
            </div>
            <p>
                Üyelik gerektirmeden sipariş bilgilerini tamamla.
                Siparişin oluşturulduğunda takip numaran ekranda gösterilecek.
            </p>
        </header>

        <div class="public-order-layout">
            <aside class="public-order-product public-shop-order-product">
                <div class="public-order-shop-visual">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.ItemName" />
                    }
                    <span>NO23 / Performance Goods</span>
                    <strong>23</strong>
                </div>
                <div class="public-order-shop-copy">
                    <div class="public-order-product-top">
                        <span>@Model.Category</span>
                        <strong class="@(isOutOfStock ? "public-stock-out" : "public-stock-in")">
                            @(isOutOfStock ? "Stokta Yok" : $"Stokta {Model.StockQuantity ?? 0}")
                        </strong>
                    </div>
                    <h2>@Model.ItemName</h2>
                    <p>
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "NO23 Shop koleksiyonundan seçilen performans odaklı ürün."
                            : Model.Description)
                    </p>
                    <div class="public-order-product-price">
                        <span>Tek ürün fiyatı</span>
                        <strong>@Model.UnitPrice.ToString("C0")</strong>
                    </div>
                </div>
            </aside>

            <form class="public-order-form"
                  asp-area=""
                  asp-controller="Shop"
                  asp-action="PlaceOrder"
                  method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ItemId" />

                <div class="public-order-form-heading">
                    <div><span>02</span><p>Teslimat Bilgileri</p></div>
                    <h2>Siparişini tamamla.</h2>
                </div>

                @if (isOutOfStock)
                {
                    <div class="public-order-stock-warning">Bu ürün şu anda stokta yok.</div>
                }
                <div asp-validation-summary="ModelOnly" class="public-order-validation"></div>

                <div class="public-order-form-grid">
                    <div class="public-order-field public-order-field-quantity">
                        <label for="guestQuantity">Adet</label>
                        <input id="guestQuantity" name="input.Quantity" type="number" min="1" max="99" value="@Model.Input.Quantity" />
                        @Html.ValidationMessage("input.Quantity", null, new { @class = "public-order-error" })
                    </div>
                    <div class="public-order-field public-order-field-name">
                        <label for="guestFullName">Ad Soyad</label>
                        <input id="guestFullName" name="input.FullName" value="@Model.Input.FullName" autocomplete="name" placeholder="Adınız ve soyadınız" />
                        @Html.ValidationMessage("input.FullName", null, new { @class = "public-order-error" })
                    </div>
                    <div class="public-order-field">
                        <label for="guestEmail">E-posta</label>
                        <input id="guestEmail" name="input.Email" type="email" value="@Model.Input.Email" autocomplete="email" placeholder="ornek@mail.com" />
                        @Html.ValidationMessage("input.Email", null, new { @class = "public-order-error" })
                    </div>
                    <div class="public-order-field">
                        <label for="guestPhone">Telefon</label>
                        <input id="guestPhone" name="input.PhoneNumber" value="@Model.Input.PhoneNumber" autocomplete="tel" placeholder="05__ ___ __ __" />
                        @Html.ValidationMessage("input.PhoneNumber", null, new { @class = "public-order-error" })
                    </div>
                    <div class="public-order-field public-order-field-wide">
                        <label for="guestAddress">Adres</label>
                        <textarea id="guestAddress" name="input.AddressLine" rows="3" placeholder="Teslimat adresiniz">@Model.Input.AddressLine</textarea>
                        @Html.ValidationMessage("input.AddressLine", null, new { @class = "public-order-error" })
                    </div>
                    <div class="public-order-field">
                        <label for="guestDistrict">İlçe</label>
                        <input id="guestDistrict" name="input.District" value="@Model.Input.District" placeholder="İlçe" />
                        @Html.ValidationMessage("input.District", null, new { @class = "public-order-error" })
                    </div>
                    <div class="public-order-field">
                        <label for="guestCity">Şehir</label>
                        <input id="guestCity" name="input.City" value="@Model.Input.City" placeholder="Şehir" />
                        @Html.ValidationMessage("input.City", null, new { @class = "public-order-error" })
                    </div>
                    <div class="public-order-field">
                        <label for="guestPostalCode">Posta Kodu</label>
                        <input id="guestPostalCode" name="input.PostalCode" value="@Model.Input.PostalCode" placeholder="Posta kodu" />
                        @Html.ValidationMessage("input.PostalCode", null, new { @class = "public-order-error" })
                    </div>
                    <div class="public-order-field">
                        <label for="guestDeliveryDate">Teslimat Tarihi</label>
                        <input id="guestDeliveryDate" name="input.DeliveryDate" type="date" value="@Model.Input.DeliveryDate.ToString("yyyy-MM-dd")" />
                        @Html.ValidationMessage("input.DeliveryDate", null, new { @class = "public-order-error" })
                    </div>
                    <div class="public-order-field public-order-field-wide">
                        <label for="guestDeliveryTimeSlot">Teslimat Saati</label>
                        <select id="guestDeliveryTimeSlot" name="input.DeliveryTimeSlot">
                            @foreach (var slot in deliverySlots)
                            {
                                <option value="@slot" selected="@(slot == Model.Input.DeliveryTimeSlot ? "selected" : null)">@slot</option>
                            }
                        </select>
                        @Html.ValidationMessage("input.DeliveryTimeSlot", null, new { @class = "public-order-error" })
                    </div>
                    <div class="public-order-field public-order-field-wide">
                        <label for="guestNotes">Sipariş Notu <small>İsteğe bağlı</small></label>
                        <textarea id="guestNotes" name="input.Notes" rows="3" placeholder="Siparişinle ilgili eklemek istediklerin">@Model.Input.Notes</textarea>
                        @Html.ValidationMessage("input.Notes", null, new { @class = "public-order-error" })
                    </div>
                </div>

                <button class="public-order-submit" type="submit" disabled="@isOutOfStock">
                    <span>@(isOutOfStock ? "Stokta Yok" : "Siparişi Oluştur")</span>
                    <strong>@Model.UnitPrice.ToString("C0")</strong>
                </button>
            </form>
        </div>
    </div>
</div>
