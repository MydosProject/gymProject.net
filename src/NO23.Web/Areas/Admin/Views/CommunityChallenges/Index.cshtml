@model IReadOnlyList<CommunityChallengeListItemViewModel>
@{
    ViewData["Title"] = "Community Challenge'ları";
    var openCount = Model.Count(item => item.EndsOn >= DateOnly.FromDateTime(DateTime.Today));

    string GetStatusName(string status)
    {
        return status switch
        {
            "Upcoming" => "Yakında",
            "Active" => "Devam Ediyor",
            "Completed" => "Tamamlandı",
            "Cancelled" => "İptal Edildi",
            _ => status
        };
    }
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">COMMUNITY / CHALLENGE</p>
                <h1>Challenge yönetimi</h1>
                <p class="admin-page-description">Topluluk hedeflerini, kalori kurallarını ve katılımcı ilerlemesini takip et.</p>
            </div>
            <a class="btn btn-dark" asp-action="Create">+ Yeni challenge</a>
        </header>

        <div class="admin-metrics admin-metrics-two">
            <article><span>Toplam challenge</span><strong>@Model.Count</strong><small>Yayın planı</small></article>
            <article><span>Devam eden / yaklaşan</span><strong>@openCount</strong><small>Aktif tarih aralığı</small></article>
        </div>

        <div class="table-responsive admin-table-card">
            <table class="table align-middle mb-0">
                <thead><tr><th>Sıra</th><th>Challenge</th><th>Durum</th><th>Tarih</th><th>Kalori Kuralı</th><th>Katılımcı</th><th class="text-end">İşlem</th></tr></thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7"><div class="admin-empty-row">Henüz challenge eklenmedi.</div></td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="admin-order-no">@item.DisplayOrder.ToString("00")</span></td>
                                <td><strong>@item.Title</strong></td>
                                <td><span class="admin-status">@GetStatusName(item.Status)</span></td>
                                <td>@item.StartsOn.ToString("dd.MM.yyyy") — @item.EndsOn.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <strong>@item.TargetDailyCalories kcal</strong>
                                    <small class="d-block text-muted">± @item.CalorieTolerancePercent% · @item.RequiredCompletionPercent% tamamlama</small>
                                </td>
                                <td>@item.ParticipantCount</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@item.Id">Takip</a>
                                        <a class="btn btn-sm btn-dark" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
