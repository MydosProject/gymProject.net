@model CommunityChallengeDetailViewModel

@{
    ViewData["Title"] = Model.Title;
    var paragraphs = Model.Description
        .Replace("\r\n", "\n")
        .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    string GetChallengeStatusName(string status)
    {
        return status switch
        {
            "Upcoming" => "Yakında",
            "Active" => "Devam Ediyor",
            "Completed" => "Tamamlandı",
            "Cancelled" => "İptal Edildi",
            _ => status
        };
    }
}

<section class="community-detail-page content-page">
    <div class="content-page-grid" aria-hidden="true"></div>
    <div class="content-page-orbit" aria-hidden="true"></div>

    <div class="container position-relative">
        <header class="community-detail-hero">
            <div class="community-detail-hero-copy">
                <div class="community-detail-meta">
                    <span>@GetChallengeStatusName(Model.Status)</span>
                    <span>@Model.StartsOn.ToString("dd.MM") – @Model.EndsOn.ToString("dd.MM.yyyy")</span>
                </div>

                <p class="content-section-kicker">NO23 / TOPLU CHALLENGE</p>
                <h1>@Model.Title</h1>
                <p class="community-detail-summary">@Model.Summary</p>
            </div>

            <div class="community-detail-visual community-detail-visual-challenge">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.Title"
                         loading="eager" />
                }
                else
                {
                    <span>TOPLU HEDEF</span>
                    <strong>23</strong>
                    <small>@GetChallengeStatusName(Model.Status)</small>
                }
            </div>
        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="member-dashboard-alert member-dashboard-alert-success" role="status">
                <span aria-hidden="true">✓</span>
                <div>
                    <strong>İşlem tamamlandı</strong>
                    <p>@successMessage</p>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="member-dashboard-alert" role="alert">
                <span aria-hidden="true">!</span>
                <div>
                    <strong>İşlem tamamlanamadı</strong>
                    <p>@errorMessage</p>
                </div>
            </div>
        }

        <div class="community-detail-layout">
            <article class="community-detail-article">
                <div class="community-detail-article-heading">
                    <span>01</span>
                    <div>
                        <p>TOPLU HEDEF</p>
                        <h2>Hedefini görünür kıl.</h2>
                    </div>
                </div>

                <div class="community-detail-body">
                    @foreach (var paragraph in paragraphs)
                    {
                        <p>@paragraph</p>
                    }
                </div>
            </article>

            <aside class="community-detail-aside">
                <p class="content-section-kicker">Challenge özeti</p>

                <div class="community-detail-goal">
                    <span>Hedef</span>
                    <strong>@Model.Goal</strong>
                </div>

                <div class="community-detail-goal">
                    <span>Kalori hedefi</span>
                    <strong>@Model.TargetDailyCalories kcal</strong>
                    <small>@Model.MinDailyCalories - @Model.MaxDailyCalories kcal aralığı uyumlu sayılır.</small>
                </div>

                <dl>
                    <div>
                        <dt>Başlangıç</dt>
                        <dd>@Model.StartsOn.ToString("dd.MM.yyyy")</dd>
                    </div>
                    <div>
                        <dt>Bitiş</dt>
                        <dd>@Model.EndsOn.ToString("dd.MM.yyyy")</dd>
                    </div>
                    <div>
                        <dt>Durum</dt>
                        <dd>@GetChallengeStatusName(Model.Status)</dd>
                    </div>
                    <div>
                        <dt>Tamamlanma</dt>
                        <dd>@Model.RequiredCompletionPercent% başarılı gün oranı</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Reward))
                    {
                        <div>
                            <dt>Ödül</dt>
                            <dd>@Model.Reward</dd>
                        </div>
                    }
                </dl>

                @if (!Model.IsJoined)
                {
                    <div class="community-detail-goal">
                        @if (Model.CanJoin)
                        {
                            <span>Katılım</span>
                            <strong>Community üyelerine açık</strong>
                            <form asp-controller="Community"
                                  asp-action="JoinChallenge"
                                  asp-route-slug="@Model.Slug"
                                  method="post"
                                  class="mt-3">
                                <button class="community-detail-link border-0 w-100" type="submit">
                                    Challenge'a Katıl
                                    <span aria-hidden="true">→</span>
                                </button>
                            </form>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.JoinMessage))
                        {
                            <span>Katılım</span>
                            <strong>@Model.JoinMessage</strong>
                        }
                    </div>
                }

                <a class="community-detail-back"
                   asp-controller="Community"
                   asp-action="Index"
                   asp-fragment="challenges">
                    <span aria-hidden="true">←</span>
                    Challenge'lara dön
                </a>
            </aside>
        </div>

        <section class="content-section">
            <div class="content-section-heading">
                <div>
                    <p class="content-section-kicker">Sıralama</p>
                    <h2>Kalori uyumunda öne çıkanlar.</h2>
                </div>
                <p>
                    Sıralama başarılı gün oranı ve başarılı gün sayısına göre hesaplanır.
                </p>
            </div>

            @if (Model.Leaderboard.Count == 0)
            {
                <div class="content-empty-state">
                    <span>00</span>
                    <div>
                        <h3>Henüz katılımcı yok.</h3>
                        <p>Challenge'a katılan üyeler burada görünecek.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="community-challenge-list">
                    @foreach (var item in Model.Leaderboard)
                    {
                        <article class="community-challenge-card">
                            <div class="community-challenge-number">
                                <span>Sıra</span>
                                <strong>@item.Rank.ToString("00")</strong>
                            </div>
                            <div class="community-challenge-content">
                                <div class="community-challenge-meta">
                                    <span>@(item.IsCompleted ? "Tamamlandı" : "Devam Ediyor")</span>
                                    <span>@item.CompliantDays / @item.TotalDays başarılı gün</span>
                                </div>
                                <h3>@item.MemberName</h3>
                                <p>@item.LoggedDays gün kalori girişi yaptı.</p>
                            </div>
                            <div class="community-challenge-goal">
                                <span>İlerleme</span>
                                <p>@item.ProgressPercent%</p>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</section>
