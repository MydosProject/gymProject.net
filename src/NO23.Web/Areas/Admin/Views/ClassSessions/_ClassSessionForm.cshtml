@model ClassSessionFormViewModel

<form method="post" class="bg-white border rounded-3 p-4 text-dark admin-form-card admin-session-form">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <section class="admin-form-section">
        <header>
            <span>01</span>
            <div>
                <h2>Seans planı</h2>
                <p>Programa eklenecek grup dersini ve başlangıç zamanını belirle.</p>
            </div>
        </header>

        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="GroupClassId" class="form-label"></label>
                <select asp-for="GroupClassId" asp-items="Model.GroupClassOptions" class="form-select"></select>
                <span asp-validation-for="GroupClassId" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="StartsAtLocal" class="form-label"></label>
                <input asp-for="StartsAtLocal" type="datetime-local" class="form-control" />
                <span asp-validation-for="StartsAtLocal" class="text-danger"></span>
            </div>
        </div>
    </section>

    <section class="admin-form-section">
        <header>
            <span>02</span>
            <div>
                <h2>Kontenjan ve durum</h2>
                <p>Bu seansa özel kapasiteyi ve rezervasyon görünürlüğünü yöneten durumu seç.</p>
            </div>
        </header>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CapacityOverride" class="form-label"></label>
                <input asp-for="CapacityOverride" class="form-control" />
                <span asp-validation-for="CapacityOverride" class="text-danger"></span>
                <small class="admin-field-hint">Boş bırakılırsa grup dersinin varsayılan kapasitesi kullanılır.</small>
            </div>
            <div class="col-md-6">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<ClassSessionStatus>()" class="form-select"></select>
                <small class="admin-field-hint">Yalnızca planlanan gelecek seanslar public programda gösterilir.</small>
            </div>
        </div>
    </section>

    <div class="d-flex align-items-center flex-wrap gap-2 mt-4">
        @if (Model.Id > 0 &&
             Model.Status == ClassSessionStatus.Scheduled)
        {
            <button type="button"
                    class="btn btn-outline-danger admin-cancel-session-button"
                    data-bs-toggle="modal"
                    data-bs-target="#cancelClassSessionModal">
                Ders Seansını İptal Et
            </button>
        }

        <div class="d-flex gap-2 ms-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                Vazgeç
            </a>

            <button type="submit" class="btn btn-dark">
                Değişiklikleri Kaydet
            </button>
        </div>
    </div>
</form>

@if (Model.Id > 0 &&
     Model.Status == ClassSessionStatus.Scheduled)
{
    <div class="modal fade admin-confirm-modal"
         id="cancelClassSessionModal"
         tabindex="-1"
         aria-labelledby="cancelClassSessionModalTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <p>NO23 / DERS YÖNETİMİ</p>
                        <h2 class="modal-title" id="cancelClassSessionModalTitle">
                            Ders seansı iptal edilsin mi?
                        </h2>
                    </div>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    Aktif rezervasyonlar iptal edilecek ve üyelerin ders hakları geri verilecek.
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Vazgeç
                    </button>
                    <form method="post"
                          asp-action="Cancel"
                          asp-route-id="@Model.Id">
                        <button type="submit"
                                class="btn btn-danger">
                            Ders Seansını İptal Et
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
