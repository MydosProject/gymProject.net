@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model NO23.Web.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Parolan Yenilendi";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="no23-register-page">
    <div class="register-page-grid" aria-hidden="true"></div>
    <div class="register-page-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <div class="no23-register-shell">
            <aside class="register-intro-panel">
                <a class="register-back-link"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-area="">
                    <span aria-hidden="true">←</span>
                    Ana sayfaya dön
                </a>

                <div class="register-intro-content">
                    <p class="register-kicker">NO23 Member Security</p>

                    <h1>
                        Yeni parolan
                        <span>artık hazır.</span>
                    </h1>

                    <p class="register-intro-description">
                        Hesabının parola bilgisi başarıyla güncellendi.
                        Yeni parolanla NO23 üye alanına güvenle giriş yapabilirsin.
                    </p>
                </div>

                <p class="register-intro-footer">
                    Train Better. Eat Better. Live Better.
                </p>
            </aside>

            <div class="register-form-panel d-flex flex-column justify-content-center">
                <div class="register-form-heading">
                    <div>
                        <p class="register-form-kicker">İşlem Tamamlandı</p>
                        <h2>Parolan yenilendi.</h2>
                    </div>

                    <span class="register-step">NO23</span>
                </div>

                <p class="register-form-description">
                    Hesabına erişmek için yeni belirlediğin parolayı kullanabilirsin.
                </p>

                <a asp-page="./Login"
                   class="no23-register-submit">
                    <span>Üye girişine git</span>
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </div>
</section>
