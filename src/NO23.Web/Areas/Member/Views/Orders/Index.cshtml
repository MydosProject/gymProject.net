@model MemberOrdersIndexViewModel

@{
    ViewData["Title"] = "Siparişlerim";

    var activeOrderCount = Model.Orders.Count(order =>
        order.Status != "Delivered" && order.Status != "Cancelled");

    var totalItemCount = Model.Orders.Sum(order => order.ItemCount);

    string GetOrderStatusClass(string status)
    {
        return status switch
        {
            "Delivered" => "is-delivered",
            "Cancelled" => "is-cancelled",
            "OutForDelivery" => "is-delivery",
            "Preparing" => "is-preparing",
            _ => "is-pending"
        };
    }

    string GetPaymentStatusClass(string status)
    {
        return status switch
        {
            "Paid" => "is-paid",
            "Failed" => "is-failed",
            "Refunded" => "is-refunded",
            "Expired" => "is-expired",
            _ => "is-payment-pending"
        };
    }

}

<section class="member-orders-page">
    <div class="member-orders-grid" aria-hidden="true"></div>
    <div class="member-orders-glow" aria-hidden="true"></div>

    <div class="container position-relative">

        @if ((ViewData["PaymentNotice"] as string) == "success")
    {
        <div class="alert alert-success alert-dismissible fade show mt-4"
            role="alert">
            <strong>Ödeme başarıyla tamamlandı.</strong>
            Siparişin onaylandı ve Siparişlerim sayfasına eklendi.

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }
    else if ((ViewData["PaymentNotice"] as string) == "failed")
    {
        <div class="alert alert-danger alert-dismissible fade show mt-4"
            role="alert">
            <strong>Ödeme tamamlanamadı.</strong>
            Sipariş ve ödeme durumunu aşağıdan kontrol edebilirsin.

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Kapat">
            </button>
        </div>
    }
        <header class="member-orders-hero">
            <div>
                <p class="member-orders-kicker">NO23 / ÜYE PANELİ / SİPARİŞLER</p>
                <h1>Her sipariş.<br /><span>Tek akışta.</span></h1>
                <p class="member-orders-description">
                    Shop ve Kitchen siparişlerini, teslimat planını ve ürün
                    kalemlerini tek ekrandan takip et.
                </p>
            </div>

            <aside class="member-orders-hero-panel">
                <div>
                    <span>TOPLAM SİPARİŞ</span>
                    <strong>@Model.Orders.Count.ToString("00")</strong>
                </div>
                <dl>
                    <div>
                        <dt>Aktif süreç</dt>
                        <dd>@activeOrderCount.ToString("00")</dd>
                    </div>
                    <div>
                        <dt>Toplam ürün</dt>
                        <dd>@totalItemCount.ToString("00")</dd>
                    </div>
                </dl>
            </aside>
        </header>

        <section class="member-orders-content"
                 id="payment-statuses"
                 aria-labelledby="member-orders-title">
            <div class="member-orders-section-heading">
                <div>
                    <p>01 / SİPARİŞ GEÇMİŞİ</p>
                    <h2 id="member-orders-title">Sipariş hareketlerin.</h2>
                </div>
                <span>@Model.Orders.Count.ToString("00")</span>
            </div>

            @if (Model.Orders.Count == 0)
            {
                <div class="member-orders-empty">
                    <span>00</span>
                    <div>
                        <p>NO23 / EMPTY STATE</p>
                        <h2>Henüz siparişin bulunmuyor.</h2>
                        <p>
                            NO23 Shop veya Kitchen menüsünden seçim yaparak
                            ilk siparişini oluşturabilirsin.
                        </p>
                    </div>
                    <a asp-area="Member" asp-controller="Shop" asp-action="Index">
                        Shop'a Git <span aria-hidden="true">↗</span>
                    </a>
                </div>
            }
            else
            {
                <div class="member-orders-list">
                    @for (var index = 0; index < Model.Orders.Count; index++)
                    {
                        var order = Model.Orders[index];

                        <article class="member-order-card">
                            <header class="member-order-card-header">
                                <span class="member-order-index">@((index + 1).ToString("00"))</span>

                                <div class="member-order-identity">
                                    <p>@order.TypeDisplayName</p>
                                    <h3>@order.OrderNumber</h3>
                                    <small>@order.CreatedAtLocal.ToString("dd.MM.yyyy · HH:mm")</small>
                                </div>

                                <div class="member-order-statuses">
                                    <span class="@GetOrderStatusClass(order.Status)">
                                        @order.StatusDisplayName
                                    </span>
                                    <span class="@GetPaymentStatusClass(order.PaymentStatus)">
                                        @order.PaymentStatusDisplayName
                                    </span>
                                </div>
                            </header>

                            <dl class="member-order-summary">
                                    @if (order.Type == "KitchenSubscription")
                                    {
                                        <div>
                                            <dt>Teslimat tercihi</dt>
                                            <dd>Beslenme planından belirlenecek</dd>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <dt>Teslimat günü</dt>
                                            <dd>
                                                @(order.DeliveryDate?.ToString("dd.MM.yyyy") ?? "-")
                                            </dd>
                                        </div>

                                        <div>
                                            <dt>Saat aralığı</dt>
                                            <dd>@(order.DeliveryTimeSlot ?? "-")</dd>
                                        </div>
                                    }
                                <div>
                                    <dt>Ürün adedi</dt>
                                    <dd>@order.ItemCount</dd>
                                </div>
                                <div class="member-order-total">
                                    <dt>Toplam</dt>
                                    <dd>@order.Total.ToString("N0") ₺</dd>
                                </div>
                            </dl>

                            @if (order.Items.Count > 0)
                            {
                                <details class="member-order-items">
                                    <summary>
                                        <span>Ürün kalemleri</span>
                                        <strong>@order.Items.Count.ToString("00")</strong>
                                        <i aria-hidden="true"></i>
                                    </summary>

                                    <div class="member-order-items-list">
                                        @foreach (var item in order.Items)
                                        {
                                            <div class="member-order-item">
                                                <div>
                                                    <span>@item.ItemTypeDisplayName</span>
                                                    <strong>@item.ProductName</strong>
                                                </div>

                                                <div>
                                                    <span>@item.Quantity adet × @item.UnitPrice.ToString("N0") ₺</span>
                                                    <strong>@item.LineTotal.ToString("N0") ₺</strong>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </details>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</section>
