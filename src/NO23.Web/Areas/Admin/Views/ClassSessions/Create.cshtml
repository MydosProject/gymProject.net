@model ClassSessionFormViewModel
@{
    ViewData["Title"] = "Programa Ders Ekle";
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head admin-form-head">
            <div>
                <a asp-action="Index" class="admin-back-link">← Programa dön</a>
                <p class="admin-eyebrow">Kulüp / Ders Yönetimi</p>
                <h1>Programa ders ekle</h1>
                <p class="admin-page-description">Aktif bir grup dersini tarih, saat ve kontenjan bilgileriyle programa yerleştir.</p>
            </div>
        </header>

        <partial name="_ClassSessionForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
