@using NO23.Web.Data.Seed
@model NO23.Web.ViewModels.Home.HomeIndexViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="no23-hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <div class="hero-layout">
            <div class="hero-copy">
                <p class="hero-kicker">
                    Performance · Nutrition · Community
                </p>

                <h1 class="hero-title">
                    <span>Train Better.</span>
                    <span class="hero-title-accent">Eat Better.</span>
                    <span>Live Better.</span>
                </h1>

                <p class="hero-description">
                    NO23 Sports Club; profesyonel antrenman, kişiselleştirilmiş
                    beslenme ve güçlü bir topluluk deneyimini tek platformda
                    buluşturur.
                </p>

                <div class="hero-actions">
                    <a class="btn no23-primary-button"
                       href="#memberships">
                        Üyelik Paketleri
                    </a>

                    <a class="btn no23-secondary-button"
                       href="#services">
                        Hizmetleri Keşfet
                    </a>
                </div>

                <div class="hero-highlights">
                    <span>Bilimsel Antrenman</span>
                    <span>Beslenme Desteği</span>
                    <span>Gelişim Takibi</span>
                </div>
            </div>

            <figure class="hero-media">
                <img src="~/images/no23-home-hero.webp"
                     alt="Karanlık bir performans stüdyosunda battle rope ile çalışan sporcu"
                     width="1983"
                     height="793"
                     fetchpriority="high" />

                <div class="hero-media-status" aria-hidden="true">
                    <span>NO23 / PERFORMANCE</span>
                    <strong>01</strong>
                </div>

                <figcaption class="hero-experience-card">
                    <span class="experience-number">23</span>
                    <p class="experience-label">NO23 Ecosystem</p>

                    <h2>
                        Yaşam tarzının tamamı tek üyelikte.
                    </h2>

                    <ul class="experience-list">
                        <li>
                            <span>01</span>
                            Sports Club
                        </li>

                        <li>
                            <span>02</span>
                            NO23 Kitchen
                        </li>

                        <li>
                            <span>03</span>
                            NO23 Community
                        </li>
                    </ul>
                </figcaption>
            </figure>
        </div>
    </div>
</section>

<section class="quick-access"
         aria-labelledby="quick-access-title">

    <div class="container">
        <div class="quick-access-heading">
            <div>
                <p class="section-kicker">Hızlı Erişim</p>

                <h2 id="quick-access-title">
                    Bugün ne yapmak istersin?
                </h2>
            </div>

            <p>
                NO23 deneyiminin tüm parçalarına tek noktadan ulaş.
            </p>
        </div>

        <div class="quick-access-grid">
            <a class="quick-access-card"
               href="#memberships">
                <span class="quick-access-number">01</span>
                <strong>Üyelik Paketleri</strong>
                <small>Sana uygun paketi keşfet</small>
            </a>

            <a class="quick-access-card"
               href="#schedule">
                <span class="quick-access-number">02</span>
                <strong>Ders Programı</strong>
                <small>Grup derslerini incele</small>
            </a>

            @if (User.IsInRole(ApplicationRoles.Admin))
            {
                <a class="quick-access-card"
                   asp-area="Admin"
                   asp-controller="KitchenMenuItems"
                   asp-action="Index">
                    <span class="quick-access-number">03</span>
                    <strong>NO23 Kitchen</strong>
                    <small>Menü ürünlerini yönet</small>
                </a>

                <a class="quick-access-card"
                   asp-area="Admin"
                   asp-controller="Orders"
                   asp-action="Index">
                    <span class="quick-access-number">04</span>
                    <strong>Sipariş Yönetimi</strong>
                    <small>Teslimat akışını incele</small>
                </a>
            }
            else
            {
                <a class="quick-access-card"
                   asp-area="Member"
                   asp-controller="Kitchen"
                   asp-action="Index"
                   asp-fragment="menu">
                    <span class="quick-access-number">03</span>
                    <strong>NO23 Kitchen</strong>
                    <small>Sağlıklı menülere ulaş</small>
                </a>

                <a class="quick-access-card"
                   asp-area="Member"
                   asp-controller="Kitchen"
                   asp-action="Index"
                   asp-fragment="calculator">
                    <span class="quick-access-number">04</span>
                    <strong>Kalori Hesapla</strong>
                    <small>Günlük ihtiyacını öğren</small>
                </a>
            }

            @if (User.IsInRole(ApplicationRoles.Admin))
            {
                <a class="quick-access-card"
                   asp-area="Admin"
                   asp-controller="ShopProducts"
                   asp-action="Index">
                    <span class="quick-access-number">05</span>
                    <strong>Shop Ürünleri</strong>
                    <small>Kataloğu ve stokları yönet</small>
                </a>

                <a class="quick-access-card"
                   asp-area="Admin"
                   asp-controller="ClassSessions"
                   asp-action="Index">
                    <span class="quick-access-number">06</span>
                    <strong>Ders Planlama</strong>
                    <small>Programı ve seansları yönet</small>
                </a>
            }
            else
            {
                <a class="quick-access-card"
                   asp-area="Member"
                   asp-controller="Shop"
                   asp-action="Index"
                   asp-fragment="shop-products">
                    <span class="quick-access-number">05</span>
                    <strong>Online Sipariş</strong>
                    <small>Öğünlerini kolayca seç</small>
                </a>

                <a class="quick-access-card"
                   asp-area="Member"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="available-classes">
                    <span class="quick-access-number">06</span>
                    <strong>Randevu Al</strong>
                    <small>Antrenmanını planla</small>
                </a>
            }
        </div>
    </div>
</section>

<section class="services-section"
         id="services">

    <div class="container">
        <div class="services-heading">
            <div>
                <p class="section-kicker">Hizmetlerimiz</p>

                <h2>
                    Sadece spor değil.<br />
                    Bütünsel gelişim.
                </h2>
            </div>

            <p>
                Hedefine, deneyimine ve yaşam tarzına göre tasarlanan
                profesyonel antrenman çözümlerini keşfet.
            </p>
        </div>

        <div class="services-grid">
            <article class="service-card service-card-accent">
                <div class="service-card-top">
                    <span class="service-number">01</span>
                    <span class="service-category">Birebir</span>
                </div>

                <div class="service-card-content">
                    <h3>Personal Training</h3>

                    <p>
                        Hedeflerine özel hazırlanan program ve profesyonel
                        eğitmen takibiyle maksimum verim elde et.
                    </p>

                    <ul class="service-features">
                        <li>Birebir antrenman</li>
                        <li>Hedef analizi</li>
                        <li>Ölçüm ve takip</li>
                        <li>Program güncelleme</li>
                    </ul>
                </div>
            </article>

            <article class="service-card"
                     id="schedule">

                <div class="service-card-top">
                    <span class="service-number">02</span>
                    <span class="service-category">Birlikte</span>
                </div>

                <div class="service-card-content">
                    <h3>Grup Dersleri</h3>

                    <p>
                        Yüksek enerji, güçlü motivasyon ve farklı seviyelere
                        uygun grup antrenmanları.
                    </p>

                    <ul class="service-features">
                        <li>Bootcamp</li>
                        <li>Metcon</li>
                        <li>Mat &amp; Reformer Pilates</li>
                        <li>Fonksiyonel antrenman</li>
                    </ul>
                </div>
            </article>

            <article class="service-card">
                <div class="service-card-top">
                    <span class="service-number">03</span>
                    <span class="service-category">Performans</span>
                </div>

                <div class="service-card-content">
                    <h3>Atletik Performans</h3>

                    <p>
                        Sporcular için ölçülebilir, branşa özel ve bilimsel
                        performans gelişimi.
                    </p>

                    <ul class="service-features">
                        <li>Kuvvet</li>
                        <li>Hız ve çeviklik</li>
                        <li>Patlayıcı güç</li>
                        <li>Test ve ölçümler</li>
                    </ul>
                </div>
            </article>

            <article class="service-card service-card-light">
                <div class="service-card-top">
                    <span class="service-number">04</span>
                    <span class="service-category">Gelişim</span>
                </div>

                <div class="service-card-content">
                    <h3>Kids Club</h3>

                    <p>
                        Çocuklar için güvenli, eğlenceli ve gelişim odaklı
                        hareket eğitimi.
                    </p>

                    <ul class="service-features">
                        <li>Motor beceri gelişimi</li>
                        <li>Denge ve koordinasyon</li>
                        <li>Kuvvet gelişimi</li>
                        <li>Eğlenceli eğitim modeli</li>
                    </ul>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="memberships-section"
         id="memberships">

    <div class="container">
        <div class="memberships-heading">
            <div>
                <p class="section-kicker">Üyelik Paketleri</p>
                <h2>Hedefine uygun planı seç.</h2>
            </div>

            <p>
                Başlangıç seviyesinden performans odaklı programlara kadar
                sana uygun NO23 deneyimini keşfet.
            </p>
        </div>

        <div class="membership-grid">
            @foreach (var package in Model.MembershipPackages)
            {
                var isPro = package.Code.Equals(
                    "PRO",
                    StringComparison.OrdinalIgnoreCase);

                var isElite = package.Code.Equals(
                    "ELITE",
                    StringComparison.OrdinalIgnoreCase);

                var cardClass = isPro
                    ? "membership-card membership-card-featured"
                    : isElite
                        ? "membership-card membership-card-elite"
                        : "membership-card";

                var level = package.Code.ToUpperInvariant() switch
                {
                    "START" => "Başlangıç",
                    "PLUS" => "Düzenli",
                    "PRO" => "Hedef Odaklı",
                    "ELITE" => "Tam Deneyim",
                    _ => "Üyelik"
                };

                var buttonText = package.Code.ToUpperInvariant() switch
                {
                    "PRO" => "PRO’ya Başvur",
                    "ELITE" => "ELITE’a Başvur",
                    _ => "Başvuru Yap"
                };

                <article class="@cardClass">
                    @if (isPro)
                    {
                        <span class="membership-recommended">
                            Önerilen
                        </span>
                    }

                    <div class="membership-card-header">
                        <span class="membership-order">
                            @package.DisplayOrder.ToString("00")
                        </span>

                        <span class="membership-level">
                            @level
                        </span>
                    </div>

                    <div>
                        <h3>@package.Name</h3>

                        <p class="membership-audience">
                            @package.Audience
                        </p>
                    </div>

                    <ul class="membership-features">
                        @foreach (var feature in package.Features)
                        {
                            <li>@feature</li>
                        }
                    </ul>

                    <a class="membership-button"
                       asp-area="Identity"
                       asp-page="/Account/Register"
                       asp-route-package="@package.Code">
                        @buttonText
                    </a>
                </article>
            }
        </div>

        <div class="membership-note">
            <div>
                <strong>
                    Hangi paketin sana uygun olduğundan emin değil misin?
                </strong>

                <span>
                    Hedeflerini birlikte değerlendirelim.
                </span>
            </div>

            <a href="#contact">
                Bizimle İletişime Geç
            </a>
        </div>
    </div>
</section>

<section class="no23-faq-section"
         id="faq"
         aria-labelledby="faq-title">
    <div class="container">
        <div class="no23-faq-heading">
            <div>
                <p class="section-kicker">Merak Ettiklerin</p>
                <h2 id="faq-title">
                    Başlamadan önce<br />bilmen gerekenler.
                </h2>
            </div>

            <p>
                Üyelikten rezervasyona, Kitchen planından online siparişe
                kadar NO23 deneyiminin temel adımlarını burada bulabilirsin.
            </p>
        </div>

        <div class="no23-faq-grid">
            <details class="no23-faq-item" open>
                <summary>
                    <span class="no23-faq-number">01</span>
                    <strong>NO23 üyeliğimi nasıl başlatabilirim?</strong>
                    <span class="no23-faq-toggle" aria-hidden="true"></span>
                </summary>
                <div class="no23-faq-answer">
                    <p>
                        Ana sayfadaki üyelik paketlerinden sana uygun olanı seçip
                        başvuru formunu tamamlayabilirsin. Hesabın ve üye profilin
                        seçtiğin paketle birlikte oluşturulur.
                    </p>
                </div>
            </details>

            <details class="no23-faq-item">
                <summary>
                    <span class="no23-faq-number">02</span>
                    <strong>Hangi üyelik paketini seçmeliyim?</strong>
                    <span class="no23-faq-toggle" aria-hidden="true"></span>
                </summary>
                <div class="no23-faq-answer">
                    <p>
                        START, PLUS, PRO ve ELITE paketlerini haftalık ders hakkı
                        ve sundukları ayrıcalıklara göre karşılaştırabilirsin.
                        Hedefin ve antrenman sıklığın doğru paketi belirlemene
                        yardımcı olur.
                    </p>
                </div>
            </details>

            <details class="no23-faq-item">
                <summary>
                    <span class="no23-faq-number">03</span>
                    <strong>Grup dersine nasıl rezervasyon yapabilirim?</strong>
                    <span class="no23-faq-toggle" aria-hidden="true"></span>
                </summary>
                <div class="no23-faq-answer">
                    <p>
                        Üye girişi yaptıktan sonra hesabındaki “Uygun Dersler”
                        alanından yaklaşan seansları inceleyebilirsin. Kontenjan
                        ve kalan ders hakkın uygunsa rezervasyonunu oluşturabilirsin.
                    </p>
                </div>
            </details>

            <details class="no23-faq-item">
                <summary>
                    <span class="no23-faq-number">04</span>
                    <strong>Ders rezervasyonumu iptal edebilir miyim?</strong>
                    <span class="no23-faq-toggle" aria-hidden="true"></span>
                </summary>
                <div class="no23-faq-answer">
                    <p>
                        Yaklaşan rezervasyonunu ders başlangıcından en geç iki
                        saat öncesine kadar üye panelinden iptal edebilirsin.
                        Sınırlı paketlerde kullanılan ders hakkı hesabına geri eklenir.
                    </p>
                </div>
            </details>

            <details class="no23-faq-item">
                <summary>
                    <span class="no23-faq-number">05</span>
                    <strong>Kitchen planım nasıl belirleniyor?</strong>
                    <span class="no23-faq-toggle" aria-hidden="true"></span>
                </summary>
                <div class="no23-faq-answer">
                    <p>
                        Boy, kilo, yaş, aktivite seviyesi ve hedef bilgilerini
                        girerek günlük kalori ve makro ihtiyacını hesaplayabilirsin.
                        Sonuca göre 5, 10, 20 günlük veya aylık planlardan birini
                        seçebilirsin.
                    </p>
                </div>
            </details>

            <details class="no23-faq-item">
                <summary>
                    <span class="no23-faq-number">06</span>
                    <strong>Shop ve Kitchen ürünlerini nasıl sipariş ederim?</strong>
                    <span class="no23-faq-toggle" aria-hidden="true"></span>
                </summary>
                <div class="no23-faq-answer">
                    <p>
                        Üye Shop alanında ürün ve Kitchen öğünlerini aynı sepete
                        ekleyebilirsin. Teslimat adresini, gününü ve saat aralığını
                        seçtikten sonra sipariş kaydını oluşturabilirsin.
                    </p>
                </div>
            </details>
        </div>
    </div>
</section>

@* İletişim kanalları ve çalışma saatleri gerçek işletme bilgileri geldiğinde güncellenecek. *@
<section class="no23-contact-section"
         id="contact"
         aria-labelledby="contact-title">
    <div class="container">
        <div class="no23-contact-heading">
            <div>
                <p class="section-kicker">İletişim</p>
                <h2 id="contact-title">
                    Hedefini konuşalım.<br />Ritmini birlikte planlayalım.
                </h2>
            </div>

            <p>
                Üyelik, ders programı ve NO23 deneyimiyle ilgili soruların için
                ekibimize ulaş veya kulübü ziyaret et.
            </p>
        </div>

        <div class="no23-contact-layout">
            <article class="no23-contact-featured">
                <div class="no23-contact-card-top">
                    <span>01 / HIZLI İLETİŞİM</span>
                    <strong>NO23</strong>
                </div>

                <div>
                    <p>Başlangıç için tek bir mesaj yeterli.</p>
                    <h3>Ekibimiz hedeflerine uygun ilk adımı planlasın.</h3>
                </div>

                <div class="no23-contact-actions">
                    <a href="#memberships">
                        <span>Üyelik</span>
                        <strong>Paketleri İncele ↗</strong>
                    </a>

                    <a href="#faq">
                        <span>Merak Ettiklerin</span>
                        <strong>Sık Sorulanları Gör ↓</strong>
                    </a>
                </div>
            </article>

            <div class="no23-contact-details">
                <article class="no23-contact-detail-card no23-contact-address">
                    <div class="no23-contact-location-grid" aria-hidden="true">
                        <span class="no23-contact-location-pin">23</span>
                    </div>
                    <span>02 / KULÜP KONUMU</span>
                    <div class="no23-contact-location-copy">
                        <h3>NO23 yakında burada.</h3>
                        <p>Şube adresi ve yol tarifi kesinleştiğinde bu alanda paylaşılacak.</p>
                    </div>
                </article>

                <article class="no23-contact-detail-card">
                    <span>03 / ÇALIŞMA SAATLERİ</span>
                    <div>
                        <h3>Program hazırlanıyor.</h3>
                        <p>Güncel çalışma saatleri işletme bilgileriyle birlikte yayınlanacak.</p>
                    </div>
                </article>

                <article class="no23-contact-social">
                    <span>04 / INSTAGRAM</span>
                    <strong>Topluluk hesabı hazırlanıyor.</strong>
                    <small>Resmî hesap yakında paylaşılacak.</small>
                </article>
            </div>
        </div>
    </div>
</section>
