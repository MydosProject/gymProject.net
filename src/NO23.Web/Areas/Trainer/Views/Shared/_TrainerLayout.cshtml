@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?
        .ToString() ?? string.Empty;

    var pageTitle =
        ViewData["Title"]?.ToString()
        ?? "Eğitmen Paneli";

    var userName =
        User.Identity?.Name ?? "NO23 Eğitmen";

    var userInitial =
        string.IsNullOrWhiteSpace(userName)
            ? "N"
            : userName.Trim()[0]
                .ToString()
                .ToUpperInvariant();

    string ActiveClass(
        params string[] controllers) =>
        controllers.Contains(
            currentController,
            StringComparer.OrdinalIgnoreCase)
            ? "is-active"
            : string.Empty;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="theme-color"
          content="#090b09" />

    <link rel="icon" type="image/png" sizes="48x48" href="~/images/brand/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="~/images/brand/no23-icon-192.png" />

    <title>
        @pageTitle | NO23 Eğitmen Paneli
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />


    @await RenderSectionAsync(
        "Styles",
        required: false)
</head>

<body class="trainer-panel-body">

    <div class="admin-shell trainer-shell">

        <aside class="admin-sidebar trainer-sidebar"
               id="trainerSidebar"
               aria-label="Eğitmen paneli navigasyonu">

            <div class="admin-sidebar-head trainer-sidebar-head">

                <a class="admin-brand trainer-brand"
                   asp-area="Trainer"
                   asp-controller="Dashboard"
                   asp-action="Index">

                    <span class="admin-brand-mark trainer-brand-mark">
                        NO23
                    </span>

                    <span class="trainer-brand-text">
                        <strong>Trainer</strong>
                        <small>Performance Room</small>
                    </span>

                </a>

                <button class="admin-sidebar-close trainer-sidebar-close"
                        type="button"
                        data-trainer-sidebar-close
                        aria-label="Menüyü kapat">
                    ×
                </button>

            </div>

            <div class="trainer-sidebar-intro">
                <span>EĞİTMEN PANELİ</span>
                <p>
                    Derslerini, birebir taleplerini ve üyelerinle
                    iletişimini tek yerden yönet.
                </p>
            </div>

            <nav class="admin-nav trainer-nav">

                <div class="admin-nav-group">

                    <p class="admin-nav-title">
                        Genel
                    </p>

                    <a class="admin-nav-link trainer-nav-link
                              @ActiveClass("Dashboard")"
                       asp-area="Trainer"
                       asp-controller="Dashboard"
                       asp-action="Index">

                        <span class="admin-nav-index trainer-nav-index">
                            00
                        </span>

                        <span class="trainer-nav-copy">
                            <strong>Genel Bakış</strong>
                            <small>Günün özeti</small>
                        </span>

                        <span class="trainer-nav-arrow"
                              aria-hidden="true">
                            →
                        </span>

                    </a>

                </div>

                <div class="admin-nav-group">

                    <p class="admin-nav-title">
                        Antrenman
                    </p>

                    <a class="admin-nav-link trainer-nav-link @ActiveClass("Calendar")"
                       asp-area="Trainer" asp-controller="Calendar" asp-action="Index">
                        <span class="admin-nav-index trainer-nav-index">01</span>
                        <span class="trainer-nav-copy">
                            <strong>Takvimim</strong>
                            <small>Birebir ders programı</small>
                        </span>
                        <span class="trainer-nav-arrow" aria-hidden="true">→</span>
                    </a>

                    <a class="admin-nav-link trainer-nav-link
                              @ActiveClass("PersonalTrainingRequests")"
                       asp-area="Trainer"
                       asp-controller="PersonalTrainingRequests"
                       asp-action="Index">

                        <span class="admin-nav-index trainer-nav-index">
                            01
                        </span>

                        <span class="trainer-nav-copy">
                            <strong>Birebir Talepler</strong>
                            <small>PT istekleri</small>
                        </span>

                        <span class="trainer-nav-arrow"
                              aria-hidden="true">
                            →
                        </span>

                    </a>

                    <a class="admin-nav-link trainer-nav-link
                              @ActiveClass("Classes")"
                       asp-area="Trainer"
                       asp-controller="Classes"
                       asp-action="Index">

                        <span class="admin-nav-index trainer-nav-index">
                            02
                        </span>

                        <span class="trainer-nav-copy">
                            <strong>Derslerim</strong>
                            <small>Program ve seanslar</small>
                        </span>

                        <span class="trainer-nav-arrow"
                              aria-hidden="true">
                            →
                        </span>

                    </a>

                </div>

                <div class="admin-nav-group">

                    <p class="admin-nav-title">
                        İletişim
                    </p>

                    <a class="admin-nav-link trainer-nav-link
                              @ActiveClass("Messages")"
                       asp-area="Trainer"
                       asp-controller="Messages"
                       asp-action="Index">

                        <span class="admin-nav-index trainer-nav-index">
                            03
                        </span>

                        <span class="trainer-nav-copy">
                            <strong>Mesajlar</strong>
                            <small class="message-unread-badge d-none"
                                data-unread-message-badge
                                aria-label="0 okunmamış mesaj">
                            0
                            </small>
                            <small>Üye iletişimi</small>
                        </span>

                        <span class="trainer-nav-arrow"
                              aria-hidden="true">
                            →
                        </span>

                    </a>

                </div>

            </nav>

            <div class="admin-sidebar-foot trainer-sidebar-foot">

                <div class="trainer-sidebar-user">
                    <span class="trainer-sidebar-avatar">
                        @userInitial
                    </span>

                    <div>
                        <strong>@userName</strong>
                        <small>NO23 Eğitmen</small>
                    </div>
                </div>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action(
                          "Index",
                          "Home",
                          new { area = "" })"
                      method="post">

                    <button class="admin-logout trainer-logout"
                            type="submit">

                        <span>
                            Çıkış
                        </span>

                        <span aria-hidden="true">
                            ↗
                        </span>

                    </button>

                </form>

            </div>

        </aside>

        <div class="admin-sidebar-overlay trainer-sidebar-overlay"
             data-trainer-sidebar-close>
        </div>

        <main class="admin-main trainer-main">

            <header class="admin-topbar trainer-topbar">

                <div class="admin-topbar-start">

                    <button class="admin-menu-button trainer-menu-button"
                            type="button"
                            data-trainer-sidebar-open
                            aria-controls="trainerSidebar"
                            aria-expanded="false"
                            aria-label="Menüyü aç">

                        <span></span>
                        <span></span>

                    </button>

                    <div class="trainer-page-heading">

                        <p class="admin-topbar-kicker trainer-topbar-kicker">
                            NO23 / TRAINER ROOM
                        </p>

                        <strong class="admin-topbar-title trainer-topbar-title">
                            @pageTitle
                        </strong>

                    </div>

                </div>

               <div class="admin-topbar-end trainer-topbar-end">

    <span class="admin-date trainer-date">
        @DateTime.Now.ToString("dd.MM.yyyy")
    </span>


    <div class="dropdown no23-notification-root"
         data-notification-root>

        <button class="no23-notification-button"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                aria-label="Bildirimleri aç">

            <span aria-hidden="true">!</span>

            <span class="no23-notification-count d-none"
                  data-notification-count>
                0
            </span>

        </button>

        <div class="dropdown-menu dropdown-menu-end no23-notification-menu">

            <div class="no23-notification-head">

                <div>
                    <span>NO23</span>
                    <strong>Bildirimler</strong>
                </div>

                <button type="button"
                        data-notification-mark-all>
                    Tümünü okundu yap
                </button>

            </div>

            <div class="no23-notification-empty"
                 data-notification-empty>
                Henüz bildirimin yok.
            </div>

            <div class="no23-notification-list" data-notification-list>
            </div>

        </div>

    </div>


                            <div class="admin-user trainer-user">

                                <span class="admin-user-avatar trainer-user-avatar">
                                    @userInitial
                                </span>

                                <span class="admin-user-copy trainer-user-copy">

                                    <strong>
                                        @userName
                                    </strong>

                                    <small>
                                        Eğitmen
                                    </small>

                                </span>

                            </div>

                        </div>

            </header>

            <div class="admin-content trainer-content">
                @RenderBody()
            </div>

        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script>
        (() => {
            const body = document.body;

            const openButton =
                document.querySelector(
                    '[data-trainer-sidebar-open]');

            const closeMenu = () => {
                body.classList.remove(
                    'admin-menu-open');

                openButton?.setAttribute(
                    'aria-expanded',
                    'false');
            };

            openButton?.addEventListener(
                'click',
                () => {
                    body.classList.add(
                        'admin-menu-open');

                    openButton.setAttribute(
                        'aria-expanded',
                        'true');
                });

            document.querySelectorAll(
                '[data-trainer-sidebar-close]')
                .forEach(element => {
                    element.addEventListener(
                        'click',
                        closeMenu);
                });

            document.addEventListener(
                'keydown',
                event => {
                    if (
                        event.key === 'Escape' &&
                        body.classList.contains(
                            'admin-menu-open')
                    ) {
                        closeMenu();
                        openButton?.focus();
                    }
                });
        })();
    </script>

   <script src="~/lib/signalr/signalr.min.js"></script>

    <script src="~/js/trainer-message-badge.js"
        asp-append-version="true">
    </script>

    <script src="~/js/user-notifications.js"
        asp-append-version="true">
    </script>

    @await RenderSectionAsync( "Scripts",required: false)

</body>
</html>
