@model MemberMessagesViewModel

@{
    ViewData["Title"] = "Mesajlar";
}

<section class="member-messages-page">

    <header class="member-messages-head">

        <div>

            <p class="member-messages-eyebrow">
                İletişim
            </p>

            <h1>
                Mesajlar
            </h1>

            <p class="member-messages-description">
                Birebir çalışma sürecindeki
                eğitmenlerinle iletişim kur.
            </p>

        </div>

        <div class="member-messages-count">

            <span>
                Görüşme
            </span>

            <strong>
                @(Model.Conversations.Count.ToString("00"))
            </strong>

            <small>
                kayıt
            </small>

        </div>

    </header>


    @if (TempData["MessageError"] is string error)
    {
        <div class="member-message-error">
            @error
        </div>
    }


    @if (Model.Conversations.Count == 0)
    {
        <div class="member-message-empty">

            <span aria-hidden="true">
                01
            </span>

            <div>

                <strong>
                    Henüz bir eğitmen görüşmen yok.
                </strong>

                <p>
                    Bir eğitmenle birebir çalışma
                    talebi oluşturduğunda
                    mesajlaşma burada açılır.
                </p>

                <a asp-area=""
                   asp-controller="Trainers"
                   asp-action="Index"
                   class="member-message-empty-link">

                    Eğitmenleri İncele

                    <span aria-hidden="true">
                        →
                    </span>

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="member-chat-layout">

            <aside class="member-conversation-panel">

                <div class="member-conversation-panel-head">

                    <div>

                        <span>
                            Görüşmeler
                        </span>

                        <strong>
                            Eğitmenlerin
                        </strong>

                    </div>

                    <small>
                        @Model.Conversations.Count
                    </small>

                </div>


                <div class="member-conversation-list">

                    @foreach (
                        var conversation in
                        Model.Conversations)
                    {
                        var isActive =
                            Model.ActiveConversation?.Id ==
                            conversation.Id;

                        <a asp-action="Index"
                           asp-route-conversationId="@conversation.Id"
                           class="member-conversation-item
                                  @(isActive
                                      ? "is-active"
                                      : string.Empty)">

                            <div class="member-conversation-item-top">

                                <strong>
                                    @conversation.TrainerName
                                </strong>

                                <span>
                                    @(conversation
                                        .LastActivityAtUtc
                                        .ToLocalTime()
                                        .ToString(
                                            "dd.MM.yyyy HH:mm"))
                                </span>

                            </div>

                            <small>
                                @conversation.Specialty
                            </small>

                            @if (
                                !string.IsNullOrWhiteSpace(
                                    conversation.LastMessage))
                            {
                                <p>
                                    @conversation.LastMessage
                                </p>
                            }
                            else
                            {
                                <p class="is-empty">
                                    Henüz mesaj yok.
                                </p>
                            }

                        </a>
                    }

                </div>

            </aside>


            <section class="member-chat-panel">

                @if (Model.ActiveConversation is not null)
                {
                    <div class="member-chat-card"
                         data-trainer-chat
                         data-conversation-id="@Model.ActiveConversation.Id"
                         data-current-user-id="@(
                             User.FindFirst(
                                 System.Security.Claims
                                     .ClaimTypes
                                     .NameIdentifier
                             )?.Value)">


                        <header class="member-chat-head">

                            <div>

                                <span>
                                    Aktif görüşme
                                </span>

                                <strong>
                                    @Model.ActiveConversation.TrainerName
                                </strong>

                                <small>
                                    @Model.ActiveConversation.Specialty
                                </small>

                            </div>


                            <div class="member-chat-status">

                                @if (
                                    Model.ActiveConversation.CanWrite)
                                {
                                    <span class="is-open">
                                        Mesajlaşma açık
                                    </span>
                                }
                                else
                                {
                                    <span class="is-closed">
                                        Salt okunur
                                    </span>
                                }

                            </div>

                        </header>


                        <div class="member-chat-messages"
                             data-chat-messages>

                            @if (
                                Model.ActiveConversation
                                    .Messages.Count == 0)
                            {
                                <div class="member-chat-empty"
                                     data-chat-empty>

                                    <span aria-hidden="true">
                                        00
                                    </span>

                                    <strong>
                                        Henüz mesaj yok.
                                    </strong>

                                    <p>
                                        Eğitmeninle konuşmayı
                                        buradan başlatabilirsin.
                                    </p>

                                </div>
                            }
                            else
                            {
                                <div class="member-message-list">

                                    @foreach (
                                        var message in
                                        Model.ActiveConversation.Messages)
                                    {
                                        <div class="member-message-row
                                                    @(message.IsMine
                                                        ? "is-mine"
                                                        : "is-theirs")"
                                             data-message-id="@message.Id">

                                            <div class="member-message-bubble">

                                                <div class="member-message-body">
                                                    @message.Body
                                                </div>

                                                <div class="member-message-time">

                                                    <span>
                                                        @(message
                                                            .SentAtUtc
                                                            .ToLocalTime()
                                                            .ToString(
                                                                "dd.MM.yyyy HH:mm"))
                                                    </span>

                                                    @if (message.IsMine)
                                                    {
                                                        <span class="member-message-read-state"
                                                            data-message-read-state>
                                                            @(message.ReadAtUtc.HasValue
                                                                ? " · Görüldü"
                                                                : " · Gönderildi")
                                                        </span>
                                                    }

                                                </div>

                                            </div>

                                        </div>
                                    }

                                </div>
                            }

                        </div>

                        <div class="member-chat-typing d-none"
                            data-chat-typing>
                            Yazıyor...
                        </div>


                        <footer class="member-chat-footer">

                            @if (Model.ActiveConversation.CanWrite)
                            {
                                <form asp-action="Send"
                                      method="post"
                                      class="member-chat-send-form"
                                      data-chat-send-form>

                                    <input type="hidden"
                                           name="conversationId"
                                           value="@Model.ActiveConversation.Id" />

                                    <div class="member-chat-error"
                                         data-chat-error>
                                    </div>

                                    <div class="member-chat-composer">

                                        <textarea name="body"
                                                  rows="2"
                                                  maxlength="2000"
                                                  required
                                                  placeholder="Mesajını yaz..."></textarea>

                                        <button type="submit">

                                            <span>
                                                Gönder
                                            </span>

                                            <span aria-hidden="true">
                                                →
                                            </span>

                                        </button>

                                    </div>

                                </form>
                            }
                            else
                            {
                                <div class="member-chat-readonly">

                                    <strong>
                                        Bu konuşma şu anda salt okunur.
                                    </strong>

                                    <p>
                                        Mesajlaşma birebir talep ve
                                        randevu süresince, ayrıca
                                        tamamlanan randevudan sonraki
                                        48 saat boyunca açık kalır.
                                    </p>

                                </div>
                            }

                        </footer>

                    </div>
                }

            </section>

        </div>
    }

</section>

@section Scripts {

    <script src="~/js/trainer-chat.js"
            asp-append-version="true">
    </script>

}