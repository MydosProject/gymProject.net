@model KitchenMenuItemFormViewModel

<form method="post" class="bg-white border rounded-3 p-4 text-dark">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Category" class="form-label"></label>
            <select asp-for="Category" asp-items="Html.GetEnumSelectList<MenuItemCategory>()" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="DisplayOrder" class="form-label"></label>
            <input asp-for="DisplayOrder" class="form-control" />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Calories" class="form-label"></label>
            <input asp-for="Calories" class="form-control" />
            <span asp-validation-for="Calories" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="UnitPrice" class="form-label"></label>
            <input asp-for="UnitPrice" class="form-control" />
            <span asp-validation-for="UnitPrice" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="ProteinGrams" class="form-label"></label>
            <input asp-for="ProteinGrams" class="form-control" />
            <span asp-validation-for="ProteinGrams" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="CarbohydrateGrams" class="form-label"></label>
            <input asp-for="CarbohydrateGrams" class="form-control" />
            <span asp-validation-for="CarbohydrateGrams" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="FatGrams" class="form-label"></label>
            <input asp-for="FatGrams" class="form-control" />
            <span asp-validation-for="FatGrams" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Ingredients" class="form-label"></label>
            <textarea asp-for="Ingredients" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Ingredients" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label class="form-label">Reçete</label>
            @if (Model.RecipeIngredients.Count == 0)
            {
                <div class="admin-empty-row">Reçete eklemek için önce Stok Takibi ekranından aktif malzeme tanımla.</div>
            }
            else
            {
                <div class="table-responsive admin-table-card">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Malzeme</th>
                                <th>Birim</th>
                                <th>Porsiyon başı miktar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var index = 0; index < Model.RecipeIngredients.Count; index++)
                            {
                                <tr>
                                    <td>
                                        <strong>@Model.RecipeIngredients[index].IngredientName</strong>
                                        <input type="hidden" asp-for="RecipeIngredients[index].KitchenIngredientId" />
                                        <input type="hidden" asp-for="RecipeIngredients[index].IngredientName" />
                                        <input type="hidden" asp-for="RecipeIngredients[index].Unit" />
                                        <input type="hidden" asp-for="RecipeIngredients[index].UnitDisplayName" />
                                    </td>
                                    <td>@Model.RecipeIngredients[index].UnitDisplayName</td>
                                    <td>
                                        <input asp-for="RecipeIngredients[index].QuantityPerPortion"
                                               class="form-control"
                                               min="0"
                                               step="0.001" />
                                        <span asp-validation-for="RecipeIngredients[index].QuantityPerPortion" class="text-danger"></span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="col-md-6">
            <label asp-for="Allergens" class="form-label"></label>
            <input asp-for="Allergens" class="form-control" />
            <span asp-validation-for="Allergens" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Tags" class="form-label"></label>
            <input asp-for="Tags" class="form-control" />
            <span asp-validation-for="Tags" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                @Html.DisplayNameFor(model => model.IsActive)
            </label>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        <button type="submit" class="btn btn-dark">Kaydet</button>
    </div>
</form>
