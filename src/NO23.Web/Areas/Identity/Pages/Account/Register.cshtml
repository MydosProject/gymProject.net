@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model NO23.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Bize Katıl";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="no23-register-page">
    <div class="register-page-grid" aria-hidden="true"></div>
    <div class="register-page-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <div class="no23-register-shell">
            <aside class="register-intro-panel">
                <img class="register-emblem"
                     src="~/images/brand/no23-emblem.webp"
                     alt=""
                     width="360"
                     height="360"
                     aria-hidden="true" />
                <a class="register-back-link"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <span aria-hidden="true">←</span>
                    Ana sayfaya dön
                </a>

                <div class="register-intro-content">
                    <p class="register-kicker">NO23 Membership</p>

                    <h1>
                        Hedefine giden yol
                        <span>burada başlıyor.</span>
                    </h1>

                    <p class="register-intro-description">
                        Sana uygun üyeliği seç, hedefini belirle ve NO23
                        deneyimine katıl.
                    </p>

                    <ul class="register-benefits">
                        <li>
                            <span>01</span>
                            <div>
                                <strong>Kişisel plan</strong>
                                <small>Hedefine göre şekillenen program</small>
                            </div>
                        </li>
                        <li>
                            <span>02</span>
                            <div>
                                <strong>Profesyonel takip</strong>
                                <small>Eğitmen ve gelişim desteği</small>
                            </div>
                        </li>
                        <li>
                            <span>03</span>
                            <div>
                                <strong>Tek ekosistem</strong>
                                <small>Antrenman, beslenme ve community</small>
                            </div>
                        </li>
                    </ul>
                </div>

                <p class="register-intro-footer">
                    Train Better. Eat Better. Live Better.
                </p>
            </aside>

            <div class="register-form-panel">
                <div class="register-form-heading">
                    <div>
                        <p class="register-form-kicker">Üyelik Başvurusu</p>
                        <h2>Bilgilerini tamamla.</h2>
                    </div>

                    <span class="register-step">01 / 01</span>
                </div>

                <p class="register-form-description">
                    Birkaç temel bilgiyle hesabını ve üyelik profilini oluşturalım.
                </p>

                <form id="registerForm"
                      method="post"
                      asp-antiforgery="true"
                      class="no23-register-form">

                    <div asp-validation-summary="ModelOnly"
                         class="register-validation-summary"
                         role="alert"></div>

                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="row g-3 g-lg-4">
                        <div class="col-md-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.FirstName"></label>
                                <input asp-for="Input.FirstName"
                                       class="form-control no23-form-control"
                                       autocomplete="given-name"
                                       placeholder="Adın" />
                                <span asp-validation-for="Input.FirstName"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.LastName"></label>
                                <input asp-for="Input.LastName"
                                       class="form-control no23-form-control"
                                       autocomplete="family-name"
                                       placeholder="Soyadın" />
                                <span asp-validation-for="Input.LastName"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.Email"></label>
                                <input asp-for="Input.Email"
                                       class="form-control no23-form-control"
                                       autocomplete="username"
                                       placeholder="ornek@email.com" />
                                <span asp-validation-for="Input.Email"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.PhoneNumber"></label>
                                <input asp-for="Input.PhoneNumber"
                                       class="form-control no23-form-control"
                                       autocomplete="tel"
                                       placeholder="05xx xxx xx xx" />
                                <span asp-validation-for="Input.PhoneNumber"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="no23-form-field no23-package-field">
                                <label asp-for="Input.PackageCode"></label>
                                <select asp-for="Input.PackageCode"
                                        class="form-select no23-form-select">
                                    @foreach (var package in Model.PackageOptions)
                                    {
                                        <option value="@package.Code"
                                                selected="@(string.Equals(
                                                    package.Code,
                                                    Model.Input.PackageCode,
                                                    StringComparison.OrdinalIgnoreCase)
                                                        ? "selected"
                                                        : null)">
                                            @package.Name — @package.Audience
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="Input.PackageCode"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="no23-form-field no23-package-option-field">
                                <label asp-for="Input.PackageOptionId"></label>
                                <select asp-for="Input.PackageOptionId"
                                        class="form-select no23-form-select"
                                        data-package-option-select>
                                    @foreach (var option in Model.ServiceOptions)
                                    {
                                        <option value="@option.Id"
                                                data-package-code="@option.PackageCode">
                                            @option.Name — @option.DurationDays gün
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="Input.PackageOptionId"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="no23-form-field">
                                <label asp-for="Input.FitnessGoal"></label>
                                <input asp-for="Input.FitnessGoal"
                                       class="form-control no23-form-control"
                                       placeholder="Yağ yakımı, kas kazanımı, performans..." />
                                <span asp-validation-for="Input.FitnessGoal"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.Password"></label>
                                <input asp-for="Input.Password"
                                       class="form-control no23-form-control"
                                       autocomplete="new-password"
                                       placeholder="En az 6 karakter" />
                                <span asp-validation-for="Input.Password"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.ConfirmPassword"></label>
                                <input asp-for="Input.ConfirmPassword"
                                       class="form-control no23-form-control"
                                       autocomplete="new-password"
                                       placeholder="Parolanı tekrar yaz" />
                                <span asp-validation-for="Input.ConfirmPassword"></span>
                            </div>
                        </div>
                    </div>

                    <button id="registerSubmit"
                            type="submit"
                            class="no23-register-submit">
                        <span>Üyeliği Başlat</span>
                        <span aria-hidden="true">→</span>
                    </button>

                    <p class="register-login-link">
                        Zaten hesabın var mı?
                        <a asp-area="Identity" asp-page="/Account/Login">
                            Üye Girişi
                        </a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const packageSelect = document.getElementById("Input_PackageCode");
            const optionSelect = document.querySelector("[data-package-option-select]");

            if (!packageSelect || !optionSelect) {
                return;
            }

            const options = Array.from(optionSelect.options);

            function syncPackageOptions() {
                const packageCode = packageSelect.value.toUpperCase();
                let firstVisibleOption = null;

                options.forEach(option => {
                    const isVisible = option.dataset.packageCode?.toUpperCase() === packageCode;
                    option.hidden = !isVisible;
                    option.disabled = !isVisible;

                    if (isVisible && !firstVisibleOption) {
                        firstVisibleOption = option;
                    }
                });

                const selectedOption = optionSelect.selectedOptions[0];
                if (!selectedOption || selectedOption.disabled) {
                    optionSelect.value = firstVisibleOption?.value ?? "";
                }

                optionSelect.closest(".no23-package-option-field")?.toggleAttribute(
                    "hidden",
                    !firstVisibleOption);
            }

            packageSelect.addEventListener("change", syncPackageOptions);
            syncPackageOptions();
        })();
    </script>
}
