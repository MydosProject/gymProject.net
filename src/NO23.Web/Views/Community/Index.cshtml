@model CommunityIndexViewModel
@{
    ViewData["Title"] = "NO23 Community";
}

<section class="py-5">
    <div class="container">
        <div class="mb-4">
            <p class="text-uppercase text-muted small mb-1">NO23 Community</p>
            <h1 class="h3 mb-0">Events and Challenges</h1>
        </div>

        <div class="bg-white text-dark border rounded-3 p-4 mb-4">
            <h2 class="h5 mb-3">Upcoming Events</h2>
            <div class="row g-3">
                @foreach (var item in Model.Events)
                {
                    <div class="col-md-6">
                        <article class="border rounded-3 p-3 h-100">
                            <small class="text-muted">@item.Type</small>
                            <h3 class="h6 mt-1">@item.Title</h3>
                            <p class="text-muted small">@item.Summary</p>
                            <div class="small">
                                @item.StartsAtUtc.ToString("dd.MM.yyyy HH:mm") - @item.Location
                            </div>
                            <small class="text-muted">
                                @(item.IsMembersOnly ? "Members only" : "Open event") - Capacity: @(item.Capacity?.ToString() ?? "-")
                            </small>
                        </article>
                    </div>
                }
            </div>
        </div>

        <div class="bg-white text-dark border rounded-3 p-4">
            <h2 class="h5 mb-3">Challenges</h2>
            <div class="row g-3">
                @foreach (var item in Model.Challenges)
                {
                    <div class="col-md-6">
                        <article class="border rounded-3 p-3 h-100">
                            <small class="text-muted">@item.Status</small>
                            <h3 class="h6 mt-1">@item.Title</h3>
                            <p class="text-muted small">@item.Summary</p>
                            <p class="small mb-2">@item.Goal</p>
                            <small class="text-muted">@item.StartsOn.ToString("dd.MM.yyyy") - @item.EndsOn.ToString("dd.MM.yyyy")</small>
                        </article>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
