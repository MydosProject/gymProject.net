@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model NO23.Web.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Yeni Parola Oluştur";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="no23-register-page">
    <div class="register-page-grid" aria-hidden="true"></div>
    <div class="register-page-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <div class="no23-register-shell">
            <aside class="register-intro-panel">
                <a class="register-back-link"
                   asp-page="./Login">
                    <span aria-hidden="true">←</span>
                    Üye girişine dön
                </a>

                <div class="register-intro-content">
                    <p class="register-kicker">NO23 Member Security</p>

                    <h1>
                        Hesabını yeniden
                        <span>güvenceye al.</span>
                    </h1>

                    <p class="register-intro-description">
                        Yeni parolanı yalnızca bu hesapta kullan.
                        Güçlü ve hatırlayabileceğin bir parola oluşturarak devam et.
                    </p>

                    <ul class="register-benefits">
                        <li>
                            <span>01</span>

                            <div>
                                <strong>En az 6 karakter kullan</strong>
                                <small>Parolanı kolay tahmin edilemeyecek uzunlukta oluştur</small>
                            </div>
                        </li>

                        <li>
                            <span>02</span>

                            <div>
                                <strong>Harf ve rakamları birleştir</strong>
                                <small>Büyük-küçük harf ve özel karakterlerden yararlan</small>
                            </div>
                        </li>

                        <li>
                            <span>03</span>

                            <div>
                                <strong>Başka hesaplarda kullanma</strong>
                                <small>NO23 hesabın için sana özel bir parola belirle</small>
                            </div>
                        </li>
                    </ul>
                </div>

                <p class="register-intro-footer">
                    Train Better. Eat Better. Live Better.
                </p>
            </aside>

            <div class="register-form-panel d-flex flex-column justify-content-center">
                <div class="register-form-heading">
                    <div>
                        <p class="register-form-kicker">Parola Güvenliği</p>
                        <h2>Yeni parolanı belirle.</h2>
                    </div>

                    <span class="register-step">NO23</span>
                </div>

                <p class="register-form-description">
                    Hesabının e-posta adresini doğrula, yeni parolanı iki alana da
                    aynı şekilde gir ve işlemi tamamla.
                </p>

                <form method="post"
                      asp-antiforgery="true"
                      class="no23-register-form">
                    <div asp-validation-summary="ModelOnly"
                         class="register-validation-summary"
                         role="alert"></div>

                    <input asp-for="Input.Code" type="hidden" />

                    <div class="row g-3 g-lg-4">
                        <div class="col-12">
                            <div class="no23-form-field">
                                <label asp-for="Input.Email">E-posta adresi</label>

                                <input asp-for="Input.Email"
                                       class="form-control no23-form-control"
                                       autocomplete="email"
                                       placeholder="ornek@email.com" />

                                <span asp-validation-for="Input.Email"></span>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.Password">Yeni parola</label>

                                <input asp-for="Input.Password"
                                       class="form-control no23-form-control"
                                       autocomplete="new-password"
                                       placeholder="Yeni parolan" />

                                <span asp-validation-for="Input.Password"></span>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.ConfirmPassword">Yeni parola tekrar</label>

                                <input asp-for="Input.ConfirmPassword"
                                       class="form-control no23-form-control"
                                       autocomplete="new-password"
                                       placeholder="Yeni parolanı tekrar gir" />

                                <span asp-validation-for="Input.ConfirmPassword"></span>
                            </div>
                        </div>
                    </div>

                    <button type="submit"
                            class="no23-register-submit">
                        <span>Parolamı yenile</span>
                        <span aria-hidden="true">→</span>
                    </button>

                    <p class="register-login-link">
                        İşlemden vazgeçtin mi?

                        <a asp-page="./Login">
                            Üye Girişi
                        </a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
