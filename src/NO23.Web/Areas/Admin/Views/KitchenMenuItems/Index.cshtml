@model IReadOnlyList<KitchenMenuItemListItemViewModel>
@{
    ViewData["Title"] = "Kitchen Menü";
    var activeCount = Model.Count(item => item.IsActive);
    var averageCalories = Model.Count == 0 ? 0 : (int)Model.Average(item => item.Calories);
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">NO23 KITCHEN / MENÜ</p>
                <h1>Kitchen ürünleri</h1>
                <p class="admin-page-description">Öğünleri, fiyatları, besin değerlerini ve menü görünürlüğünü yönet.</p>
            </div>
            <a class="btn btn-dark" asp-action="Create">+ Yeni ürün</a>
        </header>

        <div class="admin-metrics">
            <article><span>Menü ürünü</span><strong>@Model.Count</strong><small>Toplam öğün</small></article>
            <article><span>Aktif ürün</span><strong>@activeCount</strong><small>Siparişe açık</small></article>
            <article><span>Ort. kalori</span><strong>@averageCalories</strong><small>kcal / ürün</small></article>
        </div>

        <div class="table-responsive admin-table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Ürün</th>
                        <th>Kategori</th>
                        <th>Fiyat</th>
                        <th>Kalori</th>
                        <th>Makro</th>
                        <th>Etiket</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="9"><div class="admin-empty-row">Henüz Kitchen ürünü eklenmedi.</div></td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td data-label="Sıra"><span class="admin-order-no">@item.DisplayOrder.ToString("00")</span></td>
                                <td data-label="Ürün"><strong>@item.Name</strong></td>
                                <td data-label="Kategori">@item.Category</td>
                                <td data-label="Fiyat"><strong>@item.UnitPrice.ToString("C0")</strong></td>
                                <td data-label="Kalori">@item.Calories kcal</td>
                                <td data-label="Makro"><span class="admin-code">P @item.ProteinGrams / K @item.CarbohydrateGrams / Y @item.FatGrams</span></td>
                                <td data-label="Etiket">@(item.Tags ?? "-")</td>
                                <td data-label="Durum"><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Aktif" : "Pasif")</span></td>
                                <td class="text-end" data-label="İşlem"><a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
