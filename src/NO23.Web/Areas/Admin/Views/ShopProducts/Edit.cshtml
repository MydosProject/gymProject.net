@model ShopProductFormViewModel
@{
    ViewData["Title"] = "Shop Ürününü Düzenle";
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head admin-form-head">
            <div>
                <a asp-action="Index" class="admin-back-link">← Ürünlere dön</a>
                <p class="admin-eyebrow">Operasyon / Shop</p>
                <h1>Shop ürününü düzenle</h1>
                <p class="admin-page-description">Ürün detaylarını, stok bilgisini ve görünürlük durumunu güncelle.</p>
            </div>
        </header>

        <partial name="_ShopProductForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
