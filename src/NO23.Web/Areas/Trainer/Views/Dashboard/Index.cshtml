@model TrainerDashboardViewModel

@{
    ViewData["Title"] = "Genel Bakış";
}

<section class="admin-dashboard-page trainer-dashboard-page">

    <header class="admin-dashboard-hero trainer-dashboard-hero">

        <div class="admin-dashboard-hero-copy">

            <p class="admin-eyebrow">
                NO23 / TRAINER ROOM
            </p>

            <h1>
                Hoş geldin,
                <br />
                <span>@Model.TrainerName</span>
            </h1>

            <p>
                Birebir antrenman taleplerini,
                yaklaşan randevularını ve
                grup derslerini tek ekrandan
                takip edebilirsin.
            </p>

        </div>

        <div class="admin-dashboard-hero-panel">

            <div>
                <span>Uzmanlık</span>

                <strong>
                    @Model.Specialty
                </strong>
            </div>

            <p>
                Günlük programını, birebir taleplerini
                ve yaklaşan derslerini buradan takip
                edebilirsin.
            </p>

        </div>

    </header>


    <section class="admin-dashboard-metrics trainer-dashboard-metrics">

        <a class="admin-dashboard-metric-card"
           asp-area="Trainer"
           asp-controller="PersonalTrainingRequests"
           asp-action="Index">

            <div class="admin-dashboard-metric-top">
                <span>01</span>
                <small>Birebir</small>
            </div>

            <strong>
                @(Model.PendingRequestCount.ToString("00"))
            </strong>

            <div class="admin-dashboard-metric-footer">
                <span>Bekleyen talep</span>
                <b>→</b>
            </div>

        </a>


        <a class="admin-dashboard-metric-card"
           asp-area="Trainer"
           asp-controller="PersonalTrainingRequests"
           asp-action="Index">

            <div class="admin-dashboard-metric-top">
                <span>02</span>
                <small>Randevular</small>
            </div>

            <strong>
                @(Model.UpcomingPersonalTrainingCount.ToString("00"))
            </strong>

            <div class="admin-dashboard-metric-footer">
                <span>Yaklaşan birebir</span>
                <b>→</b>
            </div>

        </a>


        <a class="admin-dashboard-metric-card"
           asp-area="Trainer"
           asp-controller="Classes"
           asp-action="Index">

            <div class="admin-dashboard-metric-top">
                <span>03</span>
                <small>Dersler</small>
            </div>

            <strong>
                @(Model.ActiveGroupClassCount.ToString("00"))
            </strong>

            <div class="admin-dashboard-metric-footer">
                <span>Aktif grup dersi</span>
                <b>→</b>
            </div>

        </a>


        <a class="admin-dashboard-metric-card"
           asp-area="Trainer"
           asp-controller="Classes"
           asp-action="Index">

            <div class="admin-dashboard-metric-top">
                <span>04</span>
                <small>Program</small>
            </div>

            <strong>
                @(Model.UpcomingClassSessionCount.ToString("00"))
            </strong>

            <div class="admin-dashboard-metric-footer">
                <span>Yaklaşan seans</span>
                <b>→</b>
            </div>

        </a>

    </section>


    <section class="trainer-dashboard-section">

        <div class="trainer-dashboard-section-head">

            <div>
                <small>
                    Birebir antrenman
                </small>

                <h2>
                    Son talepler
                </h2>
            </div>

            <a class="trainer-dashboard-link"
               asp-area="Trainer"
               asp-controller="PersonalTrainingRequests"
               asp-action="Index">

                Tümünü gör

                <span aria-hidden="true">
                    →
                </span>

            </a>

        </div>


        <div class="trainer-dashboard-panel">

            @if (
                Model.RecentPersonalTrainingRequests
                    .Count == 0)
            {
                <div class="trainer-dashboard-empty">

                    <span aria-hidden="true">
                        01
                    </span>

                    <div>
                        <strong>
                            Henüz talep yok.
                        </strong>

                        <p>
                            Sana gönderilen birebir
                            antrenman talepleri burada
                            görünecek.
                        </p>
                    </div>

                </div>
            }
            else
            {
                <div class="trainer-dashboard-table-wrap">

                    <table class="trainer-dashboard-table">

                        <thead>
                            <tr>
                                <th>Üye</th>
                                <th>Tercih</th>
                                <th>Durum</th>
                                <th>Kesin randevu</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (
                            var request in
                            Model.RecentPersonalTrainingRequests)
                        {
                            <tr>

                                <td data-label="Üye">

                                    <strong>
                                        @request.MemberName
                                    </strong>

                                    <small>
                                        @request.MemberEmail
                                    </small>

                                </td>


                                <td data-label="Tercih">

                                    <strong>
                                        @request.PreferredDate.ToString(
                                            "dd.MM.yyyy")
                                    </strong>

                                    <small>
                                        @request.PreferredTimeWindow
                                    </small>

                                </td>


                                <td data-label="Durum">

                                    <span class="trainer-status-badge
                                        @(request.Status ==
                                            PersonalTrainingRequestStatus.Pending
                                                ? "is-pending"
                                                : request.Status ==
                                                  PersonalTrainingRequestStatus.Scheduled
                                                    ? "is-scheduled"
                                                    : "is-neutral")">

                                        @request.StatusDisplayName

                                    </span>

                                </td>


                                <td data-label="Kesin randevu">

                                    @if (
                                        request.ScheduledAtUtc
                                            is not null)
                                    {
                                        <strong>
                                            @(request
                                                .ScheduledAtUtc
                                                .Value
                                                .ToLocalTime()
                                                .ToString(
                                                    "dd.MM.yyyy HH:mm"))
                                        </strong>
                                    }
                                    else
                                    {
                                        <span class="trainer-dashboard-muted">
                                            —
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </section>


    <section class="trainer-dashboard-section">

        <div class="trainer-dashboard-section-head">

            <div>

                <small>
                    Ders programı
                </small>

                <h2>
                    Yaklaşan derslerin
                </h2>

            </div>

            <a class="trainer-dashboard-link"
               asp-area="Trainer"
               asp-controller="Classes"
               asp-action="Index">

                Derslerimi gör

                <span aria-hidden="true">
                    →
                </span>

            </a>

        </div>


        <div class="trainer-dashboard-panel">

            @if (
                Model.UpcomingClassSessions.Count == 0)
            {
                <div class="trainer-dashboard-empty">

                    <span aria-hidden="true">
                        02
                    </span>

                    <div>

                        <strong>
                            Yaklaşan ders bulunmuyor.
                        </strong>

                        <p>
                            Planlanan grup dersleri
                            burada görüntülenecek.
                        </p>

                    </div>

                </div>
            }
            else
            {
                <div class="trainer-dashboard-table-wrap">

                    <table class="trainer-dashboard-table">

                        <thead>
                            <tr>
                                <th>Ders</th>
                                <th>Tarih</th>
                                <th>Süre</th>
                                <th>Rezervasyon</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (
                            var session in
                            Model.UpcomingClassSessions)
                        {
                            <tr>

                                <td data-label="Ders">

                                    <strong>
                                        @session.ClassName
                                    </strong>

                                </td>


                                <td data-label="Tarih">

                                    <strong>
                                        @session
                                            .StartsAtUtc
                                            .ToLocalTime()
                                            .ToString(
                                                "dd.MM.yyyy HH:mm")
                                    </strong>

                                </td>


                                <td data-label="Süre">

                                    @session.DurationMinutes dk

                                </td>


                                <td data-label="Rezervasyon">

                                    @session.ReservedCount
                                    /
                                    @session.Capacity

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </section>

</section>