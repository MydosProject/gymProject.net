@model MemberPasswordResetViewModel
@{ ViewData["Title"] = "Geçici parola yenile"; }
<section class="admin-page"><div class="container" style="max-width:700px">
    <header class="admin-page-head"><div><p class="admin-eyebrow">ÜYE YÖNETİMİ</p><h1>Geçici parola yenile</h1><p>@Model.MemberName için yeni parola belirleyin.</p></div></header>
    <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" class="admin-form-card">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
        <p class="form-text">En az 6 karakter; bir büyük harf, bir küçük harf, rakam ve özel karakter. Türkçe harfler kabul edilir.</p>
        <label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        <p class="mt-3">Kaydedildiğinde eski parola geçersiz olur. Bu işlemi gerektiğinde tekrar yapabilirsiniz.</p>
        <button class="btn btn-dark mt-2" type="submit">Geçici parolayı yenile</button>
        <a class="btn btn-outline-dark mt-2" asp-action="Index">Üyelere dön</a>
    </form>
</div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
