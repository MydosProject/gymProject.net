@model IReadOnlyList<ClassSessionListItemViewModel>
@using NO23.Web.Services
@{
    ViewData["Title"] = "Ders Programı";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var includeHistory = ViewBag.IncludeHistory is true;
    var classGroups = Model.GroupBy(session => session.GroupClassId)
        .OrderBy(group => group.First().ClassName).ToList();
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">NO23 CLUB / DERS YÖNETİMİ</p>
                <h1>Ders programı</h1>
                <p class="admin-page-description">Dersleri gün ve saat düzenine göre incele; seansların katılımcılarını açarak gör.</p>
            </div>
            <div class="admin-page-actions">
                <a class="btn btn-dark" asp-controller="Calendar" asp-action="Index">Haftalık takvim</a>
                <a class="btn btn-outline-dark" asp-area="Admin" asp-controller="GroupClasses" asp-action="Index">Grup dersleri</a>
                <a class="btn btn-dark" asp-action="Create">+ Programa ders ekle</a>
            </div>
        </header>

        <div class="admin-metrics">
            <article><span>Ders türü</span><strong>@classGroups.Count</strong><small>Gösterilen program</small></article>
            <article><span>Seans</span><strong>@Model.Count</strong><small>Gösterilen seanslar</small></article>
            <article><span>Rezervasyon</span><strong>@Model.Sum(session => session.ReservedCount)</strong><small>Toplam katılımcı</small></article>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        { <div class="alert alert-success" role="status">@successMessage</div> }
        @if (TempData["ErrorMessage"] is string errorMessage)
        { <div class="alert alert-danger" role="alert">@errorMessage</div> }

        <div class="mb-3">
            @if (includeHistory)
            { <a class="btn btn-outline-dark btn-sm" asp-action="Index">Yalnızca gelecek seanslar</a> }
            else
            { <a class="btn btn-outline-dark btn-sm" asp-action="Index" asp-route-includeHistory="true">Geçmiş ve iptal edilenleri de göster</a> }
        </div>

        @if (classGroups.Count == 0)
        {
            <div class="admin-form-card">Gösterilecek seans bulunmuyor.</div>
        }
        @foreach (var classGroup in classGroups)
        {
            var first = classGroup.First();
            var slots = classGroup.GroupBy(session => new
            {
                Day = ClubTime.ToLocal(session.StartsAtUtc).DayOfWeek,
                Time = ClubTime.ToLocal(session.StartsAtUtc).TimeOfDay
            }).OrderBy(slot => ((int)slot.Key.Day + 6) % 7).ThenBy(slot => slot.Key.Time).ToList();

            <section class="admin-form-card mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <p class="admin-eyebrow mb-1">GRUP DERSİ</p>
                        <h2 class="h4 mb-1">@first.ClassName</h2>
                        <p class="mb-0">@first.TrainerName · @classGroup.Count() seans</p>
                    </div>
                    @if (!first.IsGroupClassActive)
                    { <span class="badge text-bg-secondary">Arşivlenmiş ders</span> }
                </div>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var slot in slots)
                    {
                        <span class="badge text-bg-light border text-dark">
                            @culture.DateTimeFormat.GetDayName(slot.Key.Day) @slot.Key.Time.ToString(@"hh\:mm") · @slot.Count() seans
                        </span>
                    }
                </div>

                @foreach (var slot in slots)
                {
                    <details class="border rounded p-3 mb-2">
                        <summary class="d-flex flex-wrap justify-content-between gap-2" style="cursor:pointer">
                            <strong>@culture.DateTimeFormat.GetDayName(slot.Key.Day) @slot.Key.Time.ToString(@"hh\:mm")</strong>
                            <span>@slot.Count() seans · @slot.Sum(session => session.ReservedCount) rezervasyon</span>
                        </summary>
                        <div class="table-responsive mt-3">
                            <table class="table align-middle mb-0">
                                <thead><tr><th>Tarih</th><th>Kontenjan</th><th>Durum</th><th>Katılımcılar</th><th class="text-end">İşlem</th></tr></thead>
                                <tbody>
                                @foreach (var session in slot.OrderBy(session => session.StartsAtUtc))
                                {
                                    var startsAtLocal = ClubTime.ToLocal(session.StartsAtUtc);
                                    <tr>
                                        <td><strong>@startsAtLocal.ToString("dd.MM.yyyy")</strong><small class="admin-cell-note d-block">@startsAtLocal.ToString("HH:mm")</small></td>
                                        <td>@session.ReservedCount / @session.Capacity</td>
                                        <td><span class="badge @(session.IsScheduled ? "text-bg-success" : "text-bg-secondary")">@session.Status</span></td>
                                        <td>
                                            <details>
                                                <summary>@session.Participants.Count kişi</summary>
                                                @if (session.Participants.Count == 0)
                                                { <small>Henüz katılımcı yok.</small> }
                                                @foreach (var participant in session.Participants)
                                                {
                                                    <div class="border-bottom py-2">
                                                        <strong>@participant.DisplayName</strong>
                                                        <small class="d-block">@participant.Email · @participant.PackageName</small>
                                                        <form asp-action="RemoveReservation" asp-route-id="@session.Id" method="post" class="mt-1"
                                                              onsubmit="return confirm('Bu katılımcı ders listesinden çıkarılsın mı?');">
                                                            <input type="hidden" name="reservationId" value="@participant.ReservationId" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">Çıkar</button>
                                                        </form>
                                                    </div>
                                                }
                                            </details>
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@session.Id">Düzenle</a>
                                            <a class="btn btn-sm btn-outline-dark" asp-controller="Calendar" asp-action="Index"
                                               asp-route-week="@startsAtLocal.ToString("yyyy-MM-dd")" asp-fragment="group-session-@session.Id">Takvim</a>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </details>
                }
            </section>
        }
    </div>
</section>
