                       asp-controller="Shop"
                       asp-action="Index"
                       asp-fragment="shop-products">
                        <span class="quick-access-number">05</span>
                        <strong>Online Sipariş</strong>
                        <small>Öğünlerini kolayca seç</small>
                    </a>
                }
                else
                {
                    <a class="quick-access-card"
                       asp-controller="Shop"
                       asp-action="Index">
                        <span class="quick-access-number">05</span>
                        <strong>Online Sipariş</strong>
                        <small>Ürünleri üyelik olmadan sipariş et</small>
                    </a>
                }

