@model NO23.Web.ViewModels.Plans.ServicePackageCardViewModel
@{
    var selectedId = Model.Variants.FirstOrDefault(x => x.IsRecommended)?.Id ?? Model.Variants.FirstOrDefault()?.Id;
    var billingNote = Model.Variants.Select(x => x.BillingNote).FirstOrDefault(x => x is not null);
    var isKidsPackage = string.Equals(Model.Slug, "kids-club", StringComparison.OrdinalIgnoreCase);
}
<article id="@Model.Slug" class="service-package-card @(Model.IsFeatured ? "is-featured" : null) @(isKidsPackage ? "is-kids-package" : null)">
    @if (Model.IsFeatured) { <span class="service-package-badge">En Çok Tercih Edilen</span> }
    <div class="service-package-head">
        <small>@(Model.CategoryTitle == "Personal Training" ? "PERSONAL TRAINING" : Model.CategoryTitle)</small>
        <h3>@Model.Name</h3>
        <strong>@Model.Subtitle</strong>
    </div>
    <p>@Model.Description</p>
    <ul>
        @foreach (var feature in Model.Features) { <li>@feature</li> }
    </ul>
    @if (Model.Highlights.Count > 0)
    {
        <section class="service-package-highlights" aria-label="Paket avantajları">
            <span class="service-package-highlights-title">Paket Avantajları</span>
            <div>
                @foreach (var highlight in Model.Highlights)
                {
                    <strong>@highlight</strong>
                }
            </div>
        </section>
    }
    @if (billingNote is not null)
    {
        <aside class="service-billing-note" aria-label="Aylık ödeme bilgisi">
            <span class="service-billing-note-mark">AYLIK</span>
            <span>
                <strong>Otomatik kart tahsilatı</strong>
                <small>@billingNote</small>
            </span>
        </aside>
    }
    @if (Model.Variants.Count > 0)
    {
        <form asp-area="" asp-controller="Plans" asp-action="Apply" method="get" class="service-package-application-form">
            <input type="hidden" name="package" value="@Model.Slug" />
            <fieldset class="service-package-variants">
                <legend>Başvurmak istediğin seçeneği belirle</legend>
                @foreach (var variant in Model.Variants)
                {
                    <label class="service-variant @(variant.IsRecommended ? "is-recommended" : null)">
                        <input type="radio" name="variant" value="@variant.Id" checked="@(variant.Id == selectedId)" required />
                        <span class="service-variant-check" aria-hidden="true"></span>
                        <span class="service-variant-copy">
                            <span class="service-variant-title">
                                <strong>@variant.Name</strong>
                                @if (variant.IsRecommended) { <em>En çok tercih edilen</em> }
                            </span>
                            <small>@variant.Rights</small>
                            @if (variant.CommitmentNote is not null) { <small>@variant.CommitmentNote</small> }
                            @if (variant.UnitPrice is not null) { <small>@variant.UnitPrice</small> }
                            @if (variant.Savings is not null)
                            {
                                <span class="service-variant-savings"><small>Toplam Avantaj</small><strong>@variant.Savings</strong></span>
                                <small>@variant.ComparisonNote</small>
                            }
                        </span>
                        <span class="service-variant-price"><b>@variant.Price</b><small>@variant.PriceNote</small></span>
                    </label>
                }
            </fieldset>
            <button type="submit" class="service-package-submit">Başvuru Yap <span aria-hidden="true">→</span></button>
        </form>
    }
    else { <p class="service-package-unavailable">Bu paket için aktif seçenek bulunmuyor.</p> }
</article>
