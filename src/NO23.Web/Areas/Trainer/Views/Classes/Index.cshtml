@model IReadOnlyList<
    TrainerGroupClassListItemViewModel>

@{
    ViewData["Title"] = "Derslerim";
}

<section>

    <div class="mb-4">

        <p class="text-uppercase
                  text-muted
                  small mb-1">
            Grup dersleri
        </p>

        <h1 class="h3 mb-2">
            Derslerim
        </h1>

        <p class="text-muted mb-0">
            Sana atanmış grup derslerini ve
            yaklaşan seans bilgilerini görüntüle.
        </p>

    </div>

    <div class="card border-0 shadow-sm">

        @if (Model.Count == 0)
        {
            <div class="card-body py-5
                        text-center
                        text-muted">

                Sana atanmış bir grup dersi
                bulunmuyor.

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table
                              align-middle
                              mb-0">

                    <thead>
                        <tr>
                            <th>Ders</th>
                            <th>Seviye</th>
                            <th>Süre</th>
                            <th>Kontenjan</th>
                            <th>Yaklaşan Seans</th>
                            <th>Sonraki Ders</th>
                            <th>Durum</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var groupClass in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @groupClass.Name
                                </strong>

                                <div class="small text-muted">
                                    Ortalama
                                    @groupClass.AverageCaloriesBurned
                                    kcal
                                </div>
                            </td>

                            <td>
                                @groupClass.DifficultyLevel
                            </td>

                            <td>
                                @groupClass.DurationMinutes dk
                            </td>

                            <td>
                                @groupClass.Capacity
                            </td>

                            <td>
                                @groupClass.UpcomingSessionCount
                            </td>

                            <td>

                                @if (
                                    groupClass.NextSessionAtUtc
                                        is not null)
                                {
                                   @(groupClass.NextSessionAtUtc.Value
                                    .ToLocalTime()
                                    .ToString("dd.MM.yyyy HH:mm"))
                                }
                                else
                                {
                                    <span class="text-muted">
                                        —
                                    </span>
                                }

                            </td>

                            <td>

                                @if (groupClass.IsActive)
                                {
                                    <span class="badge
                                                 text-bg-success">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge
                                                 text-bg-secondary">
                                        Pasif
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }

    </div>

</section>