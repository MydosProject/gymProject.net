@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Yönetim Paneli";
    var userName = User.Identity?.Name ?? "NO23 Yönetici";
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "N" : userName.Trim()[0].ToString().ToUpperInvariant();
    var isKitchenSection =
        currentController.Equals("KitchenMenuItems", StringComparison.OrdinalIgnoreCase) ||
        currentController.Equals("KitchenStock", StringComparison.OrdinalIgnoreCase) ||
        currentController.Equals("KitchenSubscriptionPackages", StringComparison.OrdinalIgnoreCase) ||
        currentController.Equals("KitchenSubscriptions", StringComparison.OrdinalIgnoreCase);
    var isClassSection =
        currentController.Equals("GroupClasses", StringComparison.OrdinalIgnoreCase) ||
        currentController.Equals("ClassSessions", StringComparison.OrdinalIgnoreCase);
    var isMembershipSection =
        currentController.Equals("Members", StringComparison.OrdinalIgnoreCase) ||
        currentController.Equals("MembershipPackages", StringComparison.OrdinalIgnoreCase);

    string ActiveClass(params string[] controllers) =>
        controllers.Contains(currentController, StringComparer.OrdinalIgnoreCase) ? "is-active" : string.Empty;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090b09" />
    <title>@pageTitle | NO23 Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NO23.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="no23-admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar" aria-label="Admin navigasyonu">
            <div class="admin-sidebar-head">
                <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <span class="admin-brand-mark">NO23</span>
                    <span class="admin-brand-copy">Control Room</span>
                </a>
                <button class="admin-sidebar-close" type="button" data-admin-sidebar-close aria-label="Menüyü kapat">×</button>
            </div>

            <nav class="admin-nav">
                <div class="admin-nav-group">
                    <p class="admin-nav-title">Genel</p>
                    <a class="admin-nav-link @ActiveClass("Dashboard")"
                       asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        <span class="admin-nav-index">00</span>
                        <span>Genel Bakış</span>
                    </a>
                </div>

                <div class="admin-nav-group">
                    <p class="admin-nav-title">Operasyon</p>
                    <a class="admin-nav-link @ActiveClass("Orders")" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                        <span class="admin-nav-index">01</span>
                        <span>Siparişler</span>
                    </a>
                    <a class="admin-nav-link @ActiveClass("ShopProducts")" asp-area="Admin" asp-controller="ShopProducts" asp-action="Index">
                        <span class="admin-nav-index">02</span>
                        <span>Shop Ürünleri</span>
                    </a>
                    <a class="admin-nav-link has-submenu @ActiveClass("KitchenMenuItems", "KitchenStock", "KitchenSubscriptionPackages", "KitchenSubscriptions")"
                       asp-area="Admin"
                       asp-controller="KitchenMenuItems"
                       asp-action="Index"
                       aria-controls="adminKitchenSubmenu"
                       aria-expanded="@(isKitchenSection ? "true" : "false")"
                       data-admin-submenu-toggle>
                        <span class="admin-nav-index">03</span>
                        <span>Kitchen</span>
                        <span class="admin-nav-chevron" aria-hidden="true"></span>
                    </a>
                    <div class="admin-nav-submenu @(isKitchenSection ? "is-open" : string.Empty)"
                         id="adminKitchenSubmenu"
                         aria-label="Kitchen alt menüsü">
                        <a class="admin-nav-sublink @ActiveClass("KitchenMenuItems")"
                           asp-area="Admin"
                           asp-controller="KitchenMenuItems"
                           asp-action="Index">
                            Menü Ürünleri
                        </a>
                        <a class="admin-nav-sublink @ActiveClass("KitchenStock")"
                           asp-area="Admin"
                           asp-controller="KitchenStock"
                           asp-action="Index">
                            Stok Takibi
                        </a>
                        <a class="admin-nav-sublink @ActiveClass("KitchenSubscriptionPackages")"
                           asp-area="Admin"
                           asp-controller="KitchenSubscriptionPackages"
                           asp-action="Index">
                            Paketler
                        </a>
                        <a class="admin-nav-sublink @ActiveClass("KitchenSubscriptions")"
                           asp-area="Admin"
                           asp-controller="KitchenSubscriptions"
                           asp-action="Index">
                            Abonelikler
                        </a>
                    </div>
                </div>

                <div class="admin-nav-group">
                    <p class="admin-nav-title">İçerik & Topluluk</p>
                    <a class="admin-nav-link @ActiveClass("CommunityEvents")" asp-area="Admin" asp-controller="CommunityEvents" asp-action="Index">
                        <span class="admin-nav-index">04</span>
                        <span>Etkinlikler</span>
                    </a>
                    <a class="admin-nav-link @ActiveClass("CommunityChallenges")" asp-area="Admin" asp-controller="CommunityChallenges" asp-action="Index">
                        <span class="admin-nav-index">05</span>
                        <span>Challenge'lar</span>
                    </a>
                    <a class="admin-nav-link @ActiveClass("BlogPosts")" asp-area="Admin" asp-controller="BlogPosts" asp-action="Index">
                        <span class="admin-nav-index">06</span>
                        <span>Blog</span>
                    </a>
                    <a class="admin-nav-link @ActiveClass("SuccessStories")" asp-area="Admin" asp-controller="SuccessStories" asp-action="Index">
                        <span class="admin-nav-index">07</span>
                        <span>Başarı Hikâyeleri</span>
                    </a>
                </div>

                <div class="admin-nav-group">
                    <p class="admin-nav-title">Kulüp</p>
                    <a class="admin-nav-link has-submenu @ActiveClass("Members", "MembershipPackages")"
                       asp-area="Admin"
                       asp-controller="Members"
                       asp-action="Index"
                       aria-controls="adminMembershipSubmenu"
                       aria-expanded="@(isMembershipSection ? "true" : "false")"
                       data-admin-submenu-toggle>
                        <span class="admin-nav-index">08</span>
                        <span>Üyeler & Paketler</span>
                        <span class="admin-nav-chevron" aria-hidden="true"></span>
                    </a>
                    <div class="admin-nav-submenu @(isMembershipSection ? "is-open" : string.Empty)"
                         id="adminMembershipSubmenu"
                         aria-label="Üyeler ve Paketler alt menüsü">
                        <a class="admin-nav-sublink @ActiveClass("Members")"
                           asp-area="Admin"
                           asp-controller="Members"
                           asp-action="Index">
                            Üyeler
                        </a>
                        <a class="admin-nav-sublink @ActiveClass("MembershipPackages")"
                           asp-area="Admin"
                           asp-controller="MembershipPackages"
                           asp-action="Index">
                            Üyelik Paketleri
                        </a>
                    </div>
                    <a class="admin-nav-link @ActiveClass("Trainers")" asp-area="Admin" asp-controller="Trainers" asp-action="Index">
                        <span class="admin-nav-index">09</span>
                        <span>Eğitmenler</span>
                    </a>
                    <a class="admin-nav-link has-submenu @ActiveClass("GroupClasses", "ClassSessions")"
                       asp-area="Admin"
                       asp-controller="GroupClasses"
                       asp-action="Index"
                       aria-controls="adminClassesSubmenu"
                       aria-expanded="@(isClassSection ? "true" : "false")"
                       data-admin-submenu-toggle>
                        <span class="admin-nav-index">10</span>
                        <span>Ders Yönetimi</span>
                        <span class="admin-nav-chevron" aria-hidden="true"></span>
                    </a>
                    <div class="admin-nav-submenu @(isClassSection ? "is-open" : string.Empty)"
                         id="adminClassesSubmenu"
                         aria-label="Ders Yönetimi alt menüsü">
                        <a class="admin-nav-sublink @ActiveClass("GroupClasses")"
                           asp-area="Admin"
                           asp-controller="GroupClasses"
                           asp-action="Index">
                            Grup Dersleri
                        </a>
                        <a class="admin-nav-sublink @ActiveClass("ClassSessions")"
                           asp-area="Admin"
                           asp-controller="ClassSessions"
                           asp-action="Index">
                            Ders Programı
                        </a>
                    </div>
                </div>
            </nav>

            <div class="admin-sidebar-foot">
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                      method="post">
                    <button class="admin-logout" type="submit">
                        <span class="admin-logout-icon" aria-hidden="true"></span>
                        <span>Çıkış</span>
                    </button>
                </form>
            </div>
        </aside>

        <div class="admin-sidebar-overlay" data-admin-sidebar-close></div>

        <main class="admin-main">
            <header class="admin-topbar">
                <div class="admin-topbar-start">
                    <button class="admin-menu-button"
                            type="button"
                            data-admin-sidebar-open
                            aria-controls="adminSidebar"
                            aria-expanded="false"
                            aria-label="Menüyü aç">
                        <span></span><span></span>
                    </button>
                    <div>
                        <p class="admin-topbar-kicker">NO23 / ADMIN</p>
                        <strong class="admin-topbar-title">@pageTitle</strong>
                    </div>
                </div>

                <div class="admin-topbar-end">
                    <span class="admin-date">@DateTime.Now.ToString("dd.MM.yyyy")</span>
                    <a class="admin-user" asp-area="Identity" asp-page="/Account/Manage/Index" title="Hesap ayarları">
                        <span class="admin-user-avatar">@userInitial</span>
                        <span class="admin-user-copy">
                            <strong>@userName</strong>
                            <small>Yönetici</small>
                        </span>
                    </a>
                </div>
            </header>

            <div class="admin-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const body = document.body;
            const openButton = document.querySelector('[data-admin-sidebar-open]');
            const closeMenu = () => {
                body.classList.remove('admin-menu-open');
                openButton?.setAttribute('aria-expanded', 'false');
            };

            openButton?.addEventListener('click', () => {
                body.classList.add('admin-menu-open');
                openButton.setAttribute('aria-expanded', 'true');
            });

            document.querySelectorAll('[data-admin-sidebar-close]').forEach((element) => {
                element.addEventListener('click', closeMenu);
            });

            document.querySelectorAll('[data-admin-submenu-toggle]').forEach((toggle) => {
                toggle.addEventListener('click', (event) => {
                    const submenuId = toggle.getAttribute('aria-controls');
                    const submenu = submenuId ? document.getElementById(submenuId) : null;

                    if (!submenu) {
                        return;
                    }

                    event.preventDefault();

                    const shouldOpen = toggle.getAttribute('aria-expanded') !== 'true';
                    toggle.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
                    submenu.classList.toggle('is-open', shouldOpen);
                });
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && body.classList.contains('admin-menu-open')) {
                    closeMenu();
                    openButton?.focus();
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
