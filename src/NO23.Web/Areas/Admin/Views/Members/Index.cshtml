@model IReadOnlyList<MemberListItemViewModel>
@{
    ViewData["Title"] = "Üyeler";
    var navigation = (NO23.Web.ViewModels.ListNavigationViewModel)ViewData["ListNavigation"]!;
    var packageCount = (int)ViewBag.PackageCount;
    var newThisMonthCount = (int)ViewBag.NewThisMonthCount;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-members.css" asp-append-version="true" />
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">KULÜP / ÜYE YÖNETİMİ</p>
                <h1>Üyeler</h1>
                <p class="admin-page-description">
                    Üye profillerini, paket dağılımını, hedefleri ve kalan ders haklarını tek ekrandan takip et.
                </p>
            </div>

            <a class="btn btn-dark"
               asp-action="Create">
                Yeni üye ekle
            </a>
            <a class="btn btn-outline-dark"
               asp-area="Admin"
               asp-controller="ServicePackages"
               asp-action="Index">
                Paketleri Yönet
            </a>
        </header>

        @if (TempData["StatusMessage"] is string statusMessage)
        { <div class="alert alert-success">@statusMessage</div> }
        @if (TempData["ErrorMessage"] is string errorMessage)
        { <div class="alert alert-danger">@errorMessage</div> }

        <div class="admin-metrics">
            <article>
                <span>Toplam üye</span>
                <strong>@ViewBag.OverallCount</strong>
                <small>Kayıtlı üye profili</small>
            </article>
            <article>
                <span>Aktif paket türü</span>
                <strong>@packageCount</strong>
                <small>Üyeler tarafından kullanılan</small>
            </article>
            <article>
                <span>Bu ay katılan</span>
                <strong>@newThisMonthCount</strong>
                <small>Yeni üye kaydı</small>
            </article>
        </div>

        <partial name="/Views/Shared/_ListFilters.cshtml" model="navigation" />
        <div class="table-responsive admin-table-card member-table-scroll" role="region" aria-label="Üyeler tablosu" tabindex="0">
            <table class="table align-middle mb-0 admin-members-table">
                <thead>
                    <tr>
                        <th>Üye</th>
                        <th>İletişim</th>
                        <th>Paket</th>
                        <th>Hedef</th>
                        <th>Kalan Ders</th>
                        <th>Antrenör</th>
                        <th>Tahsilat</th>
                        <th>Kayıt</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9">
                                <div class="admin-empty-row">Aramaya uygun üye bulunamadı.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var member in Model)
                        {
                            <tr>
                                <td data-label="Üye">
                                    <strong>@(string.IsNullOrWhiteSpace(member.FullName) ? "İsimsiz üye" : member.FullName)</strong>
                                    <small class="admin-cell-note">@member.Email</small>
                                </td>
                                <td data-label="İletişim">@(string.IsNullOrWhiteSpace(member.PhoneNumber) ? "-" : member.PhoneNumber)</td>
                                <td data-label="Paket">
                                    <span class="admin-status">@member.PackageName</span>
                                    @if (member.IsKitchenOnly)
                                    { <small class="admin-cell-note d-block">Kitchen hesabı · Spor üyeliği yok</small> }
                                    @if (member.MembershipEndsAtUtc is { } membershipEnd)
                                    {
                                        <small class="admin-cell-note d-block">Bitiş: @NO23.Web.Services.ClubTime.ToLocal(membershipEnd).ToString("dd.MM.yyyy")</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(member.FamilyCode))
                                    {
                                        <small class="admin-cell-note d-block">Aile kodu: @member.FamilyCode</small>
                                        @if (member.SiblingDiscountPercent > 0)
                                        {
                                            <small class="admin-cell-note d-block">%@member.SiblingDiscountPercent kardeş indirimi</small>
                                        }
                                    }
                                </td>
                                <td data-label="Hedef">@(string.IsNullOrWhiteSpace(member.FitnessGoal) ? "-" : member.FitnessGoal)</td>
                                <td data-label="Kalan ders">
                                    @if (member.Credits is not null) { <partial name="/Views/Shared/_LessonCreditCompact.cshtml" model="member.Credits" /> }
                                    else {
                                    <strong>@(member.IsKitchenOnly ? "—" : member.IsUnlimitedPackage ? "Sınırsız" : member.RemainingClassCredits)</strong>
                                    <small class="admin-cell-note">@(member.IsKitchenOnly ? "Spor üyeliği yok" : "Ders hakkı")</small>
                                    }
                                    <a asp-action="Credits" asp-route-id="@member.MemberProfileId">Ders hakları</a>
                                </td>
                                <td data-label="Antrenör" class="member-trainer-cell">
                                    <div class="member-trainer-content">
                                    <strong class="member-trainer-name">@(member.AssignedTrainerName ?? "Antrenör atanmamış")</strong>
                                    <form asp-action="AssignTrainer" method="post" class="member-trainer-form">
                                        <input type="hidden" name="memberProfileId" value="@member.MemberProfileId" />
                                        <input type="hidden" name="page" value="@navigation.Page" /><input type="hidden" name="query" value="@navigation.Query" /><input type="hidden" name="state" value="@navigation.State" />
                                        <select class="form-select form-select-sm" name="trainerId" aria-label="@($"{member.FullName} için antrenör seç")">
                                            <option value="">Atanmamış</option>
                                            @foreach (var trainer in (IEnumerable<SelectListItem>)ViewBag.Trainers)
                                            {
                                                <option value="@trainer.Value" selected="@(trainer.Value == member.AssignedTrainerId?.ToString())">@trainer.Text</option>
                                            }
                                        </select>
                                        <button class="btn btn-outline-dark btn-sm" type="submit">Kaydet</button>
                                    </form>
                                    </div>
                                </td>
                                <td data-label="Tahsilat">
                                    <strong>@member.Payments.Collected.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ₺ alındı</strong>
                                    <small class="admin-cell-note d-block">Kalan: @member.Payments.Outstanding.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ₺</small>
                                    @if (member.Payments.LastReceiptDate is { } paidOn)
                                    { <small class="admin-cell-note d-block">Son: @paidOn.ToString("dd.MM.yyyy") · @member.Payments.LastReceiptDayAmount.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR")) ₺</small> }
                                    <a asp-action="Payments" asp-route-id="@member.MemberProfileId">Ödeme geçmişi</a>
                                </td>
                                <td data-label="Kayıt">
                                    <strong>@NO23.Web.Services.ClubTime.ToLocal(member.CreatedAtUtc).ToString("dd.MM.yyyy")</strong>
                                    <small class="admin-cell-note">Kayıt tarihi</small>
                                </td>
                                <td data-label="İşlem">
                                    <div class="member-row-actions">
                                        <a class="btn btn-outline-dark btn-sm" asp-action="Edit" asp-route-id="@member.MemberProfileId">Düzenle</a>
                                        <a class="btn btn-outline-dark btn-sm" asp-action="ResetPassword" asp-route-id="@member.MemberProfileId">Geçici parola yenile</a>
                                        <a class="btn btn-outline-dark btn-sm" asp-controller="MemberProgress" asp-action="Index" asp-route-memberId="@member.MemberProfileId">Ölçüm ve fotoğraflar</a>
                                        <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@member.MemberProfileId">Sil</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
<partial name="/Views/Shared/_ListPagination.cshtml" model="navigation" />
</section>
