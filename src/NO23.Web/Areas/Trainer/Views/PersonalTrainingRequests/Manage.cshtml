@model TrainerPersonalTrainingRequestManageViewModel

@{
    ViewData["Title"] = "Birebir Talep";

    var createdAtLocal =
        Model.CreatedAtUtc.ToLocalTime();
}

<section class="trainer-request-manage-page">

    <header class="trainer-request-manage-head">

        <div>

            <a asp-action="Index"
               class="trainer-back-link">
                ← Birebir taleplere dön
            </a>

            <p class="trainer-page-eyebrow">
                Birebir antrenman
            </p>

            <h1>
                Talep #@Model.Id.ToString("0000")
            </h1>

            <p class="trainer-page-description">
                Üyenin birebir çalışma talebini
                incele ve uygun işlemi gerçekleştir.
            </p>

        </div>

        <div class="trainer-request-manage-status">

            <span>
                Durum
            </span>

            <strong>
                @Model.CurrentStatusDisplayName
            </strong>

            <span class="trainer-status-badge
                @(Model.CurrentStatus ==
                    PersonalTrainingRequestStatus.Pending
                        ? "is-pending"
                        : Model.CurrentStatus ==
                          PersonalTrainingRequestStatus.Scheduled
                            ? "is-scheduled"
                            : "is-neutral")">

                @Model.CurrentStatusDisplayName

            </span>

        </div>

    </header>


    <div asp-validation-summary="ModelOnly"
         class="trainer-form-validation"
         role="alert">
    </div>


    <div class="trainer-request-manage-grid">

        <section class="trainer-request-member-card">

            <div class="trainer-request-card-head">

                <div>

                    <span>
                        Üye
                    </span>

                    <h2>
                        @Model.MemberName
                    </h2>

                    <p>
                        @Model.MemberEmail
                    </p>

                </div>

                <span class="trainer-request-card-number"
                      aria-hidden="true">
                    01
                </span>

            </div>


            <div class="trainer-request-info-grid">

                <div class="trainer-request-info-item">

                    <span>
                        Tercih edilen gün
                    </span>

                    <strong>
                        @(Model.PreferredDate
                            .ToString("dd.MM.yyyy"))
                    </strong>

                </div>


                <div class="trainer-request-info-item">

                    <span>
                        Saat aralığı
                    </span>

                    <strong>
                        @Model.PreferredTimeWindow
                    </strong>

                </div>


                <div class="trainer-request-info-item is-wide">

                    <span>
                        Üyenin hedefi / notu
                    </span>

                    <div class="trainer-request-goal-note">

                        @if (
                            string.IsNullOrWhiteSpace(
                                Model.GoalNote))
                        {
                            <span class="trainer-request-muted">
                                Üye ek bir not paylaşmadı.
                            </span>
                        }
                        else
                        {
                            @Model.GoalNote
                        }

                    </div>

                </div>

            </div>

        </section>


        <section class="trainer-request-action-card">

            <div class="trainer-request-card-head">

                <div>

                    <span>
                        Talep yönetimi
                    </span>

                    <h2>
                        Randevu işlemleri
                    </h2>

                    <p>
                        Talebi planla veya mevcut
                        durum bilgisini görüntüle.
                    </p>

                </div>

                <span class="trainer-request-card-number"
                      aria-hidden="true">
                    02
                </span>

            </div>


            @if (Model.CanManage)
            {
                <form method="post"
                      class="trainer-request-manage-form">

                    <input type="hidden"
                           asp-for="Id" />


                    <div class="trainer-request-form-field">

                        <label asp-for="ScheduledAtLocal">
                        </label>

                        <input asp-for="ScheduledAtLocal"
                               asp-format="{0:yyyy-MM-ddTHH:mm}"
                               type="datetime-local" />

                        <span asp-validation-for="ScheduledAtLocal"
                              class="trainer-field-validation">
                        </span>

                        <small>
                            Talebi planlarken tarih ve saat
                            seçimi zorunludur.
                        </small>

                    </div>


                    <div class="trainer-request-form-field">

                        <label asp-for="TrainerNote">
                        </label>

                        <textarea asp-for="TrainerNote"
                                  rows="4"
                                  placeholder="Üyeye iletilecek kısa bir not yazabilirsin.">
                        </textarea>

                        <span asp-validation-for="TrainerNote"
                              class="trainer-field-validation">
                        </span>

                    </div>


                    <div class="trainer-request-actions">

                        <button type="submit"
                                asp-action="Schedule"
                                asp-route-id="@Model.Id"
                                class="trainer-request-submit">

                            <span>
                                Randevuyu Planla
                            </span>

                            <span aria-hidden="true">
                                →
                            </span>

                        </button>


                        <button type="submit"
                                asp-action="Reject"
                                asp-route-id="@Model.Id"
                                class="trainer-request-reject">

                            Talebi Reddet

                        </button>

                    </div>

                </form>
            }
            else
            {
                <div class="trainer-request-readonly">

                    <div>

                        <span>
                            Kesin randevu
                        </span>

                        <strong>

                            @if (
                                Model.ScheduledAtLocal
                                    is not null)
                            {
                                @(Model
                                    .ScheduledAtLocal
                                    .Value
                                    .ToString(
                                        "dd.MM.yyyy HH:mm"))
                            }
                            else
                            {
                                <span class="trainer-request-muted">
                                    —
                                </span>
                            }

                        </strong>

                    </div>


                    <div>

                        <span>
                            Eğitmen notu
                        </span>

                        <div>

                            @if (
                                string.IsNullOrWhiteSpace(
                                    Model.TrainerNote))
                            {
                                <span class="trainer-request-muted">
                                    Not eklenmedi.
                                </span>
                            }
                            else
                            {
                                @Model.TrainerNote
                            }

                        </div>

                    </div>

                </div>
            }

        </section>

    </div>


    <footer class="trainer-request-manage-footer">

        <span>
            Talep oluşturulma
        </span>

        <strong>
            @createdAtLocal.ToString(
                "dd.MM.yyyy HH:mm")
        </strong>

    </footer>

</section>

@section Scripts {

}