@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const categoryButtons = document.querySelectorAll(
                "[data-kitchen-category-filter]"
            );

            const tagButtons = document.querySelectorAll(
                "[data-kitchen-tag-filter]"
            );

            const menuCards = document.querySelectorAll(
                "[data-kitchen-category]"
            );

            const emptyState = document.querySelector(
                ".kitchen-filter-empty"
            );

            const searchInput = document.querySelector(
                "[data-kitchen-search]"
            );

            const clearButton = document.querySelector(
                "[data-kitchen-clear]"
            );

            const resultCount = document.querySelector(
                "[data-kitchen-result-count]"
            );

            const emptyTitle = document.querySelector(
                "[data-kitchen-empty-title]"
            );

            const emptyDescription = document.querySelector(
                "[data-kitchen-empty-description]"
            );

            if (!categoryButtons.length || !menuCards.length) {
                return;
            }

            let selectedCategory = "all";
            const selectedTags = new Set();

            const normalizeText = function (value) {
                return (value || "")
                    .toLocaleLowerCase("tr-TR")
                    .trim();
            };

            const applyFilters = function () {
                const query = normalizeText(searchInput?.value);
                let visibleCardCount = 0;

                menuCards.forEach(function (card) {
                    const cardCategory =
                        card.dataset.kitchenCategory;

                    const cardTags = normalizeText(
                        card.dataset.kitchenTags
                    )
                        .split(/[,;|]/)
                        .map(function (tag) {
                            return tag.trim();
                        })
                        .filter(Boolean);

                    const searchableText = normalizeText(
                        card.dataset.kitchenSearch
                    );

                    const matchesCategory =
                        selectedCategory === "all" ||
                        cardCategory === selectedCategory;

                    const matchesTags = Array.from(
                        selectedTags
                    ).every(function (tag) {
                        return cardTags.includes(tag);
                    });

                    const matchesSearch =
                        !query || searchableText.includes(query);

                    const shouldShow =
                        matchesCategory &&
                        matchesTags &&
                        matchesSearch;

                    card.hidden = !shouldShow;

                    if (shouldShow) {
                        visibleCardCount += 1;
                    }
                });

                if (resultCount) {
                    resultCount.textContent =
                        visibleCardCount.toString();
                }

                const hasActiveFilters =
                    selectedCategory !== "all" ||
                    selectedTags.size > 0 ||
                    Boolean(query);

                if (clearButton) {
                    clearButton.hidden = !hasActiveFilters;
                }

                if (emptyState) {
                    emptyState.hidden = visibleCardCount !== 0;
                }

                if (visibleCardCount === 0 && emptyTitle) {
                    emptyTitle.textContent = query
                        ? "Aramana uygun ürün bulunamadı."
                        : "Bu filtrelere uygun ürün bulunamadı.";
                }

                if (visibleCardCount === 0 && emptyDescription) {
                    emptyDescription.textContent = query
                        ? "Farklı bir ürün veya içerik adıyla tekrar arayabilirsin."
                        : "Filtrelerden birini kaldırarak diğer menü seçeneklerini inceleyebilirsin.";
                }
            };

            categoryButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    selectedCategory =
                        button.dataset.kitchenCategoryFilter;

                    categoryButtons.forEach(function (
                        filterButton
                    ) {
                        const isActive = filterButton === button;

                        filterButton.classList.toggle(
                            "active",
                            isActive
                        );

                        filterButton.setAttribute(
                            "aria-pressed",
                            isActive ? "true" : "false"
                        );
                    });

                    applyFilters();
                });
            });

            tagButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    const tag = normalizeText(
                        button.dataset.kitchenTagFilter
                    );

                    if (selectedTags.has(tag)) {
                        selectedTags.delete(tag);
                    } else {
                        selectedTags.add(tag);
                    }

                    const isActive = selectedTags.has(tag);

                    button.classList.toggle("active", isActive);
                    button.setAttribute(
                        "aria-pressed",
                        isActive ? "true" : "false"
                    );

                    applyFilters();
                });
            });

            searchInput?.addEventListener("input", applyFilters);

            clearButton?.addEventListener("click", function () {
                selectedCategory = "all";
                selectedTags.clear();

                if (searchInput) {
                    searchInput.value = "";
                }

                categoryButtons.forEach(function (button) {
                    const isAll =
                        button.dataset.kitchenCategoryFilter ===
                        "all";

                    button.classList.toggle("active", isAll);
                    button.setAttribute(
                        "aria-pressed",
                        isAll ? "true" : "false"
                    );
                });

                tagButtons.forEach(function (button) {
                    button.classList.remove("active");
                    button.setAttribute("aria-pressed", "false");
                });

                applyFilters();
            });

            applyFilters();
        });
    </script>
}
