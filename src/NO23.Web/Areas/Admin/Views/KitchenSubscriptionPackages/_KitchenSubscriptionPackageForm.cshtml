@model KitchenSubscriptionPackageFormViewModel

<form method="post" class="bg-white border rounded-3 p-4 text-dark admin-form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <section class="admin-form-section">
        <header>
            <span>01</span>
            <div>
                <h2>Paket bilgileri</h2>
                <p>Kitchen paketinin planını, süresini, üye panelindeki açıklamasını ve fiyatını belirle.</p>
            </div>
        </header>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Plan" class="form-label"></label>
                <select asp-for="Plan" asp-items="Html.GetEnumSelectList<KitchenSubscriptionPlan>()" class="form-select"></select>
                <span asp-validation-for="Plan" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" class="form-control" />
                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Days" class="form-label"></label>
                <input asp-for="Days" class="form-control" />
                <span asp-validation-for="Days" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="UnitPrice" class="form-label"></label>
                <input asp-for="UnitPrice" class="form-control" />
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <label class="form-check admin-form-toggle w-100 mb-0">
                    <input asp-for="IsActive" class="form-check-input" />
                    <span>
                        <strong>@Html.DisplayNameFor(model => model.IsActive)</strong>
                        <small>Aktif paketler üye Kitchen ekranında gösterilir.</small>
                    </span>
                </label>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>
    </section>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        <button type="submit" class="btn btn-dark">Kaydet</button>
    </div>
</form>
