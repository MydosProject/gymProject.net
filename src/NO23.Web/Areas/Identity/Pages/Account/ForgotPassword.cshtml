@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ForgotPasswordModel
@{
    ViewData["Title"] = "Parolamı Unuttum";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="no23-register-page">
    <div class="register-page-grid" aria-hidden="true"></div>
    <div class="register-page-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <div class="no23-register-shell">
            <aside class="register-intro-panel">
                <a class="register-back-link"
                   asp-page="./Login">
                    <span aria-hidden="true">←</span>
                    Üye girişine dön
                </a>

                <div class="register-intro-content">
                    <p class="register-kicker">NO23 Member Access</p>

                    <h1>
                        Hesabına yeniden
                        <span>erişim sağla.</span>
                    </h1>

                    <p class="register-intro-description">
                        Hesabında kullandığın e-posta adresini paylaş.
                        Parolanı güvenli biçimde yenilemen için gerekli adımları sana iletelim.
                    </p>

                    <ul class="register-benefits">
                        <li>
                            <span>01</span>

                            <div>
                                <strong>E-posta adresini gir</strong>
                                <small>NO23 hesabında kullandığın adresi yaz</small>
                            </div>
                        </li>

                        <li>
                            <span>02</span>

                            <div>
                                <strong>Bağlantını kontrol et</strong>
                                <small>Gelen kutunu ve gereksiz klasörünü incele</small>
                            </div>
                        </li>

                        <li>
                            <span>03</span>

                            <div>
                                <strong>Yeni parolanı belirle</strong>
                                <small>Güçlü ve yalnızca sana ait bir parola oluştur</small>
                            </div>
                        </li>
                    </ul>
                </div>

                <p class="register-intro-footer">
                    Train Better. Eat Better. Live Better.
                </p>
            </aside>

            <div class="register-form-panel d-flex flex-column justify-content-center">
                <div class="register-form-heading">
                    <div>
                        <p class="register-form-kicker">Hesap Kurtarma</p>
                        <h2>Parolanı yenile.</h2>
                    </div>

                    <span class="register-step">NO23</span>
                </div>

                <p class="register-form-description">
                    Sıfırlama bağlantısını gönderebilmemiz için hesabında kayıtlı
                    e-posta adresini gir.
                </p>

                <form method="post"
                      asp-antiforgery="true"
                      class="no23-register-form">
                    <div asp-validation-summary="ModelOnly"
                         class="register-validation-summary"
                         role="alert"></div>

                    <div class="no23-form-field">
                        <label asp-for="Input.Email">E-posta adresi</label>

                        <input asp-for="Input.Email"
                               class="form-control no23-form-control"
                               autocomplete="email"
                               placeholder="ornek@email.com" />

                        <span asp-validation-for="Input.Email"></span>
                    </div>

                    <button type="submit"
                            class="no23-register-submit">
                        <span>Sıfırlama bağlantısı gönder</span>
                        <span aria-hidden="true">→</span>
                    </button>

                    <p class="register-login-link">
                        Parolanı hatırladın mı?

                        <a asp-page="./Login">
                            Üye Girişi
                        </a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
