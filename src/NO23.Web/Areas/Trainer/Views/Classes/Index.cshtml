@model TrainerClassesIndexViewModel

@{
    ViewData["Title"] = "Derslerim";
}

<section class="trainer-classes-page">

    <header class="trainer-page-head">

        <div>

            <p class="trainer-page-eyebrow">
                Grup dersleri
            </p>

            <h1>
                Derslerim
            </h1>

            <p class="trainer-page-description">
                Grup derslerini ve birebir seanslarını birlikte takip et.
            </p>

        </div>

        <div class="trainer-page-count">

            <span>
                Toplam
            </span>

            <strong>
                @((Model.GroupClasses.Count + Model.PersonalClasses.Count).ToString("00"))
            </strong>

            <small>
                ders
            </small>

        </div>

    </header>


    <div class="trainer-class-panel">

        @if (Model.GroupClasses.Count == 0)
        {
            <div class="trainer-class-empty">

                <span aria-hidden="true">
                    01
                </span>

                <div>

                    <strong>
                        Henüz atanmış ders yok.
                    </strong>

                    <p>
                        Sana atanacak grup dersleri ve
                        yaklaşan seans bilgileri burada
                        görüntülenecek.
                    </p>

                </div>

            </div>
        }
        else
        {
            <div class="trainer-class-table-wrap">

                <table class="trainer-class-table">

                    <thead>
                        <tr>
                            <th>Ders</th>
                            <th>Seviye</th>
                            <th>Süre</th>
                            <th>Kontenjan</th>
                            <th>Yaklaşan Seans</th>
                            <th>Sonraki Ders</th>
                            <th>Durum</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var groupClass in Model.GroupClasses)
                    {
                        <tr>

                            <td data-label="Ders">

                                <strong class="trainer-class-name">
                                    @groupClass.Name
                                </strong>

                                <small class="trainer-class-muted">
                                    Ortalama
                                    @groupClass.AverageCaloriesBurned
                                    kcal
                                </small>

                            </td>


                            <td data-label="Seviye">

                                <span class="trainer-class-value">
                                    @groupClass.DifficultyLevel
                                </span>

                            </td>


                            <td data-label="Süre">

                                <span class="trainer-class-value">
                                    @groupClass.DurationMinutes dk
                                </span>

                            </td>


                            <td data-label="Kontenjan">

                                <span class="trainer-class-value">
                                    @groupClass.Capacity
                                </span>

                            </td>


                            <td data-label="Yaklaşan Seans">

                                <span class="trainer-class-session-count">
                                    @groupClass.UpcomingSessionCount
                                </span>

                            </td>


                            <td data-label="Sonraki Ders">

                                @if (
                                    groupClass.NextSessionAtUtc
                                        is not null)
                                {
                                    <strong class="trainer-class-next-date">
                                        @(groupClass
                                            .NextSessionAtUtc
                                            .Value
                                            .ToLocalTime()
                                            .ToString(
                                                "dd.MM.yyyy HH:mm"))
                                    </strong>
                                }
                                else
                                {
                                    <span class="trainer-class-muted">
                                        —
                                    </span>
                                }

                            </td>


                            <td data-label="Durum">

                                @if (groupClass.IsActive)
                                {
                                    <span class="trainer-status-badge is-scheduled">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="trainer-status-badge is-neutral">
                                        Pasif
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }

    </div>

    <div class="trainer-class-panel mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">Birebir derslerim</h2>
            <a asp-area="Trainer" asp-controller="Calendar" asp-action="Index">Takvimde yönet →</a>
        </div>
        @if (Model.PersonalClasses.Count == 0)
        {
            <p class="mb-0">Son 30 günde veya ileride planlanmış birebir ders bulunmuyor.</p>
        }
        else
        {
            <div class="trainer-class-table-wrap">
                <table class="trainer-class-table">
                    <thead><tr><th>Üye</th><th>Tarih ve saat</th><th>Süre</th><th>Durum</th></tr></thead>
                    <tbody>
                        @foreach (var session in Model.PersonalClasses)
                        {
                            <tr>
                                <td data-label="Üye"><strong>@session.MemberName</strong></td>
                                <td data-label="Tarih ve saat">@NO23.Web.Services.ClubTime.ToLocal(session.StartsAtUtc).ToString("dd.MM.yyyy HH:mm")</td>
                                <td data-label="Süre">@session.DurationMinutes dk</td>
                                <td data-label="Durum">@session.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
