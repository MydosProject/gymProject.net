@model MemberDeleteViewModel
@{
    ViewData["Title"] = "Üyeyi Sil";
}

<section class="admin-page">
    <div class="container" style="max-width:760px">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">KULÜP / ÜYE YÖNETİMİ</p>
                <h1>Üyeyi sil</h1>
                <p class="admin-page-description">Bu işlem üye profilini ve giriş hesabını kalıcı olarak kaldırır.</p>
            </div>
        </header>

        <div class="admin-form-card">
            <h2>@(string.IsNullOrWhiteSpace(Model.FullName) ? "İsimsiz üye" : Model.FullName)</h2>
            <p class="text-muted">@Model.Email · @Model.PackageName</p>

            @if (Model.HasProtectedHistory)
            {
                <div class="alert alert-warning">
                    Bu üye kalıcı olarak silinemez. Korunması gereken
                    @Model.OrderCount sipariş, @Model.KitchenSubscriptionCount mutfak aboneliği ve
                    @Model.PersonalTrainingSessionCount birebir ders kaydı bulunuyor.
                </div>
            }
            else
            {
                <div class="alert alert-danger">Bu işlem geri alınamaz. Üyenin giriş hesabı da silinecektir.</div>
            }

            <div class="d-flex justify-content-end gap-2">
                <a class="btn btn-outline-secondary" asp-action="Index">Vazgeç</a>
                @if (!Model.HasProtectedHistory)
                {
                    <form method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button class="btn btn-danger" type="submit">Üyeyi kalıcı olarak sil</button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
