@model IReadOnlyList<KitchenAllergenListItemViewModel>
@{ ViewData["Title"] = "Alerjenler"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><p class="text-uppercase small text-muted mb-1">Kitchen / Güvenlik</p><h1 class="h3 mb-0">Alerjenler</h1></div>
    <a asp-action="Create" class="btn btn-dark">Yeni Alerjen</a>
</div>
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="table-responsive bg-white border rounded-3">
    <table class="table align-middle mb-0">
        <thead><tr><th>Sıra</th><th>Alerjen</th><th>Açıklama</th><th>Kullanım</th><th>Durum</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr><td>@item.DisplayOrder</td><td><strong>@item.Name</strong></td><td>@item.Description</td>
                <td>@item.MenuItemCount öğün · @item.MemberCount üye</td>
                <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Aktif" : "Pasif")</span></td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">Sil</button></form></td></tr>
        }
        </tbody>
    </table>
</div>
