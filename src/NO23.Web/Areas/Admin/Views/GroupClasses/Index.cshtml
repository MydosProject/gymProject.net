@model IReadOnlyList<GroupClassListItemViewModel>
@{
    ViewData["Title"] = "Grup Dersleri";
    var activeCount = Model.Count(groupClass => groupClass.IsActive);
    var totalSessionCount = Model.Sum(groupClass => groupClass.SessionCount);
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">NO23 CLUB / DERS YÖNETİMİ</p>
                <h1>Grup dersleri</h1>
                <p class="admin-page-description">Ders içeriklerini, eğitmenleri, performans hedeflerini ve program görünürlüğünü yönet.</p>
            </div>
            <div class="admin-page-actions">
                <a class="btn btn-outline-dark" asp-area="Admin" asp-controller="ClassSessions" asp-action="Index">Ders programı</a>
                <a class="btn btn-dark" asp-action="Create">+ Yeni ders</a>
            </div>
        </header>

        <div class="admin-metrics">
            <article><span>Grup dersi</span><strong>@Model.Count</strong><small>Toplam ders</small></article>
            <article><span>Aktif ders</span><strong>@activeCount</strong><small>Public sitede görünür</small></article>
            <article><span>Planlanan seans</span><strong>@totalSessionCount</strong><small>Tüm program</small></article>
        </div>

        <div class="table-responsive admin-table-card admin-class-table">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Ders</th>
                        <th>Eğitmen</th>
                        <th>Süre</th>
                        <th>Zorluk</th>
                        <th>Enerji</th>
                        <th>Kapasite</th>
                        <th>Program</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="10"><div class="admin-empty-row">Henüz grup dersi eklenmedi.</div></td></tr>
                    }
                    else
                    {
                        @for (var index = 0; index < Model.Count; index++)
                        {
                            var groupClass = Model[index];
                            <tr>
                                <td><span class="admin-order-no">@((index + 1).ToString("00"))</span></td>
                                <td><strong class="admin-class-name">@groupClass.Name</strong></td>
                                <td>@groupClass.TrainerName</td>
                                <td><span class="admin-code">@groupClass.DurationMinutes dk</span></td>
                                <td>@groupClass.DifficultyLevel</td>
                                <td>@groupClass.AverageCaloriesBurned kcal</td>
                                <td>@groupClass.Capacity kişi</td>
                                <td>
                                    <strong>@groupClass.SessionCount</strong>
                                    <span class="admin-cell-note">seans</span>
                                </td>
                                <td><span class="badge @(groupClass.IsActive ? "text-bg-success" : "text-bg-secondary")">@(groupClass.IsActive ? "Aktif" : "Pasif")</span></td>
                                <td class="text-end"><a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@groupClass.Id">Düzenle</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
