@model CommunityEventFormViewModel
@{
    ViewData["Title"] = "Yeni Etkinlik";
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head admin-form-head">
            <div>
                <a asp-action="Index" class="admin-back-link">← Etkinliklere dön</a>
                <p class="admin-eyebrow">Topluluk / Etkinlikler</p>
                <h1>Yeni etkinlik</h1>
                <p class="admin-page-description">Tarih, konum ve katılım detaylarıyla yeni bir topluluk etkinliği oluştur.</p>
            </div>
        </header>
        <partial name="_CommunityEventForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
