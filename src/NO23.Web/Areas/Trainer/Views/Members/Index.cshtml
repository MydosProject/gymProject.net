@using NO23.Web.Services
@model TrainerMembersViewModel
@{
    ViewData["Title"] = "Üyelerim";
}
<section class="admin-page">
    <header class="admin-page-head trainer-page-head"><div><h1>Üyelerim</h1><p>Sana atanmış @Model.TotalCount üye · paket, kalan seans ve gelişim takibi.</p></div></header>
    <form method="get" class="d-flex flex-wrap gap-2 mb-4">
        <label for="member-list-query" class="visually-hidden">Üye ara</label>
        <input id="member-list-query" name="query" value="@Model.Query" class="form-control" style="max-width:30rem" maxlength="80" placeholder="Ad soyad, telefon veya #üye no" />
        <button class="btn btn-dark" type="submit">Ara</button>
        @if (!string.IsNullOrEmpty(Model.Query)) { <a asp-action="Index" class="btn btn-outline-light">Tüm üyelerim</a> }
    </form>
    <div class="table-responsive">
        <table class="table table-dark align-middle">
            <thead><tr><th>Üye</th><th>İletişim</th><th>Paket</th><th>Kalan seans</th><th>Paket bitişi</th><th>İşlemler</th></tr></thead>
            <tbody>
            @if (Model.Members.Count == 0) { <tr><td colspan="6">Bu aramaya uygun atanmış üye bulunamadı.</td></tr> }
            @foreach (var member in Model.Members)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@member.Id">@member.ApplicationUser.FirstName @member.ApplicationUser.LastName</a><br /><small>#@member.Id</small></td>
                    <td>@(member.ApplicationUser.PhoneNumber ?? "Telefon kayıtlı değil")<br /><small>@member.ApplicationUser.Email</small></td>
                    <td>@(member.ServicePackageVariant?.ServicePackage.Name ?? member.MembershipPackage.Name)<br /><small>@member.ServicePackageVariant?.Name</small></td>
                    <td>@if (Model.Credits.TryGetValue(member.Id, out var credits)) { <partial name="/Views/Shared/_LessonCreditCompact.cshtml" model="credits" /> } else { <strong>@member.RemainingClassCredits</strong> }</td>
                    <td>@(member.MembershipEndsAtUtc.HasValue ? ClubTime.ToLocal(member.MembershipEndsAtUtc.Value).ToString("dd.MM.yyyy") : "—")</td>
                    <td><div class="d-flex flex-wrap gap-2"><a asp-action="Details" asp-route-id="@member.Id">Detay</a><a asp-controller="Calendar" asp-route-memberId="@member.Id">Takvim</a><a asp-controller="Measurements" asp-route-memberId="@member.Id">Ölçümler</a></div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <nav class="d-flex align-items-center gap-3 mt-3" aria-label="Üye sayfaları">
        @if (Model.Page > 1) { <a asp-route-query="@Model.Query" asp-route-page="@(Model.Page - 1)">← Önceki</a> }
        <span>Sayfa @Model.Page</span>
        @if (Model.Page * TrainerMembersViewModel.PageSize < Model.TotalCount) { <a asp-route-query="@Model.Query" asp-route-page="@(Model.Page + 1)">Sonraki →</a> }
    </nav>
</section>
