@model CommunityChallengeFormViewModel
@{
    ViewData["Title"] = "Yeni Challenge";
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head admin-form-head">
            <div>
                <a asp-action="Index" class="admin-back-link">← Challenge'lara dön</a>
                <p class="admin-eyebrow">Topluluk / Challenge</p>
                <h1>Yeni challenge</h1>
                <p class="admin-page-description">Üyeleri harekete geçirecek hedef, tarih ve ödül detaylarını tanımla.</p>
            </div>
        </header>
        <partial name="_CommunityChallengeForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
