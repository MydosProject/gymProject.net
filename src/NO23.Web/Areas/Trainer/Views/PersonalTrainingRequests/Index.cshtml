@model IReadOnlyList<
    TrainerPersonalTrainingRequestListItemViewModel>

@{
    ViewData["Title"] = "Birebir Talepler";
}

<section class="trainer-requests-page">

    @if (
        TempData["TrainerStatusMessage"]
            is string statusMessage)
    {
        <div class="trainer-status-message">
            @statusMessage
        </div>
    }

    <header class="trainer-page-head">

        <div>

            <p class="trainer-page-eyebrow">
                Birebir antrenman
            </p>

            <h1>
                Birebir Talepler
            </h1>

            <p class="trainer-page-description">
                Sana gönderilen birebir antrenman
                taleplerini ve planlanmış
                randevularını görüntüle.
            </p>

        </div>

        <div class="trainer-page-count">

            <span>
                Toplam
            </span>

            <strong>
                @(Model.Count.ToString("00"))
            </strong>

            <small>
                talep
            </small>

        </div>

    </header>


    <div class="trainer-request-panel">

        @if (Model.Count == 0)
        {
            <div class="trainer-request-empty">

                <span aria-hidden="true">
                    01
                </span>

                <div>

                    <strong>
                        Henüz birebir talep yok.
                    </strong>

                    <p>
                        Sana gönderilen yeni birebir
                        antrenman talepleri burada
                        görüntülenecek.
                    </p>

                </div>

            </div>
        }
        else
        {
            <div class="trainer-request-table-wrap">

                <table class="trainer-request-table">

                    <thead>
                        <tr>
                            <th>Üye</th>
                            <th>Tercih</th>
                            <th>Hedef / Not</th>
                            <th>Durum</th>
                            <th>Kesin Randevu</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var request in Model)
                    {
                        <tr>

                            <td data-label="Üye">

                                <strong class="trainer-request-name">
                                    @request.MemberName
                                </strong>

                                <small class="trainer-request-muted">
                                    @request.MemberEmail
                                </small>

                            </td>


                            <td data-label="Tercih">

                                <strong>
                                    @(request.PreferredDate
                                        .ToString("dd.MM.yyyy"))
                                </strong>

                                <small class="trainer-request-muted">
                                    @request.PreferredTimeWindow
                                </small>

                            </td>


                            <td data-label="Hedef / Not">

                                <div class="trainer-request-note">

                                    @if (
                                        string.IsNullOrWhiteSpace(
                                            request.GoalNote))
                                    {
                                        <span class="trainer-request-muted">
                                            Not belirtilmedi.
                                        </span>
                                    }
                                    else
                                    {
                                        @request.GoalNote
                                    }

                                </div>

                            </td>


                            <td data-label="Durum">

                                <span class="trainer-status-badge
                                    @(request.Status ==
                                        PersonalTrainingRequestStatus.Pending
                                            ? "is-pending"
                                            : request.Status ==
                                              PersonalTrainingRequestStatus.Scheduled
                                                ? "is-scheduled"
                                                : "is-neutral")">

                                    @request.StatusDisplayName

                                </span>

                            </td>


                            <td data-label="Kesin Randevu">

                                @if (
                                    request.ScheduledAtUtc
                                        is not null)
                                {
                                    <strong>
                                        @(request
                                            .ScheduledAtUtc
                                            .Value
                                            .ToLocalTime()
                                            .ToString(
                                                "dd.MM.yyyy HH:mm"))
                                    </strong>
                                }
                                else
                                {
                                    <span class="trainer-request-muted">
                                        —
                                    </span>
                                }

                            </td>


                            <td data-label="İşlem">

                                @if (
                                    request.Status ==
                                    PersonalTrainingRequestStatus.Pending)
                                {
                                    <a class="trainer-request-action is-primary"
                                       asp-action="Manage"
                                       asp-route-id="@request.Id">

                                        Yönet

                                        <span aria-hidden="true">
                                            →
                                        </span>

                                    </a>
                                }
                                else
                                {
                                    <a class="trainer-request-action"
                                       asp-action="Manage"
                                       asp-route-id="@request.Id">

                                        Detay

                                        <span aria-hidden="true">
                                            →
                                        </span>

                                    </a>
                                }

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }

    </div>

</section>