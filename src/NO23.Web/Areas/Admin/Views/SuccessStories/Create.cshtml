@model SuccessStoryFormViewModel
@{
    ViewData["Title"] = "Yeni Başarı Hikâyesi";
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head admin-form-head">
            <div>
                <a asp-action="Index" class="admin-back-link">← Hikâyelere dön</a>
                <p class="admin-eyebrow">İçerik / Başarı Hikâyeleri</p>
                <h1>Yeni başarı hikâyesi</h1>
                <p class="admin-page-description">Üye dönüşümünü, sonucu ve görsel içerikleriyle birlikte yayınla.</p>
            </div>
        </header>
        <partial name="_SuccessStoryForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
