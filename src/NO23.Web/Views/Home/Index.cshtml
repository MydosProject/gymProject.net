@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const video = document.querySelector("[data-hero-video]");
            const toggle = document.querySelector("[data-hero-video-toggle]");

            if (!video || !toggle) {
                return;
            }

            const icon = toggle.querySelector(".hero-video-toggle-icon");
            const label = toggle.querySelector("[data-hero-video-label]");

            const playVideo = () => {
                video.defaultMuted = true;
                video.muted = true;
                video.playsInline = true;

                video.play().catch(updateToggle);
            };

            const updateToggle = () => {
                const isPaused = video.paused;

                toggle.setAttribute("aria-pressed", isPaused ? "true" : "false");
                toggle.setAttribute(
                    "aria-label",
                    isPaused
                        ? "Arka plan videosunu oynat"
                        : "Arka plan videosunu durdur"
                );

                icon.textContent = isPaused ? "▶" : "Ⅱ";
                label.textContent = isPaused ? "Oynat" : "Durdur";
            };

            toggle.addEventListener("click", () => {
                if (video.paused) {
                    playVideo();
                    return;
                }

                video.pause();
            });

            video.addEventListener("play", updateToggle);
            video.addEventListener("pause", updateToggle);
            video.addEventListener(
                "canplay",
                () => {
                    if (video.paused) {
                        playVideo();
                    }
                },
                { once: true }
            );

            video.load();
            playVideo();

            updateToggle();
        });
    </script>
}
