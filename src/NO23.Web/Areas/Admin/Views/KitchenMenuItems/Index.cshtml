@model IReadOnlyList<KitchenMenuItemListItemViewModel>
@{
    ViewData["Title"] = "Kitchen Menü";
}

<section class="py-5">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">Admin</p>
                <h1 class="h3 mb-0">Kitchen Menü</h1>
            </div>

            <a class="btn btn-dark" asp-action="Create">Yeni Ürün</a>
        </div>

        <div class="table-responsive bg-white border rounded-3">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Ürün</th>
                        <th>Kategori</th>
                        <th>Kalori</th>
                        <th>Makro</th>
                        <th>Etiket</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DisplayOrder</td>
                            <td><strong>@item.Name</strong></td>
                            <td>@item.Category</td>
                            <td>@item.Calories</td>
                            <td>P @item.ProteinGrams / K @item.CarbohydrateGrams / Y @item.FatGrams</td>
                            <td>@(item.Tags ?? "-")</td>
                            <td>
                                <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(item.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
