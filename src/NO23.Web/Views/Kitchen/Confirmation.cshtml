@using NO23.Web.Domain.Enums
@model NO23.Web.ViewModels.GuestOrders.GuestOrderConfirmationViewModel

@{
    var isPaid = Model.PaymentStatus == PaymentStatus.Paid;
    var isFailed = Model.PaymentStatus == PaymentStatus.Failed;
    var isRefunded = Model.PaymentStatus == PaymentStatus.Refunded;
    var isExpired = Model.PaymentStatus == PaymentStatus.Expired;

    ViewData["Title"] = isPaid
        ? "Ödeme Başarılı"
        : isFailed
            ? "Ödeme Başarısız"
            : isRefunded
                ? "Ödeme İade Edildi"
                : isExpired
                    ? "Ödeme Süresi Doldu"
                    : "Ödeme Bekliyor";
}

<div class="public-confirmation-page public-confirmation-kitchen">
    <div class="public-order-grid-bg" aria-hidden="true"></div>

    <div class="container position-relative">
        <section class="public-confirmation-layout">

            <div class="public-confirmation-copy">

                @if (isPaid)
                {
                    <p class="public-order-kicker">
                        NO23 / Payment Successful
                    </p>

                    <span class="public-confirmation-status">
                        Ödeme Başarılı
                    </span>

                    <h1>
                        Öğünün<br />
                        <em>hazırlanıyor.</em>
                    </h1>

                    <p>
                        Ödemen başarıyla alındı ve NO23 Kitchen siparişin onaylandı.
                        Teslimat takibi için sipariş numaranı saklayabilirsin.
                    </p>
                }
                else if (isFailed)
                {
                    <p class="public-order-kicker">
                        NO23 / Payment Failed
                    </p>

                    <span class="public-confirmation-status">
                        Ödeme Başarısız
                    </span>

                    <h1>
                        Ödeme<br />
                        <em>tamamlanamadı.</em>
                    </h1>

                    <p>
                        Ödeme işlemi tamamlanamadığı için Kitchen siparişin
                        onaylanmadı. Kitchen'a dönerek yeniden sipariş
                        oluşturabilirsin.
                    </p>
                }
                else if (isRefunded)
                {
                    <p class="public-order-kicker">
                        NO23 / Payment Refunded
                    </p>

                    <span class="public-confirmation-status">
                        Ödeme İade Edildi
                    </span>

                    <h1>
                        Ödemen<br />
                        <em>iade edildi.</em>
                    </h1>

                    <p>
                        Bu sipariş için ödeme iade durumunda.
                        Sipariş numaranı referans olarak saklayabilirsin.
                    </p>
                }
                else if (isExpired)
                {
                    <p class="public-order-kicker">
                        NO23 / Payment Expired
                    </p>

                    <span class="public-confirmation-status">
                        Ödeme Süresi Doldu
                    </span>

                    <h1>
                        Ödeme süresi<br />
                        <em>doldu.</em>
                    </h1>

                    <p>
                        Ödeme belirtilen süre içinde tamamlanmadığı için
                        sipariş iptal edildi. Yeniden sipariş oluşturabilirsin.
                    </p>
                }

                <a class="public-order-back"
                   asp-area=""
                   asp-controller="Kitchen"
                   asp-action="Index">
                    Kitchen'a Dön <span aria-hidden="true">↗</span>
                </a>
            </div>

            <article class="public-confirmation-receipt">
                <div class="public-confirmation-number">
                    <span>Sipariş Numarası</span>
                    <strong>@Model.OrderNumber</strong>
                </div>

                <dl>
                    <div>
                        <dt>Ürün</dt>
                        <dd>@Model.ProductName</dd>
                    </div>

                    <div>
                        <dt>Adet</dt>
                        <dd>@Model.Quantity</dd>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.RemovedIngredientNames))
                    {
                        <div>
                            <dt>Çıkarılacak</dt>
                            <dd>@Model.RemovedIngredientNames</dd>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.AddedIngredientNames))
                    {
                        <div>
                            <dt>Ekstra</dt>
                            <dd>@Model.AddedIngredientNames</dd>
                        </div>
                    }

                    <div>
                        <dt>Toplam</dt>
                        <dd class="public-confirmation-total">
                            @Model.Total.ToString("C0")
                        </dd>
                    </div>

                    <div>
                        <dt>Teslimat</dt>
                        <dd>
                            @Model.DeliveryMethodText<br />
                            @Model.DeliveryDate.ToString("dd.MM.yyyy")
                            /
                            @Model.DeliveryTimeSlot
                        </dd>
                    </div>

                    <div>
                        <dt>Ödeme</dt>
                        <dd>@Model.PaymentStatusText</dd>
                    </div>
                </dl>

                <footer>
                    <span>NO23 Kitchen</span>
                    <strong>23</strong>
                </footer>
            </article>

        </section>
    </div>
</div>
