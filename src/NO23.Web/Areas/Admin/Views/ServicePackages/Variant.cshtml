@model ServicePackageVariantFormViewModel
@{ViewData["Title"]="Paket Varyantı";}
<section class="admin-page"><div class="container"><header class="admin-page-head admin-form-head"><div><a asp-action="Edit" asp-route-id="@Model.ServicePackageId" class="admin-back-link">← @Model.PackageName paketine dön</a><p class="admin-eyebrow">Paket Varyantı</p><h1>@(Model.Id>0?"Varyantı düzenle":"Yeni varyant")</h1></div></header>
<form method="post" asp-action="@(Model.Id>0?"EditVariant":"CreateVariant")" asp-route-id="@(Model.Id>0?Model.Id:null)" class="bg-white border rounded-3 p-4 text-dark admin-form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="ServicePackageId"/>
<div class="row g-3"><div class="col-md-5"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/></div><div class="col-md-4"><label asp-for="BillingType" class="form-label"></label><select asp-for="BillingType" asp-items="Html.GetEnumSelectList<ServicePackageBillingType>()" class="form-select"></select></div><div class="col-md-3"><label asp-for="DisplayOrder" class="form-label"></label><input asp-for="DisplayOrder" class="form-control"/></div>
<div class="col-md-3"><label asp-for="DurationMonths" class="form-label"></label><input asp-for="DurationMonths" class="form-control"/></div><div class="col-md-3"><label asp-for="DurationDays" class="form-label"></label><input asp-for="DurationDays" class="form-control"/></div><div class="col-md-3"><label asp-for="MonthlyPrice" class="form-label"></label><input asp-for="MonthlyPrice" class="form-control"/></div><div class="col-md-3"><label asp-for="TotalPrice" class="form-label"></label><input asp-for="TotalPrice" class="form-control"/></div>
<div class="col-md"><label asp-for="PersonalTrainingSessionCount" class="form-label"></label><input asp-for="PersonalTrainingSessionCount" class="form-control"/></div><div class="col-md"><label asp-for="ReformerClassCreditCount" class="form-label"></label><input asp-for="ReformerClassCreditCount" class="form-control"/></div><div class="col-md"><label asp-for="PerformanceClassCreditCount" class="form-label"></label><input asp-for="PerformanceClassCreditCount" class="form-control"/></div><div class="col-md"><label asp-for="GroupClassCreditCount" class="form-label"></label><input asp-for="GroupClassCreditCount" class="form-control"/></div><div class="col-md"><label asp-for="KidsClassCreditCount" class="form-label"></label><input asp-for="KidsClassCreditCount" class="form-control"/></div>
</div><div class="admin-feature-grid mt-4"><label class="form-check admin-feature-option"><input asp-for="IncludesGymAccess" class="form-check-input"/><span>Salon erişimi</span></label><label class="form-check admin-feature-option"><input asp-for="IsRecommended" class="form-check-input"/><span>Önerilen varyant</span></label><label class="form-check admin-feature-option"><input asp-for="IsActive" class="form-check-input"/><span>Aktif</span></label></div><div class="d-flex justify-content-end mt-4"><button class="btn btn-dark">Kaydet</button></div></form>
</div></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
