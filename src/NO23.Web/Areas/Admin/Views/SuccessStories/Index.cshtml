@model IReadOnlyList<SuccessStoryListItemViewModel>
@{
    ViewData["Title"] = "Başarı Hikâyeleri";
    var publishedCount = Model.Count(item => item.PublishedAtUtc.HasValue);
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">İÇERİK / ÜYE DÖNÜŞÜMLERİ</p>
                <h1>Başarı hikâyeleri</h1>
                <p class="admin-page-description">Üye gelişimlerini, sonuç metriklerini ve yayın durumunu yönet.</p>
            </div>

            <a class="btn btn-dark"
               asp-action="Create">
                + Yeni hikâye
            </a>
        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">
                @successMessage
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }

        <div class="admin-metrics admin-metrics-two">
            <article>
                <span>Toplam hikâye</span>
                <strong>@Model.Count</strong>
                <small>Üye dönüşümü</small>
            </article>

            <article>
                <span>Yayın tarihli</span>
                <strong>@publishedCount</strong>
                <small>Planlanmış / yayında</small>
            </article>
        </div>

        <div class="table-responsive admin-table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Üye</th>
                        <th>Hikâye</th>
                        <th>Sonuç</th>
                        <th>Durum</th>
                        <th>Yayın tarihi</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="admin-empty-row">
                                    Henüz başarı hikâyesi eklenmedi.
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td data-label="Üye">
                                    <strong>@item.MemberName</strong>
                                </td>

                                <td data-label="Hikâye">
                                    @item.Title
                                </td>

                                <td data-label="Sonuç">
                                    @(item.AchievementMetric ?? "-")
                                </td>

                                <td data-label="Durum">
                                    <span class="admin-status">
                                        @item.Status
                                    </span>
                                </td>

                                <td data-label="Yayın tarihi">
                                    @(item.PublishedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy") ?? "-")
                                </td>

                                <td class="text-end"
                                    data-label="İşlem">
                                    <a class="btn btn-sm btn-outline-dark"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id">
                                        Düzenle
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>