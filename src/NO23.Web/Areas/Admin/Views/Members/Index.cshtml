@model IReadOnlyList<MemberListItemViewModel>
@{
    ViewData["Title"] = "Üyeler";
    var packageCount = Model
        .Select(member => member.PackageName)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
    var utcNow = DateTime.UtcNow;
    var newThisMonthCount = Model.Count(member =>
        member.CreatedAtUtc.Year == utcNow.Year &&
        member.CreatedAtUtc.Month == utcNow.Month);
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">KULÜP / ÜYE YÖNETİMİ</p>
                <h1>Üyeler</h1>
                <p class="admin-page-description">
                    Üye profillerini, paket dağılımını, hedefleri ve kalan ders haklarını tek ekrandan takip et.
                </p>
            </div>

            <a class="btn btn-outline-dark"
               asp-area="Admin"
               asp-controller="MembershipPackages"
               asp-action="Index">
                Paketleri Yönet
            </a>
        </header>

        <div class="admin-metrics">
            <article>
                <span>Toplam üye</span>
                <strong>@Model.Count</strong>
                <small>Kayıtlı üye profili</small>
            </article>
            <article>
                <span>Aktif paket türü</span>
                <strong>@packageCount</strong>
                <small>Üyeler tarafından kullanılan</small>
            </article>
            <article>
                <span>Bu ay katılan</span>
                <strong>@newThisMonthCount</strong>
                <small>Yeni üye kaydı</small>
            </article>
        </div>

        <div class="table-responsive admin-table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Üye</th>
                        <th>İletişim</th>
                        <th>Paket</th>
                        <th>Hedef</th>
                        <th>Kalan Ders</th>
                        <th>Kayıt</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6">
                                <div class="admin-empty-row">Henüz kayıtlı üye bulunmuyor.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var member in Model)
                        {
                            <tr>
                                <td data-label="Üye">
                                    <strong>@(string.IsNullOrWhiteSpace(member.FullName) ? "İsimsiz üye" : member.FullName)</strong>
                                    <small class="admin-cell-note">@member.Email</small>
                                </td>
                                <td data-label="İletişim">@(string.IsNullOrWhiteSpace(member.PhoneNumber) ? "-" : member.PhoneNumber)</td>
                                <td data-label="Paket"><span class="admin-status">@member.PackageName</span></td>
                                <td data-label="Hedef">@(string.IsNullOrWhiteSpace(member.FitnessGoal) ? "-" : member.FitnessGoal)</td>
                                <td data-label="Kalan ders">
                                    <strong>@(member.RemainingClassCredits == 0 ? "Sınırsız" : member.RemainingClassCredits)</strong>
                                    <small class="admin-cell-note">Ders hakkı</small>
                                </td>
                                <td data-label="Kayıt">
                                    <strong>@member.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")</strong>
                                    <small class="admin-cell-note">Kayıt tarihi</small>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
