@using NO23.Web.Services
@using NO23.Web.Domain.Enums
@using NO23.Web.Extensions
@model NO23.Web.ViewModels.Admin.MemberCreditsViewModel
@{ ViewData["Title"] = "Üye ders hakları"; var summary = Model.Summary; }
<section class="admin-page"><div class="container">
    <header class="admin-page-head"><div><h1>Üye ders hakları</h1><p>@Model.MemberName · Üye #@summary.MemberId</p></div><a asp-action="Index" class="btn btn-outline-dark">Üyelere dön</a></header>
    @foreach (var key in new[] { "SuccessMessage", "ErrorMessage" })
    { if (TempData[key] is string message) { <p class="alert @(key == "SuccessMessage" ? "alert-success" : "alert-danger")" role="status">@message</p> } }
    <partial name="/Views/Shared/_LessonCreditSummary.cshtml" model="summary" />
    @if (!summary.HasCategoryAccounts)
    {
        <details class="admin-form-card"><summary>Kategori dağılımını doğrula ve ayrı hesaplara geçir</summary>
        <p>Önce geçmişi inceleyin. Bu işlem yalnız doğruladığınız dağılımı kaydeder; geçmiş bakiye farkını gizlice düzeltmez. Grup derslerinin hak kategorilerini de kontrol edin.</p>
        <form asp-action="InitializeCategories" method="post" data-submit-once>
            <input type="hidden" name="MemberId" value="@summary.MemberId" /><input type="hidden" name="ExpectedBalance" value="@Model.Migration.ExpectedBalance" />
            <label>Paket başlangıcı<input name="StartsOn" type="date" value="@Model.Migration.StartsOn?.ToString("yyyy-MM-dd")" required class="form-control" /></label>
            @for (var i = 0; i < Model.Migration.Balances.Count; i++) { var row = Model.Migration.Balances[i]; <fieldset><legend class="h6">@row.Category.GetDisplayName()</legend><input type="hidden" name="Balances[@i].Category" value="@row.Category" /><label>Tanımlanan toplam hak<input name="Balances[@i].Granted" type="number" min="0" max="100000" value="@row.Granted" class="form-control" /></label><label>Kayıtlı kalan bakiye (grupta ayrılmış hak hariç)<input name="Balances[@i].Remaining" type="number" min="0" max="100000" value="@row.Remaining" class="form-control" /></label></fieldset> }
            <label>Kontrol / düzeltme gerekçesi<textarea name="Reason" required minlength="5" maxlength="400" class="form-control"></textarea></label>
            <label><input name="Confirmed" type="checkbox" value="true" required /> Paket tanımı, geçmiş ve dağılımı kontrol ettim.</label><button class="btn btn-dark">Kategori hesaplarını oluştur</button>
        </form></details>
    }
    @if (summary.HasCategoryAccounts)
    {
        <section class="admin-form-card"><h2 class="h5">Hak düzeltme</h2>
        <p>Telafi veya hediye için kategoriye hak ekleyin ya da çıkarın; paket toplamı da buna göre değişir. Gerekirse aylık sınırı değiştirin. Kalan bakiye hatalıysa "Hatalı kaydı düzelt"i işaretleyin: paket toplamı değişmez, yalnız kategoride görünen kayıt farkı kadar düzeltme yapılır. Planlı derslere ayrılmış haklar çıkarılamaz. Her düzeltme gerekçesiyle hak hareketlerine yazılır.</p>
        <form asp-action="AdjustCredits" method="post" data-submit-once><input type="hidden" name="MemberId" value="@summary.MemberId" /><input type="hidden" name="OperationId" value="@Guid.NewGuid()" />
            <label>Kategori<select name="Category" class="form-select" required>@foreach (var row in summary.Categories) { var gap = row.Granted + row.Converted - row.Completed - row.Remaining; <option value="@row.Category">@row.Category.GetDisplayName() · kalan @row.Remaining · boş @row.Available@(row.MonthlyLimit.HasValue ? $" · aylık sınır {row.MonthlyLimit}" : "")@(gap != 0 ? $" · kayıt farkı {gap:+#;-#}" : "")</option> }</select></label>
            <label>Hak değişimi (+ ekle / − çıkar)<input name="Delta" type="number" min="-1000" max="1000" value="0" required class="form-control" /></label>
            <label><input name="FixesRecord" type="checkbox" value="true" /> Hatalı kaydı düzelt (paket toplamı değişmez)</label>
            <label><input name="ChangeMonthlyLimit" type="checkbox" value="true" /> Aylık sınırı değiştir</label>
            <label>Yeni aylık sınır (boş bırakılırsa sınır kalkar)<input name="MonthlyLimit" type="number" min="0" max="1000" class="form-control" /></label>
            <label>Gerekçe<input name="Reason" minlength="5" maxlength="300" required class="form-control" /></label><button class="btn btn-dark">Düzeltmeyi kaydet</button>
        </form></section>
        <section class="admin-form-card"><h2 class="h5">Kurala bağlı hak dönüşümü</h2>
        <form asp-action="ConvertCredits" method="post" data-submit-once><input type="hidden" name="MemberId" value="@summary.MemberId" /><input type="hidden" name="OperationId" value="@Guid.NewGuid()" />
            <label>Kural<select name="RuleId" class="form-select" required><option value="">Aktif kural seçin</option>@foreach (var rule in Model.ConversionRules.Where(x => x.IsActive)) { <option value="@rule.Id">@rule.Name: @rule.SourceCredits @rule.From.GetDisplayName() → @rule.TargetCredits @rule.To.GetDisplayName()</option> }</select></label>
            <label>Kaç kez uygulanacak<input name="Times" type="number" min="1" max="1000" value="1" required class="form-control" /></label><label>Gerekçe<input name="Reason" minlength="5" maxlength="300" required class="form-control" /></label><button class="btn btn-dark">Kuralı uygula</button>
        </form></section>
    }
    <details class="admin-form-card"><summary>Dönüşüm kurallarını yönet</summary>
        @foreach (var rule in Model.ConversionRules) { <p>@rule.Name · @rule.SourceCredits @rule.From.GetDisplayName() → @rule.TargetCredits @rule.To.GetDisplayName() · @(rule.IsActive ? "Aktif" : "Pasif")</p>@if (rule.IsActive) { <form asp-action="DisableCreditRule" method="post"><input name="memberId" type="hidden" value="@summary.MemberId" /><input name="ruleId" type="hidden" value="@rule.Id" /><button class="btn btn-sm btn-outline-warning">Kuralı pasife al</button></form> } }
        <form asp-action="AddCreditRule" method="post" data-submit-once><input name="memberId" type="hidden" value="@summary.MemberId" /><label>Kural adı<input name="Name" required maxlength="120" class="form-control" /></label>
            <label>Kaynak kategori<select name="From" class="form-select">@foreach (var c in Enum.GetValues<LessonCategory>()) { <option value="@c">@c.GetDisplayName()</option> }</select></label>
            <label>Hedef kategori<select name="To" class="form-select">@foreach (var c in Enum.GetValues<LessonCategory>()) { <option value="@c">@c.GetDisplayName()</option> }</select></label>
            <label>Kaynak hak<input name="SourceCredits" type="number" min="1" max="1000" value="1" class="form-control" /></label><label>Hedef hak<input name="TargetCredits" type="number" min="1" max="1000" value="1" class="form-control" /></label>
            <label><input name="IncreaseTargetMonthlyLimit" type="checkbox" value="true" /> Hedef aylık sınırına dönüştürülen hak kadar ekle</label><button class="btn btn-dark">Dönüşüm kuralını kaydet</button>
        </form>
    </details>
    <details class="admin-form-card"><summary>Kategori hak hareketleri (@Model.Movements.Count)</summary>@foreach (var movement in Model.Movements) { <p>@ClubTime.ToLocal(movement.CreatedAtUtc).ToString("dd.MM.yyyy HH:mm") · @movement.Account.Category.GetDisplayName() · @movement.Delta · @movement.Actor<br />@movement.Reason</p> }</details>
    <p>Kayıtlı bakiye: <strong>@summary.StoredBalance</strong>. Grup rezervasyonu sırasında hak ayrılır; birebir ders tamamlandığında veya katılmadı olarak sonuçlandırıldığında hak düşer. İptal hak kaybettirmez.</p>
    @if (!summary.HasCategoryAccounts && summary.HasKnownPeriod && !summary.IsUnlimited && (summary.UnreviewedCompleted > 0 || summary.InvalidGroupReservations > 0))
    {
        @foreach (var cancelledGroups in new[] { false, true })
        {
            var count = cancelledGroups ? summary.InvalidGroupReservations : summary.UnreviewedCompleted;
            if (count == 0) continue;
            <form asp-action="ReviewCredits" method="post" class="admin-form-card mb-3">
                <h2 class="h5">@(cancelledGroups ? "İptal grup rezervasyonlarında hak kontrolü" : "Eski tamamlanmış / katılmadı birebir derslerde hak kontrolü")</h2>
                <p>@count kayıt var. Önce ders geçmişini ve önceki manuel düzenlemeleri kontrol et.</p>
                <input type="hidden" name="id" value="@summary.MemberId" /><input type="hidden" name="expectedCount" value="@count" /><input type="hidden" name="expectedBalance" value="@summary.StoredBalance" /><input type="hidden" name="cancelledGroups" value="@cancelledGroups.ToString().ToLowerInvariant()" />
                <label class="form-label">Kontrol sonucu<select name="alreadyAdjusted" required class="form-select"><option value="">Yöntem seç</option><option value="false">@(cancelledGroups ? "Hak iade edilmemiş; bir kez iade et" : "Hak düşülmemiş; bir kez düş")</option><option value="true">Önceden manuel işlenmiş; bakiyeyi koru</option></select></label>
                <label class="d-block my-3"><input type="checkbox" name="confirmed" value="true" required /> Ders geçmişini ve bakiyeyi kontrol ettim.</label><button type="submit" class="btn btn-dark">Kontrol edilen hakları işle</button>
            </form>
        }
    }
    <a asp-action="Edit" asp-route-id="@summary.MemberId">Paket bilgilerini düzenle →</a>
    <h2 class="h5 mt-4">Paket dönemindeki son 200 ders / rezervasyon</h2>
    <div class="table-responsive"><table class="table" mobile-labels="Tarih / saat|Tür|Ders|Durum|Hak işlemi"><thead><tr><th>Tarih / saat</th><th>Tür</th><th>Ders</th><th>Durum</th><th>Hak işlemi</th></tr></thead><tbody>
    @foreach (var row in Model.History) { <tr><td>@ClubTime.ToLocal(row.StartsAtUtc).ToString("dd.MM.yyyy HH:mm")</td><td>@row.Kind</td><td>@row.Description</td><td>@row.Status</td><td>@row.CreditState</td></tr> }
    @if (Model.History.Count == 0) { <tr><td colspan="5">Bu paket dönemi için ders kaydı yok.</td></tr> }
    </tbody></table></div>
</div></section>
