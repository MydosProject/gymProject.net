@model IReadOnlyList<NO23.Web.ViewModels.GuestOrders.GuestOrderPageViewModel>
@{
    ViewData["Title"] = "NO23 Shop";
}

<section class="container py-5">
    <div class="row align-items-end g-4 mb-4">
        <div class="col-lg-8">
            <p class="text-uppercase text-muted small mb-2">NO23 Shop</p>
            <h1 class="display-5 fw-semibold mb-3">NO23 ekipmanlarını keşfet.</h1>
            <p class="lead text-muted mb-0">
                Üye olmadan da aktif shop ürünlerini inceleyebilir ve tek ürün siparişi verebilirsin.
            </p>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-light border">
            Şu anda aktif shop ürünü bulunmuyor.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var product in Model)
            {
                var isOutOfStock = product.StockQuantity is <= 0;

                <div class="col-md-6 col-xl-4">
                    <article class="card h-100 border-0 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img class="card-img-top" src="@product.ImageUrl" alt="@product.ItemName" />
                        }

                        <div class="card-body d-flex flex-column gap-3">
                            <div class="d-flex justify-content-between gap-3">
                                <span class="badge text-bg-light">@product.Category</span>
                                <strong>@product.UnitPrice.ToString("C0")</strong>
                            </div>

                            <div>
                                <h2 class="h5 mb-2">@product.ItemName</h2>
                                <p class="text-muted mb-0">
                                    @(string.IsNullOrWhiteSpace(product.Description)
                                        ? "NO23 Shop koleksiyonundan seçili ürün."
                                        : product.Description)
                                </p>
                            </div>

                            <p class="small text-muted mb-0">
                                Stok: @(product.StockQuantity ?? 0)
                            </p>

                            @if (isOutOfStock)
                            {
                                <button class="btn btn-outline-secondary mt-auto" type="button" disabled>
                                    Stokta Yok
                                </button>
                            }
                            else
                            {
                                <a class="btn btn-dark mt-auto"
                                   asp-controller="Shop"
                                   asp-action="Order"
                                   asp-route-productId="@product.ItemId">
                                    Sipariş Ver
                                </a>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
