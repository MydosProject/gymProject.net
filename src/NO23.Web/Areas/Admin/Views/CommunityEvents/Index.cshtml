@model IReadOnlyList<CommunityEventListItemViewModel>
@{
    ViewData["Title"] = "Community Etkinlikleri";
    var upcomingCount = Model.Count(item => item.StartsAtUtc.Date >= DateTime.UtcNow.Date);
    var totalCapacity = Model.Sum(item => item.Capacity ?? 0);
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">COMMUNITY / ETKİNLİK TAKVİMİ</p>
                <h1>Etkinlik yönetimi</h1>
                <p class="admin-page-description">Koşu grupları, workshop'lar ve kulüp buluşmalarını planla.</p>
            </div>
            <a class="btn btn-dark" asp-action="Create">+ Yeni etkinlik</a>
        </header>

        <div class="admin-metrics">
            <article><span>Toplam etkinlik</span><strong>@Model.Count</strong><small>Kayıtlı program</small></article>
            <article><span>Yaklaşan</span><strong>@upcomingCount</strong><small>Takvimde bekleyen</small></article>
            <article><span>Toplam kapasite</span><strong>@totalCapacity</strong><small>Katılımcı alanı</small></article>
        </div>

        <div class="table-responsive admin-table-card">
            <table class="table align-middle mb-0">
                <thead><tr><th>Sıra</th><th>Etkinlik</th><th>Tür</th><th>Durum</th><th>Tarih</th><th>Konum</th><th>Kapasite</th><th class="text-end">İşlem</th></tr></thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="8"><div class="admin-empty-row">Henüz Community etkinliği eklenmedi.</div></td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="admin-order-no">@item.DisplayOrder.ToString("00")</span></td>
                                <td><strong>@item.Title</strong></td>
                                <td>@item.Type</td>
                                <td><span class="admin-status">@item.Status</span></td>
                                <td>@item.StartsAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@item.Location</td>
                                <td>@(item.Capacity?.ToString() ?? "-")</td>
                                <td class="text-end"><a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@item.Id">Düzenle</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
