@model IReadOnlyList<BlogPostListItemViewModel>
@{
    ViewData["Title"] = "Blog";
    var publishedCount = Model.Count(item => item.PublishedAtUtc.HasValue);
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">İÇERİK / BLOG</p>
                <h1>Blog yönetimi</h1>
                <p class="admin-page-description">
                    Antrenman, beslenme ve yaşam tarzı içeriklerini yayına hazırla.
                </p>
            </div>

            <a class="btn btn-dark"
               asp-action="Create">
                + Yeni yazı
            </a>
        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">
                @successMessage
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }

        <div class="admin-metrics admin-metrics-two">
            <article>
                <span>Toplam içerik</span>
                <strong>@Model.Count</strong>
                <small>Blog arşivi</small>
            </article>

            <article>
                <span>Yayın tarihli</span>
                <strong>@publishedCount</strong>
                <small>Planlanmış / yayında</small>
            </article>
        </div>

        <div class="table-responsive admin-table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Başlık</th>
                        <th>Kategori</th>
                        <th>Durum</th>
                        <th>Yayın tarihi</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="admin-empty-row">
                                    Henüz Blog yazısı eklenmedi.
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td data-label="Başlık">
                                    <strong>@item.Title</strong>
                                </td>

                                <td data-label="Kategori">
                                    @item.Category
                                </td>

                                <td data-label="Durum">
                                    <span class="admin-status">
                                        @item.Status
                                    </span>
                                </td>

                                <td data-label="Yayın tarihi">
                                    @(item.PublishedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy") ?? "-")
                                </td>

                                <td class="text-end"
                                    data-label="İşlem">
                                    <a class="btn btn-sm btn-outline-dark"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id">
                                        Düzenle
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>