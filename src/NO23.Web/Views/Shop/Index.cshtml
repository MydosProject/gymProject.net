@model IReadOnlyList<NO23.Web.ViewModels.GuestOrders.GuestOrderPageViewModel>
@{
    ViewData["Title"] = "NO23 Shop";
}

<div class="shop-page public-commerce-page">
    <div class="shop-page-grid" aria-hidden="true"></div>
    <div class="shop-page-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <section class="shop-hero public-shop-hero">
            <div>
                <p class="shop-kicker">NO23 / Performance Goods</p>
                <h1>
                    Ekipmanını seç.
                    <span>Ritmini yanında taşı.</span>
                </h1>
                <p class="shop-hero-description">
                    Antrenman düzenine eşlik eden NO23 ürünlerini keşfet.
                    Üyelik oluşturmadan seçimini yap ve siparişini doğrudan tamamla.
                </p>
                <div class="shop-hero-links">
                    <a class="shop-primary-link" href="#public-shop-products">
                        Koleksiyonu İncele <span aria-hidden="true">↓</span>
                    </a>
                    <a class="shop-secondary-link"
                       asp-area="Identity"
                       asp-page="/Account/Register">
                        Bize Katıl <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>

            <aside class="shop-hero-card" aria-label="NO23 Shop sipariş sistemi">
                <div class="shop-hero-card-top">
                    <span>NO23 / Essential Series</span>
                    <strong>23</strong>
                </div>
                <div class="shop-hero-card-content">
                    <p>Guest order access</p>
                    <h2>Üyelik yok.<br />Beklemek yok.</h2>
                </div>
                <div class="shop-hero-card-footer">
                    <span>Seç</span>
                    <span>Bilgilerini Gir</span>
                    <span>Sipariş Ver</span>
                </div>
            </aside>
        </section>

        <section class="shop-catalog-section" id="public-shop-products">
            <div class="shop-section-heading">
                <div>
                    <p class="shop-section-kicker">01 / Koleksiyon</p>
                    <h2>Antrenmanını tamamlayan parçalar.</h2>
                </div>
                <p>
                    Stok durumunu ve fiyatı kontrol et; seçtiğin ürünü
                    üyelik gerektirmeden teslimat akışına taşı.
                </p>
            </div>

            @if (Model.Count == 0)
            {
                <div class="public-commerce-empty">
                    <span>00</span>
                    <div>
                        <h3>Yeni koleksiyon hazırlanıyor.</h3>
                        <p>Aktif Shop ürünleri burada yayınlanacak.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="shop-product-grid public-shop-grid">
                    @for (var index = 0; index < Model.Count; index++)
                    {
                        var product = Model[index];
                        var isOutOfStock = product.StockQuantity is <= 0;

                        <article class="shop-product-card public-shop-card">
                            <div class="shop-product-visual">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.ItemName" />
                                }
                                <span class="shop-product-mark">NO23 / @((index + 1).ToString("00"))</span>
                                <strong>@((index + 1).ToString("00"))</strong>
                                <span class="shop-product-category">@product.Category</span>
                            </div>

                            <div class="shop-product-content">
                                <div class="shop-product-meta">
                                    <span>@product.Category</span>
                                    <span class="@(isOutOfStock ? "public-stock-out" : "public-stock-in")">
                                        @(isOutOfStock ? "Stokta Yok" : $"Stokta {product.StockQuantity ?? 0}")
                                    </span>
                                </div>
                                <h3>@product.ItemName</h3>
                                <p>
                                    @(string.IsNullOrWhiteSpace(product.Description)
                                        ? "NO23 Shop koleksiyonundan seçilen performans odaklı ürün."
                                        : product.Description)
                                </p>

                                <div class="shop-product-purchase">
                                    <strong>@product.UnitPrice.ToString("C0")</strong>
                                    @if (isOutOfStock)
                                    {
                                        <span class="public-product-disabled">Stokta Yok</span>
                                    }
                                    else
                                    {
                                        <a class="public-product-order-link public-product-order-link-inline"
                                           asp-area=""
                                           asp-controller="Shop"
                                           asp-action="Order"
                                           asp-route-productId="@product.ItemId">
                                            Sipariş Ver <span aria-hidden="true">↗</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>
