@model BlogPostFormViewModel

<form method="post" class="bg-white border rounded-3 p-4 text-dark">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Title" class="form-label">Başlık</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Slug" class="form-label">URL kısa adı</label>
            <input asp-for="Slug" class="form-control" />
            <span asp-validation-for="Slug" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Summary" class="form-label">Kısa özet</label>
            <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Summary" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Content" class="form-label">İçerik</label>
            <textarea asp-for="Content" class="form-control" rows="8"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Category" class="form-label">Kategori</label>
            <input asp-for="Category" class="form-control" />
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Status" class="form-label">Durum</label>
            <select asp-for="Status"
                    asp-items="Html.GetEnumSelectList<ContentStatus>()"
                    class="form-select">
            </select>
        </div>

        <div class="col-md-4">
            <label asp-for="PublishedAtUtc" class="form-label">Yayın tarihi</label>
            <input asp-for="PublishedAtUtc" class="form-control" />
            <span asp-validation-for="PublishedAtUtc" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="CoverImageUrl" class="form-label">Kapak görseli URL</label>
            <input asp-for="CoverImageUrl" class="form-control" />
            <span asp-validation-for="CoverImageUrl" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Tags" class="form-label">Etiketler</label>
            <input asp-for="Tags" class="form-control" />
            <span asp-validation-for="Tags" class="text-danger"></span>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center gap-2 mt-4 flex-wrap">
        @if (Model.Id > 0)
        {
            <button type="submit"
                    asp-action="Delete"
                    asp-route-id="@Model.Id"
                    formnovalidate
                    class="btn btn-outline-danger admin-delete-button"
                    onclick="return confirm('Bu blog yazısını silmek istediğinize emin misiniz?');">
                Yazıyı Sil
            </button>
        }

        <div class="d-flex gap-2 ms-auto">
            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Vazgeç
            </a>

            <button type="submit"
                    class="btn btn-dark">
                Kaydet
            </button>
        </div>
    </div>
</form>