@using NO23.Web.Domain.Enums
@model KitchenDashboardViewModel

@{
    ViewData["Title"] = "NO23 Kitchen";

    string GetGoalName(NutritionGoal goal)
    {
        return goal switch
        {
            NutritionGoal.FatLoss => "Yağ Yakımı",
            NutritionGoal.MuscleGain => "Kas Kazanımı",
            NutritionGoal.WeightMaintenance => "Kilo Koruma",
            NutritionGoal.PerformanceNutrition => "Performans Beslenmesi",
            NutritionGoal.HealthyLifestyle => "Sağlıklı Yaşam",
            _ => "Kişisel Hedef"
        };
    }

    string GetSubscriptionPlanName(string plan)
    {
        return plan switch
        {
            nameof(KitchenSubscriptionPlan.FiveDays) => "5 Günlük Plan",
            nameof(KitchenSubscriptionPlan.TenDays) => "10 Günlük Plan",
            nameof(KitchenSubscriptionPlan.TwentyDays) => "20 Günlük Plan",
            nameof(KitchenSubscriptionPlan.Monthly) => "Aylık Plan",
            _ => plan
        };
    }

    string GetSubscriptionGoalName(string goal)
    {
        return goal switch
        {
            nameof(NutritionGoal.FatLoss) => "Yağ Yakımı",
            nameof(NutritionGoal.MuscleGain) => "Kas Kazanımı",
            nameof(NutritionGoal.WeightMaintenance) => "Kilo Koruma",
            nameof(NutritionGoal.PerformanceNutrition) => "Performans Beslenmesi",
            nameof(NutritionGoal.HealthyLifestyle) => "Sağlıklı Yaşam",
            _ => goal
        };
    }

    string GetCalorieComparison(int totalCalories, int targetCalories)
    {
        var difference = totalCalories - targetCalories;

        return difference switch
        {
            0 => "Günlük hedefle tam uyumlu",
            > 0 => $"Hedeften {difference} kcal fazla",
            _ => $"Hedeften {Math.Abs(difference)} kcal az"
        };
    }
}

<section class="kitchen-page">
    <div class="kitchen-page-grid" aria-hidden="true"></div>
    <div class="kitchen-page-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <header class="kitchen-hero">
            <div class="kitchen-hero-content">
                <p class="kitchen-kicker">NO23 Kitchen · Personal Nutrition</p>

                <h1>
                    İyi antrenman
                    <span>doğru yakıtla başlar.</span>
                </h1>

                <p class="kitchen-hero-description">
                    Günlük enerji ihtiyacını hesapla, makro hedeflerini öğren
                    ve hedefin için hazırlanan NO23 Kitchen menülerini keşfet.
                </p>

                <div class="kitchen-hero-actions">
                    <a href="#calculator"
                       class="kitchen-primary-link">
                        Kalorini Hesapla
                        <span aria-hidden="true">↓</span>
                    </a>

                    <a asp-area="Member"
                       asp-controller="Kitchen"
                       asp-action="Menu"
                       class="kitchen-secondary-link">
                        Menüyü Keşfet
                    </a>
                </div>
            </div>

            <aside class="kitchen-hero-card">
                <div class="kitchen-hero-card-top">
                    <span>NO23 Nutrition System</span>
                    <strong>23</strong>
                </div>

                <div class="kitchen-hero-card-content">
                    <p>Tek platformda</p>

                    <h2>
                        Hesapla.<br />
                        Planla.<br />
                        İyi beslen.
                    </h2>
                </div>

                <ul>
                    <li>
                        <span>01</span>
                        Kişisel kalori hedefi
                    </li>

                    <li>
                        <span>02</span>
                        Dengeli makro planı
                    </li>

                    <li>
                        <span>03</span>
                        Hedef odaklı öğünler
                    </li>
                </ul>
            </aside>
        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="kitchen-alert kitchen-alert-success"
                 role="status">
                <span aria-hidden="true">✓</span>

                <div>
                    <strong>Kitchen aboneliğin hazır</strong>
                    <p>@successMessage</p>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="kitchen-alert kitchen-alert-error"
                 role="alert">
                <span aria-hidden="true">!</span>

                <div>
                    <strong>İşlem gerçekleştirilemedi</strong>
                    <p>@errorMessage</p>
                </div>
            </div>
        }

        @if (Model.ActiveSubscription is not null)
        {
            var subscription = Model.ActiveSubscription;
            var totalDays = Math.Max(1, subscription.EndsOn.DayNumber - subscription.StartsOn.DayNumber + 1);
            var completedDays = Math.Clamp(totalDays - subscription.RemainingDays, 0, totalDays);
            var progressPercentage = (int)Math.Round(completedDays * 100d / totalDays);

            <section class="kitchen-active-subscription"
                     aria-labelledby="active-subscription-title">
                <div class="kitchen-section-heading">
                    <div>
                        <p class="kitchen-section-kicker">Aktif abonelik</p>
                        <h2 id="active-subscription-title">Kitchen planın devam ediyor.</h2>
                    </div>

                    <p>
                        Günlük hedef ve makrolarına göre hazırlanan aktif Kitchen
                        aboneliğinin özetini buradan takip edebilirsin.
                    </p>
                </div>

                <article class="kitchen-subscription-card"
                         style="--subscription-progress: @(progressPercentage)%">
                    <div class="kitchen-subscription-main">
                        <div class="kitchen-subscription-topline">
                            <span class="kitchen-subscription-status">
                                <i aria-hidden="true"></i>
                                Aktif
                            </span>
                            <strong>NO23 / NUTRITION</strong>
                        </div>

                        <div class="kitchen-subscription-title">
                            <p>@GetSubscriptionGoalName(subscription.Goal)</p>
                            <h3>@(string.IsNullOrWhiteSpace(subscription.PackageName) ? GetSubscriptionPlanName(subscription.Plan) : subscription.PackageName)</h3>
                        </div>

                        <div class="kitchen-subscription-progress">
                            <div>
                                <span>Plan ilerlemesi</span>
                                <strong>%@progressPercentage</strong>
                            </div>
                            <div class="kitchen-subscription-progress-track" aria-hidden="true">
                                <span></span>
                            </div>
                            <small>
                                @subscription.StartsOn.ToString("dd.MM.yyyy")
                                —
                                @subscription.EndsOn.ToString("dd.MM.yyyy")
                            </small>
                        </div>
                    </div>

                    <div class="kitchen-subscription-days">
                        <span>Kalan</span>
                        <strong>@subscription.RemainingDays</strong>
                        <small>gün</small>
                    </div>

                    <dl class="kitchen-subscription-macros">
                        <div>
                            <dt>Günlük Kalori</dt>
                            <dd>@subscription.DailyCalories <small>kcal</small></dd>
                        </div>
                        <div>
                            <dt>Protein</dt>
                            <dd>@subscription.ProteinGrams <small>g</small></dd>
                        </div>
                        <div>
                            <dt>Karbonhidrat</dt>
                            <dd>@subscription.CarbohydrateGrams <small>g</small></dd>
                        </div>
                        <div>
                            <dt>Yağ</dt>
                            <dd>@subscription.FatGrams <small>g</small></dd>
                        </div>
                    </dl>

                    <footer class="kitchen-subscription-footer">
                        <p>
                            @subscription.PackagePrice.ToString("C0") tutarındaki Kitchen paketin,
                            günlük hedeflerine göre hazırlanan beslenme planını kapsar.
                        </p>
                        <a href="#nutrition-plan">
                            Planımı Gör <span aria-hidden="true">↗</span>
                        </a>
                    </footer>
                </article>
            </section>

            <section class="kitchen-meal-plan-section"
                     id="nutrition-plan"
                     aria-labelledby="nutrition-plan-title">
                <div class="kitchen-section-heading">
                    <div>
                        <p class="kitchen-section-kicker">Kişisel beslenme planı</p>
                        <h2 id="nutrition-plan-title">Gün gün öğün planın.</h2>
                    </div>

                    <p>
                        Boy, kilo, yaş, aktivite ve hedef bilgilerine göre eşleştirilen
                        öğünlerini ve günlük toplamlarını buradan takip edebilirsin.
                    </p>
                </div>

                @if (subscription.MealPlan is not null && subscription.MealPlanDays.Count > 0)
                {
                    <div class="kitchen-meal-plan-overview">
                        <div>
                            <span>Plan süresi</span>
                            <strong>@subscription.MealPlanDays.Count gün</strong>
                        </div>
                        <div>
                            <span>Günlük hedef</span>
                            <strong>@subscription.DailyCalories kcal</strong>
                        </div>
                        <div>
                            <span>Hedef türü</span>
                            <strong>@GetSubscriptionGoalName(subscription.Goal)</strong>
                        </div>
                    </div>

                    <div class="kitchen-meal-day-list">
                        @foreach (var day in subscription.MealPlanDays)
                        {
                            <details class="kitchen-meal-day-card">
                                <summary>
                                    <span class="kitchen-meal-day-number">
                                        @day.DayNumber.ToString("00")
                                    </span>

                                    <span class="kitchen-meal-day-title">
                                        <small>@day.PlanDate.ToString("dd.MM.yyyy")</small>
                                        <strong>@day.DayNumber. gün planı</strong>
                                    </span>

                                    <span class="kitchen-meal-day-calories">
                                        <small>@GetCalorieComparison(day.TotalCalories, subscription.DailyCalories)</small>
                                        <strong>@day.TotalCalories kcal</strong>
                                    </span>

                                    <span class="kitchen-meal-day-toggle"
                                          aria-hidden="true"></span>
                                </summary>

                                <div class="kitchen-meal-day-content">
                                    <dl class="kitchen-meal-day-totals">
                                        <div>
                                            <dt>Protein</dt>
                                            <dd>@day.TotalProteinGrams.ToString("0.#") g</dd>
                                        </div>
                                        <div>
                                            <dt>Karbonhidrat</dt>
                                            <dd>@day.TotalCarbohydrateGrams.ToString("0.#") g</dd>
                                        </div>
                                        <div>
                                            <dt>Yağ</dt>
                                            <dd>@day.TotalFatGrams.ToString("0.#") g</dd>
                                        </div>
                                        <div>
                                            <dt>Öğün</dt>
                                            <dd>@day.Meals.Count</dd>
                                        </div>
                                    </dl>

                                    <div class="kitchen-meal-list">
                                        @foreach (var meal in day.Meals)
                                        {
                                            <article class="kitchen-meal-row">
                                                <div>
                                                    <span>@meal.MealSlotDisplayName</span>
                                                    <strong>@meal.ProductName</strong>
                                                </div>

                                                <dl>
                                                    <div>
                                                        <dt>Adet</dt>
                                                        <dd>@meal.Quantity</dd>
                                                    </div>
                                                    <div>
                                                        <dt>Kalori</dt>
                                                        <dd>@meal.Calories kcal</dd>
                                                    </div>
                                                    <div>
                                                        <dt>Makro</dt>
                                                        <dd>
                                                            P @meal.ProteinGrams.ToString("0.#") ·
                                                            K @meal.CarbohydrateGrams.ToString("0.#") ·
                                                            Y @meal.FatGrams.ToString("0.#")
                                                        </dd>
                                                    </div>
                                                </dl>
                                            </article>
                                        }
                                    </div>
                                </div>
                            </details>
                        }
                    </div>
                }
                else
                {
                    <div class="kitchen-meal-plan-empty" role="status">
                        <span aria-hidden="true">23</span>
                        <div>
                            <h3>Beslenme planın hazırlanıyor.</h3>
                            <p>
                                Uygun Kitchen öğünleri hedeflerinle eşleştirildiğinde
                                gün gün planın burada görünecek.
                            </p>
                        </div>
                    </div>
                }
            </section>
        }

        <partial name="_KitchenCalculator" model="Model" />

        @if (Model.ActiveSubscription is null)
        {
            <section class="kitchen-plan-selection" id="plans">
                <div class="kitchen-section-heading">
                    <div>
                        <p class="kitchen-section-kicker">Kitchen planı</p>
                        <h2>Abonelik süreni seç.</h2>
                    </div>
                    <p>
                        Kalori ve makro hesabındaki son kişisel sonucunu
                        kullanarak Kitchen planını başlat.
                    </p>
                </div>

                @if (Model.Recommendation is null)
                {
                    <div class="kitchen-plan-required">
                        <span>01</span>
                        <div>
                            <h3>Önce kalori ve makro hedefini hesapla.</h3>
                            <p>
                                Plan seçeneklerini açmak için kişisel
                                hesaplamanı tamamlamalısın.
                            </p>
                        </div>
                        <a href="#calculator">
                            Hesaplamaya Dön <span aria-hidden="true">↑</span>
                        </a>
                    </div>
                }
                else
                {
                    <div class="kitchen-plan-target">
                        <div>
                            <span>Son kişisel hedef</span>
                            <strong>@GetGoalName(Model.Recommendation.Goal)</strong>
                        </div>
                        <dl>
                            <div>
                                <dt>Kalori</dt>
                                <dd>@Model.Recommendation.DailyCalories kcal</dd>
                            </div>
                            <div>
                                <dt>Protein</dt>
                                <dd>@Model.Recommendation.ProteinGrams g</dd>
                            </div>
                            <div>
                                <dt>Karbonhidrat</dt>
                                <dd>@Model.Recommendation.CarbohydrateGrams g</dd>
                            </div>
                            <div>
                                <dt>Yağ</dt>
                                <dd>@Model.Recommendation.FatGrams g</dd>
                            </div>
                        </dl>
                    </div>

                    @if (Model.SubscriptionPlans.Count == 0)
                    {
                        <div class="kitchen-plan-required">
                            <span>00</span>
                            <div>
                                <h3>Aktif Kitchen paketi bulunmuyor.</h3>
                                <p>Yeni paketler yayına alındığında burada görünecek.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                    <div class="kitchen-plan-grid">
                        @foreach (var plan in Model.SubscriptionPlans)
                        {
                            <form asp-area="Member"
                                  asp-controller="Kitchen"
                                  asp-action="Subscribe"
                                  asp-antiforgery="true"
                                  method="post"
                                  class="kitchen-plan-card">
                                <input type="hidden" name="plan" value="@plan.Plan" />
                                <input type="hidden" name="input.HeightCm" value="@Model.CalculatorInput.HeightCm" />
                                <input type="hidden" name="input.WeightKg" value="@Model.CalculatorInput.WeightKg" />
                                <input type="hidden" name="input.Age" value="@Model.CalculatorInput.Age" />
                                <input type="hidden" name="input.Gender" value="@Model.CalculatorInput.Gender" />
                                <input type="hidden" name="input.ActivityLevel" value="@Model.CalculatorInput.ActivityLevel" />
                                <input type="hidden" name="input.Goal" value="@Model.CalculatorInput.Goal" />

                                <span class="kitchen-plan-days">@plan.Days gün · @plan.UnitPrice.ToString("C0")</span>
                                <h4>@plan.Name</h4>
                                <p>@plan.Description</p>
                                <button type="submit">
                                    Aboneliği Başlat
                                    <span aria-hidden="true">→</span>
                                </button>
                            </form>
                        }
                    </div>
                    }
                }
            </section>
        }

