@model NO23.Web.ViewModels.Plans.ServicePackageCatalogViewModel
@using NO23.Web.Domain.Enums

@{
    ViewData["Title"] = Model.CategoryTitle;
}

<section class="service-catalog-page service-catalog-@Model.Category.ToString().ToLowerInvariant()">
    <div class="service-catalog-grid-bg" aria-hidden="true"></div>
    <div class="container position-relative">
        <header class="service-catalog-hero">
            <p class="section-kicker">NO23 / @(Model.CategoryTitle == "Personal Training" ? "PERSONAL TRAINING" : Model.CategoryTitle.ToUpper(System.Globalization.CultureInfo.GetCultureInfo("tr-TR")))</p>
            <h1>@(Model.CategoryTitle == "Personal Training" ? "PERSONAL TRAINING" : Model.CategoryTitle)</h1>
            <h2>@Model.Headline</h2>
            <p>@Model.Description</p>
        </header>

        <nav class="service-catalog-tabs" aria-label="Paket kategorileri">
            <a asp-action="Index" asp-route-category="membership"
               class="@(Model.Category == ServicePackageCategory.Membership ? "active" : null)">Üyelik</a>
            <a asp-action="Index" asp-route-category="personal-training"
               class="@(Model.Category == ServicePackageCategory.PersonalTraining ? "active" : null)">PERSONAL TRAINING</a>
            <a asp-action="Index" asp-route-category="group-classes"
               class="@(Model.Category == ServicePackageCategory.GroupClasses ? "active" : null)">Grup Dersleri</a>
            <a asp-action="Index" asp-route-category="kids-club"
               class="@(Model.Category == ServicePackageCategory.KidsClub ? "active" : null)">Kids Club</a>
        </nav>

        <div class="service-catalog-cards">
            @foreach (var package in Model.Packages)
            {
                <partial name="_ServicePackageCard" model="package" />
            }
        </div>

        <div class="service-catalog-footer">
            <div>
                <strong>Kararsız mısın?</strong>
                <span>Hedefine uygun paketi birlikte belirleyelim.</span>
            </div>
            <a asp-controller="Home" asp-action="Index" asp-fragment="contact">Planını Bul →</a>
        </div>
    </div>
</section>

