@model IReadOnlyList<MembershipPackageOptionListItemViewModel>
@{ ViewData["Title"] = "Paket Seçenekleri"; var activeCount = Model.Count(x => x.IsActive); }
<section class="admin-page"><div class="container">
    <header class="admin-page-head"><div><p class="admin-eyebrow">NO23 CLUB / ÜYELİK YÖNETİMİ</p><h1>Paket seçenekleri</h1><p class="admin-page-description">Ana üyelik seçildikten sonra kullanıcıya sunulan PT, grup dersi ve karma hizmet seçeneklerini yönet.</p></div><div class="admin-page-actions"><a class="btn btn-outline-dark" asp-controller="MembershipPackages" asp-action="Index">Ana Paketler</a><a class="btn btn-dark" asp-action="Create">+ Yeni Seçenek</a></div></header>
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="admin-metrics"><article><span>Toplam seçenek</span><strong>@Model.Count</strong><small>Tüm paketlerde</small></article><article><span>Aktif seçenek</span><strong>@activeCount</strong><small>Public alanda görünür</small></article><article><span>Seçim yapan üye</span><strong>@Model.Sum(x => x.MemberCount)</strong><small>Kayıtlı tercihler</small></article></div>
    <div class="table-responsive admin-table-card"><table class="table align-middle mb-0"><thead><tr><th>Ana Paket</th><th>Seçenek</th><th>Süre</th><th>PT</th><th>Grup</th><th>Salon</th><th>Durum</th><th></th></tr></thead><tbody>
    @foreach (var item in Model) { <tr><td><span class="admin-package-code">@item.PackageName</span></td><td><strong>@item.Name</strong><span class="admin-cell-note">@item.MemberCount üye</span></td><td>@item.DurationDays gün</td><td>@item.PersonalTrainingSessionCount seans</td><td>@item.GroupClassCreditCount ders</td><td>@(item.IncludesGymAccess ? "Dahil" : "—")</td><td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Aktif" : "Pasif")</span></td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">Düzenle</a> <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger">Sil</button></form></td></tr> }
    </tbody></table></div>
</div></section>
