@using System.Globalization
@model MemberReservationsIndexViewModel

@{
    ViewData["Title"] = "Rezervasyonlarım";
    var turkishCulture = CultureInfo.GetCultureInfo("tr-TR");
}

<section class="member-reservations-page">
    <div class="member-reservations-grid" aria-hidden="true"></div>
    <div class="member-reservations-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <header class="member-reservations-hero">
            <div>
                <p class="member-reservations-kicker">NO23 / ANTRENMAN PLANI</p>
                <h1>
                    Dersini seç.<br />
                    <span>Yerini ayır.</span>
                </h1>
                <p>
                    Grup derslerini tek ekrandan planla, yaklaşan
                    rezervasyonlarını takip et ve birebir antrenman için
                    eğitmenini seç.
                </p>
            </div>

            <nav class="member-reservations-switch" aria-label="Rezervasyon bölümleri">
                <a href="#group-classes">
                    <span>01</span>
                    Grup Dersleri
                </a>
                <a href="#personal-training">
                    <span>02</span>
                    Birebir Antrenman
                </a>
            </nav>
        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="member-dashboard-alert member-dashboard-alert-success" role="status">
                <span aria-hidden="true">✓</span>
                <div>
                    <strong>İşlem tamamlandı</strong>
                    <p>@successMessage</p>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="member-dashboard-alert member-dashboard-alert-error" role="alert">
                <span aria-hidden="true">!</span>
                <div>
                    <strong>İşlem gerçekleştirilemedi</strong>
                    <p>@errorMessage</p>
                </div>
            </div>
        }

        <section class="member-reservations-section"
                 id="upcoming-reservations">
            <div class="member-section-heading">
                <div>
                    <p class="member-section-kicker">Takvimin</p>
                    <h2>Yaklaşan rezervasyonların</h2>
                </div>
                <span class="member-section-count">
                    @Model.UpcomingReservations.Count.ToString("00")
                </span>
            </div>

            @if (Model.UpcomingReservations.Count == 0)
            {
                <div class="member-empty-state">
                    <span class="member-empty-number">00</span>
                    <div>
                        <h3>Henüz yaklaşan rezervasyonun yok.</h3>
                        <p>Aşağıdaki grup derslerinden sana uygun seansı seçebilirsin.</p>
                    </div>
                    <a href="#group-classes" class="member-empty-link">
                        Dersleri incele <span aria-hidden="true">↓</span>
                    </a>
                </div>
            }
            else
            {
                <div class="member-reservation-list">
                    @foreach (var reservation in Model.UpcomingReservations)
                    {
                        var localStart = reservation.StartsAtUtc.ToLocalTime();

                        <article class="member-reservation-card">
                            <div class="member-reservation-date">
                                <strong>@localStart.ToString("dd")</strong>
                                <span>@localStart.ToString("MMM", turkishCulture)</span>
                            </div>

                            <div class="member-reservation-info">
                                <p>@localStart.ToString("dddd · HH:mm", turkishCulture)</p>
                                <h3>@reservation.ClassName</h3>
                                <span>Eğitmen: @reservation.TrainerName</span>
                            </div>

                            @if (reservation.CanCancel)
                            {
                                <form asp-area="Member"
                                      asp-controller="Reservations"
                                      asp-action="Cancel"
                                      asp-antiforgery="true"
                                      method="post"
                                      class="member-reservation-action">
                                    <input type="hidden"
                                           name="reservationId"
                                           value="@reservation.ReservationId" />
                                    <button type="submit" class="member-cancel-button">
                                        İptal Et
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="member-reserved-label">
                                    İptal süresi geçti
                                </span>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="member-reservations-section"
                 id="group-classes">
            <div class="member-section-heading">
                <div>
                    <p class="member-section-kicker">01 / Grup dersleri</p>
                    <h2>Programına uygun seansı seç</h2>
                </div>
                <span class="member-section-count">
                    @Model.AvailableSessions.Count.ToString("00")
                </span>
            </div>

            @if (Model.AvailableSessions.Count == 0)
            {
                <div class="member-empty-state">
                    <span class="member-empty-number">—</span>
                    <div>
                        <h3>Şu anda uygun ders bulunmuyor.</h3>
                        <p>Yeni seanslar yayınlandığında burada görüntülenecek.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="member-session-grid">
                    @foreach (var session in Model.AvailableSessions)
                    {
                        var isFull = session.ReservedCount >= session.Capacity;
                        var hasNoClassCredits = !session.HasAvailableClassCredits;
                        var remainingCapacity = Math.Max(0, session.Capacity - session.ReservedCount);
                        var localStart = session.StartsAtUtc.ToLocalTime();

                        <article class="member-session-card
                            @(session.IsReservedByMember
                                ? "member-session-card-reserved"
                                : string.Empty)">
                            <div class="member-session-card-top">
                                <div class="member-session-date">
                                    <strong>@localStart.ToString("dd")</strong>
                                    <span>@localStart.ToString("MMM", turkishCulture)</span>
                                </div>
                                <span class="member-session-status">
                                    @(session.IsReservedByMember
                                        ? "Rezerve"
                                        : isFull
                                            ? "Kontenjan dolu"
                                            : hasNoClassCredits
                                                ? "Ders hakkı yok"
                                                : "Müsait")
                                </span>
                            </div>

                            <div class="member-session-content">
                                <p>@localStart.ToString("dddd · HH:mm", turkishCulture)</p>
                                <h3>@session.ClassName</h3>
                                <span>Eğitmen: @session.TrainerName</span>

                                <div class="member-session-details">
                                    <span>@session.DurationMinutes dk</span>
                                    <span>@session.DifficultyLevel</span>
                                    <span>@session.AverageCaloriesBurned kcal</span>
                                </div>
                            </div>

                            <div class="member-session-footer">
                                <div>
                                    <span>Kontenjan</span>
                                    <strong>@remainingCapacity / @session.Capacity</strong>
                                </div>

                                @if (session.IsReservedByMember)
                                {
                                    <span class="member-reserved-label">Planına eklendi</span>
                                }
                                else
                                {
                                    <form asp-area="Member"
                                          asp-controller="Reservations"
                                          asp-action="Reserve"
                                          asp-antiforgery="true"
                                          method="post">
                                        <input type="hidden"
                                               name="classSessionId"
                                               value="@session.SessionId" />
                                        <button type="submit"
                                                class="member-reserve-button"
                                                disabled="@(isFull || hasNoClassCredits)">
                                            @(isFull
                                                ? "Kontenjan Dolu"
                                                : hasNoClassCredits
                                                    ? "Ders Hakkı Yok"
                                                    : "Rezervasyon Yap")
                                        </button>
                                    </form>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="member-reservations-section member-personal-section"
                 id="personal-training">
            <div class="member-section-heading">
                <div>
                    <p class="member-section-kicker">02 / Birebir antrenman</p>
                    <h2>Hedefine özel çalış</h2>
                </div>
                <span class="member-coming-pill">Kişisel plan</span>
            </div>

            <div class="member-personal-intro">
                <div class="member-personal-intro-copy">
                    <span class="member-personal-intro-number">01</span>
                    <div>
                        <p>Kişisel antrenman süreci</p>
                        <h3>Eğitmenini seç, uygun zamanını bildir.</h3>
                        <span>
                            Talebin seçtiğin eğitmene iletilir.
                            Eğitmenin değerlendirmesinden sonra
                            kesin randevu bilgisi hesabında görüntülenir.
                        </span>
                    </div>
                </div>

                <div class="member-personal-steps">
                    <div><strong>01</strong><span>Eğitmenini seç</span></div>
                    <div><strong>02</strong><span>Uygun zamanını belirt</span></div>
                    <div><strong>03</strong><span>Eğitmen yanıtını takip et</span></div>
                </div>
            </div>

            <div class="member-personal-layout">
                <div class="member-trainer-panel">
                    <div class="member-personal-panel-heading">
                        <div>
                            <span>Eğitmen seçimi</span>
                            <strong>Birlikte çalışmak istediğin eğitmeni seç</strong>
                        </div>
                        <small>@Model.Trainers.Count.ToString("00") eğitmen</small>
                    </div>

                    <div class="member-trainer-options">
                        @foreach (var trainer in Model.Trainers)
                        {
                            var trainerInitial = string.IsNullOrWhiteSpace(trainer.FullName)
                                ? "PT"
                                : trainer.FullName.Trim()[0].ToString().ToUpper(turkishCulture);

                            <a class="member-trainer-option
                                      @(Model.SelectedTrainerId == trainer.Id ? "is-selected" : string.Empty)"
                               data-trainer-option
                               data-trainer-id="@trainer.Id"
                               data-trainer-name="@trainer.FullName"
                               asp-area="Member"
                               asp-controller="Reservations"
                               asp-action="Index"
                               asp-route-trainerId="@trainer.Id"
                               asp-fragment="personal-training">
                                <div class="member-trainer-option-top">
                                    <span class="member-trainer-avatar">@trainerInitial</span>
                                    <span class="member-trainer-selection" aria-hidden="true">✓</span>
                                </div>

                                <div class="member-trainer-option-copy">
                                    <span>@trainer.Specialty</span>
                                    <strong>@trainer.FullName</strong>
                                    <p>
                                        @(string.IsNullOrWhiteSpace(trainer.Bio)
                                            ? "Hedefine uygun, kişiselleştirilmiş birebir antrenman planı."
                                            : trainer.Bio)
                                    </p>
                                </div>

                                <small>
                                    @(Model.SelectedTrainerId == trainer.Id ? "Seçildi" : "Eğitmeni seç")
                                </small>
                            </a>
                        }
                    </div>
                </div>

                <div class="member-personal-form">
                    <div class="member-personal-form-heading">
                        <div>
                            <span>Başvuru formu</span>
                            <strong>Birebir talep oluştur</strong>
                        </div>
                        <span class="member-personal-form-step">02</span>
                    </div>

                    @if (!Model.CanRequestPersonalTraining)
                    {
                        <div class="member-empty-state member-personal-empty-state">
                            <span class="member-empty-number">!</span>
                            <div>
                                <h3>Paketin birebir destek içermiyor.</h3>
                                <p>Birebir antrenman talebi oluşturmak için paketinde Personal Training desteği bulunmalı.</p>
                            </div>
                        </div>
                    }
                    else if (Model.Trainers.Count == 0)
                    {
                        <div class="member-empty-state member-personal-empty-state">
                            <span class="member-empty-number">—</span>
                            <div>
                                <h3>Aktif eğitmen bulunmuyor.</h3>
                                <p>Yeni eğitmenler yayınlandığında birebir talep oluşturabilirsin.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <form asp-area="Member"
                              asp-controller="Reservations"
                              asp-action="RequestPersonalTraining"
                              asp-antiforgery="true"
                              method="post">
                            <input id="personal-trainer-id"
                                   type="hidden"
                                   name="TrainerId"
                                   value="@Model.PersonalTrainingRequestInput.TrainerId" />

                            <label class="member-personal-selected-field">
                                <span>Seçilen eğitmen</span>
                                <div class="member-personal-selected-control">
                                    <span aria-hidden="true">PT</span>
                                    <input id="selected-personal-trainer"
                                           value="@(Model.Trainers.FirstOrDefault(trainer => trainer.Id == Model.SelectedTrainerId)?.FullName ?? "Önce eğitmenini seç")"
                                           disabled />
                                </div>
                            </label>

                            <div class="member-personal-form-grid">
                                <label>
                                    <span>Tercih edilen gün</span>
                                    <input type="date"
                                           name="PreferredDate"
                                           min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")"
                                           value="@Model.PersonalTrainingRequestInput.PreferredDate.ToString("yyyy-MM-dd")"
                                           required />
                                </label>

                                <label>
                                    <span>Saat aralığı</span>
                                    <select class="member-personal-time-window-select"
                                            name="PreferredTimeWindow"
                                            required>
                                        @foreach (var timeWindow in Model.PreferredTimeWindows)
                                        {
                                            if (timeWindow == Model.PersonalTrainingRequestInput.PreferredTimeWindow)
                                            {
                                                <option value="@timeWindow" selected>
                                                    @timeWindow
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@timeWindow">
                                                    @timeWindow
                                                </option>
                                            }
                                        }
                                    </select>
                                </label>
                            </div>

                            <label>
                                <span>Hedefin ve notun</span>
                                <textarea name="GoalNote"
                                          rows="4"
                                          maxlength="1200"
                                          placeholder="Hedefini, deneyim seviyeni ve birebir antrenmandan beklentilerini yaz."></textarea>
                            </label>

                            <div class="member-personal-form-footer">
                                <p>
                                Talebin doğrudan seçtiğin eğitmene iletilir.
                                Eğitmen uygun tarih ve saati belirlediğinde burada görüntülenir.
                                </p>
                                <button id="personal-training-submit"
                                        type="submit"
                                        class="member-personal-submit">
                                    <span>Birebir Talep Oluştur</span>
                                    <strong aria-hidden="true">→</strong>
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>

            <div class="member-personal-history">
                <div class="member-personal-history-heading">
                    <div>
                        <span>Talep geçmişin</span>
                        <strong>Birebir antrenman taleplerin</strong>
                    </div>
                    <span class="member-personal-history-count">
                        @Model.PersonalTrainingRequests.Count.ToString("00")
                    </span>
                </div>

                <div class="member-personal-request-list">
                    @if (Model.PersonalTrainingRequests.Count == 0)
                    {
                        <div class="member-empty-state member-personal-history-empty">
                            <span class="member-empty-number">00</span>
                            <div>
                                <h3>Henüz birebir talebin yok.</h3>
                                <p>Eğitmenini ve uygun olduğun saat aralığını seçerek ilk talebini oluşturabilirsin.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var request in Model.PersonalTrainingRequests)
                        {
                            var scheduledAtLocal = request.ScheduledAtUtc?.ToLocalTime();

                           <article class="member-personal-request-card"
                                data-personal-training-request
                                data-request-id="@request.Id">
                                <div class="member-personal-request-date">
                                    <strong>@request.PreferredDate.ToString("dd")</strong>
                                    <span>@request.PreferredDate.ToString("MMM", turkishCulture)</span>
                                </div>

                                <div class="member-personal-request-main">
                                    <div class="member-personal-request-top">
                                        <p>@request.PreferredDate.ToString("dddd", turkishCulture) · @request.PreferredTimeWindow</p>
                                        <span class="member-personal-status"
                                            data-personal-training-status
                                            data-status="@(request.RawStatus.ToString().ToLowerInvariant())">
                                            @request.Status
                                        </span>
                                    </div>

                                    <h3>@request.TrainerName</h3>

                                    <div class="member-personal-request-details"
                                        data-personal-training-details>
                                        @if (scheduledAtLocal.HasValue)
                                        {
                                                <div data-personal-training-scheduled>
                                                    <span>Kesin randevu</span>

                                                    <strong data-personal-training-scheduled-value>
                                                        @scheduledAtLocal.Value.ToString(
                                                            "dd.MM.yyyy · HH:mm",
                                                            turkishCulture)
                                                    </strong>
                                                </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(request.TrainerNote))
                                        {
                                                <div data-personal-training-trainer-note>
                                                    <span>Eğitmen notu</span>

                                                    <strong data-personal-training-trainer-note-value>
                                                        @request.TrainerNote
                                                    </strong>
                                                </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(request.AdminNote))
                                        {
                                            <div>
                                                <span>Kulüp notu</span>
                                                <strong>@request.AdminNote</strong>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (request.CanCancel)
                                {
                                       <form asp-area="Member"
                                        asp-controller="Reservations"
                                        asp-action="CancelPersonalTraining"
                                        asp-antiforgery="true"
                                        method="post"
                                        class="member-reservation-action"
                                        data-personal-training-cancel-form>

                                        <input type="hidden"
                                            name="requestId"
                                            value="@request.Id" />

                                        <button type="submit"
                                                class="member-cancel-button"
                                                data-personal-training-cancel-button>
                                            @(request.ScheduledAtUtc.HasValue
                                                ? "Randevuyu İptal Et"
                                                : "Talebi İptal Et")
                                        </button>
                                    </form>
                                }
                            </article>
                        }
                    }
                </div>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const personalTrainingSection =
                document.getElementById("personal-training");

            const personalTrainingForm =
                personalTrainingSection?.querySelector(
                    'form[action*="RequestPersonalTraining"]');

            if (
                sessionStorage.getItem("returnToPersonalTraining") === "true" &&
                personalTrainingSection
            ) {
                sessionStorage.removeItem("returnToPersonalTraining");

                requestAnimationFrame(() => {
                    personalTrainingSection.scrollIntoView({
                        behavior: "instant",
                        block: "start"
                    });
                });
            }

            personalTrainingForm?.addEventListener("submit", () => {
                sessionStorage.setItem(
                    "returnToPersonalTraining",
                    "true"
                );
            });
            const trainerOptions = Array.from(
                document.querySelectorAll("[data-trainer-option]"));
            const selectedTrainerInput = document.getElementById(
                "selected-personal-trainer");
            const selectedTrainerIdInput = document.getElementById(
                "personal-trainer-id");
            const personalTrainingSubmit = document.getElementById(
                "personal-training-submit");

            const updatePersonalTrainingSubmitState = () => {
                if (!personalTrainingSubmit || !selectedTrainerIdInput) {
                    return;
                }

                personalTrainingSubmit.disabled =
                    !selectedTrainerIdInput.value;
            };

            updatePersonalTrainingSubmitState();

            trainerOptions.forEach(option => {
                option.addEventListener("click", event => {
                    if (event.metaKey ||
                        event.ctrlKey ||
                        event.shiftKey ||
                        event.altKey) {
                        return;
                    }

                    event.preventDefault();

                    trainerOptions.forEach(trainerOption => {
                        const isSelected = trainerOption === option;
                        trainerOption.classList.toggle("is-selected", isSelected);

                        const status = trainerOption.querySelector("small");
                        if (status) {
                            status.textContent = isSelected
                                ? "Seçildi"
                                : "Eğitmeni seç";
                        }
                    });

                    if (selectedTrainerInput) {
                        selectedTrainerInput.value =
                            option.dataset.trainerName ?? "Önce eğitmenini seç";
                    }

                    if (selectedTrainerIdInput) {
                        selectedTrainerIdInput.value =
                            option.dataset.trainerId ?? "";
                    }

                    updatePersonalTrainingSubmitState();

                    window.history.replaceState(
                        null,
                        "",
                        option.href);
                });
            });
        });
    </script>

    <script src="~/js/member-personal-training-live.js"
            asp-append-version="true">
    </script>
}
