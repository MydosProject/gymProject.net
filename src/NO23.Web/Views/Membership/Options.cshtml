@model NO23.Web.ViewModels.Membership.MembershipOptionsViewModel
@{ ViewData["Title"] = "Hizmet Seçeneğini Belirle"; }

<section class="membership-options-page">
    <div class="membership-options-grid-bg" aria-hidden="true"></div>
    <div class="container position-relative">
        <a class="membership-options-back" asp-controller="Home" asp-action="Index" asp-fragment="memberships">← Üyelik paketlerine dön</a>
        <header class="membership-options-hero">
            <div><p class="section-kicker">NO23 / @Model.PackageCode</p><h1>Paketini seçtin.<br /><span>Şimdi çalışma düzenini belirle.</span></h1></div>
            <div class="membership-options-selected"><small>SEÇİLİ ANA PAKET</small><strong>@Model.PackageName</strong><span>@Model.PackageAudience</span></div>
        </header>

        <div class="membership-options-step"><span>01</span><div><small>HİZMET TERCİHİ</small><h2>Sana uygun seçeneği belirle.</h2></div><b>01 / 02</b></div>
        <div class="membership-options-list">
            @for (var index = 0; index < Model.Options.Count; index++)
            {
                var option = Model.Options[index];
                <article class="membership-option-card @(index == 0 ? "is-featured" : string.Empty)">
                    @if (index == 0) { <span class="membership-option-badge">Önerilen</span> }
                    <div class="membership-option-head"><span>@(index + 1).ToString("00")</span><strong>@option.DurationDays GÜN</strong></div>
                    <h3>@option.Name</h3><p>@option.Description</p>
                    <ul>
                        @if (option.PersonalTrainingSessionCount > 0) { <li>@option.PersonalTrainingSessionCount birebir PT seansı</li> }
                        @if (option.GroupClassCreditCount > 0) { <li>@option.GroupClassCreditCount grup dersi hakkı</li> }
                        @if (option.IncludesGymAccess) { <li>Salon kullanım hakkı</li> }
                        @if (option.PersonalTrainingSessionCount == 0) { <li>Personal Training içermez</li> }
                    </ul>
                    <a asp-area="Identity" asp-page="/Account/Register" asp-route-package="@Model.PackageCode" asp-route-option="@option.Id">Bu Seçenekle Devam Et <span>→</span></a>
                </article>
            }
        </div>
        <div class="membership-options-note"><span>02</span><p>Seçimini kayıt ekranında değiştirebilirsin. Bu aşamada ödeme alınmayacaktır.</p></div>
    </div>
</section>
