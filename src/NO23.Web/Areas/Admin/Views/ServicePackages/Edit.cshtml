@model ServicePackageFormViewModel
@{ViewData["Title"]="Hizmet Paketi Düzenle";}
<section class="admin-page"><div class="container"><header class="admin-page-head admin-form-head"><div><a asp-action="Index" class="admin-back-link">← Kataloğa dön</a><p class="admin-eyebrow">Paket Kataloğu</p><h1>@Model.Name</h1><p class="admin-page-description">Paket içeriğini ve satın alınabilir varyantlarını yönet.</p></div></header><partial name="_Form" model="Model" />
<section class="admin-form-section bg-white border rounded-3 p-4 text-dark mt-4"><header><span>03</span><div><h2>Süre, ders ve fiyat varyantları</h2><p>Esnek/3/6/12 aylık veya 8/12/24 ders gibi seçenekleri tanımla.</p></div></header><div class="d-flex justify-content-end mb-3"><a class="btn btn-dark" asp-action="CreateVariant" asp-route-packageId="@Model.Id">+ Varyant Ekle</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Varyant</th><th>Haklar</th><th>Fiyat</th><th>Durum</th><th></th></tr></thead><tbody>@foreach(var v in Model.Variants){<tr><td><strong>@v.Name</strong>@if(v.IsRecommended){<span class="badge text-bg-warning ms-2">Önerilen</span>}</td><td>@v.Rights</td><td>@v.Price</td><td>@(v.IsActive?"Aktif":"Pasif")</td><td class="text-end"><a class="btn btn-sm btn-outline-dark" asp-action="EditVariant" asp-route-id="@v.Id">Düzenle</a><form method="post" asp-action="DeleteVariant" asp-route-id="@v.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Sil</button></form></td></tr>}</tbody></table></div></section>
</div></section>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
