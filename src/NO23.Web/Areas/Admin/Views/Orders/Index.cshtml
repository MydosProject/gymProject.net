@model IReadOnlyList<OrderListItemViewModel>
@{
    ViewData["Title"] = "Orders";
}

<section class="py-5">
    <div class="container">
        <div class="mb-4">
            <p class="text-uppercase text-muted small mb-1">Admin</p>
            <h1 class="h3 mb-0">Orders</h1>
        </div>

        <div class="table-responsive bg-white border rounded-3">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Member</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Delivery</th>
                        <th>Items</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>@order.OrderNumber</strong></td>
                            <td>@order.MemberName</td>
                            <td>@order.Type</td>
                            <td>@order.Status</td>
                            <td>@order.PaymentStatus</td>
                            <td>@order.DeliveryDate.ToString("dd.MM.yyyy") @order.DeliveryTimeSlot</td>
                            <td>@order.ItemCount</td>
                            <td>@order.Total.ToString("C0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
