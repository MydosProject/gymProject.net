@model CommunityChallengeFormViewModel

<form method="post" class="bg-white border rounded-3 p-4 text-dark">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Title" class="form-label">Başlık</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Slug" class="form-label">URL kısa adı</label>
            <input asp-for="Slug" class="form-control" />
            <span asp-validation-for="Slug" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Summary" class="form-label">Kısa özet</label>
            <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Summary" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label">Açıklama</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Goal" class="form-label">Hedef</label>
            <textarea asp-for="Goal" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Goal" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Reward" class="form-label">Ödül</label>
            <input asp-for="Reward" class="form-control" />
            <span asp-validation-for="Reward" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="TargetDailyCalories" class="form-label">Günlük hedef kalori</label>
            <input asp-for="TargetDailyCalories" class="form-control" type="number" min="800" max="5000" />
            <div class="form-text">Challenge için baz alınacak günlük hedef.</div>
            <span asp-validation-for="TargetDailyCalories" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="CalorieTolerancePercent" class="form-label">Tolerans (%)</label>
            <input asp-for="CalorieTolerancePercent" class="form-control" type="number" min="0" max="50" step="0.1" />
            <div class="form-text">Örn. 10 girilirse hedefin yüzde 10 altı/üstü uyumlu sayılır.</div>
            <span asp-validation-for="CalorieTolerancePercent" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="RequiredCompletionPercent" class="form-label">Tamamlama oranı (%)</label>
            <input asp-for="RequiredCompletionPercent" class="form-control" type="number" min="1" max="100" />
            <div class="form-text">Başarılı gün oranı bu değere ulaşınca challenge tamamlanır.</div>
            <span asp-validation-for="RequiredCompletionPercent" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="StartsOn" class="form-label">Başlangıç tarihi</label>
            <input asp-for="StartsOn" class="form-control" type="date" />
            <span asp-validation-for="StartsOn" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="EndsOn" class="form-label">Bitiş tarihi</label>
            <input asp-for="EndsOn" class="form-control" type="date" />
            <span asp-validation-for="EndsOn" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Status" class="form-label">Durum</label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<CommunityChallengeStatus>()" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="DisplayOrder" class="form-label">Sıralama</label>
            <input asp-for="DisplayOrder" class="form-control" />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="ImageUrl" class="form-label">Görsel URL</label>
            <input asp-for="ImageUrl" class="form-control" />
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        <button type="submit" class="btn btn-dark">Kaydet</button>
    </div>
</form>
