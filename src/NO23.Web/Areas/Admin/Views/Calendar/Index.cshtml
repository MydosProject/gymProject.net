@model NO23.Web.ViewModels.Admin.WeeklyCalendarViewModel
@section Styles { <link rel="stylesheet" href="~/css/admin-calendar.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/weekly-personal-schedule.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/calendar-bulk.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/consultation-calendar.css" asp-append-version="true" /> }
@using NO23.Web.Services
@using NO23.Web.Domain.Enums
@using NO23.Web.Extensions
@{
    ViewData["Title"] = Model.ViewMode == "day" ? "Günlük Takvim" : "Haftalık Takvim";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    var memberPeriods = Model.MemberPackagePeriods.ToDictionary(item => item.Id);
    var today = ClubTime.Now.Date;
}
<section class="admin-page">
    <header class="admin-page-head"><div><h1>@(Model.ViewMode == "day" ? "Günlük takvim" : "Haftalık takvim")</h1><p>Grup derslerini, birebir seansları ve ön görüşmeleri birlikte planla. Tüm saatler Türkiye saatidir.</p></div></header>
    @foreach (var key in new[] { "SuccessMessage", "ErrorMessage" })
    { if (TempData[key] is string message) { <div class="alert @(key == "ErrorMessage" ? "alert-danger" : "alert-success")" role="status">@message</div> } }
    <partial name="/Views/Shared/_CalendarNavigation.cshtml" model="Model.Navigation" />
    @if (Model.Credits is not null) { <partial name="/Views/Shared/_LessonCreditSummary.cshtml" model="Model.Credits" /><p><a asp-controller="Members" asp-action="Credits" asp-route-id="@Model.MemberId">Ders hakkı kontrolü ve geçmişi →</a></p> }
    <div class="row g-3 mb-4">
        <div class="col-lg-6"><details class="border rounded p-3 bg-white text-dark"><summary>+ Haftalık grup dersi ekle</summary>
            <form asp-action="CreateGroup" method="post" class="mt-3"><input type="hidden" name="IncludeCompleted" value="@Model.IncludeCompleted.ToString().ToLowerInvariant()" /><input type="hidden" name="FilterMemberId" value="@Model.MemberId" /><input type="hidden" name="FilterTrainerId" value="@Model.TrainerId" />
                <label class="form-label">Grup dersi</label><select name="GroupClassId" class="form-select mb-2" asp-items="Model.Classes" required><option value="">Ders seç</option></select>
                <label>Başlangıç haftası <input name="Week" type="date" value="@Model.Week.ToString("yyyy-MM-dd")" class="form-control" required /></label>
                <fieldset class="my-2"><legend class="fs-6">Haftanın günleri</legend>
                    @for(var i=0;i<7;i++){ var day=(DayOfWeek)((i+1)%7); <label class="me-2"><input type="checkbox" name="Days" value="@day" /> @culture.DateTimeFormat.GetDayName(day)</label> }
                </fieldset>
                <label>Saat <input type="time" name="Time" value="18:00" required class="form-control" /></label>
                <label>Sezon süresi (hafta) <input type="number" name="Weeks" min="1" max="52" value="1" class="form-control" required /></label>
                <label>Kontenjan (boşsa dersin kontenjanı) <input type="number" name="Capacity" min="1" max="200" class="form-control" /></label>
                <p class="mt-2">Seçtiğin gün ve saatte 52 haftaya kadar sezonluk seans oluşturabilirsin. Çakışma varsa hiçbir seans eklenmez.</p>
                <button class="btn btn-dark">Haftalık programı oluştur</button>
            </form></details></div>
        <div class="col-lg-6"><details class="border rounded p-3 bg-white text-dark"><summary>+ Birebir ders ekle</summary>
            <form asp-action="CreatePersonal" method="post" class="mt-3"><input type="hidden" name="IncludeCompleted" value="@Model.IncludeCompleted.ToString().ToLowerInvariant()" /><input type="hidden" name="FilterMemberId" value="@Model.MemberId" /><input type="hidden" name="FilterTrainerId" value="@Model.TrainerId" />
                <label class="form-label">Antrenör</label><select name="TrainerId" asp-items="Model.Trainers" class="form-select" required><option value="">Antrenör seç</option></select>
                <label class="form-label">Üye</label><select name="MemberProfileId" asp-items="Model.Members" class="form-select" required><option value="">Üye seç</option></select>
                <p>Yönetici olarak üyeyi atanmış antrenöründen farklı bir antrenöre planlayabilir; bugün, geçmiş veya gelecek tarihli manuel kayıt girebilirsin. Kalıcı atama değişmez.</p>
                <label>Tarih ve saat <input name="StartsAt" type="datetime-local" required class="form-control" /></label>
                <label>Süre (dakika) <input name="DurationMinutes" type="number" min="15" max="240" value="50" required class="form-control" /></label>
                <label class="d-block">Not <textarea name="Note" maxlength="600" class="form-control"></textarea></label>
                <button class="btn btn-dark mt-2">Takvime ekle</button>
            </form></details></div>
    </div>
    <details class="border rounded p-3 bg-white text-dark mb-4">
        <summary>+ Haftalık sabit birebir program ekle</summary>
        <form asp-action="CreateWeeklyPersonal" method="post" class="row g-2 mt-2" data-weekly-personal-schedule data-preview-url="@Url.Action("PreviewWeekly")"><input type="hidden" name="IncludeCompleted" value="@Model.IncludeCompleted.ToString().ToLowerInvariant()" /><input type="hidden" name="FilterMemberId" value="@Model.MemberId" /><input type="hidden" name="FilterTrainerId" value="@Model.TrainerId" />
            <div class="col-md-6"><label class="form-label">Antrenör</label><select name="TrainerId" asp-items="Model.Trainers" class="form-select" required><option value="">Antrenör seç</option></select></div>
            <div class="col-md-6"><label class="form-label">Üye</label><select name="MemberProfileId" class="form-select" required data-schedule-member><option value="">Üye seç</option>
                @foreach (var member in Model.Members)
                {
                    var period = memberPeriods.GetValueOrDefault(int.Parse(member.Value));
                    <option value="@member.Value" data-package-start-utc="@period?.MembershipStartsAtUtc?.ToString("yyyy-MM-ddTHH:mm:ss.fff'Z'")" data-package-end-utc="@period?.MembershipEndsAtUtc?.ToString("yyyy-MM-ddTHH:mm:ss.fff'Z'")">@member.Text</option>
                }
            </select></div>
            <div class="col-md-4"><label class="form-label">Başlangıç haftası</label><input name="Week" type="date" value="@Model.Week.ToString("yyyy-MM-dd")" class="form-control" required /></div>
            <div class="col-md-4"><label class="form-label">Saat</label><input name="Time" type="time" value="11:00" class="form-control" required /></div>
            <div class="col-md-4" data-automatic-schedule-field><label class="form-label" for="automaticScheduleLength">Program süresi (otomatik)</label><output id="automaticScheduleLength" class="form-control" data-automatic-schedule-length aria-live="polite">Üye seçin</output></div>
            <div class="col-md-4" data-manual-schedule-field hidden><label class="form-label" for="manualScheduleWeeks">Hafta sayısı (bitiş tarihi bilinmiyor)</label><input id="manualScheduleWeeks" name="Weeks" type="number" min="1" max="52" value="4" class="form-control" disabled /></div>
            <fieldset class="col-12"><legend class="fs-6">Sabit günler</legend>
                @for(var i=0;i<7;i++){ var day=(DayOfWeek)((i+1)%7); <label class="me-3"><input type="checkbox" name="Days" value="@day" /> @culture.DateTimeFormat.GetDayName(day)</label> }
            </fieldset>
            <div class="col-md-4"><label class="form-label">Süre (dakika)</label><input name="DurationMinutes" type="number" min="15" max="240" value="50" class="form-control" required /></div>
            <div class="col-md-8"><label class="form-label">Not</label><input name="Note" maxlength="600" class="form-control" /></div>
            <div class="schedule-account col-12" data-schedule-account aria-live="polite"></div><p class="mb-0" data-schedule-description aria-live="polite">Üyeyi seçin; program süresi paket bitişinden otomatik hesaplanır. Bitiş tarihi bilinmeyen eski üyeler için hafta sayısı girilir.</p>
            <p class="mb-0">Başlangıç haftası bugün, geçmiş veya gelecek olabilir. Dersler paket dönemi içinde kalır. Birebir ders hakkı ve çakışmalar kontrol edilir; hata varsa hiçbir ders eklenmez.</p>
            <div><button class="btn btn-dark">Haftalık birebir programı oluştur</button></div>
        </form>
        <form asp-action="ReviewCredits" method="post" class="schedule-credit-review mt-3" data-schedule-credit-review hidden>
            <strong>Eski tamamlanmış derslerde işlenmemiş hak var</strong>
            <p data-credit-review-description></p>
            <input type="hidden" name="MemberProfileId" />
            <input type="hidden" name="ExpectedCount" />
            <input type="hidden" name="ExpectedBalance" />
            <input type="hidden" name="Week" value="@Model.Week.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="IncludeCompleted" value="@Model.IncludeCompleted.ToString().ToLowerInvariant()" />
            <label class="d-block mb-2">Hak düzeltme yöntemi
                <select name="AlreadyAdjusted" class="form-select" required>
                    <option value="">Ders geçmişini kontrol edip seçin</option>
                    <option value="false">Bu dersler düşülmemiş; bakiyeden düş</option>
                    <option value="true">Önceden manuel düşülmüş; bakiyeyi koru ve işlenmiş say</option>
                </select>
            </label>
            <label class="d-block mb-2"><input type="checkbox" name="Confirmed" value="true" required /> Ders geçmişini ve bakiyeyi kontrol ettim; seçtiğim işlemi doğruluyorum.</label>
            <button class="btn btn-dark" type="submit">Kontrol edilen ders haklarını işle</button>
        </form>
    </details>
    @await Html.PartialAsync("_CalendarBulkToolbar", new NO23.Web.ViewModels.Admin.CalendarBulkInput { Week = Model.Week, TrainerId = Model.TrainerId, MemberId = Model.MemberId, IncludeCompleted = Model.IncludeCompleted })
    <div class="weekly-calendar-legend" aria-label="Ders türleri">
        <span class="calendar-kind is-personal">Birebir</span><span class="calendar-kind">Grup</span><span class="calendar-kind is-consultation">Ön görüşme</span>
        <p>Toplu işlem için ders kartındaki seçim kutusunu işaretleyin.</p>
    </div>
    <div class="weekly-calendar @(Model.ViewMode == "day" ? "is-day-view" : null)">
    @foreach(var date in Model.DisplayDays)
    {
        var entries=Model.EntriesFor(date);
        <section class="weekly-calendar-day @(date.Date == today ? "is-today" : null)" aria-label="@date.ToString("dddd dd MMMM", culture)">
        <header class="calendar-day-head">
            <h2><a class="calendar-day-link" asp-action="Index" asp-route-view="day" asp-route-date="@date.ToString("yyyy-MM-dd")" asp-route-trainerId="@Model.TrainerId" asp-route-memberId="@Model.MemberId" asp-route-includeCompleted="@Model.IncludeCompleted">@date.ToString("dddd",culture)</a><time datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("dd MMM", culture)</time></h2>
            <div class="calendar-day-indicators">
                @if(date.Date == today){<span class="calendar-today">Bugün</span>}
                <span class="calendar-day-count">@entries.Count kayıt</span>
            </div>
        </header>
        @if(entries.Count==0){<div class="calendar-day-empty"><strong>Ders yok</strong><p>Bu gün için ders planlanmamış.</p></div>}
        @foreach(var entry in entries)
        {
        <div class="calendar-entry"><time class="calendar-entry-clock">@ClubTime.ToLocal(entry.StartsAtUtc).ToString("HH:mm")</time>
        @if (entry.Appointment is { } appointment)
        {
            <partial name="/Views/Shared/_ConsultationCalendarCard.cshtml" model="appointment" />
        }
        else if (entry.Group is { } session)
        {
            var participants=session.Reservations.Where(x=>x.Status==ClassReservationStatus.Reserved).ToList();
            <article id="group-session-@session.Id" class="weekly-calendar-session">
                <div class="calendar-session-top"><span class="calendar-kind">Grup</span><span class="calendar-duration">@session.GroupClass.DurationMinutes dk</span></div>
                <time class="calendar-session-time" datetime="@ClubTime.ToLocal(session.StartsAtUtc).ToString("yyyy-MM-ddTHH:mm")">@ClubTime.ToLocal(session.StartsAtUtc).ToString("HH:mm")</time>
                <h3>@session.GroupClass.Name</h3>
                <p class="calendar-session-trainer"><span>Eğitmen</span><strong>@session.GroupClass.Trainer.FirstName @session.GroupClass.Trainer.LastName</strong></p>
                <div class="calendar-session-state"><span class="calendar-status is-@session.Status.ToString().ToLowerInvariant()">@session.Status.GetDisplayName()</span><span class="calendar-capacity">@participants.Count / @(session.CapacityOverride??session.GroupClass.Capacity) kişi</span></div>
                @if(session.Status==ClassSessionStatus.Scheduled){<label class="calendar-session-select"><input id="select-group-@session.Id" type="checkbox" name="GroupIds" value="@session.Id" form="calendar-bulk-form" /><span>Toplu seçime ekle</span></label>}
                <a class="calendar-session-edit" asp-controller="ClassSessions" asp-action="Edit" asp-route-id="@session.Id">Seansı düzenle <span aria-hidden="true">→</span></a>
                <details><summary>Katılımcılar (@participants.Count)</summary>
                    @foreach(var person in participants){<div class="border-bottom py-2">@person.MemberProfile.ApplicationUser.FirstName @person.MemberProfile.ApplicationUser.LastName
                        <form asp-controller="ClassSessions" asp-action="RemoveReservation" method="post"><input type="hidden" name="IncludeCompleted" value="@Model.IncludeCompleted.ToString().ToLowerInvariant()" /><input type="hidden" name="FilterMemberId" value="@Model.MemberId" /><input type="hidden" name="FilterTrainerId" value="@Model.TrainerId" /><input name="id" type="hidden" value="@session.Id" /><input name="reservationId" type="hidden" value="@person.Id" /><button class="btn btn-sm btn-outline-danger">Çıkar</button></form></div>}
                    @if(session.Status==ClassSessionStatus.Scheduled && session.StartsAtUtc>DateTime.UtcNow){
                    <form asp-action="AddParticipant" method="post" class="mt-2"><input type="hidden" name="IncludeCompleted" value="@Model.IncludeCompleted.ToString().ToLowerInvariant()" /><input type="hidden" name="FilterMemberId" value="@Model.MemberId" /><input type="hidden" name="FilterTrainerId" value="@Model.TrainerId" /><input name="sessionId" type="hidden" value="@session.Id" /><input name="week" type="hidden" value="@Model.Week.ToString("yyyy-MM-dd")" />
                        <label>Katılımcı seç<select name="memberId" asp-items="Model.Members" required class="form-select"><option value="">Üye seç</option></select></label><button class="btn btn-dark btn-sm mt-2">Katılımcı ekle</button>
                    </form>}
                </details>
            </article>
        }
        else if (entry.Personal is { } personalSession)
        {
            <article id="personal-session-@personalSession.Id" class="weekly-calendar-session is-personal">
                <div class="calendar-session-top"><span class="calendar-kind is-personal">Birebir</span><span class="calendar-duration">@personalSession.DurationMinutes dk</span></div>
                <time class="calendar-session-time" datetime="@ClubTime.ToLocal(personalSession.StartsAtUtc).ToString("yyyy-MM-ddTHH:mm")">@ClubTime.ToLocal(personalSession.StartsAtUtc).ToString("HH:mm")</time>
                <h3>@personalSession.MemberProfile.ApplicationUser.FirstName @personalSession.MemberProfile.ApplicationUser.LastName</h3>
                <p class="calendar-session-trainer"><span>Eğitmen</span><strong>@personalSession.Trainer.FirstName @personalSession.Trainer.LastName</strong></p>
                <div class="calendar-session-state"><span class="calendar-status is-@personalSession.Status.ToString().ToLowerInvariant()">@personalSession.Status.GetDisplayName()</span></div>
                <details class="calendar-read-details"><summary>Ders detayları ve geçmiş</summary>
                    <dl><dt>Başlangıç</dt><dd>@ClubTime.ToLocal(personalSession.StartsAtUtc).ToString("dd.MM.yyyy HH:mm")</dd><dt>Bitiş</dt><dd>@ClubTime.ToLocal(personalSession.StartsAtUtc.AddMinutes(personalSession.DurationMinutes)).ToString("HH:mm")</dd><dt>Hak işlemi</dt><dd>@(personalSession.CreditConsumed ? "İşlenmiş" : "Henüz işlenmemiş / ayrılmış")</dd><dt>Not</dt><dd>@(personalSession.Note ?? "—")</dd></dl>
                    <a asp-controller="Members" asp-action="Credits" asp-route-id="@personalSession.MemberProfileId">Üyenin ders haklarını incele →</a>
                    <ul>@foreach(var history in personalSession.History.OrderByDescending(x => x.ChangedAtUtc)) { <li>@ClubTime.ToLocal(history.ChangedAtUtc).ToString("dd.MM.yyyy HH:mm") · @history.NewStatus.GetDisplayName() · @ClubTime.ToLocal(history.PreviousStartsAtUtc).ToString("dd.MM HH:mm") → @ClubTime.ToLocal(history.NewStartsAtUtc).ToString("dd.MM HH:mm")<br />@history.Note</li> }</ul>
                </details>
                @if(personalSession.Status==PersonalTrainingSessionStatus.Scheduled){<label class="calendar-session-select"><input id="select-personal-@personalSession.Id" type="checkbox" name="PersonalIds" value="@personalSession.Id" form="calendar-bulk-form" /><span>Toplu seçime ekle</span></label>}
                @if(personalSession.Status==PersonalTrainingSessionStatus.Scheduled){<details><summary>Dersi düzenle</summary>
                <form asp-action="UpdatePersonal" method="post"><input type="hidden" name="IncludeCompleted" value="@Model.IncludeCompleted.ToString().ToLowerInvariant()" /><input type="hidden" name="FilterMemberId" value="@Model.MemberId" /><input type="hidden" name="FilterTrainerId" value="@Model.TrainerId" />
                    <input name="Id" type="hidden" value="@personalSession.Id" /><input name="TrainerId" type="hidden" value="@personalSession.TrainerId" /><input name="Week" type="hidden" value="@Model.Week.ToString("yyyy-MM-dd")" />
                    <label>İşlem<select name="Status" class="form-select"><option value="Postponed">Tarih / saat değiştir</option><option value="Completed">Tamamlandı</option><option value="Cancelled">İptal edildi</option><option value="NoShow">Katılmadı</option></select></label>
                    <label>Yeni tarih ve saat<input name="PostponedStartsAt" type="datetime-local" class="form-control" /></label>
                    <label>Not<textarea name="Note" maxlength="600" class="form-control"></textarea></label>
                    <small>Erteleme ve iptalde ders hakkı korunur. Tamamlandı veya katılmadı işlemi bir ders hakkı düşer.</small>
                    <button class="btn btn-dark btn-sm mt-2">Kaydet</button>
                </form></details>}
            </article>
        }
        </div>
        }
        </section>
    }
    </div>
</section>
@section Scripts {
    <script src="~/js/calendar-bulk.js" asp-append-version="true"></script>
    <script src="~/js/weekly-personal-schedule.js" asp-append-version="true"></script>
}
