@model GroupClassFormViewModel
@{
    ViewData["Title"] = "Yeni Grup Dersi";
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head admin-form-head">
            <div>
                <a asp-action="Index" class="admin-back-link">← Derslere dön</a>
                <p class="admin-eyebrow">Kulüp / Ders Yönetimi</p>
                <h1>Yeni grup dersi</h1>
                <p class="admin-page-description">Public programda yer alacak yeni dersin eğitmen, performans ve kapasite bilgilerini oluştur.</p>
            </div>
        </header>

        <partial name="_GroupClassForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
