@using NO23.Web.Domain.Enums
@model NO23.Web.ViewModels.Member.KitchenCheckoutViewModel

@{
    ViewData["Title"] = "Kitchen Paket Ödemesi";
}

<section class="member-kitchen-checkout-page">
    <div class="container">
        <div class="member-kitchen-checkout-shell">

            <header class="member-kitchen-checkout-hero">
                <div>
                    <p class="member-kitchen-checkout-kicker">
                        NO23 KITCHEN / ÖDEME
                    </p>

                    <h1>@Model.PackageName</h1>

                    <p class="member-kitchen-checkout-summary">
                        @Model.PackageDays gün
                        <span>•</span>
                        @Model.PackagePrice.ToString("C0")
                    </p>
                </div>

                <div class="member-kitchen-checkout-price">
                    <span>Paket Tutarı</span>
                    <strong>@Model.PackagePrice.ToString("C0")</strong>
                    <small>@Model.PackageDays günlük Kitchen planı</small>
                </div>
            </header>

            <div class="member-kitchen-checkout-note">
                <span class="member-kitchen-checkout-note-icon"
                      aria-hidden="true">
                    i
                </span>

                <div>
                    <strong>Teslimat yöntemini şimdi seçebilirsin.</strong>

                    <p>
                        Adresine teslim veya NO23 Sports Club'dan teslim alma
                        seçeneklerinden sana uygun olanı belirle.
                    </p>
                </div>
            </div>

            <form asp-area="Member"
                  asp-controller="Kitchen"
                  asp-action="Checkout"
                  method="post"
                  class="member-kitchen-checkout-form"
                  data-turkey-location-root>

                <input asp-for="KitchenSubscriptionId"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="member-kitchen-checkout-validation"
                     role="alert">
                </div>

                @if (!Model.IsPaymentAvailable)
                {
                    <div class="alert alert-warning" role="status">
                        Online ödeme şu anda kullanılamıyor. Paket siparişi geçici olarak durduruldu.
                    </div>
                }

                <div class="member-kitchen-checkout-form-head">
                    <div>
                        <p>TESLİMAT BİLGİLERİ</p>
                        <h2>Bilgilerini tamamla.</h2>
                    </div>

                    <span>01</span>
                </div>

                <fieldset class="shop-delivery-method member-kitchen-checkout-delivery-method"
                          data-delivery-method-root>
                    <legend>Teslimat yöntemi</legend>
                    <label>
                        <input asp-for="DeliveryMethod"
                               type="radio"
                               value="@OrderDeliveryMethod.AddressDelivery" />
                        <span>
                            Adrese teslim
                            <small>Seçeceğin il ve ilçedeki adresine gönderilir.</small>
                        </span>
                    </label>
                    <label>
                        <input asp-for="DeliveryMethod"
                               type="radio"
                               value="@OrderDeliveryMethod.ClubPickup" />
                        <span>
                            Salondan teslim
                            <small>@Model.ClubPickupDisplayName</small>
                        </span>
                    </label>
                    <span asp-validation-for="DeliveryMethod"></span>
                </fieldset>

                <div class="member-kitchen-checkout-grid">

                    <label class="member-kitchen-checkout-field">
                        <span>Ad Soyad</span>

                        <input asp-for="FullName"
                               autocomplete="name" />

                        <small asp-validation-for="FullName"></small>
                    </label>

                    <label class="member-kitchen-checkout-field">
                        <span>Telefon</span>

                        <input asp-for="PhoneNumber"
                               autocomplete="tel" />

                        <small asp-validation-for="PhoneNumber"></small>
                    </label>

                    <label class="member-kitchen-checkout-field is-wide"
                           data-address-delivery-field>
                        <span>Adres</span>

                        <textarea asp-for="AddressLine"
                                  rows="3"
                                  autocomplete="street-address"></textarea>

                        <small asp-validation-for="AddressLine"></small>
                    </label>

                    <label class="member-kitchen-checkout-field"
                           data-address-delivery-field>
                        <span>İl</span>

                        <select asp-for="City"
                                autocomplete="address-level1"
                                data-turkey-city
                                data-selected-value="@Model.City">
                            <option value="">İl seçin</option>
                        </select>

                        <small asp-validation-for="City"></small>
                    </label>

                    <label class="member-kitchen-checkout-field"
                           data-address-delivery-field>
                        <span>İlçe</span>

                        <select asp-for="District"
                                autocomplete="address-level2"
                                data-turkey-district
                                data-selected-value="@Model.District"
                                disabled>
                            <option value="">Önce il seçin</option>
                        </select>

                        <small asp-validation-for="District"></small>
                    </label>

                </div>

                <div class="member-kitchen-checkout-footer">
                    <div>
                        <span>Sonraki adım</span>
                        <strong>iyzico güvenli ödeme ekranı</strong>
                    </div>

                    <button type="submit"
                            class="member-kitchen-checkout-submit"
                            disabled="@(!Model.IsPaymentAvailable)">
                        @(Model.IsPaymentAvailable ? "Ödeme Adımına Devam Et" : "Ödeme Kullanılamıyor")
                        <span aria-hidden="true">→</span>
                    </button>
                </div>

            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
