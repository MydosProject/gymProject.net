@model IReadOnlyList<BlogPostCardViewModel>

@{
    ViewData["Title"] = "Blog";
    var featuredPost = Model.FirstOrDefault();
    var remainingPosts = Model.Skip(1).ToList();

    string GetCategoryName(string category)
    {
        return category switch
        {
            "Training" => "Antrenman",
            "Nutrition" => "Beslenme",
            "Lifestyle" => "Yaşam",
            "Recovery" => "Toparlanma",
            _ => category
        };
    }
}

<section class="blog-page content-page">
    <div class="content-page-grid" aria-hidden="true"></div>

    <div class="container position-relative">
        <header class="content-hero blog-hero">
            <div class="content-hero-copy">
                <p class="content-kicker">NO23 Blog · Knowledge in Motion</p>
                <h1>
                    Bilgiyi
                    <span>harekete dönüştür.</span>
                </h1>
                <p class="content-hero-description">
                    Antrenman, beslenme, toparlanma ve yaşam tarzı üzerine sade,
                    uygulanabilir ve hedef odaklı NO23 içerikleri.
                </p>
            </div>

            <aside class="blog-hero-index">
                <span>Blog / @DateTime.Now.Year</span>
                <strong>@Model.Count.ToString("00")</strong>
                <p>Güncel içerik</p>
            </aside>
        </header>

        @if (featuredPost is null)
        {
            <div class="content-empty-state blog-empty-state">
                <span>J</span>
                <div>
                    <h3>Yeni içerikler hazırlanıyor.</h3>
                    <p>NO23 Blog çok yakında yeni yazılarla burada.</p>
                </div>
            </div>
        }
        else
        {
            <section class="blog-featured-section">
                <p class="content-section-kicker">Öne çıkan içerik</p>

                <article class="blog-featured-card">
                    <div class="blog-featured-visual">
                        @if (!string.IsNullOrWhiteSpace(featuredPost.CoverImageUrl))
                        {
                            <img src="@featuredPost.CoverImageUrl"
                                 alt="@featuredPost.Title"
                                 loading="eager" />
                        }
                        else
                        {
                            <span>NO23</span>
                            <strong>BLOG</strong>
                            <small>01 / @DateTime.Now.Year</small>
                        }
                    </div>

                    <div class="blog-featured-content">
                        <div class="blog-post-meta">
                            <span>@GetCategoryName(featuredPost.Category)</span>
                            <span>@(featuredPost.PublishedAtUtc?.ToString("dd.MM.yyyy") ?? "Yeni")</span>
                        </div>

                        <h2>@featuredPost.Title</h2>
                        <p>@featuredPost.Summary</p>

                        @if (!string.IsNullOrWhiteSpace(featuredPost.Tags))
                        {
                            <div class="blog-tag-list" aria-label="Etiketler">
                                @foreach (var tag in featuredPost.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span>#@tag.Trim()</span>
                                }
                            </div>
                        }

                        <a class="blog-read-link"
                           asp-controller="Blog"
                           asp-action="Details"
                           asp-route-slug="@featuredPost.Slug"
                           data-content-modal-open="blog-modal-@featuredPost.Id"
                           aria-haspopup="dialog"
                           aria-controls="blog-modal-@featuredPost.Id">
                            Yazıyı Oku
                            <span aria-hidden="true">↗</span>
                        </a>
                    </div>
                </article>
            </section>

            @if (remainingPosts.Count > 0)
            {
                <section class="content-section blog-latest-section">
                    <div class="content-section-heading">
                        <div>
                            <p class="content-section-kicker">Son yazılar</p>
                            <h2>Ritmini geliştiren fikirler.</h2>
                        </div>
                        <p>
                            Karmaşık bilgiyi günlük rutinde uygulayabileceğin net
                            adımlara dönüştürüyoruz.
                        </p>
                    </div>

                    <div class="blog-post-grid">
                        @for (var index = 0; index < remainingPosts.Count; index++)
                        {
                            var item = remainingPosts[index];

                            <article class="blog-post-card">
                                <div class="blog-post-card-top">
                                    <span>@GetCategoryName(item.Category)</span>
                                    <strong>@((index + 2).ToString("00"))</strong>
                                </div>
                                <div class="blog-post-card-content">
                                    <p>@(item.PublishedAtUtc?.ToString("dd.MM.yyyy") ?? "Yeni")</p>
                                    <h3>@item.Title</h3>
                                    <p>@item.Summary</p>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Tags))
                                {
                                    <div class="blog-tag-list">
                                        @foreach (var tag in item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span>#@tag.Trim()</span>
                                        }
                                    </div>
                                }

                                <a class="blog-read-link"
                                   asp-controller="Blog"
                                   asp-action="Details"
                                   asp-route-slug="@item.Slug"
                                   data-content-modal-open="blog-modal-@item.Id"
                                   aria-haspopup="dialog"
                                   aria-controls="blog-modal-@item.Id">
                                    Yazıyı Oku
                                    <span aria-hidden="true">↗</span>
                                </a>
                            </article>
                        }
                    </div>
                </section>
            }
        }
    </div>

    @foreach (var item in Model)
    {
        var publishedAt = item.PublishedAtUtc ?? item.CreatedAtUtc;
        var paragraphs = item.Content
            .Replace("\r\n", "\n")
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        <dialog id="blog-modal-@item.Id"
                class="content-reading-modal blog-reading-modal"
                aria-labelledby="blog-modal-title-@item.Id"
                data-content-modal>
            <article class="content-reading-modal-panel">
                <button type="button"
                        class="content-reading-modal-close"
                        aria-label="Yazıyı kapat"
                        data-content-modal-close>×</button>

                <header class="content-reading-modal-header">
                    <div>
                        <p class="content-section-kicker">NO23 / BLOG</p>
                        <div class="content-reading-modal-meta">
                            <span>@GetCategoryName(item.Category)</span>
                            <time datetime="@publishedAt.ToString("yyyy-MM-dd")">
                                @publishedAt.ToString("dd.MM.yyyy")
                            </time>
                        </div>
                        <h2 id="blog-modal-title-@item.Id">@item.Title</h2>
                        <p>@item.Summary</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                    {
                        <img src="@item.CoverImageUrl" alt="" loading="lazy" />
                    }
                    else
                    {
                        <div class="content-reading-modal-mark" aria-hidden="true">23</div>
                    }
                </header>

                <div class="content-reading-modal-body">
                    @foreach (var paragraph in paragraphs)
                    {
                        <p>@paragraph</p>
                    }
                </div>

                <footer class="content-reading-modal-footer">
                    @if (!string.IsNullOrWhiteSpace(item.Tags))
                    {
                        <div class="blog-tag-list" aria-label="Etiketler">
                            @foreach (var tag in item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span>#@tag.Trim()</span>
                            }
                        </div>
                    }
                    <button type="button" data-content-modal-close>Kapat</button>
                </footer>
            </article>
        </dialog>
    }
</section>
