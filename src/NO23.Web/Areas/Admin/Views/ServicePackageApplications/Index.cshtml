@model IReadOnlyList<ServicePackageApplicationListItemViewModel>
@using NO23.Web.Extensions

@{
    var navigation = (NO23.Web.ViewModels.ListNavigationViewModel)ViewData["ListNavigation"]!;
    ViewData["Title"] = "Paket Başvuruları";
    var statuses = Enum.GetValues<ServicePackageApplicationStatus>();
    var pendingCount = (int)ViewBag.PendingCount;
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">NO23 CLUB / ÜYELER &amp; PAKETLER</p>
                <h1>Paket başvuruları</h1>
                <p class="admin-page-description">
                    Membership, birebir antrenman, grup dersi ve Kids Club
                    paketleri için gönderilen başvuruları buradan takip et.
                </p>
            </div>
        </header>
<partial name="/Views/Shared/_ListFilters.cshtml" model="navigation" />

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="status">
                @successMessage
            </div>
        }

        <section class="admin-metrics"
                 aria-label="Paket başvurusu özeti">
            <article>
                <span>Toplam başvuru</span>
                <strong>@(((int)ViewBag.OverallCount).ToString("00"))</strong>
            </article>
            <article>
                <span>Yeni başvuru</span>
                <strong>@pendingCount.ToString("00")</strong>
            </article>
            <article>
                <span>İşlenen</span>
                <strong>@((((int)ViewBag.OverallCount) - pendingCount).ToString("00"))</strong>
            </article>
        </section>

        <div class="table-responsive admin-table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Başvuru</th>
                        <th>Paket seçimi</th>
                        <th>İletişim</th>
                        <th>Not</th>
                        <th>Gönderilme</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="py-5 text-center">
                                Henüz paket başvurusu bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td data-label="Başvuru">
                                    <strong>#@item.Id.ToString("D4")</strong>
                                    <span class="admin-cell-note d-block">
                                        @item.FullName
                                    </span>
                                </td>
                                <td data-label="Paket seçimi">
                                    <strong>@item.PackageName</strong>
                                    <span class="admin-cell-note d-block">
                                        @item.PackageCategory · @item.VariantName
                                    </span>
                                </td>
                                <td data-label="İletişim">
                                    <a href="mailto:@item.Email">@item.Email</a>
                                    <a class="admin-cell-note d-block"
                                       href="tel:@item.PhoneNumber">
                                        @item.PhoneNumber
                                    </a>
                                </td>
                                <td data-label="Not">
                                    @if (!string.IsNullOrWhiteSpace(item.FamilyCode))
                                    {
                                        <strong>@item.FamilyCode</strong>
                                        @if (item.SiblingDiscountPercent > 0) { <span class="admin-cell-note d-block">%@item.SiblingDiscountPercent kardeş indirimi</span> }
                                    }
                                    @if (string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <span class="admin-cell-note">—</span>
                                    }
                                    else
                                    {
                                        <span>@item.Notes</span>
                                    }
                                </td>
                                <td data-label="Gönderilme">
                                    <strong>@item.CreatedAtLocal.ToString("dd.MM.yyyy")</strong>
                                    <span class="admin-cell-note d-block">
                                        @item.CreatedAtLocal.ToString("HH:mm")
                                    </span>
                                </td>
                                <td data-label="Durum">
                                    <form asp-action="UpdateStatus" method="post"
                                          class="d-flex gap-2 align-items-center">
                                        <input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="page" value="@navigation.Page" /><input type="hidden" name="query" value="@navigation.Query" /><input type="hidden" name="state" value="@navigation.State" />
                                        <select name="status"
                                                class="form-select form-select-sm"
                                                aria-label="@item.FullName başvuru durumu">
                                            @foreach (var status in statuses)
                                            {
                                                <option value="@status"
                                                        selected="@(status == item.Status ? "selected" : null)">
                                                    @status.GetDisplayName()
                                                </option>
                                            }
                                        </select>
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-light">
                                            Kaydet
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
<partial name="/Views/Shared/_ListPagination.cshtml" model="navigation" />
</section>
