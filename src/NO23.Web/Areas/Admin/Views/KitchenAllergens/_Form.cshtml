@model KitchenAllergenFormViewModel
<form method="post" class="bg-white border rounded-3 p-4 text-dark">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input type="hidden" asp-for="Id" />
    <div class="row g-3"><div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="DisplayOrder" class="form-label"></label><input asp-for="DisplayOrder" class="form-control" /></div>
    <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
    <div class="col-12"><label class="form-check"><input asp-for="IsActive" class="form-check-input" /> @Html.DisplayNameFor(x => x.IsActive)</label></div></div>
    <div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a><button class="btn btn-dark">Kaydet</button></div>
</form>
