@model IReadOnlyList<PersonalTrainingRequestListItemViewModel>
@{
    ViewData["Title"] = "Birebir Talepler";
    var pendingCount = Model.Count(request => request.IsPending);
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">NO23 CLUB / DERS YÖNETİMİ</p>
                <h1>Birebir talepler</h1>
                <p class="admin-page-description">Üyelerin eğitmenle birebir çalışma taleplerini planla, reddet veya tamamlandı olarak işaretle.</p>
            </div>
            <div class="admin-page-actions">
                <a class="btn btn-outline-dark" asp-area="Admin" asp-controller="ClassSessions" asp-action="Index">Ders programı</a>
            </div>
        </header>

        <div class="admin-metrics">
            <article><span>Toplam talep</span><strong>@Model.Count</strong><small>Tüm kayıtlar</small></article>
            <article><span>Bekleyen</span><strong>@pendingCount</strong><small>İşlem bekliyor</small></article>
            <article><span>İşlenen</span><strong>@(Model.Count - pendingCount)</strong><small>Planlandı veya kapandı</small></article>
        </div>

        <div class="table-responsive admin-table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Üye</th>
                        <th>Eğitmen</th>
                        <th>Tercih</th>
                        <th>Oluşturulma</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7"><div class="admin-empty-row">Henüz birebir antrenman talebi bulunmuyor.</div></td></tr>
                    }
                    else
                    {
                        @for (var index = 0; index < Model.Count; index++)
                        {
                            var request = Model[index];
                            var createdAtLocal = request.CreatedAtUtc.ToLocalTime();

                            <tr>
                                <td data-label="Sıra"><span class="admin-order-no">@((index + 1).ToString("00"))</span></td>
                                <td data-label="Üye">
                                    <strong class="admin-class-name">@request.MemberName</strong>
                                    <span class="admin-cell-note">@request.MemberEmail</span>
                                </td>
                                <td data-label="Eğitmen">@request.TrainerName</td>
                                <td data-label="Tercih">
                                    <strong>@request.PreferredDate.ToString("dd.MM.yyyy")</strong>
                                    <span class="admin-cell-note">@request.PreferredTimeWindow</span>
                                </td>
                                <td data-label="Oluşturulma">
                                    <strong>@createdAtLocal.ToString("dd.MM.yyyy")</strong>
                                    <span class="admin-cell-note">@createdAtLocal.ToString("HH:mm")</span>
                                </td>
                                <td data-label="Durum">
                                    <span class="badge @(request.IsPending ? "text-bg-warning" : "text-bg-secondary")">@request.Status</span>
                                </td>
                                <td class="text-end" data-label="İşlem">
                                    <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@request.Id">Yönet</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
