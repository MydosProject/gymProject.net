@model ShopProductFormViewModel
@{
    ViewData["Title"] = "Yeni Shop Ürünü";
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head admin-form-head">
            <div>
                <a asp-action="Index" class="admin-back-link">← Ürünlere dön</a>
                <p class="admin-eyebrow">Operasyon / Shop</p>
                <h1>Yeni Shop ürünü</h1>
                <p class="admin-page-description">Fiyat, stok ve vitrin bilgileriyle yeni bir ürün oluştur.</p>
            </div>
        </header>

        <partial name="_ShopProductForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
