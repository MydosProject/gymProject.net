@model IReadOnlyList<
    TrainerGroupClassListItemViewModel>

@{
    ViewData["Title"] = "Derslerim";
}

<section class="trainer-classes-page">

    <header class="trainer-page-head">

        <div>

            <p class="trainer-page-eyebrow">
                Grup dersleri
            </p>

            <h1>
                Derslerim
            </h1>

            <p class="trainer-page-description">
                Sana atanmış grup derslerini ve
                yaklaşan seans bilgilerini görüntüle.
            </p>

        </div>

        <div class="trainer-page-count">

            <span>
                Toplam
            </span>

            <strong>
                @(Model.Count.ToString("00"))
            </strong>

            <small>
                ders
            </small>

        </div>

    </header>


    <div class="trainer-class-panel">

        @if (Model.Count == 0)
        {
            <div class="trainer-class-empty">

                <span aria-hidden="true">
                    01
                </span>

                <div>

                    <strong>
                        Henüz atanmış ders yok.
                    </strong>

                    <p>
                        Sana atanacak grup dersleri ve
                        yaklaşan seans bilgileri burada
                        görüntülenecek.
                    </p>

                </div>

            </div>
        }
        else
        {
            <div class="trainer-class-table-wrap">

                <table class="trainer-class-table">

                    <thead>
                        <tr>
                            <th>Ders</th>
                            <th>Seviye</th>
                            <th>Süre</th>
                            <th>Kontenjan</th>
                            <th>Yaklaşan Seans</th>
                            <th>Sonraki Ders</th>
                            <th>Durum</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var groupClass in Model)
                    {
                        <tr>

                            <td data-label="Ders">

                                <strong class="trainer-class-name">
                                    @groupClass.Name
                                </strong>

                                <small class="trainer-class-muted">
                                    Ortalama
                                    @groupClass.AverageCaloriesBurned
                                    kcal
                                </small>

                            </td>


                            <td data-label="Seviye">

                                <span class="trainer-class-value">
                                    @groupClass.DifficultyLevel
                                </span>

                            </td>


                            <td data-label="Süre">

                                <span class="trainer-class-value">
                                    @groupClass.DurationMinutes dk
                                </span>

                            </td>


                            <td data-label="Kontenjan">

                                <span class="trainer-class-value">
                                    @groupClass.Capacity
                                </span>

                            </td>


                            <td data-label="Yaklaşan Seans">

                                <span class="trainer-class-session-count">
                                    @groupClass.UpcomingSessionCount
                                </span>

                            </td>


                            <td data-label="Sonraki Ders">

                                @if (
                                    groupClass.NextSessionAtUtc
                                        is not null)
                                {
                                    <strong class="trainer-class-next-date">
                                        @(groupClass
                                            .NextSessionAtUtc
                                            .Value
                                            .ToLocalTime()
                                            .ToString(
                                                "dd.MM.yyyy HH:mm"))
                                    </strong>
                                }
                                else
                                {
                                    <span class="trainer-class-muted">
                                        —
                                    </span>
                                }

                            </td>


                            <td data-label="Durum">

                                @if (groupClass.IsActive)
                                {
                                    <span class="trainer-status-badge is-scheduled">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="trainer-status-badge is-neutral">
                                        Pasif
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }

    </div>

</section>