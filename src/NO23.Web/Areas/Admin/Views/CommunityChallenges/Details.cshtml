@model CommunityChallengeDetailsViewModel

@{
    ViewData["Title"] = "Challenge Takibi";

    string GetStatusName(string status)
    {
        return status switch
        {
            "Upcoming" => "Yakında",
            "Active" => "Devam Ediyor",
            "Completed" => "Tamamlandı",
            "Cancelled" => "İptal Edildi",
            _ => status
        };
    }

    string GetParticipationStatusName(string status)
    {
        return status switch
        {
            "Active" => "Devam Ediyor",
            "Completed" => "Tamamlandı",
            "Withdrawn" => "Ayrıldı",
            _ => status
        };
    }
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head admin-form-head">
            <div>
                <a asp-action="Index" class="admin-back-link">← Challenge'lara dön</a>
                <p class="admin-eyebrow">Topluluk / Challenge Takibi</p>
                <h1>@Model.Title</h1>
                <p class="admin-page-description">Katılımcı ilerlemesini ve günlük kalori girişlerini sadece takip et.</p>
            </div>
            <a class="btn btn-outline-dark" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
        </header>

        <div class="admin-metrics">
            <article><span>Durum</span><strong>@GetStatusName(Model.Status)</strong><small>@Model.StartsOn.ToString("dd.MM.yyyy") — @Model.EndsOn.ToString("dd.MM.yyyy")</small></article>
            <article><span>Kalori Hedefi</span><strong>@Model.TargetDailyCalories kcal</strong><small>@Model.MinDailyCalories - @Model.MaxDailyCalories kcal aralığı</small></article>
            <article><span>Tamamlanma</span><strong>@Model.RequiredCompletionPercent%</strong><small>Başarılı gün oranı</small></article>
            <article><span>Katılımcı</span><strong>@Model.Participants.Count</strong><small>Community üyesi</small></article>
        </div>

        <div class="table-responsive admin-table-card mt-4">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Üye</th>
                        <th>Durum</th>
                        <th>Katılım</th>
                        <th>Başarılı Gün</th>
                        <th>Kayıt</th>
                        <th>İlerleme</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Participants.Count == 0)
                    {
                        <tr><td colspan="6"><div class="admin-empty-row">Henüz katılımcı yok.</div></td></tr>
                    }
                    else
                    {
                        @foreach (var participant in Model.Participants)
                        {
                            <tr>
                                <td data-label="Üye">
                                    <strong>@participant.MemberName</strong>
                                    <small class="d-block text-muted">@participant.MemberEmail</small>
                                </td>
                                <td data-label="Durum"><span class="admin-status">@GetParticipationStatusName(participant.Status)</span></td>
                                <td data-label="Katılım">@participant.JoinedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td data-label="Başarılı gün">@participant.CompliantDays / @participant.TotalDays</td>
                                <td data-label="Kayıt">@participant.LoggedDays gün</td>
                                <td data-label="İlerleme"><strong>@participant.ProgressPercent%</strong></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="table-responsive admin-table-card mt-4">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Son Kalori Girişleri</th>
                        <th>Tarih</th>
                        <th>Alınan Kalori</th>
                        <th>Hedef Aralığı</th>
                        <th>Uyum</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentLogs.Count == 0)
                    {
                        <tr><td colspan="5"><div class="admin-empty-row">Henüz kalori girişi yok.</div></td></tr>
                    }
                    else
                    {
                        @foreach (var log in Model.RecentLogs)
                        {
                            <tr>
                                <td data-label="Üye"><strong>@log.MemberName</strong></td>
                                <td data-label="Tarih">@log.EntryDate.ToString("dd.MM.yyyy")</td>
                                <td data-label="Alınan kalori">@log.CaloriesConsumed kcal</td>
                                <td data-label="Hedef aralığı">@log.MinCalories - @log.MaxCalories kcal</td>
                                <td data-label="Uyum">
                                    <span class="admin-status">@(log.IsCompliant ? "Uygun" : "Aralık Dışı")</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
