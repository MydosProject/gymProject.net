@model IReadOnlyList<NO23.Web.Domain.Entities.AppointmentRequest>
@using NO23.Web.Extensions
@{ ViewData["Title"] = "Randevu Talepleri"; var navigation = (NO23.Web.ViewModels.ListNavigationViewModel)ViewData["ListNavigation"]!; }
<section class="admin-page"><div class="container">
    <header class="admin-page-head"><div><h1>Randevu talepleri</h1><p>Ziyaretçiyi arayarak tarih ve saati netleştir, ardından talebi onayla. Saatler Türkiye saatidir.</p></div></header>
    @foreach (var key in new[] { "SuccessMessage", "ErrorMessage" }) { if (TempData[key] is string message) { <div class="alert @(key == "SuccessMessage" ? "alert-success" : "alert-danger")">@message</div> } }
    <partial name="/Views/Shared/_ListFilters.cshtml" model="navigation" />
    <div class="table-responsive"><table class="table table-dark align-middle" aria-label="Randevu talepleri">
        <thead><tr><th>İletişim</th><th>Hizmet</th><th>Tercih edilen zaman</th><th>Not</th><th>Durum</th><th>Kesin plan</th></tr></thead>
        <tbody>
        @if (Model.Count == 0) { <tr><td colspan="6">Aramaya uygun randevu talebi bulunamadı.</td></tr> }
        @foreach (var request in Model)
        {
            <tr><td data-label="İletişim">@request.FullName<br />@request.PhoneNumber</td><td data-label="Hizmet">@request.Service</td>
                <td data-label="Tercih edilen zaman">@request.PreferredDate.ToString("dd.MM.yyyy") @request.PreferredTime.ToString("HH:mm")</td><td data-label="Not">@(string.IsNullOrWhiteSpace(request.Notes) ? "—" : request.Notes)</td>
                <td data-label="Durum"><form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                    <input type="hidden" name="id" value="@request.Id" /><input type="hidden" name="page" value="@navigation.Page" /><input type="hidden" name="query" value="@navigation.Query" /><input type="hidden" name="state" value="@navigation.State" />
                    <select name="status" class="form-select" aria-label="@request.FullName talep durumu">
                        @foreach (var status in Enum.GetValues<ServicePackageApplicationStatus>())
                        { <option value="@status" selected="@(status == request.Status)">@status.GetDisplayName()</option> }
                    </select><button class="btn btn-outline-light">Kaydet</button>
                </form></td>
                <td data-label="Kesin plan">@if (request.ScheduleStatus.HasValue) { <span>@request.ScheduleStatus.Value.GetDisplayName()</span><br />@NO23.Web.Services.ClubTime.ToLocal(request.ScheduledAtUtc!.Value).ToString("dd.MM.yyyy HH:mm")<br />@request.ScheduledTrainer?.FirstName @request.ScheduledTrainer?.LastName }
                    else { <span>Henüz planlanmadı</span> }
                    <br /><a asp-action="Schedule" asp-route-id="@request.Id">Planla / detay →</a></td>
            </tr>
        }
        </tbody>
    </table></div>
<partial name="/Views/Shared/_ListPagination.cshtml" model="navigation" />
</div></section>
