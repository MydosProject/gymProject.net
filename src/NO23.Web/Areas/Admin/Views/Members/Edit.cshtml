@model MemberEditViewModel
@using NO23.Web.ViewModels.Admin
@{
    ViewData["Title"] = "Üyeyi Düzenle";
    var packageOptions = ViewBag.PackageOptions as List<ManualMemberPackageOptionViewModel> ?? [];
}

<section class="admin-page">
    <div class="container" style="max-width:900px">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">KULÜP / ÜYE YÖNETİMİ</p>
                <h1>Üyeyi düzenle</h1>
                <p class="admin-page-description">İletişim, paket, ders hakkı ve personel trainer atamasını güncelleyin.</p>
            </div>
            <a class="btn btn-outline-dark" asp-action="Index">Üyelere dön</a>
        </header>

        <form method="post" class="admin-form-card">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ServicePackageVariantId" class="form-label"></label>
                    <select asp-for="ServicePackageVariantId" class="form-select" id="packageVariant">
                        @if (Model.ServicePackageVariantId is null) { <option value="">Eski paket (değiştirilmedi)</option> }
                        @foreach (var group in packageOptions.GroupBy(item => item.GroupName))
                        {
                            <optgroup label="@group.Key">
                                @foreach (var option in group)
                                {
                                    <option value="@option.Id" data-category="@option.Category">@option.Label</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <span asp-validation-for="ServicePackageVariantId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AssignedTrainerId" class="form-label"></label>
                    <select asp-for="AssignedTrainerId" asp-items="ViewBag.Trainers" class="form-select">
                        <option value="">Atanmamış</option>
                    </select>
                    <span asp-validation-for="AssignedTrainerId" class="text-danger"></span>
                </div>
                <div class="col-md-6" id="familyCodeField">
                    <label asp-for="FamilyCode" class="form-label"></label>
                    <input asp-for="FamilyCode" class="form-control" placeholder="İlk çocuk için boş bırakın" />
                    <span asp-validation-for="FamilyCode" class="text-danger"></span>
                    <small class="form-text text-muted">İkinci çocuk için ilk çocuğun aile kodunu girin.</small>
                </div>
                <div class="col-md-6">
                    <label asp-for="RemainingClassCredits" class="form-label"></label>
                    <input asp-for="RemainingClassCredits" class="form-control" min="0" />
                    <span asp-validation-for="RemainingClassCredits" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FitnessGoal" class="form-label"></label>
                    <input asp-for="FitnessGoal" class="form-control" />
                    <span asp-validation-for="FitnessGoal" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="btn btn-outline-secondary" asp-action="Index">Vazgeç</a>
                <button class="btn btn-dark" type="submit">Değişiklikleri kaydet</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const select = document.getElementById('packageVariant');
            const family = document.getElementById('familyCodeField');
            const toggle = () => family.hidden = select.selectedOptions[0]?.dataset.category !== 'KidsClub';
            select.addEventListener('change', toggle); toggle();
        })();
    </script>
}
