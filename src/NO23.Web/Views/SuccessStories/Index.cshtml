@model IReadOnlyList<SuccessStoryCardViewModel>

@{
    ViewData["Title"] = "Başarı Hikâyeleri";
}

<section class="stories-page content-page">
    <div class="content-page-grid" aria-hidden="true"></div>
    <div class="stories-page-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <header class="content-hero stories-hero">
            <div class="content-hero-copy">
                <p class="content-kicker">NO23 Stories · Real Progress</p>
                <h1>
                    Değişim bir anda değil,
                    <span>her gün başlar.</span>
                </h1>
                <p class="content-hero-description">
                    Gerçek üyeler, gerçek hedefler ve sürdürülebilir sonuçlar.
                    NO23 topluluğunun kendi ritmini bulan dönüşüm hikâyeleri.
                </p>
                <a href="#member-stories" class="content-primary-link">
                    Hikâyeleri Keşfet
                    <span aria-hidden="true">↓</span>
                </a>
            </div>

            <aside class="stories-hero-quote">
                <span>NO23 / Progress</span>
                <blockquote>
                    “En güçlü sonuç, devam edebildiğin sonuçtur.”
                </blockquote>
                <strong>@Model.Count.ToString("00") · Hikâye</strong>
            </aside>
        </header>

        <section class="content-section" id="member-stories">
            <div class="content-section-heading">
                <div>
                    <p class="content-section-kicker">Üye dönüşümleri</p>
                    <h2>Rakamların arkasındaki emek.</h2>
                </div>
                <p>
                    Her ilerleme kişisel. Her hikâye, doğru planın ve istikrarlı
                    çalışmanın neleri değiştirebileceğini gösteriyor.
                </p>
            </div>

            @if (Model.Count == 0)
            {
                <div class="content-empty-state">
                    <span>23</span>
                    <div>
                        <h3>Yeni hikâyeler hazırlanıyor.</h3>
                        <p>NO23 üyelerinin yolculukları çok yakında burada.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="stories-list">
                    @for (var index = 0; index < Model.Count; index++)
                    {
                        var item = Model[index];

                        <article class="story-card">
                            <div class="story-card-visual">
                                @if (!string.IsNullOrWhiteSpace(item.BeforeImageUrl) ||
                                     !string.IsNullOrWhiteSpace(item.AfterImageUrl))
                                {
                                    <div class="story-image-grid">
                                        @if (!string.IsNullOrWhiteSpace(item.BeforeImageUrl))
                                        {
                                            <figure>
                                                <img src="@item.BeforeImageUrl"
                                                     alt="@item.MemberName değişim öncesi"
                                                     loading="lazy" />
                                                <figcaption>Başlangıç</figcaption>
                                            </figure>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.AfterImageUrl))
                                        {
                                            <figure>
                                                <img src="@item.AfterImageUrl"
                                                     alt="@item.MemberName güncel durum"
                                                     loading="lazy" />
                                                <figcaption>Şimdi</figcaption>
                                            </figure>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span>NO23 Member</span>
                                    <strong>@((index + 1).ToString("00"))</strong>
                                    <small>Real progress / Real story</small>
                                }
                            </div>

                            <div class="story-card-content">
                                <div class="story-card-meta">
                                    <span>@item.MemberName</span>
                                    <span>@(item.PublishedAtUtc?.ToString("dd.MM.yyyy") ?? "NO23 Story")</span>
                                </div>
                                <h3>@item.Title</h3>
                                <p>@item.Summary</p>

                                @if (!string.IsNullOrWhiteSpace(item.AchievementMetric))
                                {
                                    <div class="story-metric">
                                        <span>Sonuç</span>
                                        <strong>@item.AchievementMetric</strong>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.VideoUrl))
                                {
                                    <a class="story-video-link"
                                       href="@item.VideoUrl"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        Video Hikâyeyi İzle
                                        <span aria-hidden="true">↗</span>
                                    </a>
                                }

                                <a class="story-read-link"
                                   asp-controller="SuccessStories"
                                   asp-action="Details"
                                   asp-route-slug="@item.Slug"
                                   data-content-modal-open="story-modal-@item.Id"
                                   aria-haspopup="dialog"
                                   aria-controls="story-modal-@item.Id">
                                    Hikâyeyi Oku
                                    <span aria-hidden="true">→</span>
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>

    @foreach (var item in Model)
    {
        var publishedAt = item.PublishedAtUtc ?? item.CreatedAtUtc;
        var paragraphs = item.Story
            .Replace("\r\n", "\n")
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var hasImages = !string.IsNullOrWhiteSpace(item.BeforeImageUrl) ||
                        !string.IsNullOrWhiteSpace(item.AfterImageUrl);

        <dialog id="story-modal-@item.Id"
                class="content-reading-modal story-reading-modal"
                aria-labelledby="story-modal-title-@item.Id"
                data-content-modal>
            <article class="content-reading-modal-panel">
                <button type="button"
                        class="content-reading-modal-close"
                        aria-label="Hikâyeyi kapat"
                        data-content-modal-close>×</button>

                <header class="content-reading-modal-header">
                    <div>
                        <p class="content-section-kicker">NO23 / REAL PROGRESS</p>
                        <div class="content-reading-modal-meta">
                            <span>@item.MemberName</span>
                            <time datetime="@publishedAt.ToString("yyyy-MM-dd")">
                                @publishedAt.ToString("dd.MM.yyyy")
                            </time>
                        </div>
                        <h2 id="story-modal-title-@item.Id">@item.Title</h2>
                        <p>@item.Summary</p>
                    </div>

                    @if (hasImages)
                    {
                        <div class="story-reading-modal-images">
                            @if (!string.IsNullOrWhiteSpace(item.BeforeImageUrl))
                            {
                                <figure>
                                    <img src="@item.BeforeImageUrl"
                                         alt="@item.MemberName değişim öncesi"
                                         loading="lazy" />
                                    <figcaption>Başlangıç</figcaption>
                                </figure>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.AfterImageUrl))
                            {
                                <figure>
                                    <img src="@item.AfterImageUrl"
                                         alt="@item.MemberName güncel durum"
                                         loading="lazy" />
                                    <figcaption>Şimdi</figcaption>
                                </figure>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="content-reading-modal-mark" aria-hidden="true">23</div>
                    }
                </header>

                @if (!string.IsNullOrWhiteSpace(item.AchievementMetric))
                {
                    <div class="story-reading-modal-metric">
                        <span>Sonuç</span>
                        <strong>@item.AchievementMetric</strong>
                    </div>
                }

                <div class="content-reading-modal-body">
                    @foreach (var paragraph in paragraphs)
                    {
                        <p>@paragraph</p>
                    }
                </div>

                <footer class="content-reading-modal-footer">
                    @if (!string.IsNullOrWhiteSpace(item.VideoUrl))
                    {
                        <a href="@item.VideoUrl"
                           target="_blank"
                           rel="noopener noreferrer">
                            Video hikâyeyi izle <span aria-hidden="true">↗</span>
                        </a>
                    }
                    <button type="button" data-content-modal-close>Kapat</button>
                </footer>
            </article>
        </dialog>
    }
</section>
