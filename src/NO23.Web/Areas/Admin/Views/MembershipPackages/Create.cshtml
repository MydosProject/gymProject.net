@model MembershipPackageFormViewModel
@{
    ViewData["Title"] = "Yeni Paket";
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head admin-form-head">
            <div>
                <a asp-action="Index" class="admin-back-link">← Paketlere dön</a>
                <p class="admin-eyebrow">Kulüp / Üyelik Yönetimi</p>
                <h1>Yeni üyelik paketi</h1>
                <p class="admin-page-description">Yeni paket seviyesinin ders hakkını, hedef kitlesini ve NO23 ayrıcalıklarını oluştur.</p>
            </div>
        </header>

        <partial name="_PackageForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
