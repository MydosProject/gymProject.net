@model IReadOnlyList<TrainerListItemViewModel>
@{
    ViewData["Title"] = "Eğitmenler";
}

<section class="py-5">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">Admin</p>
                <h1 class="h3 mb-0">Eğitmenler</h1>
            </div>

            <a class="btn btn-dark" asp-action="Create">Yeni Eğitmen</a>
        </div>

        <div class="table-responsive bg-white border rounded-3">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Eğitmen</th>
                        <th>Uzmanlık</th>
                        <th>Sertifikalar</th>
                        <th>Ders</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trainer in Model)
                    {
                        <tr>
                            <td data-label="Eğitmen"><strong>@trainer.FullName</strong></td>
                            <td data-label="Uzmanlık">@trainer.Specialty</td>
                            <td data-label="Sertifikalar">@(trainer.Certifications ?? "-")</td>
                            <td data-label="Ders">@trainer.ClassCount</td>
                            <td data-label="Durum">
                                <span class="badge @(trainer.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(trainer.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-end" data-label="İşlem">
                                <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@trainer.Id">Düzenle</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
