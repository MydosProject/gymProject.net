@model IReadOnlyList<MembershipPackageListItemViewModel>
@{
    ViewData["Title"] = "Üyelik Paketleri";
}

<section class="py-5">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <p class="text-uppercase text-muted small mb-1">Admin</p>
                <h1 class="h3 mb-0">Üyelik Paketleri</h1>
            </div>

            <a class="btn btn-dark"
               asp-area="Admin"
               asp-controller="MembershipPackages"
               asp-action="Create">
                Yeni Paket
            </a>
        </div>

        <div class="table-responsive bg-white border rounded-3">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Kod</th>
                        <th>Paket</th>
                        <th>Haftalık Ders</th>
                        <th>Üye</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var package in Model)
                    {
                        <tr>
                            <td>@package.DisplayOrder</td>
                            <td><strong>@package.Code</strong></td>
                            <td>
                                <div>@package.Name</div>
                                <small class="text-muted">@package.Audience</small>
                            </td>
                            <td>@(package.WeeklyClassLimit?.ToString() ?? "Sınırsız")</td>
                            <td>@package.MemberCount</td>
                            <td>
                                <span class="badge @(package.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(package.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-dark"
                                   asp-area="Admin"
                                   asp-controller="MembershipPackages"
                                   asp-action="Edit"
                                   asp-route-id="@package.Id">
                                    Düzenle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
