@using NO23.Web.Domain.Enums
@using System.Globalization
@model NO23.Web.ViewModels.KitchenPublicPageViewModel
@{
    ViewData["Title"] = "NO23 Kitchen";
}

<div class="kitchen-page public-commerce-page">
    <div class="kitchen-page-grid" aria-hidden="true"></div>
    <div class="kitchen-page-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <section class="kitchen-hero public-kitchen-hero">
            <div>
                <p class="kitchen-kicker">NO23 / Nutrition System</p>
                <h1>
                    Hedefine göre seç.
                    <span>Üye olmadan sipariş ver.</span>
                </h1>
                <p class="kitchen-hero-description">
                    Kalori ve makroları açıkça gösterilen NO23 Kitchen ürünlerini incele;
                    sana uygun öğünü seçip üyelik gerektirmeden siparişini tamamla.
                </p>

            </div>

            <aside class="kitchen-hero-card" aria-label="Kitchen sipariş sistemi">
                <div class="kitchen-hero-card-top">
                    <span>NO23 / Guest Order</span>
                    <strong>23</strong>
                </div>
                <div class="kitchen-hero-card-content">
                    <p>Tek seferlik sipariş</p>
                    <h2>Planını bekleme.<br />Öğününü şimdi seç.</h2>
                </div>
                <ul>
                    <li><span>01</span> Ürününü ve hedefini belirle</li>
                    <li><span>02</span> Teslimat bilgilerini gir</li>
                    <li><span>03</span> Siparişini oluştur</li>
                </ul>
            </aside>
        </section>

        <section class="kitchen-subscription-section" id="calorie-calculator">
            <div class="kitchen-section-heading">
                <div>
                    <p class="kitchen-section-kicker">Ücretsiz Kalori Hesaplama</p>
                    <h2>Üye olmadan günlük hedefini öğren.</h2>
                </div>
                <p>Öğün planını seçmeden önce günlük kalori ve makro hedefini hesapla. Sonucun sonraki adımlarda korunur.</p>
            </div>

            <form asp-action="CalculateCalories" method="post" class="kitchen-subscription-card">
                <div class="row g-3">
                    <div class="col-md-4"><label asp-for="CalculatorInput.HeightCm">Boy (cm)</label><input asp-for="CalculatorInput.HeightCm" class="form-control" /><span asp-validation-for="CalculatorInput.HeightCm"></span></div>
                    <div class="col-md-4"><label asp-for="CalculatorInput.WeightKg">Kilo (kg)</label><input asp-for="CalculatorInput.WeightKg" class="form-control" /><span asp-validation-for="CalculatorInput.WeightKg"></span></div>
                    <div class="col-md-4"><label asp-for="CalculatorInput.Age">Yaş</label><input asp-for="CalculatorInput.Age" class="form-control" /><span asp-validation-for="CalculatorInput.Age"></span></div>
                    <div class="col-md-4">
                        <label asp-for="CalculatorInput.Gender">Cinsiyet</label>
                        <select asp-for="CalculatorInput.Gender" class="form-select"><option value="Female">Kadın</option><option value="Male">Erkek</option></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CalculatorInput.ActivityLevel">Aktivite</label>
                        <select asp-for="CalculatorInput.ActivityLevel" class="form-select"><option value="Sedentary">Hareketsiz</option><option value="LightlyActive">Az aktif</option><option value="ModeratelyActive">Orta aktif</option><option value="VeryActive">Çok aktif</option></select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CalculatorInput.Goal">Hedef</label>
                        <select asp-for="CalculatorInput.Goal" class="form-select"><option value="FatLoss">Kilo verme</option><option value="HealthyLifestyle">Sağlıklı yaşam</option><option value="MuscleGain">Kas kazanımı</option></select>
                    </div>
                </div>
                <button type="submit" class="kitchen-subscription-cta mt-3">Kalorimi Hesapla <span aria-hidden="true">→</span></button>

                @if (Model.Recommendation is not null)
                {
                    <div class="kitchen-subscription-prices mt-3" aria-live="polite">
                        <div><span>Günlük enerji</span><strong>@Model.Recommendation.DailyCalories kcal</strong></div>
                        <div><span>Protein</span><strong>@Model.Recommendation.ProteinGrams g</strong></div>
                        <div><span>Karbonhidrat</span><strong>@Model.Recommendation.CarbohydrateGrams g</strong></div>
                        <div><span>Yağ</span><strong>@Model.Recommendation.FatGrams g</strong></div>
                    </div>
                }
            </form>
        </section>

        @if (Model.SubscriptionPlans.Count > 0)
        {
            @if (TempData["ErrorMessage"] is string kitchenError)
            {
                <div class="alert alert-danger" role="alert">@kitchenError</div>
            }
            <section class="kitchen-subscription-section" id="plans">
                <div class="kitchen-section-heading">
                    <div>
                        <p class="kitchen-section-kicker">NO23 Kitchen Aboneliği</p>
                        <h2>Günlük öğün düzenini seç.</h2>
                    </div>
                    <p>Her gün 1, 2 veya 3 ana öğün ve bir ara öğün seç. Kalori hedefin üretim planına aktarılır.</p>
                </div>

                <div class="kitchen-subscription-grid">
                    @if (Model.Recommendation is null)
                    {
                        <div class="kitchen-plan-required" style="grid-column: 1 / -1">
                            <span>01</span>
                            <div>
                                <h3>Önce kalori ve makro hedefini hesapla.</h3>
                                <p>Hesaplamanı tamamladıktan sonra paket ve günlük öğün seçenekleri burada açılacak.</p>
                            </div>
                            <a href="#calorie-calculator">Kalorimi Hesapla <span aria-hidden="true">↑</span></a>
                        </div>
                    }
                    else
                    {
                        <div class="kitchen-plan-target" style="grid-column: 1 / -1">
                            <div>
                                <span>Günlük kişisel hedefin</span>
                                <strong>@Model.Recommendation.DailyCalories kcal</strong>
                            </div>
                            <dl>
                                <div><dt>Protein</dt><dd>@Model.Recommendation.ProteinGrams g</dd></div>
                                <div><dt>Karbonhidrat</dt><dd>@Model.Recommendation.CarbohydrateGrams g</dd></div>
                                <div><dt>Yağ</dt><dd>@Model.Recommendation.FatGrams g</dd></div>
                            </dl>
                        </div>
                    @foreach (var plan in Model.SubscriptionPlans)
                    {
                        <form class="kitchen-subscription-card" asp-action="StartSubscription" method="post"
                              data-public-kitchen-plan
                              data-price-one="@plan.UnitPrice.ToString(CultureInfo.InvariantCulture)"
                              data-price-two="@plan.TwoMainMealsPrice.ToString(CultureInfo.InvariantCulture)"
                              data-price-three="@plan.ThreeMainMealsPrice.ToString(CultureInfo.InvariantCulture)"
                              data-delivery-daily="@plan.DailyDeliveryFee.ToString(CultureInfo.InvariantCulture)"
                              data-days="@plan.Days">
                            <input type="hidden" name="plan" value="@plan.Plan" />
                            <span class="kitchen-plan-days">@plan.Days gün</span>
                            <h3>@plan.Name</h3>
                            <p>@plan.Description</p>
                            <div class="kitchen-subscription-prices">
                                <div><span>1 ana + 1 ara</span><strong>@plan.UnitPrice.ToString("C0")</strong></div>
                                <div><span>2 ana + 1 ara</span><strong>@plan.TwoMainMealsPrice.ToString("C0")</strong></div>
                                <div><span>3 ana + 1 ara</span><strong>@plan.ThreeMainMealsPrice.ToString("C0")</strong></div>
                            </div>
                            <small class="kitchen-delivery-note">Adrese teslim: @plan.DailyDeliveryFee.ToString("C0") / gün · Salondan teslim ücretsiz</small>

                            <fieldset class="kitchen-meal-selection">
                                <legend>Öğünlerini seç</legend>
                                <label><input type="checkbox" name="selectedMeals" value="Breakfast" checked data-public-main-meal /> Kahvaltı</label>
                                <label><input type="checkbox" name="selectedMeals" value="Lunch" data-public-main-meal /> Öğle yemeği</label>
                                <label><input type="checkbox" name="selectedMeals" value="Dinner" data-public-main-meal /> Akşam yemeği</label>
                                <label><input type="radio" name="selectedMeals" value="MorningSnack" /> Sabah ara öğünü</label>
                                <label><input type="radio" name="selectedMeals" value="AfternoonSnack" checked /> Öğleden sonra ara öğünü</label>
                            </fieldset>

                            <fieldset class="kitchen-meal-selection">
                                <legend>Teslimat</legend>
                                <label><input type="radio" name="deliveryMethod" value="ClubPickup" checked /> Gel-al · ücretsiz</label>
                                <label><input type="radio" name="deliveryMethod" value="AddressDelivery" /> Eve teslim · @plan.DailyDeliveryFee.ToString("C0")/gün</label>
                            </fieldset>

                            <div class="kitchen-subscription-prices mt-3">
                                <div><span>Seçimin</span><strong data-public-package-price>@plan.UnitPrice.ToString("C0")</strong></div>
                                <div><span>Teslimat</span><strong data-public-delivery-price>Ücretsiz</strong></div>
                                <div><span>Toplam</span><strong data-public-total-price>@plan.UnitPrice.ToString("C0")</strong></div>
                            </div>
                            <button type="submit" class="kitchen-subscription-cta">Seçimi kaydet ve devam et <span aria-hidden="true">→</span></button>
                        </form>
                    }
                    }
                </div>
            </section>
        }

        <section class="kitchen-menu-section" id="public-kitchen-menu">
            <div class="kitchen-section-heading">
                <div>
                    <p class="kitchen-section-kicker">NO23 Menü</p>
                    <h2>Hedefine uygun öğünü seç.</h2>
                </div>
                <p>
                    Kategori, beslenme tercihi veya ürün adına göre filtrele.
                    Kalori ve makroları tek bakışta karşılaştır.
                </p>
            </div>

            @if (Model.MenuItems.Count == 0)
            {
                <div class="kitchen-menu-empty">
                    <span>00</span>
                    <div>
                        <h3>Yeni menü hazırlanıyor.</h3>
                        <p>Aktif Kitchen ürünleri burada yayınlanacak.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="kitchen-filter-panel" data-kitchen-filter>
                    <div class="kitchen-filter-panel-heading">
                        <div>
                            <span>Filtreleme sistemi</span>
                            <p>Öğün tipini ve beslenme tercihini birlikte kullanabilirsin.</p>
                        </div>
                        <strong>@Model.MenuItems.Count.ToString("00")</strong>
                    </div>

                    <div class="kitchen-filter-toolbar">
                        <label class="kitchen-filter-search">
                            <span>Menüde ara</span>
                            <input type="search"
                                   placeholder="Ürün, içerik veya kategori ara"
                                   autocomplete="off"
                                   data-kitchen-search />
                            <i aria-hidden="true">⌕</i>
                        </label>
                        <div class="kitchen-filter-summary" aria-live="polite">
                            <span><strong data-kitchen-count>@Model.MenuItems.Count</strong> ürün gösteriliyor</span>
                            <button type="button" data-kitchen-reset hidden>Filtreleri Temizle</button>
                        </div>
                    </div>

                    <div class="kitchen-filter-groups">
                        <fieldset class="kitchen-filter-group">
                            <legend>Öğün türü</legend>
                            <div class="kitchen-menu-filters" data-filter-group="category">
                                <button class="kitchen-filter-button active" type="button" data-category="all">Tümü</button>
                                <button class="kitchen-filter-button" type="button" data-category="breakfast">Kahvaltılar</button>
                                <button class="kitchen-filter-button" type="button" data-category="mainmeal">Ana Öğünler</button>
                                <button class="kitchen-filter-button" type="button" data-category="snack">Ara Öğünler</button>
                                <button class="kitchen-filter-button" type="button" data-category="dessert">Tatlılar</button>
                                <button class="kitchen-filter-button" type="button" data-category="beverage">İçecekler</button>
                            </div>
                        </fieldset>

                        <fieldset class="kitchen-filter-group">
                            <legend>Beslenme tercihi</legend>
                            <div class="kitchen-menu-filters" data-filter-group="nutrition">
                                <button class="kitchen-filter-button kitchen-tag-filter-button active" type="button" data-nutrition="all">Tümü</button>
                                <button class="kitchen-filter-button kitchen-tag-filter-button" type="button" data-nutrition="high-protein">Yüksek Protein</button>
                                <button class="kitchen-filter-button kitchen-tag-filter-button" type="button" data-nutrition="low-calorie">Düşük Kalori</button>
                                <button class="kitchen-filter-button kitchen-tag-filter-button" type="button" data-nutrition="gluten-free">Glutensiz</button>
                                <button class="kitchen-filter-button kitchen-tag-filter-button" type="button" data-nutrition="vegetarian">Vejetaryen</button>
                            </div>
                        </fieldset>
                    </div>
                </div>

                <div class="kitchen-menu-grid" data-kitchen-grid>
                    @for (var index = 0; index < Model.MenuItems.Count; index++)
                    {
                        var item = Model.MenuItems[index];
                        var rawCategory = item.Category?.Trim().ToLowerInvariant() ?? string.Empty;
                        var categoryKey = rawCategory.Contains("breakfast") || rawCategory.Contains("kahvalt")
                            ? "breakfast"
                            : rawCategory.Contains("main") || rawCategory.Contains("ana")
                                ? "mainmeal"
                                : rawCategory.Contains("snack") || rawCategory.Contains("ara")
                                    ? "snack"
                                    : rawCategory.Contains("dessert") || rawCategory.Contains("tatl")
                                        ? "dessert"
                                        : rawCategory.Contains("beverage") || rawCategory.Contains("drink") || rawCategory.Contains("içecek")
                                            ? "beverage"
                                            : rawCategory.Replace(" ", string.Empty);
                        var categoryLabel = categoryKey switch
                        {
                            "breakfast" => "Kahvaltı",
                            "mainmeal" => "Ana Öğün",
                            "snack" => "Ara Öğün",
                            "dessert" => "Tatlı",
                            "beverage" => "İçecek",
                            _ => item.Category
                        };
                        var searchableText = $"{item.ItemName} {item.Description} {item.Ingredients} {item.Category}";
                        var proteinValue = item.ProteinGrams ?? 0;
                        var calorieValue = item.Calories ?? 0;
                        var allergenText = item.Allergens ?? string.Empty;
                        var contentText = $"{item.ItemName} {item.Description} {item.Ingredients}";
                        var isHighProtein = proteinValue >= 25;
                        var isLowCalorie = calorieValue > 0 && calorieValue <= 400;
                        var isGlutenFree = allergenText.Contains("gluten", StringComparison.OrdinalIgnoreCase) == false
                            && contentText.Contains("ekmek", StringComparison.OrdinalIgnoreCase) == false;
                        var isVegetarian = contentText.Contains("tavuk", StringComparison.OrdinalIgnoreCase) == false
                            && contentText.Contains("et ", StringComparison.OrdinalIgnoreCase) == false
                            && contentText.Contains("balık", StringComparison.OrdinalIgnoreCase) == false;
                        var nutritionKeys = string.Join(" ", new[]
                        {
                            isHighProtein ? "high-protein" : null,
                            isLowCalorie ? "low-calorie" : null,
                            isGlutenFree ? "gluten-free" : null,
                            isVegetarian ? "vegetarian" : null
                        }.Where(value => value is not null));

                        <div class="kitchen-menu-card-wrapper"
                             data-kitchen-item
                             data-category="@categoryKey"
                             data-nutrition="@nutritionKeys"
                             data-search="@searchableText">
                            <article class="kitchen-menu-card">
                                <div class="kitchen-menu-visual">
                                    <span class="kitchen-menu-category">@categoryLabel</span>
                                    <strong>@((index + 1).ToString("00"))</strong>
                                    <div>
                                        <span>@calorieValue</span>
                                        <small>kcal</small>
                                    </div>
                                </div>

                                <div class="kitchen-menu-card-content">
                                    <div class="kitchen-menu-card-heading">
                                        <div>
                                            <p>@categoryLabel</p>
                                            <h3>@item.ItemName</h3>
                                        </div>
                                        <span class="kitchen-menu-id">@item.UnitPrice.ToString("C0") · #@((index + 1).ToString("00"))</span>
                                    </div>

                                    <p class="kitchen-menu-ingredients">
                                        @(string.IsNullOrWhiteSpace(item.Description)
                                            ? "NO23 Kitchen tarafından hazırlanan dengeli ve performans odaklı öğün."
                                            : item.Description)
                                    </p>

                                    <div class="kitchen-menu-macros">
                                        <span><small>Protein</small>@item.ProteinGrams?.ToString("0.#") g</span>
                                        <span><small>Karbonhidrat</small>@item.CarbohydrateGrams?.ToString("0.#") g</span>
                                        <span><small>Yağ</small>@item.FatGrams?.ToString("0.#") g</span>
                                    </div>

                                    <div class="kitchen-menu-meta">
                                        <div class="kitchen-menu-tags">
                                            @if (isHighProtein) { <span>Yüksek Protein</span> }
                                            @if (isLowCalorie) { <span>Düşük Kalori</span> }
                                            @if (isGlutenFree) { <span>Glutensiz</span> }
                                            @if (isVegetarian) { <span>Vejetaryen</span> }
                                        </div>
                                        <p class="kitchen-allergen">
                                            <strong>Alerjen:</strong>
                                            @(string.IsNullOrWhiteSpace(item.Allergens) ? "Belirtilmedi" : item.Allergens)
                                        </p>
                                    </div>

                                    <a class="public-product-order-link"
                                       asp-area=""
                                       asp-controller="Kitchen"
                                       asp-action="Order"
                                       asp-route-menuItemId="@item.ItemId">
                                        Sipariş Ver <span aria-hidden="true">↗</span>
                                    </a>
                                </div>
                            </article>
                        </div>
                    }
                </div>

                <div class="kitchen-menu-empty" data-kitchen-empty hidden>
                    <span>00</span>
                    <div>
                        <h3>Bu filtrelere uygun ürün bulunamadı.</h3>
                        <p>Filtreleri temizleyerek tüm Kitchen menüsünü yeniden görüntüleyebilirsin.</p>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const money = value => Number(value).toLocaleString("tr-TR", { style: "currency", currency: "TRY", maximumFractionDigits: 0 });
            document.querySelectorAll("[data-public-kitchen-plan]").forEach(form => {
                const updatePlan = () => {
                    const mainCount = form.querySelectorAll("[data-public-main-meal]:checked").length;
                    const prices = [0, Number(form.dataset.priceOne), Number(form.dataset.priceTwo), Number(form.dataset.priceThree)];
                    const packagePrice = prices[mainCount] || 0;
                    const address = form.querySelector("[name='deliveryMethod'][value='AddressDelivery']")?.checked;
                    const delivery = address ? Number(form.dataset.deliveryDaily) * Number(form.dataset.days) : 0;
                    form.querySelector("[data-public-package-price]").textContent = money(packagePrice);
                    form.querySelector("[data-public-delivery-price]").textContent = delivery ? money(delivery) : "Ücretsiz";
                    form.querySelector("[data-public-total-price]").textContent = money(packagePrice + delivery);
                };
                form.addEventListener("change", updatePlan);
                form.addEventListener("submit", event => {
                    const mainCount = form.querySelectorAll("[data-public-main-meal]:checked").length;
                    if (mainCount < 1 || !form.querySelector("[name='selectedMeals']:checked")) event.preventDefault();
                });
                updatePlan();
            });

            const root = document.querySelector("[data-kitchen-filter]");
            if (!root) return;

            const items = Array.from(document.querySelectorAll("[data-kitchen-item]"));
            const search = root.querySelector("[data-kitchen-search]");
            const count = root.querySelector("[data-kitchen-count]");
            const reset = root.querySelector("[data-kitchen-reset]");
            const empty = document.querySelector("[data-kitchen-empty]");
            let category = "all";
            let nutrition = "all";

            const normalize = value => (value || "").toLocaleLowerCase("tr-TR").trim();

            const update = () => {
                const query = normalize(search.value);
                let visible = 0;

                items.forEach(item => {
                    const categoryMatches = category === "all" || item.dataset.category === category;
                    const nutritionMatches = nutrition === "all"
                        || (item.dataset.nutrition || "").split(" ").includes(nutrition);
                    const searchMatches = !query || normalize(item.dataset.search).includes(query);
                    const show = categoryMatches && nutritionMatches && searchMatches;
                    item.hidden = !show;
                    if (show) visible++;
                });

                count.textContent = visible;
                empty.hidden = visible !== 0;
                reset.hidden = category === "all" && nutrition === "all" && !query;
            };

            root.querySelectorAll("[data-category]").forEach(button => {
                button.addEventListener("click", () => {
                    root.querySelectorAll("[data-category]").forEach(item => item.classList.remove("active"));
                    button.classList.add("active");
                    category = button.dataset.category;
                    update();
                });
            });

            root.querySelectorAll("[data-nutrition]").forEach(button => {
                button.addEventListener("click", () => {
                    root.querySelectorAll("[data-nutrition]").forEach(item => item.classList.remove("active"));
                    button.classList.add("active");
                    nutrition = button.dataset.nutrition;
                    update();
                });
            });

            search.addEventListener("input", update);
            reset.addEventListener("click", () => {
                category = "all";
                nutrition = "all";
                search.value = "";
                root.querySelectorAll("[data-category], [data-nutrition]").forEach(item => {
                    item.classList.toggle("active", item.dataset.category === "all" || item.dataset.nutrition === "all");
                });
                update();
            });
        })();
    </script>
}
