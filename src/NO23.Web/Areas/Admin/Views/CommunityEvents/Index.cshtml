@model IReadOnlyList<CommunityEventListItemViewModel>

@{
    ViewData["Title"] = "Community Etkinlikleri";

    var upcomingCount = Model.Count(item =>
        item.Status == "Planlanmış" &&
        item.StartsAtUtc.Date >= DateTime.UtcNow.Date);

    var totalCapacity = Model
        .Where(item => item.Status != "İptal edildi")
        .Sum(item => item.Capacity ?? 0);
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">
                    COMMUNITY / ETKİNLİK TAKVİMİ
                </p>

                <h1>Etkinlik yönetimi</h1>

                <p class="admin-page-description">
                    Koşu grupları, workshop'lar ve kulüp buluşmalarını planla.
                </p>
            </div>

            <a class="btn btn-dark" asp-action="Create">
                + Yeni etkinlik
            </a>
        </header>

        <div class="admin-metrics">
            <article>
                <span>Toplam etkinlik</span>
                <strong>@Model.Count</strong>
                <small>Kayıtlı program</small>
            </article>

            <article>
                <span>Yaklaşan</span>
                <strong>@upcomingCount</strong>
                <small>Takvimde bekleyen</small>
            </article>

            <article>
                <span>Toplam kapasite</span>
                <strong>@totalCapacity</strong>
                <small>Katılımcı alanı</small>
            </article>
        </div>

        <div class="table-responsive admin-table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Etkinlik</th>
                        <th>Tür</th>
                        <th>Durum</th>
                        <th>Tarih</th>
                        <th>Konum</th>
                        <th>Kapasite</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8">
                                <div class="admin-empty-row">
                                    Henüz Community etkinliği eklenmedi.
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td data-label="Sıra">
                                    <span class="admin-order-no">
                                        @item.DisplayOrder.ToString("00")
                                    </span>
                                </td>

                                <td data-label="Etkinlik">
                                    <strong>@item.Title</strong>
                                </td>

                                <td data-label="Tür">
                                    @item.Type
                                </td>

                                <td data-label="Durum">
                                    <span class="admin-status @(item.Status == "İptal edildi" ? "is-cancelled" : "")">
                                        @item.Status
                                    </span>
                                </td>

                                <td data-label="Tarih">
                                    @(item.StartsAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                </td>

                                <td data-label="Konum">
                                    @item.Location
                                </td>

                                <td data-label="Kapasite">
                                    @(item.Capacity.HasValue
                                        ? $"{item.ReservedCount} / {item.Capacity}"
                                        : $"{item.ReservedCount} / sınırsız")
                                </td>

                                <td class="text-end" data-label="İşlem">
                                    <a class="btn btn-sm btn-outline-dark"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id">
                                        Düzenle
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
