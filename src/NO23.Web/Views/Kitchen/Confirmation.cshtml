@model NO23.Web.ViewModels.GuestOrders.GuestOrderConfirmationViewModel
@{
    ViewData["Title"] = "Sipariş Alındı";
}

<div class="public-confirmation-page public-confirmation-kitchen">
    <div class="public-order-grid-bg" aria-hidden="true"></div>
    <div class="container position-relative">
        <section class="public-confirmation-layout">
            <div class="public-confirmation-copy">
                <p class="public-order-kicker">NO23 / Order Confirmed</p>
                <span class="public-confirmation-status">Sipariş Alındı</span>
                <h1>Öğünün<br /><em>hazırlanıyor.</em></h1>
                <p>
                    NO23 Kitchen siparişin sisteme kaydedildi.
                    Teslimat takibi için sipariş numaranı saklayabilirsin.
                </p>
                <a class="public-order-back"
                   asp-area=""
                   asp-controller="Kitchen"
                   asp-action="Index">
                    Kitchen'a Dön <span aria-hidden="true">↗</span>
                </a>
            </div>

            <article class="public-confirmation-receipt">
                <div class="public-confirmation-number">
                    <span>Sipariş Numarası</span>
                    <strong>@Model.OrderNumber</strong>
                </div>
                <dl>
                    <div><dt>Ürün</dt><dd>@Model.ProductName</dd></div>
                    <div><dt>Adet</dt><dd>@Model.Quantity</dd></div>
                    <div><dt>Toplam</dt><dd class="public-confirmation-total">@Model.Total.ToString("C0")</dd></div>
                    <div><dt>Teslimat</dt><dd>@Model.DeliveryDate.ToString("dd.MM.yyyy") / @Model.DeliveryTimeSlot</dd></div>
                    <div><dt>Ödeme</dt><dd>@Model.PaymentStatusText</dd></div>
                </dl>
                <footer><span>NO23 Kitchen</span><strong>23</strong></footer>
            </article>
        </section>
    </div>
</div>
