@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model NO23.Web.Areas.Identity.Pages.Account.RegisterModel
@using NO23.Web.Services
@{
    ViewData["Title"] = Model.IsKitchenRegistration ? "Kitchen Hesabı Oluştur" : "Bize Katıl";
    Layout = "/Views/Shared/_Layout.cshtml";
    var clubToday = DateOnly.FromDateTime(ClubTime.Now);
    var selectedOption = Model.ServiceOptions.FirstOrDefault(option => option.Id == Model.Input.ServicePackageVariantId &&
        string.Equals(option.PackageCode, Model.Input.PackageCode, StringComparison.OrdinalIgnoreCase));
}
@section Styles {
    <link rel="stylesheet" href="~/css/package-selector.css" asp-append-version="true" />
}

<section class="no23-register-page">
    <div class="register-page-grid" aria-hidden="true"></div>
    <div class="register-page-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <div class="no23-register-shell">
            <aside class="register-intro-panel">
                <img class="register-emblem"
                     src="~/images/brand/no23-emblem.webp"
                     alt=""
                     width="360"
                     height="360"
                     aria-hidden="true" />
                <a class="register-back-link"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <span aria-hidden="true">←</span>
                    Ana sayfaya dön
                </a>

                <div class="register-intro-content">
                    <p class="register-kicker">NO23 · Sports Club & Kitchen</p>

                    @if (Model.IsKitchenRegistration)
                    {
                    <h1>Öğünlerini seçtin.<span>Şimdi hesabını aç.</span></h1>
                    <p class="register-intro-description">Kitchen planını ve teslimatlarını tek hesabından takip et.</p>
                    <ul class="register-benefits">
                        <li><span>01</span><div><strong>Seçimlerin hazır</strong><small>Öğünlerini yeniden seçmen gerekmez</small></div></li>
                        <li><span>02</span><div><strong>Kitchen hesabı</strong><small>Spor üyeliği satın alman gerekmez</small></div></li>
                        <li><span>03</span><div><strong>Ödemeye devam et</strong><small>Hesabını aç, planını tamamla</small></div></li>
                    </ul>
                    }
                    else
                    {
                    <h1>
                        Hedefine giden yol
                        <span>burada başlıyor.</span>
                    </h1>

                    <p class="register-intro-description">
                        Sana uygun spor üyeliğini seç, NO23 deneyimine katıl.
                    </p>

                    <ul class="register-benefits">
                        <li>
                            <span>01</span>
                            <div>
                                <strong>Kişisel plan</strong>
                                <small>Hedefine göre şekillenen program</small>
                            </div>
                        </li>
                        <li>
                            <span>02</span>
                            <div>
                                <strong>Profesyonel takip</strong>
                                <small>Eğitmen ve gelişim desteği</small>
                            </div>
                        </li>
                        <li>
                            <span>03</span>
                            <div>
                                <strong>Tek ekosistem</strong>
                                <small>Antrenman, beslenme ve community</small>
                            </div>
                        </li>
                    </ul>
                    }
                </div>

                <p class="register-intro-footer">
                    Train Better. Eat Better. Live Better.
                </p>
            </aside>

            <div class="register-form-panel">
                <div class="register-form-heading">
                    <div>
                        <p class="register-form-kicker">@(Model.IsKitchenRegistration ? "NO:23 Kitchen · Hesap oluştur" : "Spor üyeliği · Hesap oluştur")</p>
                        <h2>Bilgilerini tamamla.</h2>
                    </div>

                    <span class="register-step">01 / 01</span>
                </div>

                <p class="register-form-description">
                    @(Model.IsKitchenRegistration
                        ? "Seçtiğin öğünler saklandı. Hesabını oluşturduktan sonra Kitchen ödeme adımına devam edeceksin."
                        : "Birkaç temel bilgiyle hesabını ve spor üyelik profilini oluşturalım.")
                </p>

                <form id="registerForm"
                      method="post"
                      asp-antiforgery="true"
                      class="no23-register-form">

                    <div asp-validation-summary="ModelOnly"
                         class="register-validation-summary"
                         role="alert"></div>

                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="Input.Flow" />
                    <span asp-validation-for="Input.Flow" class="text-danger"></span>

                    <div class="row g-3 g-lg-4">
                        <div class="col-md-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.FirstName"></label>
                                <input asp-for="Input.FirstName"
                                       class="form-control no23-form-control"
                                       autocomplete="given-name"
                                       placeholder="Adın" />
                                <span asp-validation-for="Input.FirstName"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.LastName"></label>
                                <input asp-for="Input.LastName"
                                       class="form-control no23-form-control"
                                       autocomplete="family-name"
                                       placeholder="Soyadın" />
                                <span asp-validation-for="Input.LastName"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.NationalIdentityNumber"></label>
                                <input asp-for="Input.NationalIdentityNumber"
                                       class="form-control no23-form-control"
                                       inputmode="numeric"
                                       pattern="[0-9]{11}"
                                       maxlength="11"
                                       autocomplete="off"
                                       placeholder="11 haneli TC Kimlik No" />
                                <span asp-validation-for="Input.NationalIdentityNumber"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.BirthDate"></label>
                                <input asp-for="Input.BirthDate"
                                       type="date"
                                       class="form-control no23-form-control"
                                       autocomplete="bday"
                                       min="@clubToday.AddYears(-120).ToString("yyyy-MM-dd")"
                                       max="@clubToday.ToString("yyyy-MM-dd")"
                                       required />
                                <span asp-validation-for="Input.BirthDate"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="no23-form-field">
                                <label asp-for="Input.PhoneNumber"></label>
                                <input asp-for="Input.PhoneNumber"
                                       class="form-control no23-form-control"
                                       autocomplete="tel"
                                       placeholder="05xx xxx xx xx" />
                                <span asp-validation-for="Input.PhoneNumber"></span>
                            </div>
                        </div>

                        @if (!Model.IsKitchenRegistration)
                        {
                        <div class="col-12" data-package-selector>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="no23-form-field no23-package-field">
                                        <label asp-for="Input.PackageCode"></label>
                                        <select asp-for="Input.PackageCode" class="form-select no23-form-select" data-package-choice required>
                                            <option value="">Spor üyelik paketi seçin</option>
                                            @foreach (var package in Model.PackageOptions)
                                            {
                                                <option value="@package.Code">@package.Name</option>
                                            }
                                        </select>
                                        <span asp-validation-for="Input.PackageCode"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="no23-form-field no23-package-option-field">
                                        <label asp-for="Input.ServicePackageVariantId"></label>
                                        <select asp-for="Input.ServicePackageVariantId" class="form-select no23-form-select" data-package-variant required>
                                            <option value="">Üyelik süresi seçin</option>
                                            @foreach (var package in Model.PackageOptions)
                                            {
                                                <optgroup label="@package.Name">
                                                    @foreach (var option in Model.ServiceOptions.Where(option => option.PackageCode == package.Code))
                                                    {
                                                        <option value="@option.Id" data-package="@option.PackageCode" data-label="@option.Name"
                                                                data-price="@option.Price" data-price-note="@option.PriceNote" data-total-price="@option.TotalPrice"
                                                                data-duration="@option.Duration" data-rights="@option.Rights">@package.Name — @option.Name</option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                        <span asp-validation-for="Input.ServicePackageVariantId"></span>
                                    </div>
                                </div>
                            </div>
                            <p class="form-text">Spor üyeliği için paket ve süre seçimi zorunludur.</p>
                            @if (Model.PackageOptions.Count == 0)
                            {
                                <p class="register-validation-summary" role="status">Şu anda başvuruya açık üyelik paketi bulunmuyor.</p>
                            }
                            <div class="package-choice-summary" data-package-summary hidden="@(selectedOption is null)" aria-live="polite" aria-atomic="true">
                                <dl>
                                    <div><dt>Fiyat</dt><dd><strong data-package-price>@selectedOption?.Price</strong> <span data-package-price-note>@selectedOption?.PriceNote</span></dd></div>
                                    <div><dt>Süre</dt><dd data-package-duration>@selectedOption?.Duration</dd></div>
                                    <div data-package-total-row hidden="@(selectedOption?.TotalPrice is null)"><dt>Dönem toplamı</dt><dd data-package-total-price>@selectedOption?.TotalPrice</dd></div>
                                    <div><dt>Ders hakkı</dt><dd data-package-rights>@selectedOption?.Rights</dd></div>
                                </dl>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="no23-form-field">
                                <label asp-for="Input.FitnessGoal"></label>
                                <input asp-for="Input.FitnessGoal"
                                       class="form-control no23-form-control"
                                       placeholder="Yağ yakımı, kas kazanımı, performans..." />
                                <span asp-validation-for="Input.FitnessGoal"></span>
                            </div>
                        </div>
                        }

                        <div class="col-12">
                            <div class="no23-form-field">
                                <label asp-for="Input.ReferralCode">Davet kodu (varsa)</label>
                                <input asp-for="Input.ReferralCode"
                                       class="form-control no23-form-control"
                                       autocomplete="off"
                                       placeholder="Arkadaşının NO23 davet kodu" />
                                <span asp-validation-for="Input.ReferralCode"></span>
                                <small class="text-muted">Davet koduyla kayıt olursan ikiniz de %10 indirim kazanırsınız.</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.Password"></label>
                                <input asp-for="Input.Password"
                                       class="form-control no23-form-control"
                                       autocomplete="new-password"
                                       placeholder="En az 6 karakter" />
                                <span asp-validation-for="Input.Password"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="no23-form-field">
                                <label asp-for="Input.ConfirmPassword"></label>
                                <input asp-for="Input.ConfirmPassword"
                                       class="form-control no23-form-control"
                                       autocomplete="new-password"
                                       placeholder="Parolanı tekrar yaz" />
                                <span asp-validation-for="Input.ConfirmPassword"></span>
                            </div>
                        </div>
                    </div>

                    <button id="registerSubmit"
                            type="submit"
                            class="no23-register-submit" disabled="@(!Model.IsKitchenRegistration && Model.PackageOptions.Count == 0)">
                        <span>@(Model.IsKitchenRegistration ? "Hesabımı oluştur ve Kitchen'e devam et" : "Hesabımı oluştur")</span>
                        <span aria-hidden="true">→</span>
                    </button>

                    <p class="register-login-link">
                        Zaten hesabın var mı?
                        <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">
                            Üye Girişi
                        </a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/package-selector.js" asp-append-version="true"></script>
}
