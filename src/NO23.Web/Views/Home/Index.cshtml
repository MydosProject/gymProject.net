<section class="memberships-section"
         id="memberships">

    <div class="container">
        <div class="memberships-heading">
            <div>
                <p class="section-kicker">Üyelik Paketleri</p>
                <h2>Hedefine uygun planı seç.</h2>
            </div>

            <p>
                Başlangıç seviyesinden performans odaklı programlara kadar
                sana uygun NO23 deneyimini keşfet.
            </p>
        </div>

        <div class="membership-grid">
            @foreach (var package in Model.MembershipPackages)
            {
                var isPro = package.Code.Equals(
                    "PRO",
                    StringComparison.OrdinalIgnoreCase);

                var isElite = package.Code.Equals(
                    "ELITE",
                    StringComparison.OrdinalIgnoreCase);

                var cardClass = isPro
                    ? "membership-card membership-card-featured"
                    : isElite
                        ? "membership-card membership-card-elite"
                        : "membership-card";

                var level = package.Code.ToUpperInvariant() switch
                {
                    "START" => "Başlangıç",
                    "PLUS" => "Düzenli",
                    "PRO" => "Hedef Odaklı",
                    "ELITE" => "Tam Deneyim",
                    _ => "Üyelik"
                };

                var buttonText = package.Code.ToUpperInvariant() switch
                {
                    "PRO" => "PRO’ya Başvur",
                    "ELITE" => "ELITE’a Başvur",
                    _ => "Başvuru Yap"
                };

                <article class="@cardClass">
                    @if (isPro)
                    {
                        <span class="membership-recommended">
                            Önerilen
                        </span>
                    }

                    <div class="membership-card-header">
                        <span class="membership-order">
                            @package.DisplayOrder.ToString("00")
                        </span>

                        <span class="membership-level">
                            @level
                        </span>
                    </div>

                    <div>
                        <h3>@package.Name</h3>

                        <p class="membership-audience">
                            @package.Audience
                        </p>
                    </div>

                    <ul class="membership-features">
                        @foreach (var feature in package.Features)
                        {
                            <li>@feature</li>
                        }
                    </ul>

                    <a class="membership-button"
                       asp-area="Identity"
                       asp-page="/Account/Register"
                       asp-route-package="@package.Code">
                        @buttonText
                    </a>
                </article>
            }
        </div>

        <div class="membership-note">
            <div>
                <strong>
                    Hangi paketin sana uygun olduğundan emin değil misin?
                </strong>

                <span>
                    Hedeflerini birlikte değerlendirelim.
                </span>
            </div>

            <a href="#contact">
                Bizimle İletişime Geç
            </a>
        </div>
    </div>
</section>

<section class="no23-faq-section"
         id="faq"
         aria-labelledby="faq-title">
    <div class="container">
        <div class="no23-faq-heading">
            <div>
                <p class="section-kicker">Merak Ettiklerin</p>
                <h2 id="faq-title">
                    Başlamadan önce<br />bilmen gerekenler.
                </h2>
            </div>

            <p>
                Üyelikten rezervasyona, Kitchen planından online siparişe
                kadar NO23 deneyiminin temel adımlarını burada bulabilirsin.
            </p>
        </div>

        <div class="no23-faq-grid">
            <details class="no23-faq-item" open>
                <summary>
                    <span class="no23-faq-number">01</span>
                    <strong>NO23 üyeliğimi nasıl başlatabilirim?</strong>
                    <span class="no23-faq-toggle" aria-hidden="true"></span>
                </summary>
                <div class="no23-faq-answer">
                    <p>
                        Ana sayfadaki üyelik paketlerinden sana uygun olanı seçip
                        başvuru formunu tamamlayabilirsin. Hesabın ve üye profilin
                        seçtiğin paketle birlikte oluşturulur.
                    </p>
                </div>
            </details>

            <details class="no23-faq-item">
                <summary>
                    <span class="no23-faq-number">02</span>
                    <strong>Hangi üyelik paketini seçmeliyim?</strong>
                    <span class="no23-faq-toggle" aria-hidden="true"></span>
                </summary>
                <div class="no23-faq-answer">
                    <p>
                        START, PLUS, PRO ve ELITE paketlerini haftalık ders hakkı
                        ve sundukları ayrıcalıklara göre karşılaştırabilirsin.
                        Hedefin ve antrenman sıklığın doğru paketi belirlemene
                        yardımcı olur.
                    </p>
                </div>
            </details>

            <details class="no23-faq-item">
                <summary>
                    <span class="no23-faq-number">03</span>
                    <strong>Grup dersine nasıl rezervasyon yapabilirim?</strong>
                    <span class="no23-faq-toggle" aria-hidden="true"></span>
                </summary>
                <div class="no23-faq-answer">
                    <p>
                        Üye girişi yaptıktan sonra hesabındaki “Uygun Dersler”
                        alanından yaklaşan seansları inceleyebilirsin. Kontenjan
                        ve kalan ders hakkın uygunsa rezervasyonunu oluşturabilirsin.
                    </p>
                </div>
            </details>

            <details class="no23-faq-item">
                <summary>
                    <span class="no23-faq-number">04</span>
                    <strong>Ders rezervasyonumu iptal edebilir miyim?</strong>
                    <span class="no23-faq-toggle" aria-hidden="true"></span>
                </summary>
                <div class="no23-faq-answer">
