@model TrainerPanelAccountViewModel

@{
    ViewData["Title"] = "Trainer Panel Hesabı";
}

<section class="admin-trainer-account-page">

    <header class="admin-trainer-account-head">

        <div>

            <a asp-action="Index"
               class="admin-trainer-account-back">
                ← Eğitmenlere dön
            </a>

            <p class="admin-trainer-account-eyebrow">
                Eğitmen / Panel erişimi
            </p>

            <h1>
                Trainer Panel Hesabı
            </h1>

            <p>
                <strong>@Model.TrainerName</strong>
                için giriş hesabı oluştur.
            </p>

        </div>

        <div class="admin-trainer-account-mark"
             aria-hidden="true">
            01
        </div>

    </header>


    <div class="admin-trainer-account-grid">

        <aside class="admin-trainer-account-info">

            <span>
                Panel erişimi
            </span>

            <h2>
                Eğitmene giriş bilgilerini tanımla.
            </h2>

            <p>
                Oluşturulan hesap ile eğitmen kendi
                paneline giriş yapabilir; derslerini,
                birebir taleplerini ve mesajlarını
                görüntüleyebilir.
            </p>

            <div class="admin-trainer-account-trainer">

                <small>
                    Hesap oluşturulan eğitmen
                </small>

                <strong>
                    @Model.TrainerName
                </strong>

            </div>

        </aside>


        <form method="post"
              class="admin-trainer-account-form">

            <div asp-validation-summary="ModelOnly"
                 class="admin-trainer-account-validation">
            </div>

            <input type="hidden"
                   asp-for="TrainerId" />


            <div class="admin-trainer-account-form-head">

                <div>

                    <span>
                        Giriş bilgileri
                    </span>

                    <strong>
                        Hesap bilgilerini tamamla
                    </strong>

                </div>

                <span aria-hidden="true">
                    02
                </span>

            </div>


            <div class="admin-trainer-account-fields">

                <label class="admin-trainer-account-field">

                    <span>
                        @Html.DisplayNameFor(model => model.Email)
                    </span>

                    <input asp-for="Email"
                           autocomplete="email" />

                    <small asp-validation-for="Email">
                    </small>

                </label>


                <div class="admin-trainer-account-row">

                    <label class="admin-trainer-account-field">

                        <span>
                            @Html.DisplayNameFor(
                                model => model.Password)
                        </span>

                        <input asp-for="Password"
                               autocomplete="new-password" />

                        <small asp-validation-for="Password">
                        </small>

                    </label>


                    <label class="admin-trainer-account-field">

                        <span>
                            @Html.DisplayNameFor(
                                model => model.ConfirmPassword)
                        </span>

                        <input asp-for="ConfirmPassword"
                               autocomplete="new-password" />

                        <small asp-validation-for="ConfirmPassword">
                        </small>

                    </label>

                </div>

            </div>


            <div class="admin-trainer-account-actions">

                <a asp-action="Index"
                   class="admin-trainer-account-cancel">
                    Vazgeç
                </a>

                <button type="submit"
                        class="admin-trainer-account-submit">

                    <span>
                        Hesabı oluştur
                    </span>

                    <strong aria-hidden="true">
                        →
                    </strong>

                </button>

            </div>

        </form>

    </div>

</section>

@section Scripts {

}