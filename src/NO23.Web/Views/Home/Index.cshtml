@using NO23.Web.Data.Seed
@model NO23.Web.ViewModels.Home.HomeIndexViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="no23-hero">
    <div class="hero-video-shell" aria-hidden="true">
        @* Video source: https://www.pexels.com/video/silhouette-of-man-strength-training-in-dark-gym-31445380/ *@
        <video class="hero-background-video"
               data-hero-video
               src="@Url.Content("~/videos/no23-hero.mp4")?v=20260723-1"
               autoplay
               muted
               loop
               playsinline
               preload="auto"
               poster="~/images/no23-home-hero.webp">
        </video>
    </div>

    <div class="hero-video-overlay" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="container position-relative">
        <div class="hero-layout">
            <div class="hero-copy">
                <p class="hero-kicker">
                    Performance · Nutrition · Community
                </p>

                <h1 class="hero-title">
                    <span>Train Better.</span>
                    <span class="hero-title-accent">Eat Better.</span>
                    <span>Live Better.</span>
                </h1>

                <p class="hero-description">
                    NO23 Sports Club; profesyonel antrenman, kişiselleştirilmiş
                    beslenme ve güçlü bir topluluk deneyimini tek platformda
                    buluşturur.
                </p>

                <div class="hero-actions">
                    <a class="btn no23-primary-button"
                       href="#memberships">
                        Üyelik Paketleri
                    </a>

                    <a class="btn no23-secondary-button"
                       href="#services">
                        Hizmetleri Keşfet
                    </a>
                </div>

                <div class="hero-highlights">
                    <span>Bilimsel Antrenman</span>
                    <span>Beslenme Desteği</span>
                    <span>Gelişim Takibi</span>
                </div>
            </div>

            <div class="hero-video-meta" aria-hidden="true">
                <span>NO23 / PERFORMANCE</span>
                <strong>01</strong>
                <small>Güç · Tempo · Disiplin</small>
            </div>
        </div>
    </div>

    <button class="hero-video-toggle"
            type="button"
            data-hero-video-toggle
            aria-label="Arka plan videosunu durdur"
            aria-pressed="false">
        <span class="hero-video-toggle-icon" aria-hidden="true">Ⅱ</span>
        <span data-hero-video-label>Durdur</span>
    </button>
</section>

<section class="quick-access"
         aria-labelledby="quick-access-title">

    <div class="container">
        <div class="quick-access-heading">
            <div>
                <p class="section-kicker">Hızlı Erişim</p>

                <h2 id="quick-access-title">
                    Bugün ne yapmak istersin?
                </h2>
            </div>

            <p>
                NO23 deneyiminin tüm parçalarına tek noktadan ulaş.
            </p>
        </div>

        <div class="quick-access-grid">
            <a class="quick-access-card"
               href="#memberships">
                <span class="quick-access-number">01</span>
                <strong>Üyelik Paketleri</strong>
                <small>Sana uygun paketi keşfet</small>
            </a>

            <a class="quick-access-card"
               href="#schedule">
                <span class="quick-access-number">02</span>
                <strong>Ders Programı</strong>
                <small>Grup derslerini incele</small>
            </a>

            @if (User.IsInRole(ApplicationRoles.Admin))
            {
                <a class="quick-access-card"
                   asp-area="Admin"
                   asp-controller="KitchenMenuItems"
                   asp-action="Index">
                    <span class="quick-access-number">03</span>
                    <strong>NO23 Kitchen</strong>
                    <small>Menü ürünlerini yönet</small>
                </a>

                <a class="quick-access-card"
                   asp-area="Admin"
                   asp-controller="Orders"
                   asp-action="Index">
                    <span class="quick-access-number">04</span>
                    <strong>Sipariş Yönetimi</strong>
                    <small>Teslimat akışını incele</small>
                </a>
            }
            else
            {
                @if (User.IsInRole(ApplicationRoles.Member))
                {
                    <a class="quick-access-card"
                       asp-area="Member"
                       asp-controller="Kitchen"
                       asp-action="Index"
                       asp-fragment="menu">
                        <span class="quick-access-number">03</span>
                        <strong>NO23 Kitchen</strong>
                        <small>Sağlıklı menülere ulaş</small>
                    </a>
                }
                else
                {
                    <a class="quick-access-card"
                       asp-controller="Kitchen"
                       asp-action="Index">
                        <span class="quick-access-number">03</span>
                        <strong>NO23 Kitchen</strong>
                        <small>Sağlıklı menülere ulaş</small>
                    </a>
                }

                <a class="quick-access-card"
                   asp-area="Member"
                   asp-controller="Kitchen"
                   asp-action="Index"
                   asp-fragment="calculator">
                    <span class="quick-access-number">04</span>
                    <strong>Kalori Hesapla</strong>
                    <small>Günlük ihtiyacını öğren</small>
                </a>
            }

            @if (User.IsInRole(ApplicationRoles.Admin))
            {
                <a class="quick-access-card"
                   asp-area="Admin"
                   asp-controller="ShopProducts"
                   asp-action="Index">
                    <span class="quick-access-number">05</span>
                    <strong>Shop Ürünleri</strong>
                    <small>Kataloğu ve stokları yönet</small>
                </a>

                <a class="quick-access-card"
                   asp-area="Admin"
                   asp-controller="ClassSessions"
                   asp-action="Index">
                    <span class="quick-access-number">06</span>
                    <strong>Ders Planlama</strong>
                    <small>Programı ve seansları yönet</small>
                </a>
            }
            else
            {
                @if (User.IsInRole(ApplicationRoles.Member))
                {
                    <a class="quick-access-card"
