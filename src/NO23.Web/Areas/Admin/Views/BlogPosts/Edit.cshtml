@model BlogPostFormViewModel
@{
    ViewData["Title"] = "Blog Yazısını Düzenle";
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head admin-form-head">
            <div>
                <a asp-action="Index" class="admin-back-link">← Blog'a dön</a>
                <p class="admin-eyebrow">İçerik / Blog</p>
                <h1>Yazıyı düzenle</h1>
                <p class="admin-page-description">İçeriği, etiketleri ve yayın planını tek ekrandan güncelle.</p>
            </div>
        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">
                @successMessage
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }

        <partial name="_BlogPostForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
