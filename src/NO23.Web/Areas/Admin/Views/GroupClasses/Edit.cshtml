@model GroupClassFormViewModel
@{
    ViewData["Title"] = "Grup Dersi Düzenle";
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head admin-form-head">
            <div>
                <a asp-action="Index" class="admin-back-link">← Derslere dön</a>
                <p class="admin-eyebrow">Kulüp / Ders Yönetimi</p>
                <h1>Grup dersini düzenle</h1>
                <p class="admin-page-description">Dersin eğitmen, performans, kapasite ve public görünürlük bilgilerini güncelle.</p>
            </div>
        </header>

        <partial name="_GroupClassForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
