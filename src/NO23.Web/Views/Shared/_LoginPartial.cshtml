@using Microsoft.AspNetCore.Identity
@using NO23.Web.Data.Seed
@using NO23.Web.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav no23-auth-nav align-items-lg-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        @if (User.IsInRole(ApplicationRoles.Admin))
        {
            <a class="nav-link no23-account-link"
               asp-area="Admin"
               asp-controller="Members"
               asp-action="Index"
               title="Admin paneli">
                Admin Paneli
            </a>
        }
        else if (User.IsInRole(ApplicationRoles.Member))
        {
            <a class="nav-link no23-account-link"
               asp-area="Member"
               asp-controller="Home"
               asp-action="Index"
               title="Üye panelim">
                Hesabım
            </a>
        }
        else
        {
            <a class="nav-link no23-account-link"
               asp-area="Identity"
               asp-page="/Account/Manage/Index"
               title="Hesabım">
                Hesabım
            </a>
        }
    </li>

    <li class="nav-item">
        <form class="no23-logout-form"
              asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
              method="post">
            <button type="submit" class="btn no23-logout-button">
                Çıkış
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link no23-login-link"
           asp-area="Identity"
           asp-page="/Account/Login">
            Üye Girişi
        </a>
    </li>

    <li class="nav-item">
        <a class="btn no23-register-button"
           asp-area="Identity"
           asp-page="/Account/Register">
            Bize Katıl
        </a>
    </li>
}
</ul>
