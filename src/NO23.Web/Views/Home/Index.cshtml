@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="no23-hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <div class="row align-items-center gy-5">
            <div class="col-xl-8 col-lg-7">
                <p class="hero-kicker">
                    Performance · Nutrition · Community
                </p>

                <h1 class="hero-title">
                    <span>Train Better.</span>
                    <span class="hero-title-accent">Eat Better.</span>
                    <span>Live Better.</span>
                </h1>

                <p class="hero-description">
                    NO23 Sports Club; profesyonel antrenman, kişiselleştirilmiş
                    beslenme ve güçlü bir topluluk deneyimini tek platformda
                    buluşturur.
                </p>

                <div class="hero-actions">
                    <a class="btn no23-primary-button"
                       href="#memberships">
                        Üyelik Paketleri
                    </a>

                    <a class="btn no23-secondary-button"
                       href="#services">
                        Hizmetleri Keşfet
                    </a>
                </div>

                <div class="hero-highlights">
                    <span>Bilimsel Antrenman</span>
                    <span>Beslenme Desteği</span>
                    <span>Gelişim Takibi</span>
                </div>
            </div>

            <div class="col-xl-4 col-lg-5">
                <aside class="hero-experience-card">
                    <span class="experience-number">23</span>
                    <p class="experience-label">NO23 Ecosystem</p>

                    <h2>
                        Yaşam tarzının tamamı tek üyelikte.
                    </h2>

                    <ul class="experience-list">
                        <li>
                            <span>01</span>
                            Sports Club
                        </li>
                        <li>
                            <span>02</span>
                            NO23 Kitchen
                        </li>
                        <li>
                            <span>03</span>
                            NO23 Community
                        </li>
                    </ul>
                </aside>
            </div>
        </div>
    </div>
</section>

<section class="quick-access" aria-labelledby="quick-access-title">
    <div class="container">
        <div class="quick-access-heading">
            <div>
                <p class="section-kicker">Hızlı Erişim</p>
                <h2 id="quick-access-title">Bugün ne yapmak istersin?</h2>
            </div>

            <p>
                NO23 deneyiminin tüm parçalarına tek noktadan ulaş.
            </p>
        </div>

        <div class="quick-access-grid">
            <a class="quick-access-card" href="#memberships">
                <span class="quick-access-number">01</span>
                <strong>Üyelik Paketleri</strong>
                <small>Sana uygun paketi keşfet</small>
            </a>

            <a class="quick-access-card" href="#schedule">
                <span class="quick-access-number">02</span>
                <strong>Ders Programı</strong>
                <small>Grup derslerini incele</small>
            </a>

            <a class="quick-access-card" href="#kitchen">
                <span class="quick-access-number">03</span>
                <strong>NO23 Kitchen</strong>
                <small>Sağlıklı menülere ulaş</small>
            </a>

            <a class="quick-access-card" href="#calorie">
                <span class="quick-access-number">04</span>
                <strong>Kalori Hesapla</strong>
                <small>Günlük ihtiyacını öğren</small>
            </a>

            <a class="quick-access-card" href="#order">
                <span class="quick-access-number">05</span>
                <strong>Online Sipariş</strong>
                <small>Öğünlerini kolayca seç</small>
            </a>

            <a class="quick-access-card" href="#appointment">
                <span class="quick-access-number">06</span>
                <strong>Randevu Al</strong>
                <small>Antrenmanını planla</small>
            </a>
        </div>
    </div>
</section>

<section class="services-section" id="services">
    <div class="container">
        <div class="services-heading">
            <div>
                <p class="section-kicker">Hizmetlerimiz</p>
                <h2>
                    Sadece spor değil.<br />
                    Bütünsel gelişim.
                </h2>
            </div>

            <p>
                Hedefine, deneyimine ve yaşam tarzına göre tasarlanan
                profesyonel antrenman çözümlerini keşfet.
            </p>
        </div>

        <div class="services-grid">
            <article class="service-card service-card-accent">
                <div class="service-card-top">
                    <span class="service-number">01</span>
                    <span class="service-category">Birebir</span>
                </div>

                <div class="service-card-content">
                    <h3>Personal Training</h3>

                    <p>
                        Hedeflerine özel hazırlanan program ve profesyonel
                        eğitmen takibiyle maksimum verim elde et.
                    </p>

                    <ul class="service-features">
                        <li>Birebir antrenman</li>
                        <li>Hedef analizi</li>
                        <li>Ölçüm ve takip</li>
                        <li>Program güncelleme</li>
                    </ul>
                </div>
            </article>

            <article class="service-card" id="schedule">
                <div class="service-card-top">
                    <span class="service-number">02</span>
                    <span class="service-category">Birlikte</span>
                </div>

                <div class="service-card-content">
                    <h3>Grup Dersleri</h3>

                    <p>
                        Yüksek enerji, güçlü motivasyon ve farklı seviyelere
                        uygun grup antrenmanları.
                    </p>

                    <ul class="service-features">
                        <li>Bootcamp</li>
                        <li>Metcon</li>
                        <li>Mat &amp; Reformer Pilates</li>
                        <li>Fonksiyonel antrenman</li>
                    </ul>
                </div>
            </article>

            <article class="service-card">
                <div class="service-card-top">
                    <span class="service-number">03</span>
                    <span class="service-category">Performans</span>
                </div>

                <div class="service-card-content">
                    <h3>Atletik Performans</h3>

                    <p>
                        Sporcular için ölçülebilir, branşa özel ve bilimsel
                        performans gelişimi.
                    </p>

                    <ul class="service-features">
                        <li>Kuvvet</li>
                        <li>Hız ve çeviklik</li>
                        <li>Patlayıcı güç</li>
                        <li>Test ve ölçümler</li>
                    </ul>
                </div>
            </article>

            <article class="service-card service-card-light">
                <div class="service-card-top">
                    <span class="service-number">04</span>
                    <span class="service-category">Gelişim</span>
                </div>

                <div class="service-card-content">
                    <h3>Kids Club</h3>

                    <p>
                        Çocuklar için güvenli, eğlenceli ve gelişim odaklı
                        hareket eğitimi.
                    </p>

                    <ul class="service-features">
                        <li>Motor beceri gelişimi</li>
                        <li>Denge ve koordinasyon</li>
                        <li>Kuvvet gelişimi</li>
                        <li>Eğlenceli eğitim modeli</li>
                    </ul>
                </div>
            </article>
        </div>
    </div>
</section>