@model ServicePackageFormViewModel
<form method="post" class="bg-white border rounded-3 p-4 text-dark admin-form-card"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input type="hidden" asp-for="Id" />
<section class="admin-form-section"><header><span>01</span><div><h2>Paket kimliği</h2><p>Kategori, paket adı ve public sayfadaki metinleri belirle.</p></div></header><div class="row g-3">
<div class="col-md-4"><label asp-for="Category" class="form-label"></label><select asp-for="Category" asp-items="Html.GetEnumSelectList<ServicePackageCategory>()" class="form-select"></select></div>
<div class="col-md-5"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-3"><label asp-for="DisplayOrder" class="form-label"></label><input asp-for="DisplayOrder" class="form-control" /></div>
<div class="col-md-6"><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" /><span asp-validation-for="Slug" class="text-danger"></span></div><div class="col-md-6"><label asp-for="MembershipPackageId" class="form-label"></label><select asp-for="MembershipPackageId" class="form-select"><option value="">Bağlantı yok</option>@foreach(var p in Model.MembershipPackages){<option value="@p.Id">@p.Name</option>}</select><span asp-validation-for="MembershipPackageId" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Subtitle" class="form-label"></label><input asp-for="Subtitle" class="form-control" /></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div></div></section>
<section class="admin-form-section"><header><span>02</span><div><h2>Özellikler ve görünürlük</h2><p>Her satıra public kartta gösterilecek bir özellik yaz.</p></div></header><label asp-for="FeaturesText" class="form-label"></label><textarea asp-for="FeaturesText" class="form-control" rows="6" placeholder="Ölçüm ve gelişim takibi&#10;Uzman eğitmen desteği"></textarea><div class="admin-feature-grid mt-4"><label class="form-check admin-feature-option"><input asp-for="IsFeatured" class="form-check-input" /><span>Öne çıkan paket</span></label><label class="form-check admin-feature-option"><input asp-for="IsActive" class="form-check-input" /><span>Aktif</span></label></div></section>
<div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a><button class="btn btn-dark">Kaydet</button></div></form>
