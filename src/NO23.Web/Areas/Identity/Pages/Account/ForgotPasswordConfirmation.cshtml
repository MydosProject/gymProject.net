@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Parola Sıfırlama Bağlantısı";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="no23-register-page">
    <div class="register-page-grid" aria-hidden="true"></div>
    <div class="register-page-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <div class="no23-register-shell">
            <aside class="register-intro-panel">
                <a class="register-back-link"
                   asp-controller="Home"
                   asp-action="Index"
                   asp-area="">
                    <span aria-hidden="true">←</span>
                    Ana sayfaya dön
                </a>

                <div class="register-intro-content">
                    <p class="register-kicker">NO23 Member Access</p>

                    <h1>
                        Bir sonraki adım
                        <span>e-postanda.</span>
                    </h1>

                    <p class="register-intro-description">
                        Hesabını güvende tutmak için parola yenileme işlemi
                        yalnızca sana gönderilen bağlantı üzerinden tamamlanır.
                    </p>
                </div>

                <p class="register-intro-footer">
                    Train Better. Eat Better. Live Better.
                </p>
            </aside>

            <div class="register-form-panel d-flex flex-column justify-content-center">
                <div class="register-form-heading">
                    <div>
                        <p class="register-form-kicker">İstek Alındı</p>
                        <h2>E-postanı kontrol et.</h2>
                    </div>

                    <span class="register-step">NO23</span>
                </div>

                <p class="register-form-description">
                    Adresin sistemde kayıtlıysa parola sıfırlama bağlantısı gönderilecek.
                    Gelen kutunda göremezsen gereksiz veya spam klasörünü de kontrol et.
                </p>

                <a asp-page="./Login"
                   class="no23-register-submit">
                    <span>Üye girişine dön</span>
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </div>
</section>
