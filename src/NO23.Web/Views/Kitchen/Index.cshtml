@model IReadOnlyList<NO23.Web.ViewModels.GuestOrders.GuestOrderPageViewModel>
@{
    ViewData["Title"] = "NO23 Kitchen";
}

<section class="container py-5">
    <div class="row align-items-end g-4 mb-4">
        <div class="col-lg-8">
            <p class="text-uppercase text-muted small mb-2">NO23 Kitchen</p>
            <h1 class="display-5 fw-semibold mb-3">Hedefine uygun öğünleri keşfet.</h1>
            <p class="lead text-muted mb-0">
                Üye olmadan da aktif Kitchen ürünlerini inceleyebilir ve tek ürün siparişi verebilirsin.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <a class="btn btn-outline-dark" asp-area="Identity" asp-page="/Account/Register">
                Üyelik Oluştur
            </a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-light border">
            Şu anda aktif Kitchen ürünü bulunmuyor.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <article class="card h-100 border-0 shadow-sm">
                        <div class="card-body d-flex flex-column gap-3">
                            <div class="d-flex justify-content-between gap-3">
                                <span class="badge text-bg-light">@item.Category</span>
                                <strong>@item.UnitPrice.ToString("C0")</strong>
                            </div>

                            <div>
                                <h2 class="h5 mb-2">@item.ItemName</h2>
                                <p class="text-muted mb-0">
                                    @(string.IsNullOrWhiteSpace(item.Description)
                                        ? "NO23 Kitchen tarafından hazırlanan dengeli öğün."
                                        : item.Description)
                                </p>
                            </div>

                            <dl class="row small text-muted mb-0">
                                <dt class="col-6">Kalori</dt>
                                <dd class="col-6 text-end">@item.Calories kcal</dd>
                                <dt class="col-6">Protein</dt>
                                <dd class="col-6 text-end">@item.ProteinGrams g</dd>
                                <dt class="col-6">Karbonhidrat</dt>
                                <dd class="col-6 text-end">@item.CarbohydrateGrams g</dd>
                                <dt class="col-6">Yağ</dt>
                                <dd class="col-6 text-end">@item.FatGrams g</dd>
                            </dl>

                            @if (!string.IsNullOrWhiteSpace(item.Allergens))
                            {
                                <p class="small text-muted mb-0">
                                    <strong>Alerjen:</strong> @item.Allergens
                                </p>
                            }

                            <a class="btn btn-dark mt-auto"
                               asp-controller="Kitchen"
                               asp-action="Order"
                               asp-route-menuItemId="@item.ItemId">
                                Sipariş Ver
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
