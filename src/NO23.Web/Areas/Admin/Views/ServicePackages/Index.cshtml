@using NO23.Web.Domain.Enums
@model IReadOnlyList<ServicePackageListItemViewModel>
@{
    var selectedCategory = ViewData["PackageCategory"] as ServicePackageCategory?;
    var membershipOnly = selectedCategory == ServicePackageCategory.Membership;
    ViewData["Title"] = membershipOnly ? "Üyelik Paketleri" : "Paket Kataloğu";
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">NO23 / ÜRÜN YÖNETİMİ</p>
                <h1>@(membershipOnly ? "Üyelik paketleri" : "Paket kataloğu")</h1>
                <p class="admin-page-description">
                    @(membershipOnly
                        ? "Public alanda sunulan HYBRID, PRO ve BLACK üyeliklerini; süre, ders hakları ve fiyat seçenekleriyle yönet."
                        : "Membership, Personal Training, grup dersleri ve Kids Club paketlerini tek yerden yönet.")
                </p>
            </div>
            <div class="admin-page-actions">
                @if (membershipOnly)
                {
                    <a class="btn btn-outline-dark" asp-action="Index">Tüm kataloğu görüntüle</a>
                }
                <a class="btn btn-dark"
                   asp-action="Create"
                   asp-route-category="@(selectedCategory?.ToString())">
                    + Yeni @(membershipOnly ? "Üyelik Paketi" : "Paket")
                </a>
            </div>
        </header>

        <div class="admin-metrics">
            <article>
                <span>@(membershipOnly ? "Üyelik paketi" : "Toplam paket")</span>
                <strong>@Model.Count</strong>
                <small>@(membershipOnly ? "Güncel satış kataloğu" : "Dört hizmet kategorisi")</small>
            </article>
            <article>
                <span>Aktif</span>
                <strong>@Model.Count(x => x.IsActive)</strong>
                <small>Public alanda görünür</small>
            </article>
            <article>
                <span>Varyant</span>
                <strong>@Model.Sum(x => x.VariantCount)</strong>
                <small>Süre, ders ve fiyat seçeneği</small>
            </article>
        </div>

        <div class="table-responsive admin-table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        @if (!membershipOnly)
                        {
                            <th>Kategori</th>
                        }
                        <th>Paket</th>
                        <th>Varyant</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="@(membershipOnly ? 5 : 6)">
                                <div class="admin-empty-row">Bu kategoride henüz paket bulunmuyor.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="admin-order-no">@item.DisplayOrder.ToString("00")</span></td>
                                @if (!membershipOnly)
                                {
                                    <td><span class="admin-package-code">@item.Category</span></td>
                                }
                                <td>
                                    <strong>@item.Name</strong>
                                    <span class="admin-cell-note">@item.Subtitle</span>
                                </td>
                                <td>@item.VariantCount seçenek</td>
                                <td>
                                    <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                        @(item.IsActive ? "Aktif" : "Pasif")
                                    </span>
                                    @if (item.IsFeatured)
                                    {
                                        <span class="badge text-bg-warning ms-1">Öne çıkan</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@item.Id">Yönet</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
