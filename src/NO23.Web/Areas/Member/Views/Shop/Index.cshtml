@model ShopDashboardViewModel

@{
    ViewData["Title"] = "NO23 Shop";

    string GetProductCategoryName(string category)
    {
        return category switch
        {
            "Apparel" => "Giyim",
            "Accessories" => "Aksesuar",
            "Equipment" => "Ekipman",
            _ => category
        };
    }

    string GetKitchenCategoryName(string category)
    {
        return category switch
        {
            "Breakfast" => "Kahvaltı",
            "MainMeal" => "Ana Öğün",
            "Snack" => "Ara Öğün",
            "Dessert" => "Tatlı",
            "Beverage" => "İçecek",
            _ => category
        };
    }

}

<section class="shop-page">
    <div class="shop-page-grid" aria-hidden="true"></div>
    <div class="shop-page-glow" aria-hidden="true"></div>

    <div class="container position-relative">
        <header class="shop-hero">
            <div class="shop-hero-copy">
                <p class="shop-kicker">NO23 Shop · Member Selection</p>

                <h1>
                    Kulüp ritmini
                    <span>yanında taşı.</span>
                </h1>

                <p class="shop-hero-description">
                    Antrenman ekipmanlarından NO23 koleksiyonuna, hedeflerine uygun
                    Kitchen öğünlerinden günlük aksesuarlara kadar seçimini tamamla.
                </p>

            </div>

            <aside class="shop-hero-card">
                <div class="shop-hero-card-top">
                    <span>NO23 Member Store</span>
                    <strong>23</strong>
                </div>

                <div class="shop-hero-card-content">
                    <p>Tek siparişte</p>
                    <h2>
                        Giy.<br />
                        Hazırlan.<br />
                        Beslen.
                    </h2>
                </div>

                <div class="shop-hero-card-footer">
                    <span>01 · Shop</span>
                    <span>02 · Kitchen</span>
                    <span>03 · Teslimat</span>
                </div>
            </aside>
        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="shop-alert shop-alert-success" role="status">
                <span aria-hidden="true">✓</span>
                <div>
                    <strong>İşlem tamamlandı</strong>
                    <p>@successMessage</p>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="shop-alert shop-alert-error" role="alert">
                <span aria-hidden="true">!</span>
                <div>
                    <strong>İşlem gerçekleştirilemedi</strong>
                    <p>@errorMessage</p>
                </div>
            </div>
        }

        <section class="shop-catalog-section" id="shop-products">
            <div class="shop-section-heading">
                <div>
                    <p class="shop-section-kicker">01 · NO23 koleksiyonu</p>
                    <h2>Antrenman stilini tamamla.</h2>
                </div>

                <p>
                    Kulüp içinde ve günlük hayatta kullanabileceğin fonksiyonel
                    ürünler, sade NO23 tasarımıyla bir arada.
                </p>
            </div>

            @if (Model.ShopProducts.Count == 0)
            {
                <div class="shop-empty-state">
                    <span>01</span>
                    <div>
                        <h3>Koleksiyon hazırlanıyor.</h3>
                        <p>Yeni NO23 ürünleri çok yakında burada olacak.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="shop-product-grid">
                    @for (var index = 0; index < Model.ShopProducts.Count; index++)
                    {
                        var product = Model.ShopProducts[index];

                        <article class="shop-product-card">
                            <div class="shop-product-visual">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Name"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <span class="shop-product-mark">NO23</span>
                                    <strong>@((index + 1).ToString("00"))</strong>
                                }

                                <span class="shop-product-category">
                                    @GetProductCategoryName(product.Category)
                                </span>
                            </div>

                            <div class="shop-product-content">
                                <div class="shop-product-meta">
                                    <span>@(product.Tags?.Split(',').FirstOrDefault()?.Trim() ?? "NO23 seçimi")</span>
                                    <span>@product.StockQuantity adet</span>
                                </div>

                                <h3>@product.Name</h3>
                                <p>@product.Description</p>

                                <div class="shop-product-purchase">
                                    <strong>@product.UnitPrice.ToString("N0") ₺</strong>

                                    <form asp-action="AddShopProduct"
                                          asp-antiforgery="true"
                                          method="post"
                                          class="shop-add-form">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <div class="shop-quantity-control"
                                             data-quantity-control>
                                            <button type="button"
                                                    class="shop-quantity-button"
                                                    data-quantity-decrease
                                                    aria-label="@product.Name adedini azalt"
                                                    disabled>
                                                <svg class="shop-quantity-icon"
                                                     viewBox="0 0 12 12"
                                                     aria-hidden="true"
                                                     focusable="false">
                                                    <path d="M2.5 6h7" />
                                                </svg>
                                            </button>
                                            <input type="number"
                                                   name="quantity"
                                                   value="1"
                                                   min="1"
                                                   max="@Math.Max(product.StockQuantity, 1)"
                                                   step="1"
                                                   inputmode="numeric"
                                                   required
                                                   aria-label="@product.Name adet"
                                                   @(product.StockQuantity == 0 ? "disabled" : null) />
                                            <button type="button"
                                                    class="shop-quantity-button"
                                                    data-quantity-increase
                                                    aria-label="@product.Name adedini artır"
                                                    @(product.StockQuantity == 0 ? "disabled" : null)>
                                                <svg class="shop-quantity-icon"
                                                     viewBox="0 0 12 12"
                                                     aria-hidden="true"
                                                     focusable="false">
                                                    <path d="M2.5 6h7M6 2.5v7" />
                                                </svg>
                                            </button>
                                        </div>
                                        <button type="submit"
                                                @(product.StockQuantity == 0 ? "disabled" : null)>
                                            @(product.StockQuantity == 0 ? "Tükendi" : "Sepete Ekle")
                                            <span aria-hidden="true">+</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="shop-kitchen-section" id="shop-kitchen">
            <div class="shop-section-heading">
                <div>
                    <p class="shop-section-kicker">02 · NO23 Kitchen</p>
                    <h2>Gününü doğru yakıtla planla.</h2>
                </div>

                <p>
                    Kalori ve makro değerleri belli, dengeli ve pratik Kitchen
                    öğünlerini siparişine ekle.
                </p>
            </div>

            @if (Model.KitchenMenuItems.Count == 0)
            {
                <div class="shop-empty-state">
                    <span>02</span>
                    <div>
                        <h3>Kitchen menüsü hazırlanıyor.</h3>
                        <p>Yeni öğünler çok yakında siparişe açılacak.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="shop-kitchen-grid">
                    @for (var index = 0; index < Model.KitchenMenuItems.Count; index++)
                    {
                        var item = Model.KitchenMenuItems[index];

                        <article class="shop-kitchen-card">
                            <div class="shop-kitchen-card-top">
                                <span>@GetKitchenCategoryName(item.Category)</span>
                                <strong>@((index + 1).ToString("00"))</strong>
                            </div>

                            <div class="shop-kitchen-card-content">
                                <p class="shop-kitchen-calorie">@item.Calories kcal</p>
                                <h3>@item.Name</h3>
                                <p class="shop-kitchen-ingredients">@item.Ingredients</p>

                                @if (item.HasAllergenConflict)
                                {
                                    <div class="alert alert-danger py-2 px-3 small" role="alert">
                                        <strong>Bu öğün profilindeki alerjenleri içeriyor:</strong>
                                        @string.Join(", ", item.MatchingAllergenNames)
                                    </div>
                                }
                                else if (item.AllergenNames.Count > 0)
                                {
                                    <p class="small text-muted"><strong>Alerjen:</strong> @string.Join(", ", item.AllergenNames)</p>
                                }

                                <div class="shop-kitchen-macros" aria-label="Makro değerleri">
                                    <span><small>Protein</small><strong>@item.ProteinGrams g</strong></span>
                                    <span><small>Karbonhidrat</small><strong>@item.CarbohydrateGrams g</strong></span>
                                    <span><small>Yağ</small><strong>@item.FatGrams g</strong></span>
                                </div>
                            </div>

                            <div class="shop-kitchen-card-footer">
                                <strong>@item.UnitPrice.ToString("N0") ₺</strong>

                                <form asp-action="AddKitchenMenuItem"
                                      asp-antiforgery="true"
                                      method="post"
                                      class="shop-add-form">
                                    <input type="hidden" name="menuItemId" value="@item.Id" />
                                    <div class="shop-quantity-control"
                                         data-quantity-control>
                                        <button type="button"
                                                class="shop-quantity-button"
                                                data-quantity-decrease
                                                aria-label="@item.Name adedini azalt"
                                                disabled>
                                            <svg class="shop-quantity-icon"
                                                 viewBox="0 0 12 12"
                                                 aria-hidden="true"
                                                 focusable="false">
                                                <path d="M2.5 6h7" />
                                            </svg>
                                        </button>
                                        <input type="number"
                                               name="quantity"
                                               value="1"
                                               min="1"
                                               max="20"
                                               step="1"
                                               inputmode="numeric"
                                               required
                                               aria-label="@item.Name adet" />
                                        <button type="button"
                                                class="shop-quantity-button"
                                                data-quantity-increase
                                                aria-label="@item.Name adedini artır">
                                            <svg class="shop-quantity-icon"
                                                 viewBox="0 0 12 12"
                                                 aria-hidden="true"
                                                 focusable="false">
                                                <path d="M2.5 6h7M6 2.5v7" />
                                            </svg>
                                        </button>
                                    </div>
                                    <button type="submit" @(item.HasAllergenConflict ? "disabled" : null)>
                                        @(item.HasAllergenConflict ? "Alerjinle Uyuşmuyor" : "Sepete Ekle")
                                        <span aria-hidden="true">+</span>
                                    </button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll("[data-quantity-control]")
                .forEach(control => {
                    const input = control.querySelector('input[name="quantity"]');
                    const decreaseButton = control.querySelector(
                        "[data-quantity-decrease]");
                    const increaseButton = control.querySelector(
                        "[data-quantity-increase]");

                    if (!input || !decreaseButton || !increaseButton) {
                        return;
                    }

                    const minimum = Number.parseInt(input.min, 10) || 1;
                    const maximum = Number.parseInt(input.max, 10) ||
                        Number.MAX_SAFE_INTEGER;

                    const normalizeValue = () => {
                        const parsedValue = Number.parseInt(input.value, 10);
                        const value = Number.isNaN(parsedValue)
                            ? minimum
                            : Math.min(maximum, Math.max(minimum, parsedValue));

                        input.value = value.toString();
                        decreaseButton.disabled = input.disabled || value <= minimum;
                        increaseButton.disabled = input.disabled || value >= maximum;

                        return value;
                    };

                    const changeValue = amount => {
                        const currentValue = normalizeValue();
                        input.value = Math.min(
                            maximum,
                            Math.max(minimum, currentValue + amount))
                            .toString();
                        normalizeValue();
                        input.dispatchEvent(new Event("input", { bubbles: true }));
                    };

                    decreaseButton.addEventListener("click", () => changeValue(-1));
                    increaseButton.addEventListener("click", () => changeValue(1));
                    input.addEventListener("change", normalizeValue);
                    input.addEventListener("blur", normalizeValue);
                    input.addEventListener("input", () => {
                        const parsedValue = Number.parseInt(input.value, 10);
                        decreaseButton.disabled = input.disabled ||
                            Number.isNaN(parsedValue) ||
                            parsedValue <= minimum;
                        increaseButton.disabled = input.disabled ||
                            Number.isNaN(parsedValue) ||
                            parsedValue >= maximum;
                    });

                    normalizeValue();
                });
        });
    </script>
}
