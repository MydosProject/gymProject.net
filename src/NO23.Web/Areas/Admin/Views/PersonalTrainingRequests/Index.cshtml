@model IReadOnlyList<PersonalTrainingRequestListItemViewModel>

@{
    ViewData["Title"] = "Birebir Talepler";

    var pendingCount = Model.Count(request => request.IsPending);
    var processedCount = Model.Count - pendingCount;
}

<section class="admin-page admin-personal-requests-page">
    <div class="container">
        <header class="admin-page-head admin-personal-requests-head">
            <div>
                <p class="admin-eyebrow">NO23 CLUB / DERS YÖNETİMİ</p>

                <h1>Birebir talepler</h1>

                <p class="admin-page-description">
                    Üyelerin eğitmenle birebir çalışma taleplerini incele,
                    planla ve süreçlerini tek ekrandan yönet.
                </p>
            </div>

            <div class="admin-page-actions">
                <a class="admin-personal-secondary-action"
                   asp-area="Admin"
                   asp-controller="ClassSessions"
                   asp-action="Index">
                    <span>Ders programı</span>
                    <strong aria-hidden="true">→</strong>
                </a>
            </div>
        </header>

        <section class="admin-personal-overview"
                 aria-label="Birebir talep özeti">
            <article class="admin-personal-metric">
                <div>
                    <span>01</span>
                    <small>Toplam talep</small>
                </div>

                <strong>@Model.Count.ToString("00")</strong>

                <p>Tüm birebir antrenman kayıtları</p>
            </article>

            <article class="admin-personal-metric admin-personal-metric-pending">
                <div>
                    <span>02</span>
                    <small>Bekleyen</small>
                </div>

                <strong>@pendingCount.ToString("00")</strong>

                <p>Henüz işlem yapılmamış talepler</p>
            </article>

            <article class="admin-personal-metric">
                <div>
                    <span>03</span>
                    <small>İşlenen</small>
                </div>

                <strong>@processedCount.ToString("00")</strong>

                <p>Planlanan veya kapatılan kayıtlar</p>
            </article>
        </section>

        <section class="admin-personal-list-section">
            <header class="admin-personal-list-heading">
                <div>
                    <span>Talep listesi</span>
                    <h2>Üye başvuruları</h2>
                </div>

                <small>@Model.Count kayıt</small>
            </header>

            <div class="table-responsive admin-table-card admin-personal-table-card">
                <table class="table align-middle mb-0 admin-personal-table">
                    <thead>
                        <tr>
                            <th>Sıra</th>
                            <th>Üye</th>
                            <th>Eğitmen</th>
                            <th>Tercih</th>
                            <th>Oluşturulma</th>
                            <th>Durum</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="admin-personal-empty-state">
                                        <span>00</span>

                                        <div>
                                            <h3>Henüz birebir antrenman talebi yok.</h3>

                                            <p>
                                                Üyeler talep oluşturduğunda kayıtlar
                                                burada görüntülenecek.
                                            </p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (var index = 0; index < Model.Count; index++)
                            {
                                var request = Model[index];
                                var createdAtLocal =
                                    request.CreatedAtUtc.ToLocalTime();

                                <tr>
                                    <td data-label="Sıra">
                                        <span class="admin-order-no">
                                            @((index + 1).ToString("00"))
                                        </span>
                                    </td>

                                    <td data-label="Üye">
                                        <div class="admin-personal-member">
                                            <span class="admin-personal-avatar">
                                                @(string.IsNullOrWhiteSpace(request.MemberName)
                                                    ? "Ü"
                                                    : request.MemberName.Trim()[0]
                                                        .ToString()
                                                        .ToUpper())
                                            </span>

                                            <div>
                                                <strong class="admin-class-name">
                                                    @request.MemberName
                                                </strong>

                                                <span class="admin-cell-note">
                                                    @request.MemberEmail
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td data-label="Eğitmen">
                                        <div class="admin-personal-trainer">
                                            <span>Eğitmen</span>
                                            <strong>@request.TrainerName</strong>
                                        </div>
                                    </td>

                                    <td data-label="Tercih">
                                        <div class="admin-personal-date">
                                            <strong>
                                                @request.PreferredDate.ToString("dd.MM.yyyy")
                                            </strong>

                                            <span class="admin-cell-note">
                                                @request.PreferredTimeWindow
                                            </span>
                                        </div>
                                    </td>

                                    <td data-label="Oluşturulma">
                                        <div class="admin-personal-date">
                                            <strong>
                                                @createdAtLocal.ToString("dd.MM.yyyy")
                                            </strong>

                                            <span class="admin-cell-note">
                                                @createdAtLocal.ToString("HH:mm")
                                            </span>
                                        </div>
                                    </td>

                                    <td data-label="Durum">
                                        <span class="admin-personal-status
                                                     @(request.IsPending
                                                         ? "is-pending"
                                                         : "is-processed")">
                                            @request.Status
                                        </span>
                                    </td>

                                    <td class="text-end"
                                        data-label="İşlem">
                                        <a class="admin-personal-manage-button"
                                           asp-action="Edit"
                                           asp-route-id="@request.Id">
                                            <span>Yönet</span>
                                            <strong aria-hidden="true">→</strong>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</section>