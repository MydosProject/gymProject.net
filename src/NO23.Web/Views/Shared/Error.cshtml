@model ErrorViewModel
@{
    ViewData["Title"] = "Bir Sorun Oluştu";
}

<div class="error-page">
    <section class="error-stage">
        <div class="container error-stage-grid">
            <div class="error-code" aria-hidden="true">
                <span>NO</span>
                <strong>23</strong>
                <small>SYSTEM / PAUSE</small>
            </div>

            <div class="error-copy">
                <p class="error-kicker">BEKLENMEYEN BİR DURUM OLUŞTU</p>
                <h1>Ritmi kısa süreliğine <span>durdurduk.</span></h1>
                <p>
                    İsteğini şu anda tamamlayamadık. Ana sayfaya dönebilir veya iletişim kanallarından
                    NO23 ekibine ulaşabilirsin.
                </p>

                <div class="error-actions">
                    <a class="no23-primary-button" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a>
                    <a class="error-secondary-link"
                       asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="contact">
                        Destek al <span>↗</span>
                    </a>
                </div>

                @if (Model.ShowRequestId)
                {
                    <div class="error-request-id">
                        <span>Talep kimliği</span>
                        <code>@Model.RequestId</code>
                        <small>Destek ekibiyle iletişime geçerken bu kodu paylaşabilirsin.</small>
                    </div>
                }
            </div>
        </div>
    </section>
</div>
