@model SuccessStoryFormViewModel
@{
    ViewData["Title"] = "Başarı Hikâyesini Düzenle";
}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head admin-form-head">
            <div>
                <a asp-action="Index" class="admin-back-link">← Hikâyelere dön</a>
                <p class="admin-eyebrow">İçerik / Başarı Hikâyeleri</p>
                <h1>Hikâyeyi düzenle</h1>
                <p class="admin-page-description">Üye bilgilerini, dönüşüm içeriğini ve yayın durumunu güncelle.</p>
            </div>
        </header>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">
                @successMessage
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }

        <partial name="_SuccessStoryForm" model="Model" />
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}