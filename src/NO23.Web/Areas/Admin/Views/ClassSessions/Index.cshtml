@model IReadOnlyList<ClassSessionListItemViewModel>
@{
    ViewData["Title"] = "Ders Programı";
    var scheduledCount = Model.Count(session => session.IsScheduled);
    var totalReservations = Model.Sum(session => session.ReservedCount);

}

<section class="admin-page">
    <div class="container">
        <header class="admin-page-head">
            <div>
                <p class="admin-eyebrow">NO23 CLUB / DERS YÖNETİMİ</p>
                <h1>Ders programı</h1>
                <p class="admin-page-description">Grup derslerini takvime yerleştir, kontenjanı takip et ve seans durumlarını yönet.</p>
            </div>
            <div class="admin-page-actions">
                <a class="btn btn-outline-dark" asp-area="Admin" asp-controller="GroupClasses" asp-action="Index">Grup dersleri</a>
                <a class="btn btn-dark" asp-action="Create">+ Programa ders ekle</a>
            </div>
        </header>

        <div class="admin-metrics">
            <article><span>Toplam seans</span><strong>@Model.Count</strong><small>Tüm program</small></article>
            <article><span>Planlanan</span><strong>@scheduledCount</strong><small>Rezervasyona açık</small></article>
            <article><span>Rezervasyon</span><strong>@totalReservations</strong><small>Toplam katılımcı</small></article>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <div class="table-responsive admin-table-card admin-session-table">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Ders</th>
                        <th>Eğitmen</th>
                        <th>Tarih</th>
                        <th>Saat</th>
                        <th>Kontenjan</th>
                        <th>Kalan</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="9"><div class="admin-empty-row">Henüz programa seans eklenmedi.</div></td></tr>
                    }
                    else
                    {
                        @for (var index = 0; index < Model.Count; index++)
                        {
                            var session = Model[index];
                            var startsAtLocal = session.StartsAtUtc.ToLocalTime();
                            var remainingCapacity = Math.Max(0, session.Capacity - session.ReservedCount);
                            var isScheduled = session.IsScheduled;

                            <tr>
                                <td data-label="Sıra"><span class="admin-order-no">@((index + 1).ToString("00"))</span></td>
                                <td data-label="Ders">
                                    <strong class="admin-class-name">@session.ClassName</strong>
                                    @if (!session.IsGroupClassActive)
                                    {
                                        <small class="admin-cell-note">Pasif ders</small>
                                    }
                                </td>
                                <td data-label="Eğitmen">@session.TrainerName</td>
                                <td data-label="Tarih"><strong>@startsAtLocal.ToString("dd.MM.yyyy")</strong></td>
                                <td data-label="Saat"><span class="admin-code">@startsAtLocal.ToString("HH:mm")</span></td>
                                <td data-label="Kontenjan">
                                    <strong>@session.ReservedCount / @session.Capacity</strong>
                                    <span class="admin-cell-note">rezervasyon</span>
                                </td>
                                <td data-label="Kalan"><span class="admin-capacity @(remainingCapacity == 0 ? "is-full" : null)">@remainingCapacity yer</span></td>
                                <td data-label="Durum"><span class="badge @(isScheduled ? "text-bg-success" : "text-bg-secondary")">@session.Status</span></td>
                                <td class="text-end" data-label="İşlem"><a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@session.Id">Düzenle</a></td>
                            </tr>
                            <tr class="admin-session-participant-row">
                                <td colspan="9">
                                    <details class="admin-session-participants">
                                        <summary>
                                            <span>Katılımcılar</span>
                                            <strong>@session.Participants.Count kişi</strong>
                                        </summary>

                                        @if (session.Participants.Count == 0)
                                        {
                                            <p class="admin-session-participants-empty">
                                                Bu seansa henüz kayıt yaptıran üye yok.
                                            </p>
                                        }
                                        else
                                        {
                                            <div class="admin-session-participant-list">
                                                @foreach (var participant in session.Participants)
                                                {
                                                    <article>
                                                        <div>
                                                            <strong>@participant.DisplayName</strong>
                                                            <span>@participant.Email</span>
                                                            <small>
                                                                @participant.PackageName ·
                                                                @participant.ReservedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") tarihinde kaydoldu
                                                            </small>
                                                        </div>
                                                        <form asp-area="Admin"
                                                              asp-controller="ClassSessions"
                                                              asp-action="RemoveReservation"
                                                              asp-route-id="@session.Id"
                                                              method="post"
                                                              onsubmit="return confirm('Bu katılımcı ders listesinden çıkarılsın mı?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden"
                                                                   name="reservationId"
                                                                   value="@participant.ReservationId" />
                                                            <button type="submit"
                                                                    class="btn btn-sm btn-outline-danger">
                                                                Listeden çıkar
                                                            </button>
                                                        </form>
                                                    </article>
                                                }
                                            </div>
                                        }
                                    </details>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
